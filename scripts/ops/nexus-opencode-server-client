#!/usr/bin/env python3
"""Execute one OpenCode request through the dedicated Nexus loopback server."""

from __future__ import annotations

import argparse
import json
import os
import sys
from importlib import import_module
from pathlib import Path


def _default_snapshot() -> Path:
    host_runtime = Path.home() / ".local/share/nexus-host-runtime/current/snapshot"
    if host_runtime.is_dir():
        return host_runtime
    return Path.home() / ".local/share/nexus-external-worker/Nexus-new"


snapshot = Path(os.getenv("NEXUS_EXTERNAL_WORKER_SNAPSHOT", str(_default_snapshot())))
if not snapshot.is_dir():
    raise SystemExit("NEXUS_EXTERNAL_WORKER_SNAPSHOT_MISSING")
sys.path.insert(0, str(snapshot))

module = import_module("nexus.services.opencode_server_client")
OpenCodeServerClient = module.OpenCodeServerClient
OpenCodeRequestTimeout = module.OpenCodeRequestTimeout
OpenCodeServerError = module.OpenCodeServerError


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--model", required=True)
    ap.add_argument("--cwd", required=True)
    ap.add_argument("--mode", choices=("plan", "act"), default="plan")
    ap.add_argument("--auto-approve", action="store_true")
    ap.add_argument("--timeout", type=int, default=900)
    ap.add_argument("--require-free", action="store_true")
    args = ap.parse_args(argv)
    prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("EMPTY_PROMPT")

    try:
        result = OpenCodeServerClient().run(
            model=args.model,
            prompt=prompt,
            directory=str(Path(args.cwd).expanduser().resolve()),
            mode=args.mode,
            auto_approve=args.auto_approve,
            timeout_seconds=args.timeout,
            require_free=args.require_free,
        )
    except OpenCodeRequestTimeout as exc:
        print(
            json.dumps(
                {
                    "type": "opencode_error",
                    "failure_kind": "TIMEOUT",
                    "outcome_unknown": True,
                    "retry_permitted": False,
                    "error": str(exc),
                },
                sort_keys=True,
            )
        )
        return 124
    except OpenCodeServerError as exc:
        print(
            json.dumps(
                {
                    "type": "opencode_error",
                    "failure_kind": "UNKNOWN",
                    "outcome_unknown": False,
                    "retry_permitted": False,
                    "error": str(exc),
                },
                sort_keys=True,
            )
        )
        return 1

    print(
        json.dumps(
            {
                "type": "opencode_result",
                "provider": result.provider,
                "model": result.model,
                "cost": result.cost,
                "finish": result.finish,
                "session_id": result.session_id,
                "message_id": result.message_id,
                "tool_event_count": result.tool_event_count,
                "text": result.text,
                "server_version": result.server_version,
            },
            ensure_ascii=False,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
