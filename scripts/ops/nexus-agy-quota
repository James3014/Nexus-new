#!/usr/bin/env python3
"""Query live Agy quota from each isolated account and persist one snapshot.

This intentionally asks Agy itself for /usage. Agy owns the live macOS
Keychain credential, while the vendor manager's copied token file can lag after
refresh. The snapshot is advisory input to the canonical dispatcher; account
health/cooldown/lease state remains owned by the account-pool manager.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


def emit_progress(
    phase: str,
    *,
    on_progress: Any = None,
    **details: Any,
) -> dict[str, Any]:
    event = {
        "phase": phase,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        **details,
    }
    sys.stderr.write(f"NEXUS_AGY_QUOTA {json.dumps(event, sort_keys=True)}\n")
    sys.stderr.flush()
    if callable(on_progress):
        try:
            on_progress(event)
        except Exception:
            pass
    return event


USAGE_LINE = re.compile(
    r"^(?P<group>.+?)\s+"
    r"(?P<window>Weekly Limit Remaining|Five Hour Limit Remaining)\s+"
    r"(?P<value>[0-9]+(?:\.[0-9]+)?%|disabled)"
    r"(?:\s+(?P<reset>\S+))?\s*$",
    re.IGNORECASE,
)


def _pool_root() -> Path:
    return Path(
        os.getenv(
            "NEXUS_AGY_ACCOUNT_POOL_ROOT",
            str(Path.home() / ".nexus/agy-account-pool/runtime"),
        )
    ).expanduser()


def _snapshot_path() -> Path:
    return Path(
        os.getenv(
            "NEXUS_AGY_QUOTA_SNAPSHOT",
            str(Path.home() / ".nexus/agy-account-pool/quota-snapshot.json"),
        )
    ).expanduser()


def _agy_binary() -> str:
    explicit = os.getenv("NEXUS_AGY_BINARY")
    if explicit:
        return str(Path(explicit).expanduser())
    found = shutil.which("agy")
    if found:
        return found
    return str(Path.home() / ".local/bin/agy")


def parse_usage(text: str) -> dict[str, dict[str, dict[str, Any]]]:
    groups: dict[str, dict[str, dict[str, Any]]] = {}
    for raw in text.splitlines():
        match = USAGE_LINE.match(raw.strip())
        if not match:
            continue
        group = match.group("group").strip()
        window = "5h" if match.group("window").lower().startswith("five hour") else "weekly"
        raw_value = match.group("value")
        if raw_value.lower() == "disabled":
            value: dict[str, Any] = {
                "status": "disabled",
                "remaining_pct": None,
                "reset_at": None,
            }
        else:
            value = {
                "status": "known",
                "remaining_pct": float(raw_value.rstrip("%")),
                "reset_at": match.group("reset") or None,
            }
        groups.setdefault(group, {})[window] = value
    return groups


def _state(pool_root: Path) -> dict[str, Any]:
    path = pool_root / "state.json"
    if not path.is_file():
        return {"accounts": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"accounts": {}}
    return data if isinstance(data, dict) else {"accounts": {}}


def _account_email(state: dict[str, Any], name: str) -> str | None:
    accounts = state.get("accounts")
    meta = accounts.get(name) if isinstance(accounts, dict) else None
    identity = meta.get("identity") if isinstance(meta, dict) else None
    if not isinstance(identity, dict):
        return None
    value = identity.get("email") or identity.get("account_name")
    return value if isinstance(value, str) and value else None


def query_account(
    *,
    account_home: Path,
    account_name: str,
    email: str | None,
    agy_binary: str,
    timeout: float,
    checked_at: str,
    on_progress: Any = None,
) -> dict[str, Any]:
    emit_progress(
        "QUERYING_ACCOUNT",
        account=account_name,
        email=email,
        timeout=timeout,
        on_progress=on_progress,
    )
    env = os.environ.copy()
    env["HOME"] = str(account_home)
    result: dict[str, Any]
    try:
        proc = subprocess.run(
            [agy_binary, "-p", "/usage"],
            cwd=account_home,
            env=env,
            capture_output=True,
            text=True,
            timeout=max(0.001, float(timeout)),
            check=False,
        )
    except subprocess.TimeoutExpired:
        result = {
            "account": account_name,
            "email": email,
            "ok": False,
            "error": "timeout",
            "checked_at": checked_at,
        }
        emit_progress(
            "ACCOUNT_RESULT",
            account=account_name,
            ok=False,
            error="timeout",
            on_progress=on_progress,
        )
        return result

    output = "\n".join(part for part in (proc.stdout, proc.stderr) if part).strip()
    if proc.returncode != 0:
        result = {
            "account": account_name,
            "email": email,
            "ok": False,
            "error": f"exit_{proc.returncode}",
            "checked_at": checked_at,
        }
        emit_progress(
            "ACCOUNT_RESULT",
            account=account_name,
            ok=False,
            error=result["error"],
            on_progress=on_progress,
        )
        return result
    groups = parse_usage(output)
    if not groups:
        result = {
            "account": account_name,
            "email": email,
            "ok": False,
            "error": "usage_unparseable",
            "checked_at": checked_at,
        }
        emit_progress(
            "ACCOUNT_RESULT",
            account=account_name,
            ok=False,
            error="usage_unparseable",
            on_progress=on_progress,
        )
        return result
    result = {
        "account": account_name,
        "email": email,
        "ok": True,
        "groups": groups,
        "checked_at": checked_at,
    }
    emit_progress("ACCOUNT_RESULT", account=account_name, ok=True, on_progress=on_progress)
    return result


def merge_snapshot(
    *,
    snapshot_path: Path,
    current_names: set[str],
    refreshed_rows: list[dict[str, Any]],
    partial: bool,
    checked_at: str,
) -> dict[str, Any]:
    merged: dict[str, dict[str, Any]] = {}
    prior_checked_at: str | None = None
    if snapshot_path.is_file():
        try:
            prior = json.loads(snapshot_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            prior = {}
        if isinstance(prior, dict) and isinstance(prior.get("checked_at"), str):
            prior_checked_at = prior["checked_at"]
        rows = prior.get("accounts") if isinstance(prior, dict) else None
        if isinstance(rows, list):
            for row in rows:
                if (
                    isinstance(row, dict)
                    and isinstance(row.get("account"), str)
                    and row["account"] in current_names
                ):
                    preserved = dict(row)
                    if "checked_at" not in preserved and prior_checked_at is not None:
                        preserved["checked_at"] = prior_checked_at
                    merged[row["account"]] = preserved

    for row in refreshed_rows:
        name = row.get("account")
        if not isinstance(name, str):
            continue
        if row.get("ok") is True or name not in merged or not merged[name].get("ok"):
            merged[name] = row
            continue
        prior_row = dict(merged[name])
        prior_row["last_refresh"] = {
            "ok": False,
            "error": row.get("error"),
            "checked_at": row.get("checked_at", checked_at),
        }
        merged[name] = prior_row

    all_names = current_names | {
        r["account"] for r in refreshed_rows if isinstance(r.get("account"), str)
    }
    return {
        "checked_at": checked_at,
        "accounts": [merged[name] for name in sorted(merged) if name in all_names],
    }


def write_snapshot(snapshot_path: Path, payload: dict[str, Any]) -> None:
    snapshot_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = snapshot_path.with_name(f".{snapshot_path.name}.tmp.{os.getpid()}")
    tmp.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    os.replace(tmp, snapshot_path)


def main(argv: list[str] | None = None, *, on_progress: Any = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("accounts", nargs="*")
    parser.add_argument("--timeout", type=int, default=30)
    parser.add_argument(
        "--total-timeout", "--deadline", dest="total_timeout", type=float, default=None
    )
    args = parser.parse_args(argv)

    checked_at = datetime.now(timezone.utc).isoformat()
    total_timeout = args.total_timeout
    if total_timeout is None:
        raw_env = os.getenv("NEXUS_AGY_QUOTA_TOTAL_TIMEOUT")
        if raw_env:
            try:
                total_timeout = float(raw_env)
            except ValueError:
                pass
    if total_timeout is None:
        total_timeout = float(args.timeout)
    deadline_monotonic = time.monotonic() + total_timeout

    emit_progress(
        "STARTING",
        accounts=args.accounts,
        timeout=args.timeout,
        total_timeout=total_timeout,
        on_progress=on_progress,
    )

    pool_root = _pool_root()
    accounts_dir = pool_root / "accounts"
    if not accounts_dir.is_dir():
        emit_progress(
            "ACCOUNTS_DIR_MISSING",
            path=str(accounts_dir),
            on_progress=on_progress,
        )
        payload = {
            "checked_at": checked_at,
            "accounts": [
                {
                    "account": name,
                    "email": None,
                    "ok": False,
                    "error": f"accounts_dir_missing:{accounts_dir}",
                    "checked_at": checked_at,
                }
                for name in (args.accounts or [])
            ],
            "error": f"AGY_ACCOUNT_POOL_ACCOUNTS_MISSING:{accounts_dir}",
        }
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 2

    all_homes = {path.name: path for path in accounts_dir.iterdir() if path.is_dir()}
    requested = args.accounts or sorted(all_homes)
    state = _state(pool_root)
    agy_binary = _agy_binary()

    rows: list[dict[str, Any]] = []
    for name in requested:
        if name not in all_homes:
            emit_progress("ACCOUNT_UNKNOWN", account=name, on_progress=on_progress)
            rows.append({
                "account": name,
                "email": _account_email(state, name),
                "ok": False,
                "error": "unknown_account",
                "checked_at": checked_at,
            })
            continue

        if deadline_monotonic is not None:
            remaining = deadline_monotonic - time.monotonic()
            if remaining <= 0:
                emit_progress("DEADLINE_EXCEEDED", account=name, on_progress=on_progress)
                rows.append({
                    "account": name,
                    "email": _account_email(state, name),
                    "ok": False,
                    "error": "deadline_exceeded",
                    "checked_at": checked_at,
                })
                continue
            effective_timeout = min(float(args.timeout), max(0.001, remaining))
        else:
            effective_timeout = args.timeout

        res = query_account(
            account_home=all_homes[name],
            account_name=name,
            email=_account_email(state, name),
            agy_binary=agy_binary,
            timeout=effective_timeout,
            checked_at=checked_at,
            on_progress=on_progress,
        )
        rows.append(res)

    snapshot_path = _snapshot_path()
    emit_progress("SAVING_SNAPSHOT", snapshot_path=str(snapshot_path), on_progress=on_progress)
    payload = merge_snapshot(
        snapshot_path=snapshot_path,
        current_names=set(all_homes),
        refreshed_rows=rows,
        partial=bool(args.accounts),
        checked_at=checked_at,
    )
    write_snapshot(snapshot_path, payload)
    emit_progress(
        "FINISHED",
        total=len(rows),
        ok=sum(1 for r in rows if r.get("ok") is True),
        on_progress=on_progress,
    )
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0 if all(row.get("ok") is True for row in rows) else 2


if __name__ == "__main__":
    raise SystemExit(main())
