#!/usr/bin/env python3
"""Query live Agy quota from each isolated account and persist one snapshot.

This intentionally asks Agy itself for /usage. Agy owns the live macOS
Keychain credential, while the vendor manager's copied token file can lag after
refresh. The snapshot is advisory input to the canonical dispatcher; account
health/cooldown/lease state remains owned by the account-pool manager.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

USAGE_LINE = re.compile(
    r"^(?P<group>.+?)\s+"
    r"(?P<window>Weekly Limit Remaining|Five Hour Limit Remaining)\s+"
    r"(?P<value>[0-9]+(?:\.[0-9]+)?%|disabled)"
    r"(?:\s+(?P<reset>\S+))?\s*$",
    re.IGNORECASE,
)


def _pool_root() -> Path:
    return Path(
        os.getenv(
            "NEXUS_AGY_ACCOUNT_POOL_ROOT",
            str(Path.home() / ".nexus/agy-account-pool/runtime"),
        )
    ).expanduser()


def _snapshot_path() -> Path:
    return Path(
        os.getenv(
            "NEXUS_AGY_QUOTA_SNAPSHOT",
            str(Path.home() / ".nexus/agy-account-pool/quota-snapshot.json"),
        )
    ).expanduser()


def _agy_binary() -> str:
    explicit = os.getenv("NEXUS_AGY_BINARY")
    if explicit:
        return str(Path(explicit).expanduser())
    found = shutil.which("agy")
    if found:
        return found
    return str(Path.home() / ".local/bin/agy")


def parse_usage(text: str) -> dict[str, dict[str, dict[str, Any]]]:
    groups: dict[str, dict[str, dict[str, Any]]] = {}
    for raw in text.splitlines():
        match = USAGE_LINE.match(raw.strip())
        if not match:
            continue
        group = match.group("group").strip()
        window = "5h" if match.group("window").lower().startswith("five hour") else "weekly"
        raw_value = match.group("value")
        if raw_value.lower() == "disabled":
            value: dict[str, Any] = {
                "status": "disabled",
                "remaining_pct": None,
                "reset_at": None,
            }
        else:
            value = {
                "status": "known",
                "remaining_pct": float(raw_value.rstrip("%")),
                "reset_at": match.group("reset") or None,
            }
        groups.setdefault(group, {})[window] = value
    return groups


def _state(pool_root: Path) -> dict[str, Any]:
    path = pool_root / "state.json"
    if not path.is_file():
        return {"accounts": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"accounts": {}}
    return data if isinstance(data, dict) else {"accounts": {}}


def _account_email(state: dict[str, Any], name: str) -> str | None:
    accounts = state.get("accounts")
    meta = accounts.get(name) if isinstance(accounts, dict) else None
    identity = meta.get("identity") if isinstance(meta, dict) else None
    if not isinstance(identity, dict):
        return None
    value = identity.get("email") or identity.get("account_name")
    return value if isinstance(value, str) and value else None


def query_account(
    *,
    account_home: Path,
    account_name: str,
    email: str | None,
    agy_binary: str,
    timeout: int,
    checked_at: str,
) -> dict[str, Any]:
    env = os.environ.copy()
    env["HOME"] = str(account_home)
    try:
        proc = subprocess.run(
            [agy_binary, "-p", "/usage"],
            cwd=account_home,
            env=env,
            capture_output=True,
            text=True,
            timeout=max(10, timeout),
            check=False,
        )
    except subprocess.TimeoutExpired:
        return {
            "account": account_name,
            "email": email,
            "ok": False,
            "error": "timeout",
            "checked_at": checked_at,
        }

    output = "\n".join(part for part in (proc.stdout, proc.stderr) if part).strip()
    if proc.returncode != 0:
        return {
            "account": account_name,
            "email": email,
            "ok": False,
            "error": f"exit_{proc.returncode}",
            "checked_at": checked_at,
        }
    groups = parse_usage(output)
    if not groups:
        return {
            "account": account_name,
            "email": email,
            "ok": False,
            "error": "usage_unparseable",
            "checked_at": checked_at,
        }
    return {
        "account": account_name,
        "email": email,
        "ok": True,
        "groups": groups,
        "checked_at": checked_at,
    }


def merge_snapshot(
    *,
    snapshot_path: Path,
    current_names: set[str],
    refreshed_rows: list[dict[str, Any]],
    partial: bool,
    checked_at: str,
) -> dict[str, Any]:
    merged: dict[str, dict[str, Any]] = {}
    if partial and snapshot_path.is_file():
        try:
            prior = json.loads(snapshot_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            prior = {}
        rows = prior.get("accounts") if isinstance(prior, dict) else None
        if isinstance(rows, list):
            for row in rows:
                if (
                    isinstance(row, dict)
                    and isinstance(row.get("account"), str)
                    and row["account"] in current_names
                ):
                    merged[row["account"]] = row

    for row in refreshed_rows:
        name = row.get("account")
        if isinstance(name, str) and name in current_names:
            merged[name] = row

    return {
        "checked_at": checked_at,
        "accounts": [merged[name] for name in sorted(merged) if name in current_names],
    }


def write_snapshot(snapshot_path: Path, payload: dict[str, Any]) -> None:
    snapshot_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = snapshot_path.with_name(f".{snapshot_path.name}.tmp.{os.getpid()}")
    tmp.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    os.replace(tmp, snapshot_path)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("accounts", nargs="*")
    parser.add_argument("--timeout", type=int, default=30)
    args = parser.parse_args(argv)

    pool_root = _pool_root()
    accounts_dir = pool_root / "accounts"
    if not accounts_dir.is_dir():
        raise SystemExit(f"AGY_ACCOUNT_POOL_ACCOUNTS_MISSING:{accounts_dir}")

    all_homes = {path.name: path for path in accounts_dir.iterdir() if path.is_dir()}
    requested = args.accounts or sorted(all_homes)
    unknown = [name for name in requested if name not in all_homes]
    if unknown:
        raise SystemExit("AGY_ACCOUNT_UNKNOWN:" + ",".join(unknown))

    state = _state(pool_root)
    checked_at = datetime.now(timezone.utc).isoformat()
    agy_binary = _agy_binary()
    rows = [
        query_account(
            account_home=all_homes[name],
            account_name=name,
            email=_account_email(state, name),
            agy_binary=agy_binary,
            timeout=args.timeout,
            checked_at=checked_at,
        )
        for name in requested
    ]
    snapshot_path = _snapshot_path()
    payload = merge_snapshot(
        snapshot_path=snapshot_path,
        current_names=set(all_homes),
        refreshed_rows=rows,
        partial=bool(args.accounts),
        checked_at=checked_at,
    )
    write_snapshot(snapshot_path, payload)
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0 if all(row.get("ok") is True for row in rows) else 2


if __name__ == "__main__":
    raise SystemExit(main())
