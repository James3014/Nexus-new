#!/usr/bin/env python3
"""Run the Nexus Core Issue-bound check locally with CI parity.

Reads the Core pin from the base ref's workflow, installs that pin into an
isolated pin-keyed tool directory (under a timeout; a cached install is reused only
after it completed), runs ``issue-init`` and ``issue-check`` in a temporary clean
detached worktree at the exact committed HEAD, and prints a JSON summary.
``issue-check`` runs with ``--require-trusted-config`` (as in CI) and with
``--expect-config-commit`` set to the base commit resolved here, so the verification
contract comes only from the trusted base commit. Both subcommands get the
``--evidence-universe`` that the base ref's workflow declares (CI's default,
``issue-marker``, when it declares none). As in the CI issue gate (nexus-core#281), a
head that carries anything under ``.nexus-core/receipts`` is refused before Core runs,
and the only receipt read is the one ``issue-check`` reports through
``--receipt-path-out``; it is never picked from the checkout by name or time. It holds
no completion authority: the Core receipt is the only verdict. Local or tooling
problems fail closed with exit 2; a Core verdict other than VERIFIED exits 1.

The JSON summary carries the receipt ``status`` plus ``reason_codes`` (list from
``outcome.reason_codes``, [] when absent) and ``transport_error`` (bool from
``outcome.transport_error``, false when absent). ``--json-out PATH`` also writes
the identical summary to PATH; if that write fails, a warning goes to stderr and
the original exit code is kept.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Sequence

SCHEMA = "nexus.core_issue_check_local.v1"
WORKFLOW_PATH = ".github/workflows/nexus-core-issue-completion.yml"
# Legacy single-job gate pinned the tool via NEXUS_CORE_TOOL_PIN; the two-job gate
# (nexus-core#116/#120) pins it via the composite-action inputs `nexus-certify-ref`
# and the `uses: James3014/nexus-core/.github/actions/<name>@<sha>` lines. Exactly one
# distinct sha must appear across all of them.
PIN_RE = re.compile(
    r"^\s*(?:NEXUS_CORE_TOOL_PIN:\s*|nexus-certify-ref:\s*\"?)([0-9a-f]{40})\"?\s*$"
    r"|^\s*-?\s*uses:\s*James3014/nexus-core/\.github/actions/[A-Za-z0-9_-]+@([0-9a-f]{40})\s*(?:#.*)?$",
    re.MULTILINE,
)
# Same source of truth as the pin: the base workflow's issue-gate input.
UNIVERSE_RE = re.compile(
    r"^\s*evidence-universe:\s*[\"']?([^\s\"'#]+)[\"']?\s*(?:#.*)?$", re.MULTILINE
)
# Core's evidence-universe modes (product/clients/issue_golden_path.py) and the issue-gate
# action's default (nexus-core .github/actions/issue-gate/action.yml).
UNIVERSE_MODES = ("issue-marker", "trusted-config")
UNIVERSE_DEFAULT = "issue-marker"
# Core receipt file name, as accepted by the CI issue gate's signing step (#281).
RECEIPT_NAME_RE = re.compile(r"^\d{8}T\d{6}\.\d{6}\+0000-[0-9a-f]{12}\.json$")
RECEIPTS_DIR = Path(".nexus-core") / "receipts"
TOOL_READY = ".nexus-core-tool-ready"
INSTALL_TIMEOUT_SECONDS = 1200
CLAIM_RE = re.compile(r"claim ceiling:\s*(\S+)", re.IGNORECASE)
CORE_REPO_URL = "git+https://github.com/James3014/nexus-core.git@{pin}"
EXIT_OK = 0
EXIT_CORE_FAILED = 1
EXIT_ERROR = 2


class LocalCheckError(RuntimeError):
    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code


def _run(
    cmd: Sequence[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    code: str = "COMMAND_FAILED",
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    if timeout is None:
        try:
            result = subprocess.run(
                list(cmd),
                cwd=cwd,
                env=env,
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError as exc:
            raise LocalCheckError(code, f"cannot execute {cmd[0]}: {exc}") from exc
    else:
        result = _run_with_timeout(cmd, cwd=cwd, env=env, code=code, timeout=timeout)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()[-500:]
        raise LocalCheckError(code, f"{' '.join(cmd[:3])} failed: {detail}")
    return result


def _run_with_timeout(
    cmd: Sequence[str],
    *,
    cwd: Path | None,
    env: dict[str, str] | None,
    code: str,
    timeout: float,
) -> subprocess.CompletedProcess[str]:
    """Run in a new process group; on timeout kill the whole group and fail closed.

    Output goes to temporary files, not pipes, so a descendant that left the
    group cannot keep the wait open after the group is killed.
    """
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        try:
            proc = subprocess.Popen(
                list(cmd),
                cwd=cwd,
                env=env,
                stdout=out,
                stderr=err,
                start_new_session=True,
            )
        except OSError as exc:
            raise LocalCheckError(code, f"cannot execute {cmd[0]}: {exc}") from exc
        try:
            proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.wait()
            raise LocalCheckError(code, f"{' '.join(cmd[:3])} timed out after {timeout:g}s")
        out.seek(0)
        err.seek(0)
        stdout = out.read().decode("utf-8", "replace")
        stderr = err.read().decode("utf-8", "replace")
    return subprocess.CompletedProcess(list(cmd), proc.returncode, stdout, stderr)


def _git(repo: Path, *args: str, code: str = "GIT_FAILED") -> str:
    return _run(["git", "-C", str(repo), *args], code=code).stdout


def _sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def check_clean(repo: Path) -> None:
    status = _git(repo, "status", "--porcelain", "--untracked-files=all")
    if status.strip():
        raise LocalCheckError(
            "WORKTREE_DIRTY",
            "source worktree has uncommitted or untracked files: "
            + "; ".join(status.strip().splitlines()[:5]),
        )


def read_pin(repo: Path, base_ref: str) -> str:
    try:
        text = _git(repo, "show", f"{base_ref}:{WORKFLOW_PATH}")
    except LocalCheckError as exc:
        raise LocalCheckError("CORE_PIN_UNRESOLVED", str(exc)) from exc
    matches = {a or b for a, b in PIN_RE.findall(text)}
    if len(matches) != 1:
        raise LocalCheckError(
            "CORE_PIN_UNRESOLVED",
            f"expected exactly one distinct Core pin (NEXUS_CORE_TOOL_PIN or nexus-certify-ref/uses@sha) in {base_ref}:{WORKFLOW_PATH}",
        )
    return matches.pop()


def read_evidence_universe(repo: Path, base_ref: str) -> str:
    """The evidence universe the base ref's workflow passes to the CI issue gate.

    Read from the base ref only, like the pin, so a head edit cannot change it.
    """
    try:
        text = _git(repo, "show", f"{base_ref}:{WORKFLOW_PATH}")
    except LocalCheckError as exc:
        raise LocalCheckError("CORE_UNIVERSE_UNRESOLVED", str(exc)) from exc
    values = set(UNIVERSE_RE.findall(text))
    if not values:
        return UNIVERSE_DEFAULT
    if len(values) != 1 or not values <= set(UNIVERSE_MODES):
        raise LocalCheckError(
            "CORE_UNIVERSE_UNRESOLVED",
            f"expected at most one evidence-universe value from {UNIVERSE_MODES} in "
            f"{base_ref}:{WORKFLOW_PATH}, found {sorted(values)}",
        )
    return values.pop()


def refuse_candidate_receipts(repo: Path, head: str, worktree: Path) -> None:
    """Fail closed when the candidate carries receipts (CI issue-gate parity, #281)."""

    def fail(detail: str) -> None:
        raise LocalCheckError("CANDIDATE_RECEIPTS_PRESENT", detail)

    core_dir = worktree / RECEIPTS_DIR.parent
    if core_dir.is_symlink():
        fail(".nexus-core is a symlink in the candidate head")
    if _git(repo, "ls-tree", "-r", "--name-only", head, "--", RECEIPTS_DIR.as_posix()).strip():
        fail("the candidate head commits files under .nexus-core/receipts")
    receipts = worktree / RECEIPTS_DIR
    if receipts.exists() or receipts.is_symlink():
        fail(".nexus-core/receipts exists in the candidate checkout")


def reported_receipt(pointer: Path, worktree: Path) -> Path | None:
    """The receipt issue-check reported through --receipt-path-out, or None if none.

    The path must name one regular file with a Core receipt name directly inside the
    checkout's receipts directory; anything else fails closed.
    """
    if not pointer.is_file():
        return None
    text = pointer.read_text(encoding="utf-8").strip()
    if not text:
        return None

    def invalid(reason: str) -> LocalCheckError:
        return LocalCheckError("RECEIPT_POINTER_INVALID", reason)

    path = Path(text)
    if "\n" in text or not path.is_absolute():
        raise invalid("pointer must be one absolute path")
    if path.is_symlink() or not path.is_file():
        raise invalid("reported receipt is not a regular file")
    if path.resolve().parent != (worktree / RECEIPTS_DIR).resolve():
        raise invalid("reported receipt is not directly inside the receipts directory")
    if not RECEIPT_NAME_RE.match(path.name):
        raise invalid("reported receipt name does not match the Core receipt pattern")
    return path.resolve()


def ensure_tool(cache_root: Path, pin: str, timeout: float = INSTALL_TIMEOUT_SECONDS) -> Path:
    """Install the pinned Core tool; reuse a cached install only once it completed."""
    base = cache_root / "tools" / pin
    certify = base / "bin" / "nexus-certify"
    ready = base / TOOL_READY
    if certify.exists() and ready.exists():
        return certify
    shutil.rmtree(base, ignore_errors=True)
    env = dict(os.environ)
    env["UV_TOOL_DIR"] = str(base / "tools")
    env["UV_TOOL_BIN_DIR"] = str(base / "bin")
    base.mkdir(parents=True, exist_ok=True)
    # Neutral cwd: uv must not discover uv.toml/pyproject.toml from the checkout.
    with tempfile.TemporaryDirectory(prefix="nexus-core-tool-") as tmp:
        _run(
            ["uv", "tool", "install", "--force", CORE_REPO_URL.format(pin=pin)],
            cwd=Path(tmp),
            env=env,
            code="CORE_INSTALL_FAILED",
            timeout=timeout,
        )
    if not certify.exists():
        raise LocalCheckError("CORE_INSTALL_FAILED", f"{certify} missing after install")
    ready.write_text(pin + "\n", encoding="utf-8")
    return certify


def resolve_token() -> str:
    token = os.environ.get("GITHUB_TOKEN", "").strip()
    if token:
        return token
    try:
        result = subprocess.run(
            ["gh", "auth", "token"], capture_output=True, text=True, check=False
        )
    except OSError as exc:
        raise LocalCheckError("GITHUB_TOKEN_UNAVAILABLE", str(exc)) from exc
    token = result.stdout.strip()
    if result.returncode != 0 or not token:
        raise LocalCheckError(
            "GITHUB_TOKEN_UNAVAILABLE", "no GITHUB_TOKEN and gh auth token failed"
        )
    return token


def _find(obj: Any, keys: Sequence[str]) -> Any:
    if isinstance(obj, dict):
        for key in keys:
            if obj.get(key) not in (None, ""):
                return obj[key]
        for value in obj.values():
            found = _find(value, keys)
            if found is not None:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = _find(value, keys)
            if found is not None:
                return found
    return None


def run_check(args: argparse.Namespace) -> tuple[dict[str, Any], int]:
    repo = Path(args.repo_root).resolve()
    cache_root = Path(args.cache_root).expanduser().resolve()
    output_dir = Path(args.output_dir).resolve() if args.output_dir else None

    if not (repo / ".git").exists():
        raise LocalCheckError("NOT_A_REPO", f"{repo} is not a git worktree root")
    check_clean(repo)
    head = _git(repo, "rev-parse", "HEAD").strip()
    head_tree = _git(repo, "rev-parse", "HEAD^{tree}").strip()
    if not args.no_fetch:
        _git(repo, "fetch", "origin", "main", code="FETCH_FAILED")
    base_sha = _git(
        repo, "rev-parse", "--verify", f"{args.base_ref}^{{commit}}", code="BASE_REF_MISSING"
    ).strip()
    pin = read_pin(repo, args.base_ref)
    universe = read_evidence_universe(repo, args.base_ref)

    certify = (
        Path(args.certify_bin)
        if args.certify_bin
        else ensure_tool(cache_root, pin, args.install_timeout)
    )
    if not certify.exists():
        raise LocalCheckError("CORE_INSTALL_FAILED", f"certify binary not found: {certify}")
    token = resolve_token()
    output_dir = output_dir or (cache_root / "runs" / f"issue-{args.issue}-{head[:12]}")
    output_dir.mkdir(parents=True, exist_ok=True)

    tmp_parent = Path(tempfile.mkdtemp(prefix="nexus-core-local-"))
    worktree = tmp_parent / "wt"
    added = False
    try:
        _git(repo, "worktree", "add", "--detach", str(worktree), head, code="WORKTREE_FAILED")
        added = True
        refuse_candidate_receipts(repo, head, worktree)
        # The worktree shares refs with the source repo, so the base ref still names
        # base_sha here (no second fetch that could move it).
        env = dict(os.environ)
        env.update(GITHUB_TOKEN=token, PYTHONDONTWRITEBYTECODE="1")
        # issue-check accepts only the config committed on the trusted base commit
        # (--require-trusted-config, as in CI), pinned to the base_sha resolved above,
        # and reports the receipt it wrote to a pointer file outside the checkout.
        # issue-init (Core pin b07ae36) takes neither trust flag and runs no verifier or
        # material command. Both get the base workflow's evidence universe.
        pointer = tmp_parent / "receipt-pointer"
        universe_args = ("--evidence-universe", universe)
        core_calls: tuple[tuple[str, tuple[str, ...]], ...] = (
            ("issue-init", universe_args),
            (
                "issue-check",
                (
                    "--require-trusted-config",
                    "--expect-config-commit",
                    base_sha,
                    *universe_args,
                    "--receipt-path-out",
                    str(pointer),
                ),
            ),
        )
        log_path = output_dir / f"issue-{args.issue}-check.log"
        log_parts: list[str] = []
        rc = 0
        check_ran = False
        for sub, trust_args in core_calls:
            try:
                proc = subprocess.run(
                    [str(certify), sub, "--repo", ".", "--issue", str(args.issue), *trust_args],
                    cwd=worktree,
                    env=env,
                    capture_output=True,
                    text=True,
                    check=False,
                )
            except OSError as exc:
                raise LocalCheckError("CORE_EXEC_FAILED", str(exc)) from exc
            check_ran = sub == "issue-check"
            log_parts.append(f"$ {sub} (exit {proc.returncode})\n{proc.stdout}{proc.stderr}")
            if proc.returncode != 0:
                rc = proc.returncode
                break
        log_text = "\n".join(log_parts)
        log_path.write_text(log_text, encoding="utf-8")

        # Only the receipt issue-check itself reported; none when it did not run.
        receipt = reported_receipt(pointer, worktree) if check_ran else None
        receipt_data: dict[str, Any] = {}
        receipt_out: Path | None = None
        if receipt is not None:
            receipt_out = output_dir / receipt.name
            shutil.copy2(receipt, receipt_out)
            try:
                receipt_data = json.loads(receipt.read_text(encoding="utf-8"))
            except ValueError as exc:
                raise LocalCheckError("RECEIPT_INVALID", str(exc)) from exc
        elif rc == 0:
            raise LocalCheckError("RECEIPT_MISSING", "Core exited 0 but wrote no receipt")

        outcome = receipt_data.get("outcome") if isinstance(receipt_data, dict) else None
        status = outcome.get("status") if isinstance(outcome, dict) else None
        if status is None:
            status = "NO_RECEIPT_STATUS"
        reason_codes = outcome.get("reason_codes") if isinstance(outcome, dict) else None
        if not isinstance(reason_codes, list):
            reason_codes = []
        transport_error = outcome.get("transport_error") if isinstance(outcome, dict) else None
        if not isinstance(transport_error, bool):
            transport_error = False
        claim_match = CLAIM_RE.findall(log_text)
        summary = {
            "schema": SCHEMA,
            "pin": pin,
            "base_ref": args.base_ref,
            "base_sha": base_sha,
            "head": head,
            "head_tree": head_tree,
            "issue": args.issue,
            "status": status,
            "reason_codes": reason_codes,
            "transport_error": transport_error,
            "claim": claim_match[-1] if claim_match else None,
            "receipt_path": str(receipt_out) if receipt_out else None,
            "receipt_sha256": _sha256_file(receipt_out) if receipt_out else None,
            "receipt_hash": _find(receipt_data, ("receipt_hash", "hash")),
            "target_tree": _find(receipt_data, ("target_tree", "tree")),
            "log_path": str(log_path),
            "core_exit_code": rc,
        }
        ok = rc == 0 and status == "VERIFIED"
        return summary, EXIT_OK if ok else EXIT_CORE_FAILED
    finally:
        if added:
            subprocess.run(
                ["git", "-C", str(repo), "worktree", "remove", "--force", str(worktree)],
                capture_output=True,
                check=False,
            )
            subprocess.run(
                ["git", "-C", str(repo), "worktree", "prune"], capture_output=True, check=False
            )
        shutil.rmtree(tmp_parent, ignore_errors=True)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--issue", type=int, required=True)
    parser.add_argument("--repo-root", default=".")
    parser.add_argument("--base-ref", default="origin/main")
    parser.add_argument("--cache-root", default="~/.cache/nexus-core-local")
    parser.add_argument("--output-dir")
    parser.add_argument(
        "--json-out",
        help="also write the summary JSON (same bytes as stdout) to this path, creating "
        "parent directories; if the write fails a warning is printed to stderr and the "
        "exit code is unchanged",
    )
    parser.add_argument("--no-fetch", action="store_true")
    parser.add_argument("--certify-bin", help="override Core binary (tests)")
    parser.add_argument(
        "--install-timeout",
        "--materials-timeout",
        dest="install_timeout",
        type=float,
        default=INSTALL_TIMEOUT_SECONDS,
        help="seconds allowed for the Core tool install (default %(default)s); "
        "--materials-timeout is the older name",
    )
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        summary, code = run_check(args)
    except LocalCheckError as exc:
        summary = {
            "schema": SCHEMA,
            "issue": args.issue,
            "status": "ERROR",
            "error_code": exc.code,
            "error": str(exc),
        }
        code = EXIT_ERROR
    text = json.dumps(summary, indent=2, sort_keys=True)
    print(text)
    if args.json_out:
        try:
            out_path = Path(args.json_out).expanduser()
            out_path.parent.mkdir(parents=True, exist_ok=True)
            out_path.write_text(text + "\n", encoding="utf-8")
        except OSError as exc:
            print(f"warning: cannot write --json-out {args.json_out}: {exc}", file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
