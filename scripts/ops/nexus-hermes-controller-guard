#!/usr/bin/env python3
"""Deterministic guard for the Hermes local-controller pilot.

This module does not own routing, execution, leases, verification, merge, or
release authority. It only converts already-authoritative Nexus observations
and explicit escalation signals into bounded control decisions.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any

DOCTOR_SCHEMA = "nexus.workflow_doctor.v1"
READ_ONLY_CEILING = "READ_ONLY_WORKFLOW_OBSERVATION"


def _load(path: str) -> dict[str, Any]:
    data = json.loads(Path(path).read_text())
    if not isinstance(data, dict):
        raise ValueError("input must be a JSON object")
    return data


def classify_doctor(data: dict[str, Any]) -> dict[str, Any]:
    if data.get("schema") != DOCTOR_SCHEMA:
        return {"decision": "BLOCK_UNKNOWN", "reason": "DOCTOR_SCHEMA_MISMATCH"}
    if data.get("claim_ceiling") != READ_ONLY_CEILING:
        return {"decision": "BLOCK_UNKNOWN", "reason": "DOCTOR_CLAIM_CEILING_MISMATCH"}

    disposition = data.get("resume_disposition")
    next_gate = (data.get("next_gate") or {}).get("code")

    if disposition == "SAFE":
        if next_gate == "NO_PENDING_GATE":
            return {"decision": "NOOP_TERMINAL", "next_gate": next_gate}
        return {"decision": "CONTINUE_EXACT_NEXT_GATE", "next_gate": next_gate}
    if disposition == "WAIT":
        return {"decision": "WAIT", "next_gate": next_gate}
    if disposition == "RECONCILE":
        return {"decision": "RECONCILE_EXISTING_EFFECT", "next_gate": next_gate}
    if disposition == "BLOCKED":
        return {"decision": "BLOCK", "next_gate": next_gate}
    return {"decision": "BLOCK_UNKNOWN", "reason": "UNKNOWN_RESUME_DISPOSITION", "observed": disposition}


def escalation_decision(data: dict[str, Any]) -> dict[str, Any]:
    reasons: list[str] = []
    if int(data.get("same_gate_failures", 0) or 0) >= 2:
        reasons.append("REPEATED_GATE_FAILURE")
    if data.get("evidence_conflict") is True:
        reasons.append("EVIDENCE_CONFLICT")
    if data.get("authority_boundary_change") is True:
        reasons.append("AUTHORITY_BOUNDARY_CHANGE")
    if data.get("irreversible_effect") is True:
        reasons.append("IRREVERSIBLE_EFFECT")
    if data.get("reviewer_worker_conflict") is True:
        reasons.append("REVIEWER_WORKER_CONFLICT")
    if (
        int(data.get("plausible_root_causes", 0) or 0) >= 2
        and data.get("bounded_falsification_exhausted") is True
    ):
        reasons.append("UNRESOLVED_MULTI_CAUSE_DIAGNOSIS")

    return {
        "escalate": bool(reasons),
        "decision": "ASK_FRONTIER_ADVISER" if reasons else "LOCAL_CONTINUE",
        "reasons": reasons,
        "authority": "ADVISORY_ONLY" if reasons else "LOCAL_BOUNDED_REASONING",
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)

    p_doctor = sub.add_parser("doctor")
    p_doctor.add_argument("--input", required=True)
    p_doctor.add_argument("--require-safe", action="store_true")

    p_escalate = sub.add_parser("escalate")
    p_escalate.add_argument("--input", required=True)

    args = parser.parse_args()
    try:
        payload = _load(args.input)
        if args.command == "doctor":
            result = classify_doctor(payload)
            if args.require_safe and payload.get("resume_disposition") != "SAFE":
                print(json.dumps(result, sort_keys=True))
                return 3
        else:
            result = escalation_decision(payload)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        result = {"decision": "BLOCK_UNKNOWN", "reason": type(exc).__name__, "detail": str(exc)}
        print(json.dumps(result, sort_keys=True))
        return 2

    print(json.dumps(result, sort_keys=True))
    return 0 if result.get("decision") != "BLOCK_UNKNOWN" else 2


if __name__ == "__main__":
    raise SystemExit(main())
