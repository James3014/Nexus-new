    "test_path_globs",
}
RED_NODE_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_./-]*\.py::[^\s:][^\s]*$")
RED_MESSAGE_LIMIT = 2000


def _require(condition: bool, detail: str, code: str = "RED_CONTRACT_INVALID") -> None:
    if not condition:
        raise DshWorkflowError(code, detail)


def _is_str_list(value: Any) -> bool:
    return isinstance(value, list) and all(isinstance(v, str) and v for v in value)


def validate_red_contract(contract: Any) -> dict[str, Any]:
    _require(isinstance(contract, dict), "contract must be a JSON object")
    keys = set(contract)
    allowed = RED_CONTRACT_KEYS | {"python"}
    _require(not (keys - allowed), f"unknown contract fields: {sorted(keys - allowed)}")
    _require(
        not (RED_CONTRACT_KEYS - keys),
        f"missing contract fields: {sorted(RED_CONTRACT_KEYS - keys)}",
    )
    _require(contract["schema"] == RED_CONTRACT_SCHEMA, "contract schema mismatch")
    repository = contract["repository"]
    _require(
        isinstance(repository, str) and bool(REPOSITORY_RE.fullmatch(repository)),
        "repository must be an owner/name slug",
    )
    issue = contract["issue_number"]
    _require(
        isinstance(issue, int) and not isinstance(issue, bool) and issue > 0,
        "issue_number must be positive int",
    )
    _require(
        isinstance(contract["invariant"], str) and bool(contract["invariant"].strip()),
        "invariant required",
    )
    nodes = contract["test_nodes"]
    _require(_is_str_list(nodes) and bool(nodes), "test_nodes must be a non-empty list of strings")
    for node in nodes:
        path = node.split("::", 1)[0]
        _require(
            bool(RED_NODE_RE.fullmatch(node)) and ".." not in path.split("/"),
            f"invalid pytest node id: {node}",
        )
    expected = contract["expected_failure"]
    _require(
        isinstance(expected, dict) and set(expected) == {"kind", "message_regex"},
        "expected_failure must have exactly kind and message_regex",
    )
    _require(expected["kind"] == "assertion", "expected_failure.kind must be 'assertion'")
    regex = expected["message_regex"]
    _require(isinstance(regex, str) and bool(regex), "message_regex must be a non-empty string")
    try:
        re.compile(regex)
    except re.error as exc:
        raise DshWorkflowError("RED_CONTRACT_INVALID", f"message_regex invalid: {exc}") from exc
    _require(
        _is_str_list(contract["forbidden_oracle_literals"]),
        "forbidden_oracle_literals must be a string list",
    )
    globs = contract["test_path_globs"]
    _require(_is_str_list(globs) and bool(globs), "test_path_globs must be a non-empty string list")
    if "python" in contract:
        _require(
            isinstance(contract["python"], str) and bool(contract["python"]),
            "python must be a string",
        )
    return contract


def _git(repo: Path, *args: str) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", "-c", "core.quotepath=off", *args],
        cwd=str(repo),
        capture_output=True,
        check=False,
    )


def _git_ok(repo: Path, *args: str, code: str = "RED_ARGUMENT_INVALID") -> bytes:
    proc = _git(repo, *args)
    if proc.returncode != 0:
        raise DshWorkflowError(
            code,
            f"git {' '.join(args[:2])} failed: {proc.stderr.decode('utf-8', 'replace').strip()}",
        )
    return proc.stdout


def _split_z(raw: bytes) -> list[str]:
    return [p.decode("utf-8", "surrogateescape") for p in raw.split(b"\0") if p]


def _glob_match(path: str, pattern: str) -> bool:
    candidates = {pattern, pattern.replace("**/", "")}
    return any(fnmatch.fnmatchcase(path, c) for c in candidates)


def _collect_worktree_changes(repo: Path, base: str) -> tuple[list[str], list[str], str]:
    tracked = _split_z(_git_ok(repo, "diff", "--name-only", "--no-renames", "-z", base))
    untracked = _split_z(_git_ok(repo, "ls-files", "--others", "--exclude-standard", "-z"))
    diff_bytes = _git_ok(repo, "diff", "--binary", "--no-renames", base)
    digest = hashlib.sha256()
    digest.update(diff_bytes)
    for rel in sorted(set(untracked)):
        digest.update(b"\0untracked\0" + rel.encode("utf-8", "surrogateescape") + b"\0")
        try:
            digest.update((repo / rel).read_bytes())
        except OSError:
            digest.update(b"<unreadable>")
    changed = sorted(set(tracked) | set(untracked))
    return changed, sorted(set(untracked)), "sha256:" + digest.hexdigest()


def _def_counts(tree: ast.AST) -> dict[str, dict[str, int]]:
    scopes: dict[str, dict[str, int]] = {}

    def visit(body: list[ast.stmt], scope: str) -> None:
        counts = scopes.setdefault(scope, {})
        for stmt in body:
            if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                counts[stmt.name] = counts.get(stmt.name, 0) + 1
                if isinstance(stmt, ast.ClassDef):
                    visit(stmt.body, f"{scope}.{stmt.name}" if scope else stmt.name)

    visit(tree.body, "")  # type: ignore[attr-defined]
    return scopes


def _find_duplicates(repo: Path, base: str, rel: str, tree: ast.AST) -> list[dict[str, Any]]:
    base_counts: dict[str, dict[str, int]] = {}
    proc = _git(repo, "show", f"{base}:{rel}")
    if proc.returncode == 0:
        try:
            base_counts = _def_counts(ast.parse(proc.stdout))
        except (SyntaxError, ValueError):
            base_counts = {}
    found: list[dict[str, Any]] = []
    for scope, counts in sorted(_def_counts(tree).items()):
        for name, count in sorted(counts.items()):
            before = base_counts.get(scope, {}).get(name, 0)
            if count > 1 and count > before:
                found.append({
                    "path": rel,
                    "scope": scope or "<module>",
                    "name": name,
                    "count": count,
                })
    return found


def _split_node(node: str) -> tuple[str, list[str]]:
    path, _, rest = node.partition("::")
    parts = [re.sub(r"\[.*\]$", "", p) for p in rest.split("::") if p]
    return path, parts


def _target_functions(tree: ast.AST, parts: list[str]) -> list[ast.AST]:
    scope: list[ast.AST] = [tree]
    for part in parts[:-1]:
        scope = [
            s
            for container in scope
            for s in getattr(container, "body", [])
            if isinstance(s, ast.ClassDef) and s.name == part
        ]
    if not parts:
        return []
    return [
        s
        for container in scope
        for s in getattr(container, "body", [])
        if isinstance(s, (ast.FunctionDef, ast.AsyncFunctionDef)) and s.name == parts[-1]
    ]


def _str_const(node: ast.AST) -> str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    return None


def _oracle_violations(func: ast.AST, forbidden: set[str]) -> list[tuple[int, str]]:
    hits: list[tuple[int, str]] = []
    for assertion in ast.walk(func):
        if not isinstance(assertion, ast.Assert):
            continue
        for cmp_node in ast.walk(assertion.test):
            if not isinstance(cmp_node, ast.Compare):
                continue
            operands = [cmp_node.left, *cmp_node.comparators]
            for i, op in enumerate(cmp_node.ops):
                left, right = operands[i], operands[i + 1]
                if isinstance(op, (ast.Eq, ast.Is)):
                    for side in (left, right):
                        value = _str_const(side)
                        if value in forbidden:
                            hits.append((cmp_node.lineno, str(value)))
                elif isinstance(op, ast.In) and isinstance(right, (ast.List, ast.Tuple, ast.Set)):
                    for elt in right.elts:
                        value = _str_const(elt)
                        if value in forbidden:
                            hits.append((cmp_node.lineno, str(value)))
    return hits


def _truncate(text: str) -> str:
    return text if len(text) <= RED_MESSAGE_LIMIT else text[:RED_MESSAGE_LIMIT] + "...[truncated]"


def _parse_junit(path: Path) -> tuple[list[dict[str, Any]] | None, bool]:
    """Return testcase records (None if unreadable) and whether an <error> was seen."""
    try:
        root = ElementTree.parse(path).getroot()
    except (OSError, ElementTree.ParseError):
        return None, False
    cases: list[dict[str, Any]] = []
    has_error = False
    for case in root.iter("testcase"):
        outcome, message = "passed", ""
        for child in case:
            tag = child.tag
            text = f"{child.get('message') or ''}\n{child.text or ''}"
            if tag == "error":
                has_error = True
                outcome, message = "error", text
            elif tag == "failure" and outcome != "error":
                outcome, message = "failed", text
            elif tag == "skipped" and outcome == "passed":
                outcome, message = "skipped", text
        cases.append({
            "classname": case.get("classname") or "",
            "name": case.get("name") or "",
            "outcome": outcome,
            "message": message.strip(),
        })
    return cases, has_error


def _python_available(python: str) -> bool:
    py_path = Path(python)
    if py_path.is_file() and os.access(python, os.X_OK):
        return True
    return os.sep not in python and shutil.which(python) is not None


def _run_red_tests(
    repo: Path, python: str, nodes: list[str], timeout: float, expected_regex: str
) -> dict[str, Any]:
    codes: set[str] = set()
    result: dict[str, Any] = {"command": [], "exit_code": None, "node_results": [], "codes": codes}
    if not _python_available(python):
        codes.add("ENVIRONMENT_FAILURE")
        result["command"] = [python, "-m", "pytest"]
        return result
    with tempfile.TemporaryDirectory(prefix="nexus-red-gate-") as tmp:
        junit = Path(tmp) / "junit.xml"
        argv = [
            python,
            "-m",
            "pytest",
            "-p",
            "no:cacheprovider",
            "-q",
            f"--junitxml={junit}",
            *nodes,
        ]
        result["command"] = argv
        env = os.environ.copy()
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        try:
            proc = subprocess.run(
                argv, cwd=str(repo), env=env, capture_output=True, timeout=timeout, check=False
            )
        except subprocess.TimeoutExpired:
            codes.add("TEST_RUN_TIMEOUT")
            return result
        except OSError:
            codes.add("ENVIRONMENT_FAILURE")
            return result
        result["exit_code"] = proc.returncode
        output = (proc.stdout + proc.stderr).decode("utf-8", "replace")
        if proc.returncode in (126, 127):
            codes.add("ENVIRONMENT_FAILURE")
            return result
        cases, has_error = _parse_junit(junit)
    if "No module named pytest" in output:
        codes.add("ENVIRONMENT_FAILURE")
    elif proc.returncode == 5 or re.search(r"^ERROR: not found: ", output, re.MULTILINE):
        codes.add("TEST_NODE_NOT_FOUND")
    elif (
        cases is None or proc.returncode in (2, 3, 4) or has_error or proc.returncode not in (0, 1)
    ):
        codes.add("COLLECTION_OR_SETUP_FAILURE")
    if codes:
        return result
    regex = re.compile(expected_regex, re.MULTILINE)
    for node in nodes:
        path, parts = _split_node(node)
        module = path[:-3].replace("/", ".")
        raw_name = node.partition("::")[2].split("::")[-1]
        classname = ".".join([module, *parts[:-1]])
        match = [
            c
            for c in cases
            if c["classname"] == classname
            and (c["name"] == raw_name or c["name"].startswith(f"{parts[-1]}["))
            and (c["name"] == raw_name or "[" not in raw_name)
        ]
        if not match:
            codes.add("TEST_NODE_NOT_FOUND")
            result["node_results"].append({"nodeid": node, "outcome": "not_found", "message": ""})
            continue
        failed = [c for c in match if c["outcome"] == "failed"]
        if not failed:
            codes.add("NO_RED_OBSERVED")
            first = match[0]
            result["node_results"].append({
                "nodeid": node,
                "outcome": first["outcome"],
                "message": _truncate(first["message"]),
            })
            continue
        bad = [c for c in failed if not (regex.search(c["message"]) and "assert" in c["message"])]
        if bad:
            codes.add("UNINTENDED_FAILURE")
        first = failed[0]
        result["node_results"].append({
            "nodeid": node,
            "outcome": "failed_unintended" if bad else "failed_expected",
            "message": _truncate(first["message"]),
        })
    return result


def _red_receipt(body: dict[str, Any]) -> dict[str, Any]:
    receipt = dict(body)
    receipt["receipt_hash"] = _sha256_bytes(_canonical_json(body).encode("utf-8"))
    return receipt


def persist_red_gate(root: Path, receipt: dict[str, Any]) -> Path:
    gate_dir = root / "red-gates" / str(receipt["contract_hash"])[7:]
    stamp = str(receipt["generated_at"]).replace(":", "").replace("-", "")
    unique = gate_dir / f"{stamp}-{receipt['receipt_hash'][7:19]}.json"
    _atomic_write_json(unique, receipt)
    _atomic_write_json(gate_dir / "latest.json", receipt)
    return unique


def run_red_gate(
    *,
    repo_root: Path,
    base_revision: str,
    contract_path: Path,
    python: str | None,
    timeout: float,
) -> dict[str, Any]:
    """Evaluate RED evidence. Raises DshWorkflowError for argument/contract errors.

    The error carries ``contract`` / ``contract_hash`` attributes when known.
    """
    try:
        raw = json.loads(contract_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise DshWorkflowError("RED_CONTRACT_INVALID", f"cannot read contract: {exc}") from exc
    contract = validate_red_contract(raw)
    contract_hash = _sha256_bytes(_canonical_json(contract).encode("utf-8"))
    interpreter = python or contract.get("python")
    if not interpreter:
        raise DshWorkflowError("RED_ARGUMENT_INVALID", "--python is required")
    if timeout <= 0:
        raise DshWorkflowError("RED_ARGUMENT_INVALID", "timeout must be positive")
    repo = repo_root.expanduser().resolve()
    if not repo.is_dir():
        raise DshWorkflowError("RED_ARGUMENT_INVALID", "repo root is not a directory")
    _git_ok(repo, "rev-parse", "--show-toplevel")
    base = _git_ok(repo, "rev-parse", "--verify", f"{base_revision}^{{commit}}").decode().strip()
    head = _git_ok(repo, "rev-parse", "HEAD").decode().strip()

    codes: set[str] = set()
    changed, _untracked, diff_hash = _collect_worktree_changes(repo, base)
    globs = contract["test_path_globs"]
    test_paths = [p for p in changed if any(_glob_match(p, g) for g in globs)]
    if any(p not in test_paths for p in changed):
        codes.add("PRODUCTION_SOURCE_MODIFIED")
    if not test_paths:
        codes.add("NO_TEST_CHANGE")

    trees: dict[str, ast.AST] = {}
    duplicates: list[dict[str, Any]] = []
    for rel in test_paths:
        if not rel.endswith(".py") or not (repo / rel).is_file():
            continue
        try:
            tree = ast.parse((repo / rel).read_bytes(), filename=rel)
        except (SyntaxError, ValueError):
            codes.add("TEST_FILE_SYNTAX_ERROR")
            continue
        trees[rel] = tree
        duplicates.extend(_find_duplicates(repo, base, rel, tree))
    if duplicates:
        codes.add("DUPLICATE_TEST_DEFINITION")

    forbidden = set(contract["forbidden_oracle_literals"])
    violations: list[dict[str, Any]] = []
    for node in contract["test_nodes"]:
        path, parts = _split_node(node)
        if path not in test_paths:
            codes.add("RED_TEST_NOT_FROM_THIS_TURN")
            continue
        tree = trees.get(path)
        if tree is None:
            continue
        for func in _target_functions(tree, parts):
            for line, literal in _oracle_violations(func, forbidden):
                violations.append({"nodeid": node, "line": line, "literal": literal})
    if violations:
        codes.add("ORACLE_ENCODES_BUGGY_BEHAVIOR")

    run = _run_red_tests(
        repo,
        interpreter,
        list(contract["test_nodes"]),
        timeout,
        contract["expected_failure"]["message_regex"],
    )
    codes |= run["codes"]

    reason_codes = sorted(codes)
    ready = not reason_codes
    body = {
        "schema": RED_RECEIPT_SCHEMA,
        "claim_ceiling": RED_CLAIM_CEILING,
        "decision": "RED_READY" if ready else "REVISE_RED",
        "red_semantics": RED_SEMANTICS if ready else None,
        "implementation_allowed": ready,
        "reason_codes": reason_codes,
        "contract_hash": contract_hash,
        "contract": contract,
        "repository": contract["repository"],
        "issue_number": contract["issue_number"],
        "base_revision": base,
        "repo_head": head,
        "worktree_diff_sha256": diff_hash,
        "changed_paths": changed,
        "changed_test_paths": test_paths,
        "duplicate_definitions": duplicates,
        "oracle_violations": violations,
        "command": run["command"],
        "exit_code": run["exit_code"],
        "node_results": run["node_results"],
        "generated_at": _utc_now(),
    }
    return _red_receipt(body)


def _red_error_receipt(code: str, detail: str) -> dict[str, Any]:
    return _red_receipt({
        "schema": RED_RECEIPT_SCHEMA,
        "claim_ceiling": RED_CLAIM_CEILING,
        "decision": "REVISE_RED",
        "red_semantics": None,
        "implementation_allowed": False,
        "reason_codes": [code],
        "detail": detail,
        "generated_at": _utc_now(),
    })


def _main_red_gate(args: argparse.Namespace) -> int:
    try:
        receipt = run_red_gate(
            repo_root=Path(args.repo_root),
            base_revision=args.base_revision,
            contract_path=Path(args.contract).expanduser(),
            python=args.python,
            timeout=args.timeout,
        )
    except DshWorkflowError as exc:
        print(json.dumps(_red_error_receipt(exc.code, str(exc)), sort_keys=True))
        return EXIT_BLOCKED
    except (OSError, ValueError) as exc:
        print(
            json.dumps(
                _red_error_receipt("RED_GATE_ERROR", f"{type(exc).__name__}: {exc}"), sort_keys=True
            )
        )
        return EXIT_BLOCKED
    out = dict(receipt)
    if args.state_root:
        out["receipt_path"] = str(persist_red_gate(_state_root(args.state_root), receipt))
    print(json.dumps(out, sort_keys=True))
    return 0 if receipt["decision"] == "RED_READY" else EXIT_BLOCKED


GREEN_CONTRACT_SCHEMA = "nexus.dsh_green_contract.v1"
GREEN_RECEIPT_SCHEMA = "nexus.dsh_green_gate_receipt.v1"
GREEN_CLAIM_CEILING = "POST_IMPLEMENTATION_EVIDENCE_GATE_NO_COMPLETION_AUTHORITY"
GREEN_SEMANTICS = "TARGET_FIXED_REGRESSIONS_CLEAN_SCOPE_CLEAN"
GREEN_CONTRACT_KEYS = {
    "schema",
    "repository",
    "issue_number",
    "target_test_nodes",
    "regression_pytest_targets",
    "allowed_change_globs",
    "lint",
}
GREEN_LINT_KEYS = {"ruff_check_paths_from_changes", "ruff_format_preview"}
GREEN_TARGET_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_./-]*(::[^\s:][^\s]*)?$")


def _green_require(condition: bool, detail: str) -> None:
    _require(condition, detail, "GREEN_CONTRACT_INVALID")


def validate_green_contract(contract: Any) -> dict[str, Any]:
    _green_require(isinstance(contract, dict), "contract must be a JSON object")
    keys = set(contract)
    _green_require(
        not (keys - GREEN_CONTRACT_KEYS), f"unknown fields: {sorted(keys - GREEN_CONTRACT_KEYS)}"
    )
    _green_require(
        not (GREEN_CONTRACT_KEYS - keys),
        f"missing contract fields: {sorted(GREEN_CONTRACT_KEYS - keys)}",
    )
    _green_require(contract["schema"] == GREEN_CONTRACT_SCHEMA, "contract schema mismatch")
    repository = contract["repository"]
    _green_require(
        isinstance(repository, str) and bool(REPOSITORY_RE.fullmatch(repository)),
        "repository must be an owner/name slug",
    )
    issue = contract["issue_number"]
    _green_require(
        isinstance(issue, int) and not isinstance(issue, bool) and issue > 0,
        "issue_number must be positive int",
    )
    nodes = contract["target_test_nodes"]
    _green_require(
        _is_str_list(nodes) and bool(nodes),
        "target_test_nodes must be a non-empty list of strings",
    )
    for node in nodes:
        path = node.split("::", 1)[0]
        _green_require(
            bool(RED_NODE_RE.fullmatch(node)) and ".." not in path.split("/"),
            f"invalid pytest node id: {node}",
        )
    targets = contract["regression_pytest_targets"]
    _green_require(_is_str_list(targets), "regression_pytest_targets must be a string list")
    for target in targets:
        path = target.split("::", 1)[0]
        _green_require(
            bool(GREEN_TARGET_RE.fullmatch(target)) and ".." not in path.split("/"),
            f"invalid regression target: {target}",
        )
    globs = contract["allowed_change_globs"]
    _green_require(
        _is_str_list(globs) and bool(globs), "allowed_change_globs must be a non-empty string list"
    )
    lint = contract["lint"]
    _green_require(
        isinstance(lint, dict) and set(lint) == GREEN_LINT_KEYS,
        f"lint must have exactly {sorted(GREEN_LINT_KEYS)}",
    )
    _green_require(
        all(isinstance(lint[k], bool) for k in GREEN_LINT_KEYS), "lint flags must be booleans"
    )
    return contract


def _node_cases(cases: list[dict[str, Any]], node: str) -> list[dict[str, Any]]:
    path, parts = _split_node(node)
    module = path[:-3].replace("/", ".")
    raw_name = node.partition("::")[2].split("::")[-1]
    classname = ".".join([module, *parts[:-1]])
    return [
        c
        for c in cases
        if c["classname"] == classname
        and (c["name"] == raw_name or c["name"].startswith(f"{parts[-1]}["))
        and (c["name"] == raw_name or "[" not in raw_name)
    ]


def _run_pytest(repo: Path, python: str, targets: list[str], timeout: float) -> dict[str, Any]:
    """Run pytest once; returns command, exit_code, cases, output and error flags."""
    result: dict[str, Any] = {
        "command": [python, "-m", "pytest", *targets],
        "exit_code": None,
        "cases": None,
        "codes": set(),
        "not_found": False,
        "output_tail": "",
    }
    codes: set[str] = result["codes"]
    if not _python_available(python):
        codes.add("ENVIRONMENT_FAILURE")
        return result
    with tempfile.TemporaryDirectory(prefix="nexus-green-gate-") as tmp:
        junit = Path(tmp) / "junit.xml"
        argv = [python, "-m", "pytest", "-p", "no:cacheprovider", "-q", f"--junitxml={junit}"]
        argv.extend(targets)
        result["command"] = argv
        env = os.environ.copy()
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        try:
            proc = subprocess.run(
                argv, cwd=str(repo), env=env, capture_output=True, timeout=timeout, check=False
            )
        except subprocess.TimeoutExpired:
            codes.add("TEST_RUN_TIMEOUT")
            return result
        except OSError:
            codes.add("ENVIRONMENT_FAILURE")
            return result
        result["exit_code"] = proc.returncode
        output = (proc.stdout + proc.stderr).decode("utf-8", "replace")
        result["output_tail"] = _truncate(output[-RED_MESSAGE_LIMIT:])
        if proc.returncode in (126, 127):
            codes.add("ENVIRONMENT_FAILURE")
            return result
        cases, has_error = _parse_junit(junit)
    result["cases"] = cases
    if "No module named pytest" in output:
        codes.add("ENVIRONMENT_FAILURE")
    elif proc.returncode == 5 or re.search(r"^ERROR: not found: ", output, re.MULTILINE):
        codes.add("TEST_NODE_NOT_FOUND")
        result["not_found"] = True
    elif (
        cases is None or proc.returncode in (2, 3, 4) or has_error or proc.returncode not in (0, 1)
    ):
        codes.add("COLLECTION_OR_SETUP_FAILURE")
    return result


def _is_python_script(repo: Path, rel: str) -> bool:
    if not rel.startswith("scripts/") or "." in Path(rel).name:
        return False
    try:
        with (repo / rel).open("rb") as handle:
            first = handle.readline(200)
    except OSError:
        return False
    return first.startswith(b"#!") and b"python" in first


def _run_ruff(
    repo: Path, python: str, args: list[str], paths: list[str], timeout: float
) -> dict[str, Any]:
    argv = [python, "-m", "ruff", *args, *paths]
    out: dict[str, Any] = {"command": argv, "exit_code": None, "output": "", "status": "ok"}
    env = os.environ.copy()
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    try:
        proc = subprocess.run(
            argv, cwd=str(repo), env=env, capture_output=True, timeout=timeout, check=False
        )
    except subprocess.TimeoutExpired:
        out["status"] = "timeout"
        return out
    except OSError:
        out["status"] = "environment"
        return out
    out["exit_code"] = proc.returncode
    out["output"] = _truncate((proc.stdout + proc.stderr).decode("utf-8", "replace"))
    if proc.returncode == 0:
        return out
    out["status"] = "violation" if proc.returncode == 1 else "environment"
    return out


def _run_green_lint(
    repo: Path,
    python: str,
    lint: dict[str, bool],
    changed: list[str],
    timeout: float,
    codes: set[str],
) -> dict[str, Any]:
    existing = [p for p in changed if (repo / p).is_file()]
    py_files = [p for p in existing if p.endswith(".py")]
    check_paths = py_files + [p for p in existing if _is_python_script(repo, p)]
    report: dict[str, Any] = {"ruff_check": None, "ruff_format": None}
    wants = [
        ("ruff_check", lint["ruff_check_paths_from_changes"], check_paths),
        ("ruff_format", lint["ruff_format_preview"], py_files),
    ]
    if not any(flag and paths for _name, flag, paths in wants):
        return report
    if not _python_available(python):
        codes.add("ENVIRONMENT_FAILURE")
        return report
    probe = subprocess.run(
        [python, "-m", "ruff", "--version"], cwd=str(repo), capture_output=True, check=False
    )
    if probe.returncode != 0:
        codes.add("ENVIRONMENT_FAILURE")
        return report
    for name, flag, paths in wants:
        if not flag or not paths:
            continue
        if name == "ruff_check":
            run = _run_ruff(repo, python, ["check", "--no-cache"], paths, timeout)
            violation_code = "LINT_FAILURE"
        else:
            run = _run_ruff(
                repo, python, ["format", "--check", "--preview", "--no-cache"], paths, timeout
            )
            violation_code = "FORMAT_FAILURE"
        report[name] = run
        if run["status"] == "violation":
            codes.add(violation_code)
        elif run["status"] == "timeout":
            codes.add("TEST_RUN_TIMEOUT")
        elif run["status"] == "environment":
            codes.add("ENVIRONMENT_FAILURE")
    return report


def _green_receipt(body: dict[str, Any]) -> dict[str, Any]:
    receipt = dict(body)
    receipt["receipt_hash"] = _sha256_bytes(_canonical_json(body).encode("utf-8"))
    return receipt


def persist_green_gate(root: Path, receipt: dict[str, Any]) -> Path:
    gate_dir = root / "green-gates" / str(receipt["contract_hash"])[7:]
    stamp = str(receipt["generated_at"]).replace(":", "").replace("-", "")
    unique = gate_dir / f"{stamp}-{receipt['receipt_hash'][7:19]}.json"
    _atomic_write_json(unique, receipt)
    _atomic_write_json(gate_dir / "latest.json", receipt)
    return unique


def _diff_check(repo: Path, base: str, untracked: list[str]) -> dict[str, Any]:
    failures: list[str] = []
    proc = _git(repo, "diff", "--check", "--no-renames", base)
    if proc.returncode != 0:
        failures.append(proc.stdout.decode("utf-8", "replace")[:RED_MESSAGE_LIMIT])
    for rel in untracked:
        extra = _git(repo, "diff", "--check", "--no-index", "--", os.devnull, rel)
        if extra.returncode != 0:
            failures.append(extra.stdout.decode("utf-8", "replace")[:RED_MESSAGE_LIMIT])
    return {"exit_code": proc.returncode, "failures": failures}


def run_green_gate(
    *,
    repo_root: Path,
    base_revision: str,
    contract_path: Path,
    python: str,
    timeout: float,
) -> dict[str, Any]:
    """Evaluate post-implementation evidence. Raises DshWorkflowError for argument errors."""
    try:
        raw = json.loads(contract_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise DshWorkflowError("GREEN_CONTRACT_INVALID", f"cannot read contract: {exc}") from exc
    contract = validate_green_contract(raw)
    contract_hash = _sha256_bytes(_canonical_json(contract).encode("utf-8"))
    if not python:
        raise DshWorkflowError("GREEN_ARGUMENT_INVALID", "--python is required")
    if timeout <= 0:
        raise DshWorkflowError("GREEN_ARGUMENT_INVALID", "timeout must be positive")
    repo = repo_root.expanduser().resolve()
    if not repo.is_dir():
        raise DshWorkflowError("GREEN_ARGUMENT_INVALID", "repo root is not a directory")
    bad = "GREEN_ARGUMENT_INVALID"
    _git_ok(repo, "rev-parse", "--show-toplevel", code=bad)
    base = (
        _git_ok(repo, "rev-parse", "--verify", f"{base_revision}^{{commit}}", code=bad)
        .decode()
        .strip()
    )
    head = _git_ok(repo, "rev-parse", "HEAD", code=bad).decode().strip()

    codes: set[str] = set()
    changed, untracked, diff_hash = _collect_worktree_changes(repo, base)
    globs = contract["allowed_change_globs"]
    untracked_set = set(untracked)
    outside_tracked = [
        p for p in changed if p not in untracked_set and not any(_glob_match(p, g) for g in globs)
    ]
    outside_untracked = [p for p in untracked if not any(_glob_match(p, g) for g in globs)]
    if outside_tracked:
        codes.add("CHANGE_OUTSIDE_ALLOWED_GLOBS")
    if outside_untracked:
        codes.add("UNTRACKED_FILE_OUTSIDE_ALLOWED_GLOBS")
    if not changed:
        codes.add("NO_CHANGE")

    diff_check = _diff_check(repo, base, [p for p in untracked if p not in outside_untracked])
    if diff_check["failures"]:
        codes.add("DIFF_CHECK_FAILURE")

    # Target nodes: every contracted node must be found and pass.
    node_results: list[dict[str, Any]] = []
    target_run = _run_pytest(repo, python, list(contract["target_test_nodes"]), timeout)
    codes |= target_run["codes"]
    if not target_run["codes"]:
        for node in contract["target_test_nodes"]:
            match = _node_cases(target_run["cases"], node)
            if not match:
                codes.add("TEST_NODE_NOT_FOUND")
                node_results.append({"nodeid": node, "outcome": "not_found", "message": ""})
                continue
            bad_case = next((c for c in match if c["outcome"] != "passed"), None)
            if bad_case is not None:
                codes.add("TARGET_TESTS_NOT_PASSING")
            node_results.append({
                "nodeid": node,
                "outcome": bad_case["outcome"] if bad_case else "passed",
                "message": _truncate(bad_case["message"]) if bad_case else "",
            })
    elif target_run["exit_code"] == 1 and target_run["cases"]:
        codes.add("TARGET_TESTS_NOT_PASSING")

    regression_run: dict[str, Any] | None = None
    regression_failures: list[dict[str, Any]] = []
    if contract["regression_pytest_targets"]:
        regression_run = _run_pytest(
            repo, python, list(contract["regression_pytest_targets"]), timeout
        )
        codes |= regression_run["codes"]
        if not regression_run["codes"] and regression_run["exit_code"] == 1:
            codes.add("REGRESSION_TESTS_FAILING")
        for case in regression_run["cases"] or []:
            if case["outcome"] in ("failed", "error"):
                regression_failures.append({
                    "classname": case["classname"],
                    "name": case["name"],
                    "outcome": case["outcome"],
                    "message": _truncate(case["message"]),
                })

    lint_report = _run_green_lint(repo, python, contract["lint"], changed, timeout, codes)

    reason_codes = sorted(codes)
    ready = not reason_codes
    body = {
        "schema": GREEN_RECEIPT_SCHEMA,
        "claim_ceiling": GREEN_CLAIM_CEILING,
        "decision": "GREEN_READY" if ready else "REVISE_GREEN",
        "green_semantics": GREEN_SEMANTICS if ready else None,
        "reason_codes": reason_codes,
        "contract_hash": contract_hash,
        "contract": contract,
        "repository": contract["repository"],
        "issue_number": contract["issue_number"],
        "base_revision": base,
        "repo_head": head,
        "worktree_diff_sha256": diff_hash,
        "changed_paths": changed,
        "untracked_paths": untracked,
        "paths_outside_allowed_globs": outside_tracked,
        "untracked_outside_allowed_globs": outside_untracked,
        "diff_check": diff_check,
        "commands": {
            "target_tests": target_run["command"],
            "regression_tests": regression_run["command"] if regression_run else None,
            "ruff_check": (lint_report["ruff_check"] or {}).get("command"),
            "ruff_format": (lint_report["ruff_format"] or {}).get("command"),
        },
        "exit_codes": {
            "target_tests": target_run["exit_code"],
            "regression_tests": regression_run["exit_code"] if regression_run else None,
            "ruff_check": (lint_report["ruff_check"] or {}).get("exit_code"),
            "ruff_format": (lint_report["ruff_format"] or {}).get("exit_code"),
            "git_diff_check": diff_check["exit_code"],
        },
        "node_results": node_results,
        "target_output_tail": target_run["output_tail"],
        "regression_failures": regression_failures,
        "regression_output_tail": regression_run["output_tail"] if regression_run else "",
        "lint_output": {
            "ruff_check": (lint_report["ruff_check"] or {}).get("output"),
            "ruff_format": (lint_report["ruff_format"] or {}).get("output"),
        },
        "generated_at": _utc_now(),
    }
    return _green_receipt(body)


def _green_error_receipt(code: str, detail: str) -> dict[str, Any]:
    return _green_receipt({
        "schema": GREEN_RECEIPT_SCHEMA,
        "claim_ceiling": GREEN_CLAIM_CEILING,
        "decision": "REVISE_GREEN",
        "green_semantics": None,
        "reason_codes": [code],
        "detail": detail,
        "generated_at": _utc_now(),
    })


def _main_green_gate(args: argparse.Namespace) -> int:
    try:
        receipt = run_green_gate(
            repo_root=Path(args.repo_root),
            base_revision=args.base_revision,
            contract_path=Path(args.contract).expanduser(),
            python=args.python,
            timeout=args.timeout,
        )
    except DshWorkflowError as exc:
        print(json.dumps(_green_error_receipt(exc.code, str(exc)), sort_keys=True))
        return EXIT_BLOCKED
    except (OSError, ValueError) as exc:
        detail = f"{type(exc).__name__}: {exc}"
        print(json.dumps(_green_error_receipt("GREEN_GATE_ERROR", detail), sort_keys=True))
        return EXIT_BLOCKED
    out = dict(receipt)
    if args.state_root:
        out["receipt_path"] = str(persist_green_gate(_state_root(args.state_root), receipt))
    print(json.dumps(out, sort_keys=True))
    return 0 if receipt["decision"] == "GREEN_READY" else EXIT_BLOCKED


TURN_STATE_SCHEMA = "nexus.dsh_turn_state.v1"
QUARANTINE_SCHEMA = "nexus.dsh_turn_quarantine.v1"
TURN_ACK_SCHEMA = "nexus.dsh_turn_failure_ack.v1"
TURN_CLAIM_CEILING = "FAILED_TURN_RECORD_NO_COMPLETION_AUTHORITY"
TURN_FAILED_DIRTY = "TURN_FAILED_DIRTY"
TURN_FAILED_CLEAN = "TURN_FAILED_CLEAN"
TURN_OK = "TURN_OK"
TURN_ACKNOWLEDGED = "TURN_FAILURE_ACKNOWLEDGED"


def _turn_state_path(root: Path, session_id: str) -> Path:
    return root / "turn-state" / f"{_validate_session_id(session_id)}.json"


def load_turn_state(root: Path, session_id: str) -> dict[str, Any] | None:
    path = _turn_state_path(root, session_id)
    if not path.is_file():
        return None
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise DshWorkflowError(
            "TURN_STATE_UNREADABLE", "turn state cannot be read; failing closed"
        ) from exc
    if not isinstance(payload, dict) or payload.get("schema") != TURN_STATE_SCHEMA:
        raise DshWorkflowError("TURN_STATE_INVALID", "turn state is malformed; failing closed")
    return payload


def _write_turn_state(root: Path, session_id: str, state: str, **extra: Any) -> dict[str, Any]:
    payload = {
        "schema": TURN_STATE_SCHEMA,
        "session_id": session_id,
        "state": state,
        "updated_at": _utc_now(),
        **extra,
    }
    _atomic_write_json(_turn_state_path(root, session_id), payload)
    return payload


def _worktree_snapshot(repo: Path, base: str | None = None) -> dict[str, Any] | None:
    """HEAD, worktree diff hash (vs ``base`` or HEAD) and untracked list; None if unavailable."""
    try:
        code = "TURN_SNAPSHOT_UNAVAILABLE"
        head = _git_ok(repo, "rev-parse", "HEAD", code=code).decode().strip()
        _changed, untracked, digest = _collect_worktree_changes(repo, base or head)
    except (DshWorkflowError, OSError):
        return None
    return {"head": head, "worktree_diff_sha256": digest, "untracked_paths": untracked}


def record_failed_turn(
    root: Path,
    binding: dict[str, Any],
    *,
    pre: dict[str, Any] | None,
    exit_code: int,
) -> dict[str, Any]:
    """Persist quarantine receipt + turn state for a non-zero DSH exit. Never reverts files."""
    session_id = str(binding["session_id"])
    repo = Path(str(binding["repo_root"]))
    post = _worktree_snapshot(repo, pre["head"] if pre else None)
    if pre is None or post is None:
        dirty, why = True, "SNAPSHOT_UNAVAILABLE"
    else:
        dirty = (
            post["head"] != pre["head"]
            or post["worktree_diff_sha256"] != pre["worktree_diff_sha256"]
        )
        why = "WORKTREE_CHANGED_DURING_TURN" if dirty else "WORKTREE_UNCHANGED"
    state = TURN_FAILED_DIRTY if dirty else TURN_FAILED_CLEAN
    generated_at = _utc_now()
    qdir = root / "quarantine" / session_id
    stamp = generated_at.replace(":", "").replace("-", "")
    patch_info: dict[str, Any] | None = None
    if pre is not None and post is not None and dirty:
        patch = _git_ok(repo, "diff", "--binary", "--no-renames", pre["head"], code="TURN_PATCH")
        patch_path = qdir / f"{stamp}-{hashlib.sha256(patch).hexdigest()[:12]}.patch"
        patch_path.parent.mkdir(parents=True, exist_ok=True)
        patch_path.write_bytes(patch)
        patch_info = {
            "path": str(patch_path),
            "sha256": _sha256_bytes(patch),
            "bytes": len(patch),
            "base": pre["head"],
        }
    new_untracked = (
        sorted(set(post["untracked_paths"]) - set(pre["untracked_paths"]))
        if pre is not None and post is not None
        else None
    )
    body = {
        "schema": QUARANTINE_SCHEMA,
        "claim_ceiling": TURN_CLAIM_CEILING,
        "state": state,
        "reason": why,
        "dsh_exit_code": exit_code,
        "session_id": session_id,
        "goal_id": binding["goal_id"],
        "repository": binding["repository"],
        "issue_number": binding["issue_number"],
        "binding_hash": binding["binding_hash"],
        "repo_root": str(repo),
        "pre_turn": pre,
        "post_turn": post,
        "turn_patch": patch_info,
        "new_untracked_paths": new_untracked,
        "automatic_revert": False,
        "generated_at": generated_at,
    }
    receipt = {**body, "receipt_hash": _sha256_bytes(_canonical_json(body).encode("utf-8"))}
    receipt_path = qdir / f"{stamp}-{receipt['receipt_hash'][7:19]}.json"
    _atomic_write_json(receipt_path, receipt)
    _atomic_write_json(qdir / "latest.json", receipt)
    return _write_turn_state(
        root,
        session_id,
        state,
        quarantine_receipt=str(receipt_path),
        quarantine_receipt_hash=receipt["receipt_hash"],
        dsh_exit_code=exit_code,
    )


def acknowledge_turn_failure(
    root: Path, binding: dict[str, Any], *, reason: str, acknowledged_by: str | None = None
) -> tuple[dict[str, Any], Path]:
    session_id = str(binding["session_id"])
    if not reason.strip():
        raise DshWorkflowError("TURN_ACK_REASON_REQUIRED", "ack requires a non-empty reason")
    state = load_turn_state(root, session_id)
    if state is None or state.get("state") not in (TURN_FAILED_DIRTY, TURN_FAILED_CLEAN):
        raise DshWorkflowError("NO_TURN_FAILURE_TO_ACK", "no failed turn is pending for session")
    snapshot = _worktree_snapshot(Path(str(binding["repo_root"])))
    generated_at = _utc_now()
    who = acknowledged_by or os.getenv("USER") or os.getenv("LOGNAME") or "unknown"
    body = {
        "schema": TURN_ACK_SCHEMA,
        "claim_ceiling": TURN_CLAIM_CEILING,
        "session_id": session_id,
        "acknowledged_state": state["state"],
        "quarantine_receipt": state.get("quarantine_receipt"),
        "quarantine_receipt_hash": state.get("quarantine_receipt_hash"),
        "acknowledged_by": who,
        "reason": reason.strip(),
        "current_worktree": snapshot,
        "generated_at": generated_at,
    }
    receipt = {**body, "receipt_hash": _sha256_bytes(_canonical_json(body).encode("utf-8"))}
    stamp = generated_at.replace(":", "").replace("-", "")
    path = root / "turn-acks" / session_id / f"{stamp}-{receipt['receipt_hash'][7:19]}.json"
    _atomic_write_json(path, receipt)
    _write_turn_state(
        root,
        session_id,
        TURN_ACKNOWLEDGED,
        acknowledged_state=state["state"],
        ack_receipt=str(path),
        ack_receipt_hash=receipt["receipt_hash"],
    )
    return receipt, path


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)

    p_bind = sub.add_parser("bind-log")
    p_bind.add_argument("--log-file", required=True)
    p_bind.add_argument("--repository", required=True)
    p_bind.add_argument("--issue", required=True, type=int)
    p_bind.add_argument("--repo-root", required=True)
    p_bind.add_argument("--dsh-home", required=True)
    p_bind.add_argument("--state-root")

    p_check = sub.add_parser("check")
    p_check.add_argument("--session-id", required=True)
    p_check.add_argument("--state-root")
    p_check.add_argument("--doctor-bin", default=_default_binary("nexus-workflow-doctor"))

    p_resume = sub.add_parser("resume")
    p_resume.add_argument("--session-id", required=True)
    p_resume.add_argument("--state-root")
    p_resume.add_argument("--doctor-bin", default=_default_binary("nexus-workflow-doctor"))
    p_resume.add_argument("--dsh-bin", default=_default_binary("dsh"))
    p_resume.add_argument("--profile", default="headless")
    p_resume.add_argument("--patch", action="append", default=[])
    p_resume.add_argument("--json", action="store_true", dest="json_output")
    p_resume.add_argument("--task", required=True)

    p_red = sub.add_parser("red-gate")
    p_red.add_argument("--repo-root", required=True)
    p_red.add_argument("--base-revision", required=True)
    p_red.add_argument("--contract", required=True)
    p_red.add_argument("--python", required=True)
    p_red.add_argument("--state-root")
    p_red.add_argument("--timeout", type=float, default=600.0)

    p_green = sub.add_parser("green-gate")
    p_green.add_argument("--repo-root", required=True)
    p_green.add_argument("--base-revision", required=True)
    p_green.add_argument("--contract", required=True)
    p_green.add_argument("--python", required=True)
    p_green.add_argument("--state-root")
    p_green.add_argument("--timeout", type=float, default=600.0)

    p_ack = sub.add_parser("ack-turn-failure")
    p_ack.add_argument("--session-id", required=True)
    p_ack.add_argument("--reason", required=True)
    p_ack.add_argument("--state-root")

    args = parser.parse_args(argv)
    if args.command == "red-gate":
        return _main_red_gate(args)
    if args.command == "green-gate":
        return _main_green_gate(args)
    root = _state_root(getattr(args, "state_root", None))

    try:
        if args.command == "bind-log":
            binding = build_binding_from_log(
                log_path=Path(args.log_file).expanduser().resolve(),
                repository=args.repository,
                issue_number=args.issue,
                repo_root=Path(args.repo_root),
                dsh_home=Path(args.dsh_home),
            )
            path = store_binding(root, binding)
            _print_result(binding, receipt_path=path)
            return 0

        binding = load_binding(root, args.session_id)
        if args.command == "ack-turn-failure":
            ack, ack_path = acknowledge_turn_failure(root, binding, reason=args.reason)
            _print_result(ack, receipt_path=ack_path)
            return 0

        turn_state = load_turn_state(root, args.session_id)
        previous_turn = turn_state.get("state") if turn_state else None
        if previous_turn == TURN_FAILED_DIRTY:
            assert turn_state is not None
            preflight = _blocked_preflight(
                binding,
                reason_code="PREVIOUS_TURN_FAILED_DIRTY",
                detail=(
                    "previous DSH turn failed and changed the worktree; inspect the "
                    "quarantine receipt and run ack-turn-failure to continue"
                ),
            )
            preflight["quarantine_receipt"] = turn_state.get("quarantine_receipt")
        else:
            preflight = run_preflight(binding, doctor_bin=args.doctor_bin)
        if previous_turn in (TURN_FAILED_DIRTY, TURN_FAILED_CLEAN):
            preflight["previous_turn_state"] = previous_turn
        preflight["invocation"] = args.command
        receipt_path = persist_preflight(root, preflight)
        if args.command == "check":
            _print_result(preflight, receipt_path=receipt_path)
            return 0 if preflight["decision"] == "ALLOW_RESUME" else EXIT_BLOCKED

        if preflight["decision"] != "ALLOW_RESUME":
            _print_result(preflight, receipt_path=receipt_path)
            return EXIT_BLOCKED

        dsh_argv = build_dsh_resume_argv(
            dsh_bin=args.dsh_bin,
            session_id=args.session_id,
            profile=args.profile,
            patches=args.patch,
            json_output=args.json_output,
            task=args.task,
        )
        env = os.environ.copy()
        env["DSH_HOME"] = str(binding["dsh_home"])
        env["NEXUS_DSH_PREFLIGHT_RECEIPT"] = str(receipt_path)
        pre_turn = _worktree_snapshot(Path(str(binding["repo_root"])))
        proc = subprocess.run(
            dsh_argv,
            cwd=str(binding["repo_root"]),
            env=env,
            check=False,
        )
        if proc.returncode != 0:
            failed = record_failed_turn(root, binding, pre=pre_turn, exit_code=proc.returncode)
            print(json.dumps(failed, sort_keys=True), file=sys.stderr)
        else:
            _write_turn_state(root, str(binding["session_id"]), TURN_OK)
        return proc.returncode
    except DshWorkflowError as exc:
        payload = {
            "schema": PREFLIGHT_SCHEMA,
            "claim_ceiling": PREFLIGHT_CLAIM_CEILING,
            "decision": "BLOCK_RESUME",
            "reason_code": exc.code,
            "detail": str(exc),
            "provider_invocation_allowed": False,
            "invocation": args.command,
        }
        print(json.dumps(payload, sort_keys=True))
        return EXIT_BLOCKED
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        payload = {
            "schema": PREFLIGHT_SCHEMA,
            "claim_ceiling": PREFLIGHT_CLAIM_CEILING,
            "decision": "BLOCK_RESUME",
            "reason_code": "DSH_WORKFLOW_GUARD_ERROR",
            "detail": f"{type(exc).__name__}: {exc}",
            "provider_invocation_allowed": False,
            "invocation": args.command,
        }
        print(json.dumps(payload, sort_keys=True))
        return EXIT_BLOCKED


if __name__ == "__main__":
    raise SystemExit(main())
