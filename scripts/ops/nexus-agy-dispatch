}


class _DispatchFailureKind(str, Enum):
    # Dispatch-local failure: the shared pool must not persist a cooldown.
    EMPTY_OUTPUT = "AGY_EMPTY_OUTPUT"


AGY_EMPTY_OUTPUT = _DispatchFailureKind.EMPTY_OUTPUT.value


def _resolve_dispatch_limits(
    kind: str,
    timeout: int | None,
    provider_stall_seconds: float | None,
    empty_output_min_bytes: int | None = None,
) -> dict[str, Any]:
    stall_default = _provider_stall_seconds()
    if kind in _READ_ONLY_PROFILE_KINDS:
        stall_default = max(30.0, stall_default / 2)
    return {
        "timeout_seconds": (
            timeout if timeout is not None else _DEFAULT_TIMEOUT_SECONDS.get(kind, 900)
        ),
        "timeout_source": "explicit" if timeout is not None else f"default:{kind}",
        "provider_stall_seconds": (
            max(0.1, float(provider_stall_seconds))
            if provider_stall_seconds is not None
            else stall_default
        ),
        "provider_stall_source": (
            "explicit"
            if provider_stall_seconds is not None
            else f"env:{kind}"
            if _provider_stall_env_set()
            else f"default:{kind}"
        ),
        "empty_output_min_bytes": (
            max(1, int(empty_output_min_bytes))
            if empty_output_min_bytes is not None
            else _empty_output_min_bytes()
        ),
    }


def _unresolved_dispatch_limits(
    timeout: int | None,
    provider_stall_seconds: float | None,
    empty_output_min_bytes: int | None = None,
) -> dict[str, Any]:
    """No profile kind (contract rejected): report the explicit limits, mark the rest unresolved."""
    return {
        "timeout_seconds": timeout,
        "timeout_source": "explicit" if timeout is not None else "unresolved",
        "provider_stall_seconds": provider_stall_seconds,
        "provider_stall_source": (
            "explicit" if provider_stall_seconds is not None else "unresolved"
        ),
        "empty_output_min_bytes": empty_output_min_bytes,
    }


