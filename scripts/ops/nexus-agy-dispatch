def _normalize_account_hash(raw: str) -> str:
    cleaned = str(raw).strip()
    if re.fullmatch(r"[0-9a-f]{12}", cleaned, re.IGNORECASE):
        return cleaned.lower()
    return hashlib.sha256(cleaned.encode("utf-8")).hexdigest()[:12]


def _resolve_excluded_account_hashes(
    raw_accounts: list[str] | None,
    *,
    manager: AgyAccountPoolManager | None = None,
) -> set[str]:
    cleaned = [str(item).strip() for item in (raw_accounts or []) if str(item).strip()]
    if not cleaned:
        return set()

    exact_hashes = {
        item.lower()
        for item in cleaned
        if re.fullmatch(r"[0-9a-f]{12}", item, re.IGNORECASE)
    }
    aliases = [
        item
        for item in cleaned
        if not re.fullmatch(r"[0-9a-f]{12}", item, re.IGNORECASE)
    ]
    if not aliases:
        return exact_hashes

    if manager is None:
        if not MANAGER.is_file() or not MANAGER_ROOT.is_dir():
            raise RuntimeError("AGY_ACCOUNT_POOL_RUNTIME_MISSING")
        manager = AgyAccountPoolManager(
            manager_path=str(MANAGER),
            manager_root=str(MANAGER_ROOT),
            use_real_manager=True,
        )

    if getattr(manager, "_use_real_manager", False):
        status = manager._call_manager_cli(["status", "--json"])
        accounts_data = status.get("accounts") or {}
        if isinstance(accounts_data, dict):
            inventory_names = {
                str(name).strip() for name in accounts_data if str(name).strip()
            }
        elif isinstance(accounts_data, list):
            inventory_names = {
                str(item.get("name") or "").strip()
                for item in accounts_data
                if isinstance(item, dict) and str(item.get("name") or "").strip()
            }
        else:
            raise RuntimeError("AGY_ACCOUNT_POOL_INVENTORY_INVALID")
    else:
        inventory_names = {
            str(getattr(account, "alias", "")).strip()
            for account in getattr(manager, "_accounts", [])
            if str(getattr(account, "alias", "")).strip()
        }

    unknown = sorted({alias for alias in aliases if alias not in inventory_names})
    if unknown:
        raise ValueError("UNKNOWN_EXCLUDED_ACCOUNT_ALIAS:" + ",".join(unknown))

    exact_hashes.update(_normalize_account_hash(alias) for alias in aliases)
    return exact_hashes


def _read_new_provider_log_activity(
    log_path: Path | None,
    *,
    offset: int,
) -> tuple[int, int, list[str]]:
    if log_path is None:
        return offset, 0, []
    try:
        if log_path.stat().st_size < offset:
            offset = 0
        with log_path.open("r", encoding="utf-8", errors="replace") as stream:
            stream.seek(offset)
            chunk = stream.read()
            new_offset = stream.tell()
    except OSError:
        return offset, 0, []
    sessions = [match.group("conversation") for match in _AGY_CONVERSATION_RE.finditer(chunk)]
    return new_offset, len(_AGY_STREAM_ACTIVITY_RE.findall(chunk)), sessions


