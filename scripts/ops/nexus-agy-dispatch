def _quota_refresh_binary() -> str | None:
    explicit = os.getenv("NEXUS_AGY_QUOTA_COMMAND", "").strip()
    if explicit:
        return explicit
    found = shutil.which("nexus-agy-quota")
    if found:
        return found
    sibling = Path(__file__).resolve().with_name("nexus-agy-quota")
    return str(sibling) if sibling.is_file() else None


def _quota_error_kind(value: object) -> str | None:
    if not isinstance(value, str):
        return None
    if value == "timeout":
        return "TIMEOUT"
    if value == "deadline_exceeded":
        return "DEADLINE_EXCEEDED"
    if value == "unknown_account":
        return "UNKNOWN_ACCOUNT"
    if value == "usage_unparseable":
        return "USAGE_UNPARSEABLE"
    if value.startswith("accounts_dir_missing:"):
        return "ACCOUNTS_DIR_MISSING"
    if value.startswith("AGY_ACCOUNT_POOL_ACCOUNTS_MISSING:"):
        return "ACCOUNTS_DIR_MISSING"
    if re.fullmatch(r"exit_[0-9]{1,3}", value):
        return "COMMAND_FAILED"
    return "OTHER"


def _quota_progress_projection(
    event: object,
    *,
    account_name: str,
    account_alias_hash: str | None,
) -> dict[str, Any] | None:
    """Project one quota CLI event into a small, identity-safe journal value."""
    if not isinstance(event, dict):
        return None
    phase = event.get("phase")
    if not isinstance(phase, str) or phase not in _QUOTA_PROGRESS_PHASES:
        return None

    projected: dict[str, Any] = {"phase": phase}
    timestamp = event.get("timestamp")
    if isinstance(timestamp, str) and len(timestamp) <= 64:
        try:
            parsed_timestamp = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
        except ValueError:
            parsed_timestamp = None
        if parsed_timestamp is not None and parsed_timestamp.tzinfo is not None:
            projected["timestamp"] = parsed_timestamp.astimezone(timezone.utc).isoformat()

    if isinstance(account_alias_hash, str) and re.fullmatch(r"[0-9a-f]{12}", account_alias_hash):
        projected["account_alias_hash"] = account_alias_hash

    if phase in _QUOTA_ACCOUNT_PHASES:
        observed_account = event.get("account")
        if observed_account is not None and observed_account != account_name:
            return None

    for source_key, target_key in (
        ("timeout", "timeout_seconds"),
        ("total_timeout", "total_timeout_seconds"),
    ):
        value = event.get(source_key)
        if (
            isinstance(value, (int, float))
            and not isinstance(value, bool)
            and 0 < float(value) <= 3600
        ):
            projected[target_key] = float(value)

    for source_key, target_key in (("total", "account_count"), ("ok", "ok_count")):
        value = event.get(source_key)
        if isinstance(value, int) and not isinstance(value, bool) and 0 <= value <= 10000:
            projected[target_key] = value
    if "ok_count" in projected:
        projected["ok_count_semantics"] = "successful_quota_queries"

    if isinstance(event.get("ok"), bool):
        projected["ok"] = event["ok"]
    error_kind = _quota_error_kind(event.get("error"))
    if error_kind is not None:
        projected["error_kind"] = error_kind
    for str_key in ("admission_state", "probe_state", "quota_state"):
        str_val = event.get(str_key)
        if isinstance(str_val, str) and 0 < len(str_val) <= 64:
            projected[str_key] = str_val
    return projected


def _notify_quota_progress(
    on_phase_hook: Any,
    progress: dict[str, Any],
    *,
    account_alias_hash: str | None = None,
) -> None:
    if not callable(on_phase_hook):
        return
    if isinstance(account_alias_hash, str) and re.fullmatch(r"[0-9a-f]{12}", account_alias_hash):
        progress = {**progress, "account_alias_hash": account_alias_hash}
    try:
        on_phase_hook(quota_preflight_progress=progress)
    except Exception:
        # Quota progress is diagnostic and must not change dispatch behavior.
        pass


def _read_quota_progress(
    stream: Any,
    *,
    account_name: str,
    account_alias_hash: str | None,
    on_phase_hook: Any,
) -> None:
    while True:
        try:
            line = stream.readline(_QUOTA_PROGRESS_MAX_LINE + 1)
        except (OSError, ValueError):
            return
        if not line:
            return
        if len(line) > _QUOTA_PROGRESS_MAX_LINE:
            while line and not line.endswith("\n"):
                line = stream.readline(_QUOTA_PROGRESS_MAX_LINE + 1)
            continue
        if not line.endswith("\n"):
            continue
        line = line.rstrip("\r\n")
        if not line.startswith(_QUOTA_PROGRESS_PREFIX):
            continue
        try:
            raw_event = json.loads(line[len(_QUOTA_PROGRESS_PREFIX) :])
        except (json.JSONDecodeError, TypeError):
            continue
        progress = _quota_progress_projection(
            raw_event,
            account_name=account_name,
            account_alias_hash=account_alias_hash,
        )
        if progress is None:
            continue
        _notify_quota_progress(on_phase_hook, progress)


def _refresh_quota_snapshot_for_account(
    account_name: str,
    *,
    timeout: int = DEFAULT_QUOTA_PREFLIGHT_TIMEOUT_SECONDS,
    on_phase_hook: Any = None,
    account_alias_hash: str | None = None,
) -> dict:
    command = _quota_refresh_binary()
    if not command:
        return _load_quota_snapshot()
    timeout_seconds = max(1, int(timeout))
    deadline = time.monotonic() + timeout_seconds
    finalize_headroom = min(1.0, max(0.5, timeout_seconds * 0.25))
    child_total_timeout = max(0.001, timeout_seconds - finalize_headroom)
    configured_total_timeout = os.getenv("NEXUS_AGY_QUOTA_TOTAL_TIMEOUT")
    if configured_total_timeout:
        try:
            child_total_timeout = min(child_total_timeout, float(configured_total_timeout))
        except ValueError:
            pass
    child_env = os.environ.copy()
    child_env["NEXUS_AGY_QUOTA_TOTAL_TIMEOUT"] = format(child_total_timeout, ".6g")
    try:
        proc = subprocess.Popen(
            [command, account_name, "--timeout", str(timeout_seconds)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            env=child_env,
        )
    except OSError:
        _notify_quota_progress(
            on_phase_hook,
            {"phase": "START_FAILED", "error_kind": "COMMAND_START_FAILED"},
            account_alias_hash=account_alias_hash,
        )
        return _load_quota_snapshot()

    assert proc.stderr is not None
    reader = threading.Thread(
        target=_read_quota_progress,
        kwargs={
            "stream": proc.stderr,
            "account_name": account_name,
            "account_alias_hash": account_alias_hash,
            "on_phase_hook": on_phase_hook,
        },
        name="agy-quota-progress",
        daemon=True,
    )
    reader.start()
    try:
        proc.wait(timeout=max(0.0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        _notify_quota_progress(
            on_phase_hook,
            {"phase": "TIMED_OUT", "error_kind": "TIMEOUT"},
            account_alias_hash=account_alias_hash,
        )
    finally:
        reader.join(timeout=max(0.0, deadline - time.monotonic()))
        if proc.stderr and not proc.stderr.closed:
            proc.stderr.close()
    return _load_quota_snapshot()


def _account_family_quota_state(
    snapshot: dict,
    *,
    account_name: str,
    model_family: str,
    now_ts: float | None = None,
) -> tuple[str, float | None, bool]:
    if model_family not in {"gemini", "claude_gpt"}:
        return "unknown", None, False
    current = time.time() if now_ts is None else float(now_ts)
    max_age = _quota_max_age_seconds()
    if not _snapshot_is_fresh(snapshot, now_ts=current, max_age_seconds=max_age):
        return "stale", None, False
    rows = snapshot.get("accounts") if isinstance(snapshot, dict) else None
    if not isinstance(rows, list):
        return "unknown", None, False
    group_name = "Gemini Models" if model_family == "gemini" else "Claude and GPT models"
    for row in rows:
        if not isinstance(row, dict) or row.get("account") != account_name:
            continue
        if not _row_is_fresh(
            row,
            snapshot,
            now_ts=current,
            max_age_seconds=max_age,
        ):
            return "stale", None, False
        if row.get("ok") is not True:
            return "unknown", None, True
        groups = row.get("groups")
        if not isinstance(groups, dict):
            return "unknown", None, True
        state, reset_ts = _family_quota_state(groups, group_name, now_ts=current)
        return state, reset_ts, True
    return "unknown", None, False


def _quota_preflight_decision(
    *,
    account_alias_hash: str | None,
    model_family: str,
    quota_state: str,
    evidence_fresh: bool,
    probe_state: str,
    dispatch_decision: str,
) -> dict[str, str | None]:
    """Separate quota-query health from the policy decision.

    ``account_alias_hash`` is None only for a family-level decision made before any claim.
    """
    evidence_state = (
        "KNOWN_BLOCKED"
        if evidence_fresh and quota_state == "blocked"
        else "KNOWN_ELIGIBLE"
        if evidence_fresh and quota_state in {"five_hour", "weekly"}
        else "UNKNOWN"
    )
    return {
        "account_alias_hash": account_alias_hash,
        "model_family": model_family,
        "evidence_state": evidence_state,
        "quota_window_state": quota_state,
        "probe_state": probe_state,
        "dispatch_decision": dispatch_decision,
    }


def _selected_snapshot_probe_state(snapshot: dict, account_name: str) -> str:
    rows = snapshot.get("accounts") if isinstance(snapshot, dict) else None
    if not isinstance(rows, list):
        return "NOT_RUN"
    for row in rows:
        if isinstance(row, dict) and row.get("account") == account_name:
            if row.get("ok") is True:
                return "CACHED_SUCCEEDED"
            if row.get("ok") is False:
                return "CACHED_FAILED"
            return "CACHED_UNKNOWN"
    return "NOT_RUN"


def _dynamic_availability_state(
    model: str | None,
    snapshot: dict,
    *,
    now_ts: float | None = None,
    max_age_seconds: float | None = None,
) -> dict[str, object]:
    family = _model_family(model)
    result: dict[str, object] = {
        "family": family,
        "snapshot_fresh": False,
        "preferred": [],
        "reserve": [],
        "fallback": [],
        "blocked": [],
        "unknown": [],
    }
    if family not in {"gemini", "claude_gpt"}:
        return result
    current = time.time() if now_ts is None else float(now_ts)
    max_age = _quota_max_age_seconds() if max_age_seconds is None else max_age_seconds
    if not _snapshot_is_fresh(
        snapshot,
        now_ts=current,
        max_age_seconds=max_age,
    ):
        return result

    rows = snapshot.get("accounts") if isinstance(snapshot, dict) else None
    if not isinstance(rows, list):
        return result

    result["snapshot_fresh"] = True
    preferred: list[tuple[str, float | None]] = []
    reserve: list[tuple[str, float | None]] = []
    fallback: list[tuple[str, float | None]] = []
    blocked: list[str] = []
    unknown: list[str] = []
    target_group = "Gemini Models" if family == "gemini" else "Claude and GPT models"
    other_group = "Claude and GPT models" if family == "gemini" else "Gemini Models"

    for row in rows:
        if not isinstance(row, dict):
            continue
        name = row.get("account")
        if not isinstance(name, str):
            continue
        if not _row_is_fresh(
            row,
            snapshot,
            now_ts=current,
            max_age_seconds=max_age,
        ):
            unknown.append(name)
            continue
        if row.get("ok") is not True:
            unknown.append(name)
            continue
        groups = row.get("groups")
        if not isinstance(groups, dict):
            unknown.append(name)
            continue

        target_state, _target_reset = _family_quota_state(
            groups,
            target_group,
            now_ts=current,
        )
        other_state, _other_reset = _family_quota_state(
            groups,
            other_group,
            now_ts=current,
        )
        drain_pressure = _family_drain_pressure(
            groups,
            target_group,
            target_state,
            now_ts=current,
        )
        if target_state == "five_hour":
            if other_state == "five_hour":
                reserve.append((name, drain_pressure))
            else:
                preferred.append((name, drain_pressure))
        elif target_state == "weekly":
            fallback.append((name, drain_pressure))
        elif target_state == "blocked":
            blocked.append(name)
        else:
            unknown.append(name)

    ordered_preferred = _order_accounts_by_drain_pressure(preferred)
    ordered_reserve = _order_accounts_by_drain_pressure(reserve)
    ordered_fallback = _order_accounts_by_drain_pressure(fallback)
    preferred_names = set(ordered_preferred)
    reserve_names = set(ordered_reserve) - preferred_names

    result.update({
        "preferred": ordered_preferred,
        "reserve": [name for name in ordered_reserve if name in reserve_names],
        "fallback": [
            name
            for name in ordered_fallback
            if name not in preferred_names and name not in reserve_names
        ],
        "blocked": sorted(set(blocked)),
        "unknown": sorted(set(unknown)),
    })
    return result


def _dynamic_preference_tiers(model: str | None, snapshot: dict) -> tuple[list[str], list[str]]:
    state = _dynamic_availability_state(model, snapshot)
    return list(state["preferred"]), list(state["reserve"])


def _publish_dynamic_availability(state: dict[str, object]) -> None:
    os.environ["NEXUS_AGY_PREFERRED_ACCOUNTS"] = ",".join(state["preferred"])
    os.environ["NEXUS_AGY_RESERVE_ACCOUNTS"] = ",".join(state["reserve"])
    os.environ["NEXUS_AGY_FALLBACK_ACCOUNTS"] = ",".join(state["fallback"])
    os.environ["NEXUS_AGY_BLOCKED_ACCOUNTS"] = ",".join(state["blocked"])


def _apply_dynamic_availability(model: str | None) -> tuple[dict, dict[str, object]]:
    if AGY_ACCOUNT_PREFERENCE_TIERS_VERSION != 3:
        raise RuntimeError("AGY_ACCOUNT_PREFERENCE_TIERS_VERSION_MISMATCH")
    snapshot = _load_quota_snapshot()
    state = _dynamic_availability_state(model, snapshot)
    _publish_dynamic_availability(state)
    return snapshot, state


def _apply_dynamic_preference(model: str | None) -> tuple[list[str], list[str]]:
    _snapshot, state = _apply_dynamic_availability(model)
    return list(state["preferred"]), list(state["reserve"])


def _family_failure_unavailable_until(
    *,
    snapshot: dict,
    account_name: str,
    model_family: str,
    failure_kind: AccountFailureKind,
    now_ts: float | None = None,
) -> float:
    current = time.time() if now_ts is None else float(now_ts)
    if not _snapshot_is_fresh(snapshot, now_ts=current):
        return current + DEFAULT_QUOTA_FAMILY_BLOCK_SECONDS

    target_group = "Gemini Models" if model_family == "gemini" else "Claude and GPT models"
    rows = snapshot.get("accounts") if isinstance(snapshot, dict) else None
    if isinstance(rows, list):
        for row in rows:
            if not isinstance(row, dict) or row.get("account") != account_name:
                continue
            if not _row_is_fresh(
                row,
                snapshot,
                now_ts=current,
                max_age_seconds=_quota_max_age_seconds(),
            ):
                break
            groups = row.get("groups")
            group = groups.get(target_group) if isinstance(groups, dict) else None
            if not isinstance(group, dict):
                break
            for window_name in ("5h", "weekly"):
                window = group.get(window_name)
                if not isinstance(window, dict):
                    continue
                reset_ts = _parse_reset_at(window.get("reset_at"))
                if reset_ts is not None and reset_ts > current:
                    return reset_ts
            break
    return current + DEFAULT_QUOTA_FAMILY_BLOCK_SECONDS


_QUOTA_FAILURE_MARKERS = (
    "resource_exhausted",
    "exceeded your current quota",
    "insufficient_quota",
    "quota exhausted",
    "quota_exhausted",
    "quota exceeded",
    "quota limit reached",
    "quota limit exceeded",
)


def _has_quota_failure_signal(text: str) -> bool:
    lowered = text.lower()
    return any(marker in lowered for marker in _QUOTA_FAILURE_MARKERS)


_PERMISSION_FAILURE_MARKERS = (
    "permission denied",
    "operation not permitted",
    "tool execution permission block",
    "tool permission denied",
    "blocked by active deny rules",
    "blocked by the active security/deny rules",
    "soft-denying tool confirmation",
    "headless mode cannot prompt for",
    "auto-denied",
    "denied by permission rules",
    "now let me restore my changes",
    "scope violation",
    "unauthorized write path",
)


def _has_permission_failure_signal(text: str) -> bool:
    lowered = text.lower()
    return any(marker in lowered for marker in _PERMISSION_FAILURE_MARKERS)


def classify_failure(
    returncode: int | None, stdout: str, stderr: str, timed_out: bool
) -> AccountFailureKind:
    if timed_out:
        return AccountFailureKind.TIMEOUT
    text = (stdout + "\n" + stderr).lower()
    if _has_permission_failure_signal(text):
        return AccountFailureKind.PERMISSION_OR_SCOPE_ERROR
    if _has_quota_failure_signal(stderr):
        return AccountFailureKind.QUOTA_EXHAUSTED
    if (
        "invalid model selection" in text
        or "not supported for model" in text
        or "unknown model" in text
        or "unrecognized model" in text
        or "model not found" in text
        or "--effort is not supported" in text
    ):
        return AccountFailureKind.MODEL_OR_TASK_ERROR
    if any(k in text for k in ("429", "rate limit", "ratelimit")):
        return AccountFailureKind.RATE_LIMITED
    if any(
        k in text
        for k in (
            "unauthorized",
            "authenticated",
            "authentication",
            "invalid api key",
            "invalid_api_key",
            "401",
            "token expired",
            "invalid token",
            "login required",
        )
    ):
        if "expired" in text:
            return AccountFailureKind.TOKEN_EXPIRED
        return AccountFailureKind.AUTH_OR_SESSION_INVALID
    if "refresh failed" in text or "token refresh" in text:
        return AccountFailureKind.TOKEN_REFRESH_FAILED
    if "403" in text or "forbidden" in text:
        return AccountFailureKind.PERMISSION_OR_SCOPE_ERROR
    if any(k in text for k in ("unavailable", "503", "service unavailable")):
        return AccountFailureKind.ACCOUNT_UNAVAILABLE
    if "disabled" in text:
        return AccountFailureKind.ACCOUNT_DISABLED
    if "nexus_agy_non_progress:pre_effect_tool_thrash" in text:
        return AccountFailureKind.PRE_EFFECT_TOOL_THRASH
    if "nexus_agy_non_progress:provider_stream_no_progress" in text:
        return AccountFailureKind.PROVIDER_STREAM_NO_PROGRESS
    if "nexus_agy_non_progress:provider_stalled" in text:
        return AccountFailureKind.PROVIDER_STALLED
    if returncode == 2:
        return AccountFailureKind.SYNTAX_OR_IMPLEMENTATION_ERROR
    return AccountFailureKind.UNKNOWN


# Only an error/fatal-severity errorreport line for the agent executor itself is
# terminal; warnings, retries, and unrelated diagnostics (title generation) are not.
_AGY_TERMINAL_EXECUTOR_ERROR_RE = re.compile(
    r"(?m)^[EF]\d{4}\s+\S+\s+\d+\s+errorreport\.go:\d+\]\s+"
    r"agent executor error:(?P<detail>[^\n]*)$"
)


def _has_terminal_quota_log_signal(text: str) -> bool:
    return any(
        _has_quota_failure_signal(match.group("detail"))
        for match in _AGY_TERMINAL_EXECUTOR_ERROR_RE.finditer(text)
    )


_AGY_ALIAS_RESOLUTION_RE = re.compile(
    r'model alias "(?P<alias>[^"\n]+)" resolved to "(?P<resolved>[^"\n]+)"'
)
_AGY_RESOLVING_MODEL_RE = re.compile(r"Resolving model (?P<resolved>[^\s]+)")
_AGY_CONVERSATION_RE = re.compile(r"Created conversation (?P<conversation>[0-9a-fA-F-]{36})")
_AGY_INSTRUCTION_TRUNCATION_RE = re.compile(
    r"(?m)^\S+\s+\S+\s+\d+\s+rules\.go:\d+\]\s+"
    r"Rule file (?P<path>.+?) truncated by (?P<truncated>\d{1,12}) bytes "
    r"\(original (?P<original>\d{1,12}) bytes, limit (?P<limit>\d{1,12}) bytes\)",
    re.IGNORECASE,
)


def _parse_input_delivery(text: str) -> dict[str, Any]:
    """Return only positive provider-log evidence of truncated input files."""
    truncations: list[dict[str, Any]] = []
    seen: set[tuple[str, int, int, int]] = set()
    for match in _AGY_INSTRUCTION_TRUNCATION_RE.finditer(text):
        file_name = Path(match.group("path").strip()).name
        observation = (
            file_name,
            int(match.group("original")),
            int(match.group("limit")),
            int(match.group("truncated")),
        )
        if observation in seen:
            continue
        seen.add(observation)
        truncations.append({
            "file_name": file_name,
            "original_bytes": observation[1],
            "limit_bytes": observation[2],
            "truncated_bytes": observation[3],
        })
    if not truncations:
        return {}
    return {
        "input_delivery_state": "TRUNCATED",
        "input_delivery_source": "AGY_LOG",
        "input_delivery_truncations": truncations,
    }


def _parse_agy_attestation(
    log_path: Path,
    *,
    requested_model: str | None,
) -> dict[str, str | None]:
    """Parse Agy-owned execution witnesses without trusting configured identity."""
    try:
        text = log_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {
            "observed_provider": None,
            "observed_model": None,
            "provider_session_id": None,
            **_parse_input_delivery(""),
        }

    input_delivery = _parse_input_delivery(text)

    canonical_requested = canonicalize_agy_model(requested_model)
    resolved_models: list[str] = []
    for match in _AGY_ALIAS_RESOLUTION_RE.finditer(text):
        alias = match.group("alias")
        if (
            requested_model is None
            or alias == requested_model
            or (canonical_requested and alias == canonical_requested)
        ):
            resolved_models.append(match.group("resolved"))
    if not resolved_models and requested_model:
        for match in _AGY_RESOLVING_MODEL_RE.finditer(text):
            resolved = match.group("resolved")
            if resolved == requested_model or (
                canonical_requested and resolved == canonical_requested
            ):
                resolved_models.append(resolved)

    conversations = [match.group("conversation") for match in _AGY_CONVERSATION_RE.finditer(text)]
    if not resolved_models or not conversations:
        return {
            "observed_provider": None,
            "observed_model": None,
            "provider_session_id": None,
            **input_delivery,
        }
    return {
        "observed_provider": "agy",
        "observed_model": resolved_models[-1],
        "provider_session_id": conversations[-1],
        **input_delivery,
    }


def run_agy(
    *,
    env: dict[str, str],
    prompt: str,
    cwd: str,
    mode: str,
    model: str | None,
    effort: str | None,
    timeout: int,
    operation_hook: Any = None,
    expect_coding_progress: bool = False,
    provider_stall_seconds: float | None = None,
    stream_no_progress_seconds: float | None = None,
    pre_effect_max_seconds: float | None = None,
    pre_effect_max_tool_events: int | None = None,
):
    expect_coding_progress = bool(expect_coding_progress and mode == "accept-edits")
    agy = shutil.which("agy")
    if not agy:
        raise RuntimeError("AGY_BINARY_NOT_FOUND")
    argv = [
        agy,
        "--new-project",
        "--add-dir",
        cwd,
        "--mode",
        mode,
        "--output-format",
        "text",
        "--print-timeout",
        f"{timeout}s",
    ]
    attestation_log = os.getenv("NEXUS_AGY_ATTESTATION_LOG")
    if attestation_log:
        log_path = Path(attestation_log).expanduser()
        log_path.parent.mkdir(parents=True, exist_ok=True)
        argv += ["--log-file", str(log_path)]
    canonical_model = canonicalize_agy_model(model)
    if canonical_model:
        argv += ["--model", canonical_model]
    if effort:
        argv += ["--effort", effort]
    argv += ["--print", prompt]

    baseline_worktree_state = None
    try:
        baseline_worktree_state = direct_operation_journal.capture_source_baseline(cwd)
        if baseline_worktree_state is None:
            raise RuntimeError("SOURCE_BASELINE_UNAVAILABLE")
    except Exception as exc:
        if operation_hook:
            _operation_hook(
                operation_hook,
                effect_observation_error=f"BASELINE_CAPTURE_FAILED:{type(exc).__name__}",
            )

    provider_log_path = Path(attestation_log).expanduser() if attestation_log else None
    if provider_log_path is not None:
        try:
            provider_log_offset = provider_log_path.stat().st_size
        except OSError:
            provider_log_offset = 0
    else:
        provider_log_offset = 0

    started = time.monotonic()
    process = subprocess.Popen(
        argv,
        cwd=cwd,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
        start_new_session=True,
    )
    provider_pid = getattr(process, "pid", None)
    provider_pgid: int | None = (
        provider_pid if isinstance(provider_pid, int) and provider_pid > 0 else None
    )
    if provider_pgid is not None:
        try:
            provider_pgid = os.getpgid(provider_pid)
        except OSError:
            # start_new_session=True establishes a fresh session/process group
            # whose PGID is the child PID. Preserve that deterministic identity
            # even if a very short-lived child exits before getpgid() readback.
            provider_pgid = provider_pid
    if operation_hook:
        try:
            _operation_hook(
                operation_hook,
                phase="PROVIDER_RUNNING",
                provider_pid=provider_pid,
                provider_pgid=provider_pgid,
                provider_process_state="RUNNING",
                provider_started_at=_agy_operation_journal.utc_now(),
            )
        except Exception as hook_exc:
            # A provider whose durable physical identity cannot be persisted
            # must not continue. This frame still owns the live Popen/session,
            # so bounded cleanup is authorized without trusting a later PID.
            if provider_pgid is not None:
                try:
                    _agy_operation_journal._stop_process_group(
                        provider_pgid,
                        grace_seconds=2.0,
                    )
                except Exception:
                    pass
            if process.poll() is None and isinstance(provider_pid, int):
                try:
                    _agy_operation_journal._stop_process(
                        provider_pid,
                        grace_seconds=2.0,
                    )
                except Exception:
                    pass
            provider_alive = isinstance(
                provider_pid, int
            ) and _agy_operation_journal._process_alive(provider_pid)
            group_alive = provider_pgid is not None and _agy_operation_journal._process_group_alive(
                provider_pgid
            )
            if provider_alive or group_alive:
                raise RuntimeError(
                    "PROVIDER_IDENTITY_PERSIST_FAILED_CLEANUP_UNVERIFIED"
                ) from hook_exc
            raise

    stdout_lines: list[str] = []
    stderr_lines: list[str] = []
    quota_failure = threading.Event()
    first_stream_seen = threading.Event()
    first_effect_seen = threading.Event()
    first_stream_monotonic: float | None = None
    non_progress_failure: str | None = None
    resolved_provider_stall_seconds = (
        _provider_stall_seconds()
        if provider_stall_seconds is None
        else max(0.1, float(provider_stall_seconds))
    )
    resolved_stream_no_progress_seconds = (
        _stream_no_progress_seconds()
        if stream_no_progress_seconds is None
        else max(0.1, float(stream_no_progress_seconds))
    )
    resolved_pre_effect_max_seconds = (
        _pre_effect_max_seconds()
        if pre_effect_max_seconds is None
        else max(0.1, float(pre_effect_max_seconds))
    )
    resolved_pre_effect_max_tool_events = (
        _pre_effect_max_tool_events()
        if pre_effect_max_tool_events is None
        else max(1, int(pre_effect_max_tool_events))
    )
    provider_session_id: str | None = None
    transcript_path: Path | None = None
    transcript_offset = 0
    tool_event_count = 0
    first_tool_activity_at: str | None = None
    first_tool_monotonic: float | None = None
    last_coding_progress_monotonic: float | None = None

    def _record_tool_events(count: int, *, observed_at: float) -> None:
        nonlocal tool_event_count, first_tool_activity_at, first_tool_monotonic
        nonlocal last_coding_progress_monotonic
        if count <= 0:
            return
        tool_event_count += count
        last_coding_progress_monotonic = observed_at
        now_iso = _agy_operation_journal.utc_now()
        payload: dict[str, Any] = {
            "tool_event_count": tool_event_count,
            "last_progress_activity_at": now_iso,
        }
        if first_tool_activity_at is None:
            first_tool_activity_at = now_iso
            first_tool_monotonic = observed_at
            payload["first_tool_activity_at"] = first_tool_activity_at
        if operation_hook:
            _operation_hook(operation_hook, **payload)

    def _advance_provider_sessions(
        sessions: list[str],
        *,
        observed_at: float,
    ) -> None:
        nonlocal provider_session_id, transcript_path, transcript_offset
        for session_id in sessions:
            if session_id == provider_session_id:
                continue
            if transcript_path is not None:
                transcript_offset, prior_tool_events = _read_new_tool_activity(
                    transcript_path,
                    offset=transcript_offset,
                )
                _record_tool_events(prior_tool_events, observed_at=observed_at)
            provider_session_id = session_id
            transcript_path = _agy_transcript_path(env, provider_session_id)
            transcript_offset = 0
            if operation_hook:
                _operation_hook(
                    operation_hook,
                    provider_session_id=provider_session_id,
                )

    def _drain_stdout(stream, sink: list[str]) -> None:
        nonlocal first_stream_monotonic
        if stream is None:
            return
        for line in iter(stream.readline, ""):
            sink.append(line)
            if not line.strip():
                continue
            now_iso = _agy_operation_journal.utc_now()
            if not first_stream_seen.is_set():
                first_stream_monotonic = time.monotonic()
                first_stream_seen.set()
                if operation_hook:
                    _operation_hook(
                        operation_hook,
                        first_stream_activity_at=now_iso,
                        provider_stream_last_activity_at=now_iso,
                    )
            elif operation_hook:
                _operation_hook(
                    operation_hook,
                    provider_stream_last_activity_at=now_iso,
                )
        stream.close()

    def _drain_stderr(stream, sink: list[str], *, detect_quota: bool = False) -> None:
        if stream is None:
            return
        for line in iter(stream.readline, ""):
            sink.append(line)
            if detect_quota and _has_quota_failure_signal(line):
                quota_failure.set()
        stream.close()

    stdout_thread = threading.Thread(
        target=_drain_stdout,
        args=(process.stdout, stdout_lines),
        daemon=True,
    )
    stderr_thread = threading.Thread(
        target=_drain_stderr,
        args=(process.stderr, stderr_lines),
        kwargs={"detect_quota": True},
        daemon=True,
    )
    stdout_thread.start()
    stderr_thread.start()

    timed_out = False
    quota_terminated = False
    deadline = started + max(1, timeout) + 10
    next_effect_observation_at = started
    try:
        while process.poll() is None:
            now = time.monotonic()

            if provider_log_path is not None:
                (
                    provider_log_offset,
                    stream_events,
                    new_sessions,
                ) = _read_new_provider_log_activity(
                    provider_log_path,
                    offset=provider_log_offset,
                )
                if new_sessions:
                    _advance_provider_sessions(new_sessions, observed_at=now)
                if stream_events:
                    now_iso = _agy_operation_journal.utc_now()
                    if first_stream_monotonic is None:
                        first_stream_monotonic = now
                    if not first_stream_seen.is_set():
                        first_stream_seen.set()
                        if operation_hook:
                            _operation_hook(
                                operation_hook,
                                first_stream_activity_at=now_iso,
                                provider_stream_last_activity_at=now_iso,
                            )
                    elif operation_hook:
                        _operation_hook(
                            operation_hook,
                            provider_stream_last_activity_at=now_iso,
                        )

            if transcript_path is not None:
                transcript_offset, new_tool_events = _read_new_tool_activity(
                    transcript_path,
                    offset=transcript_offset,
                )
                _record_tool_events(new_tool_events, observed_at=now)

            if expect_coding_progress and not first_effect_seen.is_set():
                if (
                    not first_stream_seen.is_set()
                    and tool_event_count == 0
                    and now - started >= resolved_provider_stall_seconds
                ):
                    non_progress_failure = "PROVIDER_STALLED"
                elif first_tool_monotonic is not None and (
                    now - first_tool_monotonic >= resolved_pre_effect_max_seconds
                    or tool_event_count >= resolved_pre_effect_max_tool_events
                ):
                    non_progress_failure = "PRE_EFFECT_TOOL_THRASH"
                elif first_stream_monotonic is not None:
                    progress_anchor = max(
                        first_stream_monotonic,
                        (
                            last_coding_progress_monotonic
                            if last_coding_progress_monotonic is not None
                            else first_stream_monotonic
                        ),
                    )
                    if now - progress_anchor >= resolved_stream_no_progress_seconds:
                        non_progress_failure = "PROVIDER_STREAM_NO_PROGRESS"
                if non_progress_failure is not None:
                    # Source mutation is the strongest positive progress witness.
                    # Recheck immediately at the watchdog boundary so an effect
                    # that lands between regular scans is not misclassified.
                    if baseline_worktree_state is not None:
                        try:
                            changed = direct_operation_journal.observed_changed_paths_since(
                                cwd, baseline_worktree_state
                            )
                        except Exception as exc:
                            changed = None
                            baseline_worktree_state = None
                            if operation_hook:
                                _operation_hook(
                                    operation_hook,
                                    effect_observation_error=(
                                        f"WATCHDOG_EFFECT_OBSERVATION_FAILED:{type(exc).__name__}"
                                    ),
                                )
                        if changed:
                            first_effect_seen.set()
                            non_progress_failure = None
                            now_effect_iso = _agy_operation_journal.utc_now()
                            effect_wall_ms = int((time.monotonic() - started) * 1000)
                            last_coding_progress_monotonic = now
                            if operation_hook:
                                _operation_hook(
                                    operation_hook,
                                    first_effect_at=now_effect_iso,
                                    time_to_first_effect_ms=effect_wall_ms,
                                    last_progress_activity_at=now_effect_iso,
                                )
                    if non_progress_failure is not None:
                        if provider_pgid is not None:
                            _agy_operation_journal._stop_process_group(
                                provider_pgid,
                                grace_seconds=2.0,
                            )
                        else:
                            process.terminate()
                        break

            if (
                baseline_worktree_state is not None
                and not first_effect_seen.is_set()
                and now >= next_effect_observation_at
            ):
                next_effect_observation_at = now + _EFFECT_OBSERVATION_INTERVAL_SECONDS
                try:
                    changed = direct_operation_journal.observed_changed_paths_since(
                        cwd, baseline_worktree_state
                    )
                    if changed is None:
                        baseline_worktree_state = None
                        if operation_hook:
                            _operation_hook(
                                operation_hook,
                                effect_observation_error="EFFECT_OBSERVATION_UNAVAILABLE",
                            )
                    elif changed:
                        first_effect_seen.set()
                        now_effect_iso = _agy_operation_journal.utc_now()
                        effect_wall_ms = int((time.monotonic() - started) * 1000)
                        if operation_hook:
                            _operation_hook(
                                operation_hook,
                                first_effect_at=now_effect_iso,
                                time_to_first_effect_ms=effect_wall_ms,
                                last_progress_activity_at=now_effect_iso,
                            )
                except Exception as exc:
                    baseline_worktree_state = None
                    if operation_hook:
                        _operation_hook(
                            operation_hook,
                            effect_observation_error=f"EFFECT_OBSERVATION_FAILED:{type(exc).__name__}",
                        )
            if quota_failure.wait(0.05):
                quota_terminated = True
                if provider_pgid is not None:
                    _agy_operation_journal._stop_process_group(
                        provider_pgid,
                        grace_seconds=2.0,
                    )
                else:
                    process.terminate()
                break
            if time.monotonic() >= deadline:
                timed_out = True
                if provider_pgid is not None:
                    _agy_operation_journal._stop_process_group(
                        provider_pgid,
                        grace_seconds=2.0,
                    )
                else:
                    process.terminate()
                break
            time.sleep(0.05)

        if process.poll() is None:
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                if provider_pgid is not None:
                    _agy_operation_journal._stop_process_group(
                        provider_pgid,
                        grace_seconds=2.0,
                    )
                else:
                    process.kill()
                process.wait(timeout=2)
    finally:
        if provider_pgid is not None and _agy_operation_journal._process_group_alive(provider_pgid):
            try:
                _agy_operation_journal._stop_process_group(
                    provider_pgid,
                    grace_seconds=2.0,
                )
            except Exception:
                pass
        if process.poll() is None and isinstance(provider_pid, int):
            try:
                _agy_operation_journal._stop_process(
                    provider_pid,
                    grace_seconds=2.0,
                )
            except Exception:
                pass

    stdout_thread.join(timeout=2)
    stderr_thread.join(timeout=2)
    out = "".join(stdout_lines)
    err = "".join(stderr_lines)
    stderr_lower = err.lower()
    agy_print_timed_out = (
        "[agy] print timeout after" in stderr_lower and "turn in progress" in stderr_lower
    )

    # Final provider-metadata readback closes the same short-lived race as the
    # final source-delta readback below. A provider may write its stream/session
    # or transcript after the last loop poll and exit immediately afterward.
    (
        provider_log_offset,
        final_stream_events,
        final_sessions,
    ) = _read_new_provider_log_activity(
        provider_log_path,
        offset=provider_log_offset,
    )
    if final_sessions:
        _advance_provider_sessions(
            final_sessions,
            observed_at=time.monotonic(),
        )
    if final_stream_events:
        now_iso = _agy_operation_journal.utc_now()
        if first_stream_monotonic is None:
            first_stream_monotonic = time.monotonic()
        if not first_stream_seen.is_set():
            first_stream_seen.set()
            if operation_hook:
                _operation_hook(
                    operation_hook,
                    first_stream_activity_at=now_iso,
                    provider_stream_last_activity_at=now_iso,
                )
        elif operation_hook:
            _operation_hook(
                operation_hook,
                provider_stream_last_activity_at=now_iso,
            )
    if transcript_path is not None:
        transcript_offset, final_tool_events = _read_new_tool_activity(
            transcript_path,
            offset=transcript_offset,
        )
        _record_tool_events(final_tool_events, observed_at=time.monotonic())

    # A short-lived provider can mutate the worktree and exit between polling
    # intervals. Perform one final source-delta readback before projecting EXITED
    # so time-to-first-effect does not silently miss that physical change.
    if baseline_worktree_state is not None and not first_effect_seen.is_set():
        try:
            changed = direct_operation_journal.observed_changed_paths_since(
                cwd, baseline_worktree_state
            )
            if changed is None:
                baseline_worktree_state = None
                if operation_hook:
                    _operation_hook(
                        operation_hook,
                        effect_observation_error="EFFECT_OBSERVATION_UNAVAILABLE",
                    )
            elif changed:
                first_effect_seen.set()
                now_effect_iso = _agy_operation_journal.utc_now()
                effect_wall_ms = int((time.monotonic() - started) * 1000)
                if operation_hook:
                    _operation_hook(
                        operation_hook,
                        first_effect_at=now_effect_iso,
                        time_to_first_effect_ms=effect_wall_ms,
                        last_progress_activity_at=now_effect_iso,
                    )
        except Exception as exc:
            baseline_worktree_state = None
            if operation_hook:
                _operation_hook(
                    operation_hook,
                    effect_observation_error=f"EFFECT_OBSERVATION_FAILED:{type(exc).__name__}",
                )

    wall_ms = int((time.monotonic() - started) * 1000)

    if operation_hook:
        _operation_hook(
            operation_hook,
            provider_process_state="EXITED",
        )

    if non_progress_failure is not None:
        err += f"\nNEXUS_AGY_NON_PROGRESS:{non_progress_failure}\n"
        return (
            process.returncode if process.returncode not in (None, 0) else 1,
            out,
            err,
            False,
            wall_ms,
        )
    if timed_out:
        return None, out, err, True, wall_ms
    if quota_terminated:
        return (
            process.returncode if process.returncode not in (None, 0) else 1,
            out,
            err,
            False,
            wall_ms,
        )
    return process.returncode, out, err, agy_print_timed_out, wall_ms


def emit_meta(data: dict) -> None:
    sys.stderr.write("NEXUS_AGY_DISPATCH " + json.dumps(data, sort_keys=True) + "\n")


def _runtime_revision() -> str | None:
    receipt = Path.home() / ".local/share/nexus-host-runtime/current/host-generation.json"
    try:
        data = json.loads(receipt.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    value = data.get("source_revision")
    return value if isinstance(value, str) and value else None


MAX_FAILURE_HISTORY_ENTRIES = 16


def _operation_hook(callback: Any, **payload: Any) -> None:
    if callback is not None:
        callback(payload)


TEMP_COMMAND_DENY = [
    "command(git push)",
    "command(git reset --hard)",
    "command(git reset)",
    "command(git checkout)",
    "command(git restore)",
    "command(git stash)",
    "command(git commit)",
    "command(git branch)",
    "command(git merge)",
    "command(git rebase)",
    "command(git cherry-pick)",
    "command(git revert)",
    "command(git clean)",
    "command(gh)",
    "command(curl)",
    "command(wget)",
    "command(ssh)",
    "command(scp)",
    "command(rsync)",
]

_UNSAFE_PERMISSION_RULES = {
    "command(*)",
    "read_file(*)",
    "write_file(*)",
    "read_file(/)",
    "write_file(/)",
}


def install_temp_permissions(
    env: dict[str, str],
    *,
    allow_rules: list[str],
    deny_rules: list[str] | None = None,
    allow_unsafe_legacy: bool = False,
    replace_allow_deny: bool = False,
    mode: str = "plan",
    expected_profile_sha256: str | None = None,
):
    home = str(env.get("HOME") or "").strip()
    if not home:
        raise RuntimeError("LEASE_HOME_MISSING")
    settings = Path(home) / ".gemini" / "antigravity-cli" / "settings.json"
    original = settings.read_bytes() if settings.exists() else None
    try:
        data = json.loads(original.decode("utf-8")) if original else {}
    except Exception as exc:
        raise RuntimeError(f"LEASE_SETTINGS_INVALID:{exc}") from exc
    existing_perms = data.get("permissions")
    if existing_perms is None:
        existing_perms = {}
    if not isinstance(existing_perms, dict):
        raise RuntimeError("LEASE_SETTINGS_INVALID:permissions must be an object")
    perms = dict(existing_perms)
    if replace_allow_deny:
        allow: list[str] = []
        deny: list[str] = []
    else:
        allow = list(perms.get("allow") or [])
        deny = list(perms.get("deny") or [])
    for rule in allow_rules:
        if not allow_unsafe_legacy and rule in _UNSAFE_PERMISSION_RULES:
            raise RuntimeError(f"UNSAFE_PERMISSION_RULE:{rule}")
        if rule not in allow:
            allow.append(rule)
    for rule in deny_rules or []:
        if rule not in deny:
            deny.append(rule)
    perms["allow"] = allow
    perms["deny"] = deny
    data["permissions"] = perms
    settings.parent.mkdir(parents=True, exist_ok=True)
    settings.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")

    # Deterministic permission preflight and readback
    try:
        read_text = settings.read_text(encoding="utf-8")
        read_data = json.loads(read_text)
    except Exception as exc:
        raise RuntimeError(f"PERMISSION_PREFLIGHT_READBACK_FAILED:{exc}") from exc

    read_perms = read_data.get("permissions")
    if not isinstance(read_perms, dict):
        raise RuntimeError("PERMISSION_PREFLIGHT_READBACK_FAILED:permissions must be an object")
    read_allow = read_perms.get("allow")
    read_deny = read_perms.get("deny")
    if not isinstance(read_allow, list) or not isinstance(read_deny, list):
        raise RuntimeError("PERMISSION_PREFLIGHT_READBACK_FAILED:allow and deny must be lists")

    missing_allow = [r for r in allow if r not in read_allow]
    if missing_allow:
        raise RuntimeError(
            f"PERMISSION_PREFLIGHT_VERIFICATION_FAILED:missing allow rules:{missing_allow}"
        )
    missing_deny = [r for r in deny if r not in read_deny]
    if missing_deny:
        raise RuntimeError(
            f"PERMISSION_PREFLIGHT_VERIFICATION_FAILED:missing deny rules:{missing_deny}"
        )

    if mode == "accept-edits":
        if "write_file(*)" in read_deny or "write_file(/)" in read_deny:
            raise RuntimeError(
                "PERMISSION_PREFLIGHT_CONTRADICTION:blanket write_file deny in accept-edits"
            )
        if "read_file(*)" in read_deny or "read_file(/)" in read_deny:
            raise RuntimeError(
                "PERMISSION_PREFLIGHT_CONTRADICTION:blanket read_file deny in accept-edits"
            )
        if any(r.startswith("command") for r in read_allow) and "command(*)" in read_deny:
            raise RuntimeError(
                "PERMISSION_PREFLIGHT_CONTRADICTION:blanket command deny while command permitted"
            )

    canonical_perms = {
        "allow": sorted(list(dict.fromkeys(read_allow))),
        "deny": sorted(list(dict.fromkeys(read_deny))),
    }
    computed_sha256 = permission_profile_digest(canonical_perms)
    if expected_profile_sha256 and computed_sha256 != expected_profile_sha256:
        raise RuntimeError(
            f"PERMISSION_PREFLIGHT_SHA256_MISMATCH:computed={computed_sha256}, expected={expected_profile_sha256}"
        )

    return settings, original, computed_sha256, canonical_perms


def restore_temp_permissions(token) -> None:
    if token is None:
        return
    settings, original = token[:2]
    if original is None:
        try:
            settings.unlink()
        except FileNotFoundError:
            pass
    else:
        settings.write_bytes(original)


_WRITE_FILE_RULE_RE = re.compile(r"^write_file\((?P<path>.+)\)$")


def _canonical_write_path(raw: str, *, cwd: str) -> str:
    cwd_path = Path(cwd).expanduser().resolve()
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute():
        candidate = cwd_path / candidate
    resolved = candidate.resolve()
    try:
        resolved.relative_to(cwd_path)
    except ValueError as exc:
        raise ValueError(f"AGY_WRITE_PATH_OUTSIDE_CWD:{resolved}") from exc
    return str(resolved)


def _project_write_permissions(
    *,
    cwd: str,
    mode: str,
    write_paths: list[str] | None,
    allow_rules: list[str],
) -> list[str]:
    for rule in allow_rules:
        if rule in _UNSAFE_PERMISSION_RULES:
            raise ValueError(f"UNSAFE_PERMISSION_RULE:{rule}")

    if mode != "accept-edits":
        return []

    projected: list[str] = []
    for raw in write_paths or []:
        canonical = _canonical_write_path(raw, cwd=cwd)
        rule = f"write_file({canonical})"
        if rule not in projected:
            projected.append(rule)

    for rule in allow_rules:
        match = _WRITE_FILE_RULE_RE.fullmatch(rule)
        if match is None:
            continue
        canonical = _canonical_write_path(match.group("path"), cwd=cwd)
        normalized = f"write_file({canonical})"
        if normalized != rule:
            raise ValueError(f"AGY_WRITE_RULE_NOT_CANONICAL:{rule}")
        if normalized not in projected:
            projected.append(normalized)

    if not projected:
        raise ValueError("AGY_WRITE_SCOPE_REQUIRED")
    return projected


def permission_profile_digest(effective_permissions: dict[str, list[str]]) -> str:
    canonical = {
        "allow": sorted(list(dict.fromkeys(effective_permissions.get("allow") or []))),
        "deny": sorted(list(dict.fromkeys(effective_permissions.get("deny") or []))),
    }
    raw = json.dumps(canonical, separators=(",", ":"), sort_keys=True).encode("utf-8")
    return hashlib.sha256(raw).hexdigest()


def build_effective_permission_profile(
    *,
    cwd: str,
    mode: str,
    write_paths: list[str] | None = None,
    allow_rules: list[str] | None = None,
    deny_rules: list[str] | None = None,
    temp_command_permissions: bool = False,
) -> tuple[dict[str, list[str]], str, str]:
    user_allow = list(allow_rules or [])
    user_deny = list(deny_rules or [])

    for rule in user_allow:
        if rule in _UNSAFE_PERMISSION_RULES:
            raise ValueError(f"UNSAFE_PERMISSION_RULE:{rule}")

    effective_allow: list[str] = list(user_allow)
    effective_deny: list[str] = list(user_deny)

    if mode == "accept-edits":
        projected_write_rules = _project_write_permissions(
            cwd=cwd,
            mode=mode,
            write_paths=write_paths,
            allow_rules=user_allow,
        )
        for rule in projected_write_rules:
            if rule not in effective_allow:
                effective_allow.append(rule)

        resolved_cwd = str(Path(cwd).expanduser().resolve())
        bounded_read_rule = f"read_file({resolved_cwd}/**)"
        if bounded_read_rule not in effective_allow:
            effective_allow.append(bounded_read_rule)

        if temp_command_permissions:
            if "command(*)" not in effective_allow:
                effective_allow.append("command(*)")
            for r in TEMP_COMMAND_DENY:
                if r not in effective_deny:
                    effective_deny.append(r)

        kind = "CODING_BOUNDED"
    else:
        if temp_command_permissions:
            if "command(*)" not in effective_allow:
                effective_allow.append("command(*)")
            for r in TEMP_COMMAND_DENY:
                if r not in effective_deny:
                    effective_deny.append(r)

        if any(r.startswith("read_file") or r.startswith("command") for r in effective_allow):
            kind = "READ_ONLY_RESEARCH"
        elif not effective_allow:
            kind = "NO_TOOL_PACKET"
        else:
            kind = "CUSTOM"

    # Anti-blanket-override / contradiction prevention
    has_command_allow = any(r.startswith("command") for r in effective_allow)
    if has_command_allow and "command(*)" in effective_deny:
        raise ValueError(
            "CONTRADICTORY_PERMISSION_PROFILE:command(*) in deny rules neutralizes command capability"
        )

    has_read_allow = any(r.startswith("read_file") for r in effective_allow)
    if has_read_allow and ("read_file(*)" in effective_deny or "read_file(/)" in effective_deny):
        raise ValueError(
            "CONTRADICTORY_PERMISSION_PROFILE:read_file(*) in deny rules neutralizes read capability"
        )

    has_write_allow = any(r.startswith("write_file") for r in effective_allow)
    if has_write_allow and ("write_file(*)" in effective_deny or "write_file(/)" in effective_deny):
        raise ValueError(
            "CONTRADICTORY_PERMISSION_PROFILE:write_file(*) in deny rules neutralizes write capability"
        )

    common_rules = set(effective_allow).intersection(effective_deny)
    if common_rules:
        colliding = sorted(common_rules)[0]
        raise ValueError(
            f"CONTRADICTORY_PERMISSION_PROFILE:rule present in both allow and deny:{colliding}"
        )

    canonical_perms = {
        "allow": sorted(list(dict.fromkeys(effective_allow))),
        "deny": sorted(list(dict.fromkeys(effective_deny))),
    }
    sha256 = permission_profile_digest(canonical_perms)
    return canonical_perms, kind, sha256


_WORKTREE_GITFILE_RE = re.compile(r"^gitdir:\s*(.+)$", re.MULTILINE)

# ---------------------------------------------------------------------------
# Linked-worktree detection and standalone-clone fallback
# ---------------------------------------------------------------------------


def _run_git(*args: str, cwd: str) -> tuple[int, str]:
    """Run a git command, return (returncode, stdout). Never raises."""
    try:
        result = subprocess.run(
            ["git"] + list(args),
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
            check=False,
        )
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def _is_linked_worktree(cwd: str) -> bool:
    """Return True when *cwd* is a linked Git worktree (not a standalone clone).

    Detection uses deterministic Git metadata only — no Agy logs:

    1. The .git entry is a plain file (gitfile) rather than a directory, which
       is the canonical marker for a linked worktree checkout.
    2. The common config referenced via that gitfile contains
       extensions.worktreeConfig, which is the specific setting that triggers
       the Agy 1.2.16 watcher rejection.

    A standalone clone always has a real .git *directory*.  When either
    condition cannot be read (missing git, non-git directory) this function
    returns False so normal flow is unaffected.
    """
    try:
        git_path = Path(cwd) / ".git"
        if not git_path.exists():
            # May still be a git repo via parent discovery, but check via git
            rc, toplevel = _run_git("rev-parse", "--show-toplevel", cwd=cwd)
            if rc != 0:
                return False
            git_path = Path(toplevel) / ".git"
            if not git_path.exists():
                return False

        # A regular file at .git is the gitfile pointer used by linked worktrees.
        if not git_path.is_file():
            return False  # real .git directory — standalone clone

        # Read the gitfile to find the per-worktree git dir.
        try:
            gitfile_content = git_path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return False
        match = _WORKTREE_GITFILE_RE.search(gitfile_content)
        if not match:
            return False
        worktree_git_dir = Path(match.group(1).strip()).expanduser()
        if not worktree_git_dir.is_absolute():
            worktree_git_dir = (Path(cwd) / worktree_git_dir).resolve()

        # The common config lives at <worktrees_dir>/../../config which is the
        # main repository's config.  Walk up from the per-worktree git dir.
        # Layout: <main-git-dir>/worktrees/<name>/  -> gitdir points here
        # Common config: <main-git-dir>/config
        common_config_path = worktree_git_dir.parent.parent / "config"
        if not common_config_path.is_file():
            # Non-standard layout: still a gitfile → still a linked worktree.
            return True

        try:
            config_text = common_config_path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return True  # gitfile confirmed linked worktree even without config read

        # Presence of extensions.worktreeConfig in any case is the trigger.
        if re.search(r"worktreeConfig\s*=\s*true", config_text, re.IGNORECASE):
            return True
        # Even without worktreeConfig, a gitfile-linked worktree is still
        # incompatible with the Agy watcher: return True for any gitfile.
        return True

    except Exception:
        return False


def _git_remote_url(cwd: str) -> str | None:
    """Return the 'origin' remote URL for the repo at *cwd*, or None."""
    rc, url = _run_git("remote", "get-url", "origin", cwd=cwd)
    if rc == 0 and url:
        return url
    return None


def _git_head_sha(cwd: str) -> str | None:
    """Return the full HEAD commit SHA for the repo at *cwd*, or None."""
    rc, sha = _run_git("rev-parse", "HEAD", cwd=cwd)
    if rc == 0 and sha and len(sha) >= 40:
        return sha
    return None


def _git_is_dirty(cwd: str) -> bool:
    """Return True when the working tree or index has uncommitted changes."""
    rc, output = _run_git("status", "--porcelain", cwd=cwd)
    if rc != 0:
        return True  # fail closed
    return bool(output.strip())


def _git_real_dot_git(cwd: str) -> bool:
    """Return True when .git is a real directory (not a gitfile)."""
    git_path = Path(cwd) / ".git"
    if git_path.is_dir():
        return True
    # Also accept repos that were initialized without a top-level .git (rare)
    if git_path.is_file():
        return False
    return False


class WorktreeFallbackError(ValueError):
    """Raised when a standalone-clone fallback cannot be established safely."""


def _validate_standalone_clone(
    *,
    clone_path: str,
    expected_remote: str,
    expected_sha: str,
) -> None:
    """Validate that an *existing* directory is a safe, exact standalone clone.

    Raises WorktreeFallbackError with a deterministic tag on any mismatch.
    """
    clone_dir = Path(clone_path)
    if not clone_dir.is_dir():
        raise WorktreeFallbackError(f"FALLBACK_CLONE_NOT_A_DIR:{clone_path}")

    # Must have a real .git directory (not a gitfile-linked worktree).
    if not _git_real_dot_git(clone_path):
        raise WorktreeFallbackError(f"FALLBACK_CLONE_IS_LINKED_WORKTREE:{clone_path}")

    # Remote must match exactly.
    actual_remote = _git_remote_url(clone_path)
    if actual_remote != expected_remote:
        raise WorktreeFallbackError(
            f"FALLBACK_CLONE_REMOTE_MISMATCH:expected={expected_remote!r} actual={actual_remote!r}"
        )

    # HEAD SHA must match exactly.
    actual_sha = _git_head_sha(clone_path)
    if actual_sha != expected_sha:
        raise WorktreeFallbackError(
            f"FALLBACK_CLONE_BASE_MISMATCH:expected={expected_sha!r} actual={actual_sha!r}"
        )

    # Clone must be clean (no uncommitted changes).
    if _git_is_dirty(clone_path):
        raise WorktreeFallbackError(f"FALLBACK_CLONE_DIRTY:{clone_path}")


def _prepare_standalone_clone_fallback(
    *,
    source_cwd: str,
    fallback_path: str,
) -> str:
    """Create or validate a standalone clone and return the clone path as cwd.

    Behaviour:
    - If *fallback_path* does not exist: create a fresh ``git clone`` from the
      source origin at the source HEAD revision with no shared object store and
      no worktree metadata.
    - If *fallback_path* exists and is already an exact, clean standalone clone
      of the same origin/HEAD: reuse it without modification.
    - Any other state (non-empty non-repo dir, wrong remote, wrong base, dirty,
      linked worktree) raises WorktreeFallbackError — fail closed.

    Raises WorktreeFallbackError on any unresolvable condition.
    Returns the resolved absolute path string of the standalone clone.
    """
    source_remote = _git_remote_url(source_cwd)
    if not source_remote:
        raise WorktreeFallbackError(
            f"FALLBACK_SOURCE_NO_REMOTE:cannot read origin from {source_cwd!r}"
        )

    source_sha = _git_head_sha(source_cwd)
    if not source_sha:
        raise WorktreeFallbackError(f"FALLBACK_SOURCE_NO_HEAD:cannot read HEAD from {source_cwd!r}")
    if _git_is_dirty(source_cwd):
        raise WorktreeFallbackError(
            "FALLBACK_SOURCE_DIRTY:explicit fallback cannot discard uncommitted source state"
        )

    source_dir = Path(source_cwd).expanduser().resolve()
    clone_dir = Path(fallback_path).expanduser().resolve()
    try:
        clone_dir.relative_to(source_dir)
    except ValueError:
        pass
    else:
        raise WorktreeFallbackError(
            "FALLBACK_CLONE_INSIDE_SOURCE:standalone target must be outside source worktree"
        )
    clone_path = str(clone_dir)

    if clone_dir.exists():
        # Must be a directory; non-directory is an ambiguous collision.
        if not clone_dir.is_dir():
            raise WorktreeFallbackError(f"FALLBACK_CLONE_PATH_COLLISION_NOT_DIR:{clone_path}")

        contents = list(clone_dir.iterdir())
        if not contents:
            # Empty directory: treat as new destination (will be populated below).
            clone_dir.rmdir()  # remove so git clone can create it
        else:
            # Non-empty: validate as existing clone.
            _validate_standalone_clone(
                clone_path=clone_path,
                expected_remote=source_remote,
                expected_sha=source_sha,
            )
            return clone_path

    # Create a fresh standalone clone from the local source checkout.  --no-local
    # forces independent object storage instead of hardlinks/shared worktree metadata.
    # The externally visible origin is restored to the source repository remote after
    # cloning, and checkout is pinned to the exact source SHA.
    clone_dir.parent.mkdir(parents=True, exist_ok=True)
    rc, _out = _run_git(
        "clone",
        "--no-local",
        source_cwd,
        clone_path,
        cwd=str(clone_dir.parent),
    )
    if rc != 0:
        raise WorktreeFallbackError(
            f"FALLBACK_CLONE_FAILED:git clone exited {rc} for {source_cwd!r}"
        )

    rc, _out = _run_git("remote", "set-url", "origin", source_remote, cwd=clone_path)
    if rc != 0:
        raise WorktreeFallbackError("FALLBACK_CLONE_REMOTE_SET_FAILED")

    # Checkout the exact base SHA (detached HEAD for isolation).
    rc, _out = _run_git("checkout", "--detach", source_sha, cwd=clone_path)
    if rc != 0:
        # Try without --detach (older git fallback).
        rc2, _out2 = _run_git("checkout", source_sha, cwd=clone_path)
        if rc2 != 0:
            raise WorktreeFallbackError(
                f"FALLBACK_CLONE_CHECKOUT_FAILED:cannot checkout {source_sha!r}"
            )

    # Final validation: confirm identity and cleanliness.
    _validate_standalone_clone(
        clone_path=clone_path,
        expected_remote=source_remote,
        expected_sha=source_sha,
    )
    return clone_path


def _resolve_cwd_for_dispatch(
    *,
    requested_cwd: str,
    fallback_clone_path: str | None,
) -> str:
    """Return the effective cwd for dispatch, applying fallback logic.

    - If *fallback_clone_path* is None and the requested cwd is a linked
      worktree, raise WorktreeFallbackError with WORKTREE_NO_FALLBACK_REQUESTED
      so the caller can surface a clear diagnostic.
    - If *fallback_clone_path* is provided, prepare/validate the standalone
      clone and return its path regardless of whether the source is a linked
      worktree (explicit opt-in).
    - If *fallback_clone_path* is None and the requested cwd is a normal
      standalone repo (or non-git directory), return *requested_cwd* unchanged.
    """
    if fallback_clone_path is not None:
        return _prepare_standalone_clone_fallback(
            source_cwd=requested_cwd,
            fallback_path=fallback_clone_path,
        )

    if _is_linked_worktree(requested_cwd):
        raise WorktreeFallbackError(
            "WORKTREE_NO_FALLBACK_REQUESTED:"
            "The requested --cwd is a linked Git worktree which is incompatible "
            "with the Agy watcher. Re-run with --fallback-clone <path> to provide "
            "an explicit standalone clone target."
        )

    return requested_cwd


def _resolve_hcom_agy_safe() -> Path:
    override = os.environ.get("NEXUS_HCOM_AGY_SAFE_BIN")
    if override:
        path = Path(override).expanduser().resolve()
        if path.is_file() and os.access(path, os.X_OK):
            return path
        raise RuntimeError("NEXUS_HCOM_AGY_SAFE_BIN_INVALID")
    bundled = Path(__file__).with_name("nexus-hcom-agy-safe")
    if bundled.is_file() and os.access(bundled, os.X_OK):
        return bundled
    resolved = shutil.which("hcom-agy-safe")
    if resolved:
        return Path(resolved).resolve()
    raise RuntimeError("HCOM_AGY_SAFE_NOT_FOUND")


FORBIDDEN_HCOM_COLLAB_FLAGS = {
    "--detach",
    "--daemon",
    "-d",
    "--background",
    "--headless",
    "--no-terminal",
}


def _parse_hcom_args(raw: str | None) -> list[str]:
    if raw is None or not raw.strip():
        return []
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ValueError("HCOM_ARGS_JSON_INVALID") from exc
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        raise ValueError("HCOM_ARGS_JSON_INVALID")
    for item in value:
        lowered = item.strip().lower()
        if lowered in FORBIDDEN_HCOM_COLLAB_FLAGS or lowered.startswith((
            "--detach=",
            "--daemon=",
            "--background=",
        )):
            raise ValueError(f"HCOM_COLLAB_FORBIDDEN_FLAG:{item}")
    return list(value)


def _decode_hcom_collab_status(
    line: str,
    *,
    account_alias_hash: str,
    lease_id_hash: str,
) -> dict[str, Any] | None:
    try:
        payload = json.loads(line)
    except (json.JSONDecodeError, TypeError):
        return None
    if not isinstance(payload, dict) or payload.get("schema") != "nexus.hcom_collab_status.v1":
        return None
    if (
        payload.get("account_alias_hash") != account_alias_hash
        or payload.get("lease_id_hash") != lease_id_hash
    ):
        return None
    event = payload.get("event")
    if event == "pre_provider_failed":
        return payload
    pid = payload.get("pid")
    if (
        event not in {"provider_started", "provider_terminal"}
        or not isinstance(pid, int)
        or pid <= 0
    ):
        return None
    if event == "provider_terminal" and not isinstance(payload.get("exit_code"), int):
        return None
    return payload


def dispatch_hcom_collab(
    *,
    cwd: str,
    hcom_args: list[str],
    model: str | None,
    pool_wait_timeout: float = 15.0,
    exclude_accounts: list[str] | None = None,
    coordinator: CrossProcessLeaseCoordinator | None = None,
    popen_factory: Any = subprocess.Popen,
    launcher_path: Path | None = None,
    operation_hook: Any = None,
) -> int:
    """Run one foreground hcom/Agy session under the canonical pool claim.

    Account selection and admission stay in nexus-agy-dispatch.  The launcher
    receives only the exact admitted account snapshot and an inherited
    per-account flock descriptor; it never chooses or rotates accounts itself.
    """
    for item in hcom_args:
        lowered = item.strip().lower()
        if lowered in FORBIDDEN_HCOM_COLLAB_FLAGS or lowered.startswith((
            "--detach=",
            "--daemon=",
            "--background=",
        )):
            raise ValueError(f"HCOM_COLLAB_FORBIDDEN_FLAG:{item}")

    if coordinator is None:
        if not MANAGER.is_file() or not MANAGER_ROOT.is_dir():
            raise RuntimeError("AGY_ACCOUNT_POOL_RUNTIME_MISSING")
        pool = AgyAccountPoolManager(
            manager_path=str(MANAGER),
            manager_root=str(MANAGER_ROOT),
            use_real_manager=True,
        )
        coordinator = CrossProcessLeaseCoordinator(
            manager=pool,
            allocator_lock_path=ALLOCATOR_LOCK_PATH,
            leases_dir=LEASES_DIR,
        )

    quota_snapshot, availability_state = _apply_dynamic_availability(model)
    model_family = str(availability_state["family"])
    scoped_model_family = model_family if model_family in {"gemini", "claude_gpt"} else None
    consumer_id = "hcom-" + uuid.uuid4().hex
    exclude_hashes = _resolve_excluded_account_hashes(
        exclude_accounts,
        manager=getattr(coordinator, "manager", None),
    )
    claim: AccountLeaseClaim | None = None
    child: Any = None
    status_read_fd: int | None = None
    status_write_fd: int | None = None
    status_stream: Any = None

    try:
        while True:
            try:
                claim = coordinator.acquire_claim(
                    consumer_id=consumer_id,
                    exclude_hashes=exclude_hashes,
                    wait_timeout=pool_wait_timeout,
                    model_family=scoped_model_family,
                )
            except AgyAccountPoolBusyError:
                emit_meta({
                    "status": "pool_busy",
                    "attempts": 0,
                    "rotations": len(exclude_hashes),
                    "failure_kind": "AGY_ACCOUNT_POOL_BUSY",
                    "wall_ms": 0,
                })
                return 75
            except AgyAccountPoolExhaustedError:
                emit_meta({
                    "status": "pool_exhausted",
                    "attempts": 0,
                    "rotations": len(exclude_hashes),
                    "failure_kind": "ACCOUNT_UNAVAILABLE",
                    "wall_ms": 0,
                })
                return 75
            if scoped_model_family is None:
                break
            quota_state, reset_ts, evidence_fresh = _account_family_quota_state(
                quota_snapshot,
                account_name=claim.internal_id,
                model_family=scoped_model_family,
            )
            if not evidence_fresh:
                quota_snapshot = _refresh_quota_snapshot_for_account(claim.internal_id)
                quota_state, reset_ts, evidence_fresh = _account_family_quota_state(
                    quota_snapshot,
                    account_name=claim.internal_id,
                    model_family=scoped_model_family,
                )
            if not (evidence_fresh and quota_state == "blocked"):
                break
            unavailable_until = (
                reset_ts
                if reset_ts is not None and reset_ts > time.time()
                else time.time() + DEFAULT_QUOTA_FAMILY_BLOCK_SECONDS
            )
            failed_hash = claim.account_alias_hash
            coordinator.retire_failed_claim(
                claim,
                AccountFailureKind.QUOTA_EXHAUSTED,
                model_family=scoped_model_family,
                unavailable_until=unavailable_until,
            )
            claim = None
            exclude_hashes.add(failed_hash)

        assert claim is not None
        _operation_hook(
            operation_hook,
            phase="ACCOUNT_LEASED",
            attempts=1,
            rotations=len(exclude_hashes),
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
        )
        profile_home = str(claim.lease.execution_env.get("HOME") or "").strip()
        if not profile_home:
            raise RuntimeError("LEASE_HOME_MISSING")
        profile = Path(profile_home).expanduser().resolve()
        accounts_root = (MANAGER_ROOT / "accounts").resolve()
        if profile != (accounts_root / claim.internal_id).resolve():
            raise RuntimeError("LEASE_PROFILE_IDENTITY_MISMATCH")

        lock_obj = claim.lock_file_obj
        if lock_obj is None:
            raise RuntimeError("LEASE_LOCK_MISSING")
        lease_fd = int(lock_obj.fileno())
        os.set_inheritable(lease_fd, True)

        launcher = (
            launcher_path.resolve() if launcher_path is not None else _resolve_hcom_agy_safe()
        )
        env = dict(os.environ)
        sensitive_keys = getattr(_agy_account_pool, "SENSITIVE_API_KEYS", None)
        if sensitive_keys is None:
            raise RuntimeError("SENSITIVE_API_KEYS_CONFIG_MISSING")
        for key in sensitive_keys:
            env.pop(key, None)
        status_read_fd, status_write_fd = os.pipe()
        os.set_inheritable(status_write_fd, True)
        env.update({
            "NEXUS_HCOM_AGY_LEASE_ACCOUNT": claim.internal_id,
            "NEXUS_HCOM_AGY_PROFILE_HOME": str(profile),
            "NEXUS_HCOM_AGY_LEASE_FD": str(lease_fd),
            "NEXUS_HCOM_AGY_LEASE_ID_HASH": claim.lease_id_hash,
            "NEXUS_HCOM_AGY_ACCOUNT_ALIAS_HASH": claim.account_alias_hash,
            "NEXUS_HCOM_AGY_STATUS_FD": str(status_write_fd),
        })
        child = popen_factory(
            [str(launcher), *hcom_args],
            cwd=cwd,
            env=env,
            pass_fds=(lease_fd, status_write_fd),
        )
        _operation_hook(
            operation_hook,
            phase="LAUNCHING",
            attempts=1,
            rotations=len(exclude_hashes),
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
        )
        os.close(status_write_fd)
        status_write_fd = None
        status_stream = os.fdopen(status_read_fd, "r", encoding="utf-8", errors="replace")
        status_read_fd = None

        first = _decode_hcom_collab_status(
            status_stream.readline(),
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
        )
        provider_started = first is not None and first.get("event") == "provider_started"
        pre_provider_failed = first is not None and first.get("event") == "pre_provider_failed"
        if provider_started:
            _operation_hook(
                operation_hook,
                phase="EXECUTING",
                attempts=1,
                rotations=len(exclude_hashes),
                account_alias_hash=claim.account_alias_hash,
                lease_id_hash=claim.lease_id_hash,
                provider_pid=int(first["pid"]),
            )

        code = int(child.wait())
        terminal = (
            _decode_hcom_collab_status(
                status_stream.readline(),
                account_alias_hash=claim.account_alias_hash,
                lease_id_hash=claim.lease_id_hash,
            )
            if provider_started
            else None
        )
        clean_terminal = (
            provider_started
            and terminal is not None
            and terminal.get("event") == "provider_terminal"
            and terminal.get("pid") == first.get("pid")
            and terminal.get("exit_code") == code
        )
        if clean_terminal or pre_provider_failed:
            claim.release()
            claim = None
            return code

        _operation_hook(
            operation_hook,
            phase="EXECUTING" if provider_started else "LAUNCHING",
            attempts=1,
            rotations=len(exclude_hashes),
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
            provider_pid=int(first["pid"]) if provider_started else None,
            failure_kind="HCOM_COLLAB_TERMINALITY_UNPROVEN",
        )
        claim.abandon_parent_reference()
        claim = None
        raise RuntimeError("HCOM_COLLAB_TERMINALITY_UNPROVEN")
    except BaseException:
        if claim is not None:
            if child is not None:
                claim.abandon_parent_reference()
            else:
                claim.release()
            claim = None
        raise
    finally:
        if status_stream is not None:
            status_stream.close()
        if status_read_fd is not None:
            try:
                os.close(status_read_fd)
            except OSError:
                pass
        if status_write_fd is not None:
            try:
                os.close(status_write_fd)
            except OSError:
                pass
        if claim is not None:
            claim.release()


def _run_foreground_hcom_operation(
    *,
    cwd: str,
    hcom_args: list[str],
    model: str | None,
    pool_wait_timeout: float,
    operation_root: Path,
    exclude_accounts: list[str] | None = None,
) -> int:
    resolved_exclude_hashes = sorted(_resolve_excluded_account_hashes(exclude_accounts))
    journal = AgyOperationJournal(operation_root)
    operation_id = new_operation_id()
    attempt_id = new_attempt_id()
    args_sha256 = hashlib.sha256(
        json.dumps(hcom_args, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    journal.create(
        operation_id=operation_id,
        attempt_id=attempt_id,
        cwd=cwd,
        provider="agy",
        model=model,
        effort=None,
        prompt_sha256=args_sha256,
        runtime_revision=_runtime_revision(),
        initial_fields={
            "mode": "hcom_collab",
            "hcom_args_sha256": args_sha256,
            "excluded_account_hashes": resolved_exclude_hashes,
        },
    )
    journal.mark_started(operation_id, pid=os.getpid())
    journal.update(operation_id, phase="STARTING")
    emit_meta({
        "status": "hcom_collab_started",
        "operation_id": operation_id,
        "attempt_id": attempt_id,
    })

    def on_event(event: dict[str, Any]) -> None:
        journal.heartbeat(
            operation_id,
            phase=str(event.get("phase") or "RUNNING"),
            attempts=int(event.get("attempts") or 0),
            rotations=int(event.get("rotations") or 0),
            account_alias_hash=event.get("account_alias_hash"),
            lease_id_hash=event.get("lease_id_hash"),
            failure_kind=event.get("failure_kind"),
        )
        if event.get("provider_pid"):
            journal.update(operation_id, provider_pid=int(event["provider_pid"]))

    try:
        code = dispatch_hcom_collab(
            cwd=cwd,
            hcom_args=hcom_args,
            model=model,
            pool_wait_timeout=pool_wait_timeout,
            exclude_accounts=resolved_exclude_hashes,
            operation_hook=on_event,
        )
    except BaseException as exc:
        record = journal.read(operation_id)
        if record.get("phase") != "TERMINAL":
            provider_effect_possible = str(record.get("phase") or "") in {
                "LAUNCHING",
                "EXECUTING",
            }
            journal.mark_terminal(
                operation_id,
                status="OUTCOME_UNKNOWN" if provider_effect_possible else "FAILED",
                exit_code=None,
                failure_kind=f"HCOM_COLLAB_PARENT_ABORT:{type(exc).__name__}",
                cwd=cwd,
                reconciliation={
                    "at": _agy_operation_journal.utc_now(),
                    "result": (
                        "HCOM_COLLAB_TERMINALITY_UNPROVEN"
                        if provider_effect_possible
                        else "HCOM_COLLAB_ABORT_BEFORE_PROVIDER"
                    ),
                    "retry_permitted": False,
                },
            )
        raise

    terminal_status = "COMPLETED" if code == 0 else "FAILED"
    journal.mark_terminal(
        operation_id,
        status=terminal_status,
        exit_code=code,
        failure_kind=None if code == 0 else "HCOM_COLLAB_EXIT_NONZERO",
        cwd=cwd,
        reconciliation=None,
    )
    return code


def dispatch_run(
    *,
    prompt: str,
    cwd: str,
    mode: str = "plan",
    model: str | None = None,
    effort: str | None = None,
    timeout: int = 900,
    max_calls: int = 3,
    pool_wait_timeout: float = 15.0,
    allow: list[str] | None = None,
    deny: list[str] | None = None,
    write_paths: list[str] | None = None,
    temp_command_permissions: bool = False,
    coordinator: CrossProcessLeaseCoordinator | None = None,
    run_agy_fn: Any = None,
    operation_hook: Any = None,
    admission: dict[str, Any] | None = None,
    provider_stall_seconds: float | None = None,
    stream_no_progress_seconds: float | None = None,
    pre_effect_max_seconds: float | None = None,
    pre_effect_max_tool_events: int | None = None,
    exclude_accounts: list[str] | None = None,
) -> int:
    user_allow = list(allow or [])
    try:
        effective_permissions, permission_profile_kind, permission_profile_sha256 = (
            build_effective_permission_profile(
                cwd=cwd,
                mode=mode,
                write_paths=write_paths,
                allow_rules=user_allow,
                deny_rules=deny,
                temp_command_permissions=temp_command_permissions,
            )
        )
    except ValueError as exc:
        failure_kind = str(exc)
        contract_failure = f"DISPATCH_CONTRACT_REJECTED:{failure_kind}"
        _operation_hook(
            operation_hook,
            phase="CONTRACT_REJECTED",
            attempts=0,
            rotations=0,
            failure_kind=contract_failure,
            provider_effect=False,
            permission_profile_kind="INVALID",
            permission_profile_sha256=None,
            effective_permissions=None,
        )
        emit_meta({
            "status": "invalid_contract",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": contract_failure,
            "provider_effect": False,
            "wall_ms": 0,
            "permission_profile_sha256": None,
            "permission_profile_kind": "INVALID",
        })
        return 64

    _operation_hook(
        operation_hook,
        permission_profile_sha256=permission_profile_sha256,
        permission_profile_kind=permission_profile_kind,
        effective_permissions=effective_permissions,
    )

    if effort is not None and effort not in ("low", "medium", "high"):
        effort_failure = f"DISPATCH_CONTRACT_REJECTED:INVALID_EFFORT:{effort}"
        _operation_hook(
            operation_hook,
            phase="CONTRACT_REJECTED",
            attempts=0,
            rotations=0,
            failure_kind=effort_failure,
            provider_effect=False,
        )
        emit_meta({
            "status": "invalid_contract",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": effort_failure,
            "provider_effect": False,
            "wall_ms": 0,
        })
        return 64

    if model is not None:
        stripped_model = model.strip()
        if not stripped_model:
            model_failure = "DISPATCH_MODEL_REJECTED:EMPTY_MODEL"
        elif not re.fullmatch(r"[a-zA-Z0-9_.:-]+", stripped_model):
            model_failure = f"DISPATCH_MODEL_REJECTED:INVALID_MODEL_SYNTAX:{model}"
        elif _model_family(stripped_model) == "unknown":
            model_failure = f"DISPATCH_MODEL_REJECTED:UNSUPPORTED_MODEL_FAMILY:{model}"
        elif (
            stripped_model in ("claude-opus-4-6", "claude-3-opus", "claude-opus")
            and effort is not None
        ):
            model_failure = (
                f"DISPATCH_MODEL_CONTRACT_REJECTED:UNSUPPORTED_EFFORT_FOR_MODEL:{model}:{effort}"
            )
        else:
            model_failure = None
        if model_failure:
            _operation_hook(
                operation_hook,
                phase="MODEL_REJECTED",
                attempts=0,
                rotations=0,
                failure_kind=model_failure,
                provider_effect=False,
            )
            emit_meta({
                "status": "invalid_model",
                "attempts": 0,
                "rotations": 0,
                "failure_kind": model_failure,
                "provider_effect": False,
                "wall_ms": 0,
            })
            return 64

    if admission is not None:
        decision = admission.get("overall_decision") or admission.get("decision")
        if decision != "ALLOW":
            reason = str(admission.get("reason") or decision or "DISPATCH_ADMISSION_REJECTED")
            admission_failure = f"DISPATCH_ADMISSION_REJECTED:{reason}"
            _operation_hook(
                operation_hook,
                phase="ADMISSION_REJECTED",
                attempts=0,
                rotations=0,
                failure_kind=admission_failure,
                provider_effect=False,
            )
            emit_meta({
                "status": "admission_rejected",
                "attempts": 0,
                "rotations": 0,
                "failure_kind": admission_failure,
                "provider_effect": False,
                "wall_ms": 0,
            })
            return 64

    if coordinator is None:
        if not MANAGER.is_file() or not MANAGER_ROOT.is_dir():
            raise SystemExit("AGY_ACCOUNT_POOL_RUNTIME_MISSING")

        pool = AgyAccountPoolManager(
            manager_path=str(MANAGER),
            manager_root=str(MANAGER_ROOT),
            use_real_manager=True,
        )
        coordinator = CrossProcessLeaseCoordinator(
            manager=pool,
            allocator_lock_path=ALLOCATOR_LOCK_PATH,
            leases_dir=LEASES_DIR,
        )

    runner = run_agy_fn if run_agy_fn is not None else run_agy
    quota_snapshot, availability_state = _apply_dynamic_availability(model)
    model_family = str(availability_state["family"])
    scoped_model_family = model_family if model_family in {"gemini", "claude_gpt"} else None

    usable_candidates = (
        list(availability_state.get("preferred", []))
        + list(availability_state.get("reserve", []))
        + list(availability_state.get("fallback", []))
    )
    blocked_candidates = list(availability_state.get("blocked", []))
    raw_unknown = availability_state.get("unknown")
    unknown_candidates = list(raw_unknown) if isinstance(raw_unknown, list) else []
    # Only a family whose every account is KNOWN blocked is exhausted. UNKNOWN
    # (stale/failed evidence) accounts proceed to claim and bounded per-account refresh.
    if (
        availability_state.get("snapshot_fresh")
        and len(usable_candidates) == 0
        and len(blocked_candidates) > 0
        and len(unknown_candidates) == 0
        and scoped_model_family is not None
    ):
        _operation_hook(
            operation_hook,
            phase="QUOTA_PREFLIGHT_EXHAUSTED",
            attempts=0,
            rotations=0,
            failure_kind="PROVIDER_QUOTA_EXHAUSTED_PRE_EFFECT",
            provider_effect=False,
            quota_preflight_progress={
                "phase": "PREFLIGHT_BLOCKED",
                "admission_state": "KNOWN_BLOCKED",
                "probe_state": "PROBE_OK",
                "quota_state": "blocked",
                "usable_count": 0,
                "blocked_count": len(blocked_candidates),
                "unknown_count": 0,
            },
            quota_preflight_decision=_quota_preflight_decision(
                account_alias_hash=None,
                model_family=scoped_model_family,
                quota_state="blocked",
                evidence_fresh=True,
                probe_state="CACHED_SUCCEEDED",
                dispatch_decision="BLOCK_KNOWN_QUOTA",
            ),
        )
        emit_meta({
            "status": "failed",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": "PROVIDER_QUOTA_EXHAUSTED_PRE_EFFECT",
            "provider_effect": False,
            "wall_ms": 0,
        })
        return 75

    consumer_id = "desktop-" + uuid.uuid4().hex
    try:
        exclude_hashes = _resolve_excluded_account_hashes(
            exclude_accounts,
            manager=getattr(coordinator, "manager", None),
        )
    except ValueError as exc:
        contract_failure = f"DISPATCH_CONTRACT_REJECTED:{exc}"
        _operation_hook(
            operation_hook,
            phase="CONTRACT_REJECTED",
            attempts=0,
            rotations=0,
            failure_kind=contract_failure,
            provider_effect=False,
        )
        emit_meta({
            "status": "invalid_contract",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": contract_failure,
            "provider_effect": False,
            "wall_ms": 0,
        })
        return 64

    claim: Optional[AccountLeaseClaim] = None
    try:
        claim = coordinator.acquire_claim(
            consumer_id=consumer_id,
            exclude_hashes=exclude_hashes,
            wait_timeout=pool_wait_timeout,
            model_family=scoped_model_family,
        )
    except (AgyAccountPoolBusyError, AgyAccountPoolExhaustedError) as claim_exc:
        busy = isinstance(claim_exc, AgyAccountPoolBusyError)
        claim_failure = "AGY_ACCOUNT_POOL_BUSY" if busy else "ACCOUNT_UNAVAILABLE"
        claim_event: dict[str, Any] = {
            "phase": "ACCOUNT_CLAIM_FAILED",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": claim_failure,
            "provider_effect": False,
        }
        if scoped_model_family is not None:
            claim_event["quota_preflight_progress"] = {
                "phase": "PREFLIGHT_BLOCKED",
                "admission_state": (
                    "UNKNOWN_NOT_CLAIMABLE" if unknown_candidates else "NOT_CLAIMABLE"
                ),
                "usable_count": len(usable_candidates),
                "blocked_count": len(blocked_candidates),
                "unknown_count": len(unknown_candidates),
            }
        _operation_hook(operation_hook, **claim_event)
        emit_meta({
            "status": "pool_busy" if busy else "pool_exhausted",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": claim_failure,
            "provider_effect": False,
            "wall_ms": 0,
        })
        return 75

    attempts = 0
    work_failures = 0
    work_budget = max(1, max_calls)
    rotations = 0
    max_failovers = _max_account_failovers()
    last_kind = None
    total_wall_ms = 0
    active_provider_pid: int | None = None
    active_provider_pgid: int | None = None

    def _inner_operation_hook(event: dict[str, Any] | None = None, **kwargs: Any) -> None:
        nonlocal active_provider_pid, active_provider_pgid
        merged = dict(event or {})
        merged.update(kwargs)
        if isinstance(merged.get("provider_pid"), int):
            active_provider_pid = merged["provider_pid"]
        if isinstance(merged.get("provider_pgid"), int):
            active_provider_pgid = merged["provider_pgid"]
        _operation_hook(operation_hook, **merged)

    _operation_hook(
        operation_hook,
        phase="ACCOUNT_LEASED",
        account_alias_hash=claim.account_alias_hash,
        lease_id_hash=claim.lease_id_hash,
        attempts=attempts,
        rotations=rotations,
    )

    try:
        while True:
            quota_probe = {
                "state": _selected_snapshot_probe_state(quota_snapshot, claim.internal_id)
            }
            if scoped_model_family is not None:
                quota_state, reset_ts, evidence_fresh = _account_family_quota_state(
                    quota_snapshot,
                    account_name=claim.internal_id,
                    model_family=scoped_model_family,
                )
                if not evidence_fresh:
                    quota_probe["state"] = "UNKNOWN"

                    def on_quota_progress(**event: Any) -> None:
                        progress = event.get("quota_preflight_progress")
                        if isinstance(progress, dict):
                            if progress.get("phase") == "ACCOUNT_RESULT":
                                quota_probe["state"] = (
                                    "SUCCEEDED" if progress.get("ok") is True else "FAILED"
                                )
                            elif progress.get("phase") == "TIMED_OUT":
                                quota_probe["state"] = "TIMED_OUT"
                            elif progress.get("phase") == "START_FAILED":
                                quota_probe["state"] = "START_FAILED"
                        _operation_hook(operation_hook, **event)

                    quota_snapshot = _refresh_quota_snapshot_for_account(
                        claim.internal_id,
                        on_phase_hook=on_quota_progress,
                        account_alias_hash=claim.account_alias_hash,
                    )
                    availability_state = _dynamic_availability_state(model, quota_snapshot)
                    _publish_dynamic_availability(availability_state)
                    quota_state, reset_ts, evidence_fresh = _account_family_quota_state(
                        quota_snapshot,
                        account_name=claim.internal_id,
                        model_family=scoped_model_family,
                    )
                if evidence_fresh and quota_state == "blocked":
                    _operation_hook(
                        operation_hook,
                        quota_preflight_decision=_quota_preflight_decision(
                            account_alias_hash=claim.account_alias_hash,
                            model_family=scoped_model_family,
                            quota_state=quota_state,
                            evidence_fresh=evidence_fresh,
                            probe_state=quota_probe["state"],
                            dispatch_decision=(
                                "BLOCK_KNOWN_QUOTA"
                                if rotations >= max_failovers
                                else "ROTATE_KNOWN_QUOTA"
                            ),
                        ),
                    )
                    unavailable_until = (
                        reset_ts
                        if reset_ts is not None and reset_ts > time.time()
                        else time.time() + DEFAULT_QUOTA_FAMILY_BLOCK_SECONDS
                    )
                    if rotations >= max_failovers:
                        coordinator.retire_failed_claim(
                            claim,
                            AccountFailureKind.QUOTA_EXHAUSTED,
                            model_family=scoped_model_family,
                            unavailable_until=unavailable_until,
                        )
                        emit_meta({
                            "status": "failed",
                            "attempts": attempts,
                            "rotations": rotations,
                            "failure_kind": "ACCOUNT_FAILOVER_LIMIT",
                            "account_alias_hash": claim.account_alias_hash,
                            "lease_id_hash": claim.lease_id_hash,
                            "parallel_slot": True,
                            "wall_ms": total_wall_ms,
                        })
                        return 75
                    try:
                        claim = coordinator.rotate_claim(
                            current_claim=claim,
                            failure_kind=AccountFailureKind.QUOTA_EXHAUSTED,
                            exclude_hashes=exclude_hashes,
                            wait_timeout=pool_wait_timeout,
                            model_family=scoped_model_family,
                            unavailable_until=unavailable_until,
                        )
                        rotations += 1
                        _operation_hook(
                            operation_hook,
                            phase="ACCOUNT_ROTATED",
                            attempts=attempts,
                            rotations=rotations,
                            failure_kind=AccountFailureKind.QUOTA_EXHAUSTED.value,
                            account_alias_hash=claim.account_alias_hash,
                            lease_id_hash=claim.lease_id_hash,
                            quota_preflight_progress={
                                "phase": "PREFLIGHT_BLOCKED",
                                "admission_state": "KNOWN_BLOCKED",
                                "probe_state": "PROBE_OK",
                                "quota_state": "blocked",
                                "account_alias_hash": claim.account_alias_hash,
                            },
                        )
                        continue
                    except AgyAccountPoolBusyError:
                        emit_meta({
                            "status": "pool_busy",
                            "attempts": attempts,
                            "rotations": rotations,
                            "failure_kind": "AGY_ACCOUNT_POOL_BUSY",
                            "wall_ms": total_wall_ms,
                            "permission_profile_sha256": permission_profile_sha256,
                            "permission_profile_kind": permission_profile_kind,
                        })
                        return 75
                    except AgyAccountPoolExhaustedError:
                        emit_meta({
                            "status": "pool_exhausted",
                            "attempts": attempts,
                            "rotations": rotations,
                            "failure_kind": "QUOTA_EXHAUSTED",
                            "wall_ms": total_wall_ms,
                            "permission_profile_sha256": permission_profile_sha256,
                            "permission_profile_kind": permission_profile_kind,
                        })
                        return 75

            if scoped_model_family is not None:
                admission_state = (
                    "KNOWN_ELIGIBLE"
                    if evidence_fresh and quota_state in ("five_hour", "weekly")
                    else "UNVERIFIED_POLICY_ALLOWED"
                )
                probe_state = (
                    "PROBE_OK"
                    if evidence_fresh
                    else ("PROBE_STALE" if quota_state == "stale" else "PROBE_UNKNOWN_OR_FAILED")
                )
                _operation_hook(
                    operation_hook,
                    quota_preflight_progress={
                        "phase": "PREFLIGHT_ADMITTED",
                        "admission_state": admission_state,
                        "probe_state": probe_state,
                        "quota_state": quota_state,
                        "account_alias_hash": claim.account_alias_hash,
                    },
                )
                _operation_hook(
                    operation_hook,
                    quota_preflight_decision=_quota_preflight_decision(
                        account_alias_hash=claim.account_alias_hash,
                        model_family=scoped_model_family,
                        quota_state=quota_state,
                        evidence_fresh=evidence_fresh,
                        probe_state=quota_probe["state"],
                        dispatch_decision=(
                            "ALLOW_KNOWN_ELIGIBLE"
                            if evidence_fresh and quota_state in {"five_hour", "weekly"}
                            else "ALLOW_UNKNOWN_QUOTA"
                        ),
                    ),
                )
            else:
                _operation_hook(
                    operation_hook,
                    quota_preflight_decision=_quota_preflight_decision(
                        account_alias_hash=claim.account_alias_hash,
                        model_family=model_family,
                        quota_state="not_applicable",
                        evidence_fresh=False,
                        probe_state="NOT_RUN",
                        dispatch_decision="ALLOW_NO_QUOTA_FAMILY",
                    ),
                )

            attempts += 1
            _operation_hook(
                operation_hook,
                phase="EXECUTING",
                attempts=attempts,
                rotations=rotations,
                failure_kind=None,
                account_alias_hash=claim.account_alias_hash,
                lease_id_hash=claim.lease_id_hash,
            )
            env = dict(claim.lease.execution_env)
            attempt_baseline = None
            try:
                attempt_baseline = direct_operation_journal.capture_source_baseline(cwd)
                if attempt_baseline is None:
                    raise RuntimeError("SOURCE_BASELINE_UNAVAILABLE")
            except Exception as exc:
                _operation_hook(
                    operation_hook,
                    effect_observation_error=f"ATTEMPT_BASELINE_CAPTURE_FAILED:{type(exc).__name__}",
                )
            provider_log_path = env.get("NEXUS_AGY_ATTESTATION_LOG") or os.getenv(
                "NEXUS_AGY_ATTESTATION_LOG"
            )
            # None means this attempt's log span is unknown; never scan stale bytes.
            provider_log_attempt_offset: int | None = 0
            if provider_log_path:
                try:
                    provider_log_attempt_offset = (
                        Path(provider_log_path).expanduser().stat().st_size
                    )
                except FileNotFoundError:
                    provider_log_attempt_offset = 0
                except OSError:
                    provider_log_attempt_offset = None
            permission_token = None
            try:
                allow_rules = list(effective_permissions.get("allow") or [])
                deny_rules = list(effective_permissions.get("deny") or [])
                replace_allow_deny = bool(
                    mode == "accept-edits" or allow_rules or deny_rules or temp_command_permissions
                )
                allow_unsafe_legacy = bool(temp_command_permissions or "command(*)" in allow_rules)
                if allow_rules or deny_rules or replace_allow_deny:
                    permission_token = install_temp_permissions(
                        env,
                        allow_rules=allow_rules,
                        deny_rules=deny_rules,
                        allow_unsafe_legacy=allow_unsafe_legacy,
                        replace_allow_deny=replace_allow_deny,
                        mode=mode,
                        expected_profile_sha256=permission_profile_sha256,
                    )
                runner_kwargs = {
                    "env": env,
                    "prompt": prompt,
                    "cwd": cwd,
                    "mode": mode,
                    "model": model,
                    "effort": effort,
                    "timeout": max(1, timeout),
                }
                if runner is run_agy or (
                    hasattr(runner, "__code__") and "operation_hook" in runner.__code__.co_varnames
                ):
                    runner_kwargs["operation_hook"] = _inner_operation_hook
                if runner is run_agy or (
                    hasattr(runner, "__code__")
                    and "expect_coding_progress" in runner.__code__.co_varnames
                ):
                    runner_kwargs["expect_coding_progress"] = bool(
                        mode == "accept-edits" and write_paths
                    )
                if runner is run_agy or (
                    hasattr(runner, "__code__")
                    and "provider_stall_seconds" in runner.__code__.co_varnames
                ):
                    runner_kwargs["provider_stall_seconds"] = provider_stall_seconds
                if runner is run_agy or (
                    hasattr(runner, "__code__")
                    and "stream_no_progress_seconds" in runner.__code__.co_varnames
                ):
                    runner_kwargs["stream_no_progress_seconds"] = stream_no_progress_seconds
                if runner is run_agy or (
                    hasattr(runner, "__code__")
                    and "pre_effect_max_seconds" in runner.__code__.co_varnames
                ):
                    runner_kwargs["pre_effect_max_seconds"] = pre_effect_max_seconds
                if runner is run_agy or (
                    hasattr(runner, "__code__")
                    and "pre_effect_max_tool_events" in runner.__code__.co_varnames
                ):
                    runner_kwargs["pre_effect_max_tool_events"] = pre_effect_max_tool_events
                code, out, err, timed_out, wall_ms = runner(**runner_kwargs)
            finally:
                restore_temp_permissions(permission_token)
            total_wall_ms += wall_ms

            provider_log_text = ""
            attempt_log_text = ""
            if provider_log_path:
                try:
                    provider_log_bytes = Path(provider_log_path).expanduser().read_bytes()
                except OSError:
                    provider_log_bytes = b""
                provider_log_text = provider_log_bytes.decode("utf-8", errors="replace")
                if provider_log_attempt_offset is not None:
                    # A log shorter than the pre-attempt offset was truncated or
                    # replaced during this attempt, so all of it is current.
                    if len(provider_log_bytes) >= provider_log_attempt_offset:
                        provider_log_bytes = provider_log_bytes[provider_log_attempt_offset:]
                    attempt_log_text = provider_log_bytes.decode("utf-8", errors="replace")
            # Issue #1362: agy may exit 0 after a terminal executor quota failure.
            provider_terminal_quota = (
                code == 0 and not timed_out and _has_terminal_quota_log_signal(attempt_log_text)
            )
            provider_log_lower = provider_log_text.lower()
            provider_headless_denial = (
                "print mode: soft-denying tool confirmation" in provider_log_lower
                or "soft-denying tool confirmation" in provider_log_lower
                or "headless mode cannot prompt for" in provider_log_lower
                or "auto-denied" in provider_log_lower
            )
            provider_permission_denial = mode == "accept-edits" and _has_permission_failure_signal(
                provider_log_text
            )
            semantic_output = out + "\n" + err
            semantic_output_lower = semantic_output.lower()
            semantic_permission_refusal = mode == "accept-edits" and _has_permission_failure_signal(
                semantic_output
            )
            semantic_headless_denial = mode == "accept-edits" and (
                "headless mode cannot prompt for" in semantic_output_lower
                or "soft-denying tool confirmation" in semantic_output_lower
                or "auto-denied" in semantic_output_lower
            )
            permission_blocked = (
                provider_headless_denial
                or provider_permission_denial
                or semantic_headless_denial
                or semantic_permission_refusal
            )
            attempt_changed_paths = None
            if attempt_baseline is not None:
                try:
                    attempt_changed_paths = direct_operation_journal.observed_changed_paths_since(
                        cwd, attempt_baseline
                    )
                except Exception as exc:
                    _operation_hook(
                        operation_hook,
                        effect_observation_error=(
                            f"ATTEMPT_EFFECT_OBSERVATION_FAILED:{type(exc).__name__}"
                        ),
                    )

            scope_state, scope_violations = direct_operation_journal.validate_write_scope(
                repo_root=cwd,
                write_paths=write_paths,
                observed_changed_paths=attempt_changed_paths,
            )
            scope_blocked = bool(write_paths and scope_state == "VIOLATION_OUT_OF_SCOPE")

            if (
                code == 0
                and not timed_out
                and not permission_blocked
                and not scope_blocked
                and not provider_terminal_quota
            ):
                sys.stdout.write(out)
                if err:
                    sys.stderr.write(err)
                emit_meta({
                    "status": "completed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return 0

            kind = (
                AccountFailureKind.PERMISSION_OR_SCOPE_ERROR
                if (permission_blocked or scope_blocked)
                else AccountFailureKind.QUOTA_EXHAUSTED
                if provider_terminal_quota
                else classify_failure(code, out, err, timed_out)
            )
            last_kind = kind.value
            provider_effect_observed: bool | None = False
            reconciliation_required = False

            if permission_blocked and (provider_headless_denial or semantic_headless_denial):
                last_kind = "HEADLESS_TOOL_PERMISSION_DENIED"
                if attempt_changed_paths:
                    provider_effect_observed = True
                    reconciliation_required = True
                elif attempt_changed_paths == []:
                    provider_effect_observed = False
                else:
                    provider_effect_observed = None
                    reconciliation_required = True
            elif scope_blocked:
                last_kind = "SCOPE_VIOLATION_UNAUTHORIZED_MUTATION"
                provider_effect_observed = True
                reconciliation_required = True
            elif permission_blocked:
                if attempt_changed_paths:
                    provider_effect_observed = True
                    reconciliation_required = True
                elif attempt_changed_paths == []:
                    provider_effect_observed = False
                else:
                    provider_effect_observed = None
                    reconciliation_required = True
            elif kind == AccountFailureKind.MODEL_OR_TASK_ERROR:
                last_kind = "DISPATCH_MODEL_CONTRACT_REJECTED"
                if attempt_changed_paths:
                    provider_effect_observed = True
                    reconciliation_required = True
            elif kind == AccountFailureKind.QUOTA_EXHAUSTED:
                if attempt_changed_paths:
                    last_kind = "PROVIDER_QUOTA_EXHAUSTED_AFTER_EFFECT"
                    provider_effect_observed = True
                    reconciliation_required = True
                elif attempt_changed_paths == []:
                    last_kind = "PROVIDER_QUOTA_EXHAUSTED_PRE_EFFECT"
                    provider_effect_observed = False
                else:
                    last_kind = "PROVIDER_QUOTA_EXHAUSTED_UNKNOWN_EFFECT"
                    provider_effect_observed = None
                    reconciliation_required = True
            elif attempt_changed_paths:
                provider_effect_observed = True
                reconciliation_required = True
            _operation_hook(
                operation_hook,
                phase="CLASSIFYING_FAILURE",
                attempts=attempts,
                rotations=rotations,
                failure_kind=last_kind,
                timed_out=bool(timed_out),
                account_alias_hash=claim.account_alias_hash,
                lease_id_hash=claim.lease_id_hash,
                provider_effect=provider_effect_observed,
                reconciliation_required=reconciliation_required,
            )

            if reconciliation_required:
                if out:
                    sys.stdout.write(out)
                if err:
                    sys.stderr.write(err)
                emit_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    "provider_effect": provider_effect_observed,
                    "reconciliation_required": True,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return code if isinstance(code, int) and code != 0 else 1

            if not is_agy_rotation_eligible(kind):
                if out:
                    sys.stdout.write(out)
                if err:
                    sys.stderr.write(err)
                emit_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    "provider_effect": False,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return code if isinstance(code, int) and code != 0 else 1

            family_unavailable_until = None
            if kind == AccountFailureKind.QUOTA_EXHAUSTED and scoped_model_family is not None:
                family_unavailable_until = _family_failure_unavailable_until(
                    snapshot=quota_snapshot,
                    account_name=claim.internal_id,
                    model_family=scoped_model_family,
                    failure_kind=kind,
                )

            if not is_account_failover_failure(kind):
                work_failures += 1

            if not is_account_failover_failure(kind) and work_failures >= work_budget:
                # Real work failure budget is independent from account-selection
                # failover. Retire the current failed scope without acquiring
                # another account when the model-work budget is exhausted.
                try:
                    coordinator.retire_failed_claim(
                        claim,
                        kind,
                        model_family=scoped_model_family,
                        unavailable_until=family_unavailable_until,
                    )
                except Exception:
                    pass
                if out:
                    sys.stdout.write(out)
                if err:
                    sys.stderr.write(err)
                emit_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "work_failures": work_failures,
                    "work_budget": work_budget,
                    "failure_kind": last_kind,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return code if isinstance(code, int) and code != 0 else 1

            if rotations >= max_failovers:
                try:
                    coordinator.retire_failed_claim(
                        claim,
                        kind,
                        model_family=scoped_model_family,
                        unavailable_until=family_unavailable_until,
                    )
                except Exception:
                    pass
                emit_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "work_failures": work_failures,
                    "work_budget": work_budget,
                    "failure_kind": "ACCOUNT_FAILOVER_LIMIT",
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return 75

            # Rotation eligible: rotate claim
            try:
                claim = coordinator.rotate_claim(
                    current_claim=claim,
                    failure_kind=kind,
                    exclude_hashes=exclude_hashes,
                    wait_timeout=pool_wait_timeout,
                    model_family=scoped_model_family,
                    unavailable_until=family_unavailable_until,
                )
                rotations += 1
                _operation_hook(
                    operation_hook,
                    phase="ACCOUNT_ROTATED",
                    attempts=attempts,
                    rotations=rotations,
                    failure_kind=last_kind,
                    account_alias_hash=claim.account_alias_hash,
                    lease_id_hash=claim.lease_id_hash,
                )
            except AgyAccountPoolBusyError:
                emit_meta({
                    "status": "pool_busy",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": "AGY_ACCOUNT_POOL_BUSY",
                    "wall_ms": total_wall_ms,
                })
                return 75
            except AgyAccountPoolExhaustedError:
                emit_meta({
                    "status": "pool_exhausted",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    "wall_ms": total_wall_ms,
                })
                return 75
            except Exception:
                emit_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    "wall_ms": total_wall_ms,
                })
                return 75
    finally:
        # Numeric PID/PGID observations can retain the lease, but they do not
        # authorize signalling after the owning Popen frame has returned.
        provider_still_running = (
            active_provider_pid is not None
            and _agy_operation_journal._process_alive(active_provider_pid)
        ) or (
            active_provider_pgid is not None
            and _agy_operation_journal._process_group_alive(active_provider_pgid)
        )
        if claim is not None and not provider_still_running:
            try:
                claim.release()
            except Exception:
                pass

    emit_meta({"status": "failed", "failure_kind": last_kind or "UNKNOWN"})
    return 1


def _write_private_prompt(path: Path, prompt: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(prompt)
        fh.flush()
        os.fsync(fh.fileno())


def _normalize_evidence_refs(values: list[str] | None) -> list[str]:
    refs = [str(value).strip() for value in (values or [])]
    if len(refs) > 16:
        raise ValueError("EVIDENCE_REF_LIMIT_EXCEEDED")
    for ref in refs:
        if not ref or len(ref) > 512 or any(ord(char) < 0x20 for char in ref):
            raise ValueError("EVIDENCE_REF_INVALID")
    return refs


def _spawn_background_operation(
    *,
    prompt: str,
    cwd: str,
    mode: str,
    model: str | None,
    effort: str | None,
    timeout: int,
    max_calls: int,
    pool_wait_timeout: float,
    allow: list[str],
    deny: list[str],
    temp_command_permissions: bool,
    operation_root: Path,
    write_paths: list[str] | None = None,
    provider_stall_seconds: float | None = None,
    stream_no_progress_seconds: float | None = None,
    pre_effect_max_seconds: float | None = None,
    pre_effect_max_tool_events: int | None = None,
    exclude_accounts: list[str] | None = None,
    evidence_refs: list[str] | None = None,
) -> dict[str, Any]:
    resolved_exclude_hashes = sorted(_resolve_excluded_account_hashes(exclude_accounts))
    resolved_evidence_refs = _normalize_evidence_refs(evidence_refs)
    journal = AgyOperationJournal(operation_root)
    operation_id = new_operation_id()
    attempt_id = new_attempt_id()
    coding_progress_required = bool(mode == "accept-edits" and write_paths)
    resolved_provider_stall_seconds = (
        _provider_stall_seconds()
        if provider_stall_seconds is None
        else max(0.1, float(provider_stall_seconds))
    )
    resolved_stream_no_progress_seconds = (
        _stream_no_progress_seconds()
        if stream_no_progress_seconds is None
        else max(0.1, float(stream_no_progress_seconds))
    )
    resolved_pre_effect_max_seconds = (
        _pre_effect_max_seconds()
        if pre_effect_max_seconds is None
        else max(0.1, float(pre_effect_max_seconds))
    )
    resolved_pre_effect_max_tool_events = (
        _pre_effect_max_tool_events()
        if pre_effect_max_tool_events is None
        else max(1, int(pre_effect_max_tool_events))
    )
    journal.create(
        operation_id=operation_id,
        attempt_id=attempt_id,
        cwd=cwd,
        provider="agy",
        model=model,
        effort=effort,
        prompt_sha256=hashlib.sha256(prompt.encode("utf-8")).hexdigest(),
        runtime_revision=_runtime_revision(),
        initial_fields={
            "excluded_account_hashes": resolved_exclude_hashes,
            "evidence_refs": resolved_evidence_refs,
            "liveness_policy": {
                "coding_progress_required": coding_progress_required,
                "provider_stall_seconds": resolved_provider_stall_seconds,
                "stream_no_progress_seconds": resolved_stream_no_progress_seconds,
                "pre_effect_max_seconds": resolved_pre_effect_max_seconds,
                "pre_effect_max_tool_events": resolved_pre_effect_max_tool_events,
            }
        },
    )
    prompt_path = journal.prompt_path(operation_id)
    _write_private_prompt(prompt_path, prompt)
    if write_paths:
        journal.update(operation_id, write_paths=list(write_paths))

    argv = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--operation-run",
        operation_id,
        "--operation-root",
        str(operation_root),
        "--prompt-file",
        str(prompt_path),
        "--cwd",
        cwd,
        "--mode",
        mode,
        "--timeout",
        str(timeout),
        "--max-calls",
        str(max_calls),
        "--pool-wait-timeout",
        str(pool_wait_timeout),
        "--provider-stall-seconds",
        str(resolved_provider_stall_seconds),
        "--stream-no-progress-seconds",
        str(resolved_stream_no_progress_seconds),
        "--pre-effect-max-seconds",
        str(resolved_pre_effect_max_seconds),
        "--pre-effect-max-tool-events",
        str(resolved_pre_effect_max_tool_events),
    ]
    if model:
        argv += ["--model", model]
    if effort:
        argv += ["--effort", effort]
    if temp_command_permissions:
        argv.append("--temp-command-permissions")
    for rule in allow:
        argv += ["--allow", rule]
    for rule in deny:
        argv += ["--deny", rule]
    for write_path in write_paths or []:
        argv += ["--write-path", write_path]
    for account_hash in resolved_exclude_hashes:
        argv += ["--exclude-account", account_hash]

    stdout_path = journal.stdout_path(operation_id)
    stderr_path = journal.stderr_path(operation_id)
    stdout_path.parent.mkdir(parents=True, exist_ok=True)
    with (
        stdout_path.open("ab", buffering=0) as out_fh,
        stderr_path.open("ab", buffering=0) as err_fh,
    ):
        proc = subprocess.Popen(
            argv,
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=out_fh,
            stderr=err_fh,
            start_new_session=True,
            close_fds=True,
        )
    return journal.bind_pid(operation_id, proc.pid)


def _supervisor_terminal_guard(func):
    """Cover background-supervisor startup and provider execution with durable terminalization."""

    @functools.wraps(func)
    def guarded(*args, **kwargs):
        operation_id = str(kwargs["operation_id"])
        operation_root = Path(kwargs["operation_root"])
        cwd = str(kwargs["cwd"])
        model = kwargs.get("model")
        journal = AgyOperationJournal(operation_root)
        attestation_log_path = journal.operation_dir(operation_id) / "agy.log"
        prior_sigterm = signal.getsignal(signal.SIGTERM)
        prior_sigint = signal.getsignal(signal.SIGINT)

        def _signal_handler(signum: int, _frame: Any) -> None:
            raise _SupervisorSignalError(signum)

        def _terminalize_if_needed(
            *,
            unknown_failure_kind: str,
            known_failure_kind: str,
            unknown_result: str,
            known_result: str,
            unresolved_running_result: str,
            unresolved_unverified_result: str,
        ) -> None:
            record = journal.read(operation_id)
            phase = str(record.get("phase") or "QUEUED")
            if phase == "TERMINAL":
                return
            provider_effect_possible = phase not in {
                "QUEUED",
                "STARTING",
                "ACCOUNT_LEASED",
            }
            attestation = _parse_agy_attestation(
                attestation_log_path,
                requested_model=model,
            )
            had_before, alive_after, unverified = _agy_operation_journal._stop_operation_processes(
                operation_id,
                journal.operation_dir(operation_id),
                pid=record.get("pid"),
                provider_pid=record.get("provider_pid"),
                provider_pgid=record.get("provider_pgid"),
                supervisor_pid=os.getpid(),
                grace_seconds=2.0,
            )
            had_before = had_before or bool(record.get("provider_pid")) or provider_effect_possible
            provider_state = (
                "RUNNING"
                if alive_after
                else (
                    "EXITED"
                    if record.get("provider_pid")
                    else record.get("provider_process_state", "IDLE")
                )
            )
            telemetry = {
                "provider_pid": record.get("provider_pid"),
                "provider_pgid": record.get("provider_pgid"),
                "provider_process_state": provider_state,
                "provider_started_at": record.get("provider_started_at"),
                "provider_stream_last_activity_at": record.get("provider_stream_last_activity_at"),
                "first_stream_activity_at": record.get("first_stream_activity_at"),
                "first_tool_activity_at": record.get("first_tool_activity_at"),
                "last_progress_activity_at": record.get("last_progress_activity_at"),
                "first_effect_at": record.get("first_effect_at"),
                "time_to_first_effect_ms": record.get("time_to_first_effect_ms"),
                "tool_event_count": int(record.get("tool_event_count") or 0),
            }

            if alive_after:
                journal.update(
                    operation_id,
                    status="RUNNING",
                    phase="RECONCILE_REQUIRED",
                    failure_kind=unknown_failure_kind,
                    reconciliation={
                        "at": _agy_operation_journal.utc_now(),
                        "result": (
                            unresolved_unverified_result
                            if unverified
                            else unresolved_running_result
                        ),
                        "provider_alive_before": had_before,
                        "provider_alive_after": True,
                        "retry_permitted": False,
                    },
                    **telemetry,
                    **attestation,
                )
            else:
                journal.mark_terminal(
                    operation_id,
                    status="OUTCOME_UNKNOWN" if provider_effect_possible else "FAILED",
                    exit_code=record.get("exit_code"),
                    failure_kind=(
                        unknown_failure_kind if provider_effect_possible else known_failure_kind
                    ),
                    cwd=cwd,
                    reconciliation={
                        "at": _agy_operation_journal.utc_now(),
                        "result": unknown_result if provider_effect_possible else known_result,
                        "provider_alive_before": had_before,
                        "provider_alive_after": False,
                        "retry_permitted": False,
                    },
                    **telemetry,
                    **attestation,
                )

        try:
            signal.signal(signal.SIGTERM, _signal_handler)
            signal.signal(signal.SIGINT, _signal_handler)
            return func(*args, **kwargs)
        except _SupervisorSignalError as sig_exc:
            sig_name = signal.Signals(sig_exc.signum).name
            _terminalize_if_needed(
                unknown_failure_kind=f"SUPERVISOR_SIGNAL:{sig_name}",
                known_failure_kind=f"SUPERVISOR_SIGNAL_PRE_PROVIDER:{sig_name}",
                unknown_result="SUPERVISOR_SIGNAL_WITH_UNKNOWN_PROVIDER_EFFECT",
                known_result="SUPERVISOR_SIGNAL_BEFORE_PROVIDER",
                unresolved_running_result="SUPERVISOR_SIGNAL_ORPHAN_PROVIDER_STILL_RUNNING",
                unresolved_unverified_result="SUPERVISOR_SIGNAL_ORPHAN_PROVIDER_UNVERIFIED",
            )
            raise
        except BaseException as exc:
            _terminalize_if_needed(
                unknown_failure_kind=f"WRAPPER_EXCEPTION:{type(exc).__name__}",
                known_failure_kind=f"WRAPPER_EXCEPTION_PRE_PROVIDER:{type(exc).__name__}",
                unknown_result="WRAPPER_EXCEPTION_WITH_UNKNOWN_PROVIDER_EFFECT",
                known_result="WRAPPER_EXCEPTION_BEFORE_PROVIDER",
                unresolved_running_result="WRAPPER_EXCEPTION_ORPHAN_PROVIDER_STILL_RUNNING",
                unresolved_unverified_result="WRAPPER_EXCEPTION_ORPHAN_PROVIDER_UNVERIFIED",
            )
            raise
        finally:
            signal.signal(signal.SIGTERM, prior_sigterm)
            signal.signal(signal.SIGINT, prior_sigint)

    return guarded


@_supervisor_terminal_guard
def _run_background_operation(
    *,
    operation_id: str,
    prompt_file: str,
    cwd: str,
    mode: str,
    model: str | None,
    effort: str | None,
    timeout: int,
    max_calls: int,
    pool_wait_timeout: float,
    allow: list[str],
    deny: list[str],
    temp_command_permissions: bool,
    operation_root: Path,
    write_paths: list[str] | None = None,
    heartbeat_interval: float = 15.0,
    provider_stall_seconds: float | None = None,
    stream_no_progress_seconds: float | None = None,
    pre_effect_max_seconds: float | None = None,
    pre_effect_max_tool_events: int | None = None,
    exclude_accounts: list[str] | None = None,
) -> int:
    journal = AgyOperationJournal(operation_root)
    prompt_path = Path(prompt_file)
    try:
        prompt = prompt_path.read_text(encoding="utf-8")
    finally:
        try:
            prompt_path.unlink()
        except FileNotFoundError:
            pass

    current_runtime_revision = _runtime_revision()
    journal.update(operation_id, runtime_revision=current_runtime_revision)
    journal.mark_started(operation_id, pid=os.getpid())
    stop = threading.Event()
    state: dict[str, Any] = {
        "phase": "STARTING",
        "attempts": 0,
        "rotations": 0,
        "account_alias_hash": None,
        "lease_id_hash": None,
        "failure_kind": None,
        "failure_history": [],
        "timed_out": False,
        "provider_pid": None,
        "provider_pgid": None,
        "provider_process_state": "IDLE",
        "provider_started_at": None,
        "provider_stream_last_activity_at": None,
        "first_stream_activity_at": None,
        "first_tool_activity_at": None,
        "last_progress_activity_at": None,
        "first_effect_at": None,
        "time_to_first_effect_ms": None,
        "tool_event_count": 0,
        "provider_session_id": None,
        "quota_preflight_progress": None,
        "quota_preflight_decision": None,
        "permission_profile_sha256": None,
        "permission_profile_kind": None,
        "effective_permissions": None,
    }
    state_lock = threading.Lock()

    def _heartbeat_snapshot(snapshot: dict[str, Any]) -> None:
        journal.heartbeat(
            operation_id,
            phase=str(snapshot.get("phase") or "RUNNING"),
            attempts=int(snapshot.get("attempts") or 0),
            rotations=int(snapshot.get("rotations") or 0),
            account_alias_hash=snapshot.get("account_alias_hash"),
            lease_id_hash=snapshot.get("lease_id_hash"),
            failure_kind=snapshot.get("failure_kind"),
            failure_history=list(snapshot.get("failure_history") or []),
            provider_pid=snapshot.get("provider_pid"),
            provider_pgid=snapshot.get("provider_pgid"),
            provider_process_state=snapshot.get("provider_process_state") or "IDLE",
            provider_started_at=snapshot.get("provider_started_at"),
            provider_stream_last_activity_at=snapshot.get("provider_stream_last_activity_at"),
            first_stream_activity_at=snapshot.get("first_stream_activity_at"),
            first_tool_activity_at=snapshot.get("first_tool_activity_at"),
            last_progress_activity_at=snapshot.get("last_progress_activity_at"),
            first_effect_at=snapshot.get("first_effect_at"),
            time_to_first_effect_ms=snapshot.get("time_to_first_effect_ms"),
            tool_event_count=int(snapshot.get("tool_event_count") or 0),
            provider_session_id=snapshot.get("provider_session_id"),
            quota_preflight_progress=snapshot.get("quota_preflight_progress"),
            quota_preflight_decision=snapshot.get("quota_preflight_decision"),
            permission_profile_sha256=snapshot.get("permission_profile_sha256"),
            permission_profile_kind=snapshot.get("permission_profile_kind"),
            effective_permissions=snapshot.get("effective_permissions"),
        )

    def on_event(event: dict[str, Any]) -> None:
        with state_lock:
            state.update(event)
            failure_kind = event.get("failure_kind")
            if (
                event.get("phase") == "CLASSIFYING_FAILURE"
                and isinstance(failure_kind, str)
                and failure_kind
            ):
                history = list(state.get("failure_history") or [])
                history.append({
                    "at": _agy_operation_journal.utc_now(),
                    "attempts": int(state.get("attempts") or 0),
                    "rotations": int(state.get("rotations") or 0),
                    "failure_kind": failure_kind,
                    "account_alias_hash": state.get("account_alias_hash"),
                    "lease_id_hash": state.get("lease_id_hash"),
                })
                state["failure_history"] = history[-MAX_FAILURE_HISTORY_ENTRIES:]
            snapshot = dict(state)
        _heartbeat_snapshot(snapshot)

    def heartbeat_loop() -> None:
        while not stop.wait(max(1.0, heartbeat_interval)):
            with state_lock:
                snapshot = dict(state)
            try:
                _heartbeat_snapshot(snapshot)
            except Exception:
                pass

    heartbeat_thread = threading.Thread(
        target=heartbeat_loop,
        name=f"agy-heartbeat-{operation_id}",
        daemon=True,
    )
    heartbeat_thread.start()

    exit_code: int | None = None
    attestation_log_path = journal.operation_dir(operation_id) / "agy.log"
    prior_attestation_log = os.environ.get("NEXUS_AGY_ATTESTATION_LOG")
    os.environ["NEXUS_AGY_ATTESTATION_LOG"] = str(attestation_log_path)
    try:
        exit_code = dispatch_run(
            prompt=prompt,
            cwd=cwd,
            mode=mode,
            model=model,
            effort=effort,
            timeout=timeout,
            max_calls=max_calls,
            pool_wait_timeout=pool_wait_timeout,
            allow=allow,
            deny=deny,
            write_paths=write_paths,
            temp_command_permissions=temp_command_permissions,
            operation_hook=on_event,
            provider_stall_seconds=provider_stall_seconds,
            stream_no_progress_seconds=stream_no_progress_seconds,
            pre_effect_max_seconds=pre_effect_max_seconds,
            pre_effect_max_tool_events=pre_effect_max_tool_events,
            exclude_accounts=exclude_accounts,
        )
        with state_lock:
            snapshot = dict(state)
        failure_kind = snapshot.get("failure_kind")
        provider_pid = snapshot.get("provider_pid")
        provider_pgid = snapshot.get("provider_pgid")
        provider_alive = _agy_operation_journal._process_alive(provider_pid)
        provider_group_alive = _agy_operation_journal._process_group_alive(provider_pgid)

        if provider_alive or provider_group_alive:
            attestation = _parse_agy_attestation(
                attestation_log_path,
                requested_model=model,
            )
            unresolved_failure = failure_kind or "PROVIDER_PROCESS_STILL_RUNNING_AFTER_DISPATCH"
            journal.update(
                operation_id,
                status="RUNNING",
                phase="RECONCILE_REQUIRED",
                failure_kind=unresolved_failure,
                attempts=int(snapshot.get("attempts") or 0),
                rotations=int(snapshot.get("rotations") or 0),
                account_alias_hash=snapshot.get("account_alias_hash"),
                lease_id_hash=snapshot.get("lease_id_hash"),
                provider_pid=provider_pid,
                provider_pgid=provider_pgid,
                provider_process_state="RUNNING",
                provider_started_at=snapshot.get("provider_started_at"),
                provider_stream_last_activity_at=snapshot.get("provider_stream_last_activity_at"),
                first_stream_activity_at=snapshot.get("first_stream_activity_at"),
                first_tool_activity_at=snapshot.get("first_tool_activity_at"),
                last_progress_activity_at=snapshot.get("last_progress_activity_at"),
                first_effect_at=snapshot.get("first_effect_at"),
                time_to_first_effect_ms=snapshot.get("time_to_first_effect_ms"),
                permission_profile_sha256=snapshot.get("permission_profile_sha256"),
                permission_profile_kind=snapshot.get("permission_profile_kind"),
                effective_permissions=snapshot.get("effective_permissions"),
                tool_event_count=int(snapshot.get("tool_event_count") or 0),
                reconciliation={
                    "at": _agy_operation_journal.utc_now(),
                    "result": "PROVIDER_PROCESS_STILL_RUNNING_AFTER_DISPATCH",
                    "provider_alive_before": True,
                    "provider_alive_after": True,
                    "retry_permitted": False,
                },
                **attestation,
            )
            return int(exit_code if exit_code not in (None, 0) else 1)

        timed_out = bool(snapshot.get("timed_out")) or failure_kind == "TIMEOUT"
        effect_observed = snapshot.get("first_effect_at") is not None
        if timed_out:
            terminal_status = "OUTCOME_UNKNOWN"
            reconciliation = {
                "at": _agy_operation_journal.utc_now(),
                "result": "PROVIDER_TURN_MAY_STILL_BE_RUNNING",
                "retry_permitted": False,
            }
        elif exit_code == 0:
            terminal_status = "COMPLETED"
            reconciliation = None
        elif effect_observed:
            terminal_status = "OUTCOME_UNKNOWN"
            failure_kind = failure_kind or "PROVIDER_EXIT_AFTER_EFFECT"
            reconciliation = {
                "at": _agy_operation_journal.utc_now(),
                "result": "PROVIDER_EXIT_AFTER_OBSERVED_EFFECT",
                "provider_alive_before": bool(provider_pid or provider_pgid),
                "provider_alive_after": False,
                "retry_permitted": False,
            }
        else:
            terminal_status = "FAILED"
            reconciliation = None

        attestation = _parse_agy_attestation(
            attestation_log_path,
            requested_model=model,
        )
        terminal_record = journal.mark_terminal(
            operation_id,
            status=terminal_status,
            exit_code=exit_code,
            failure_kind=failure_kind,
            cwd=cwd,
            write_paths=write_paths,
            attempts=int(snapshot.get("attempts") or 0),
            rotations=int(snapshot.get("rotations") or 0),
            account_alias_hash=snapshot.get("account_alias_hash"),
            lease_id_hash=snapshot.get("lease_id_hash"),
            reconciliation=reconciliation,
            provider_pid=snapshot.get("provider_pid"),
            provider_pgid=snapshot.get("provider_pgid"),
            provider_process_state=(
                (
                    "RUNNING"
                    if direct_operation_journal._process_alive(snapshot.get("provider_pid"))
                    else "EXITED"
                )
                if isinstance(snapshot.get("provider_pid"), int)
                and snapshot.get("provider_pid") > 0
                else (snapshot.get("provider_process_state") or "IDLE")
            ),
            provider_started_at=snapshot.get("provider_started_at"),
            provider_stream_last_activity_at=snapshot.get("provider_stream_last_activity_at"),
            first_stream_activity_at=snapshot.get("first_stream_activity_at"),
            first_tool_activity_at=snapshot.get("first_tool_activity_at"),
            last_progress_activity_at=snapshot.get("last_progress_activity_at"),
            first_effect_at=snapshot.get("first_effect_at"),
            time_to_first_effect_ms=snapshot.get("time_to_first_effect_ms"),
            quota_preflight_progress=snapshot.get("quota_preflight_progress"),
            permission_profile_sha256=snapshot.get("permission_profile_sha256"),
            permission_profile_kind=snapshot.get("permission_profile_kind"),
            effective_permissions=snapshot.get("effective_permissions"),
            tool_event_count=int(snapshot.get("tool_event_count") or 0),
            has_unresolved_external_effect=bool(
                terminal_status == "OUTCOME_UNKNOWN" and effect_observed
            ),
            **attestation,
        )
        if (
            terminal_record.get("status") == "FAILED"
            and terminal_record.get("failure_kind") == "SCOPE_VIOLATION_UNAUTHORIZED_MUTATION"
        ):
            return 1
        return int(exit_code or 0)
    except _SupervisorSignalError:
        raise
    except BaseException:
        # The outer supervisor guard owns cleanup + terminalization. Writing a
        # terminal record here would make the guard skip child reconciliation.
        raise
    finally:
        if prior_attestation_log is None:
            os.environ.pop("NEXUS_AGY_ATTESTATION_LOG", None)
        else:
            os.environ["NEXUS_AGY_ATTESTATION_LOG"] = prior_attestation_log
        stop.set()
        heartbeat_thread.join(timeout=2.0)


def _completed_provider_exit_proven(record: dict[str, Any]) -> bool:
    """Return whether durable terminal evidence proves this completed provider exited."""
    return bool(
        record.get("status") == "COMPLETED"
        and record.get("phase") == "TERMINAL"
        and record.get("provider_process_state") == "EXITED"
        and record.get("has_unresolved_external_effect") is False
        and record.get("exit_code") == 0
    )


def _cleanup_reconciled_lease(record: dict[str, Any]) -> dict[str, Any]:
    reconciliation = record.get("reconciliation")
    reconciled_provider_absent = bool(
        isinstance(reconciliation, dict)
        and reconciliation.get("provider_alive_after") is False
    )
    if not reconciled_provider_absent and not _completed_provider_exit_proven(record):
        return {"result": "NOT_SAFE_TO_CLEAN"}

    provider_pid = record.get("provider_pid")
    if (
        record.get("mode") == "hcom_collab"
        and record.get("status") == "OUTCOME_UNKNOWN"
        and (not isinstance(provider_pid, int) or provider_pid <= 0)
    ):
        return {"result": "COLLAB_PROVIDER_IDENTITY_UNPROVEN_PRESERVED"}

    alias_hash = record.get("account_alias_hash")
    lease_id_hash = record.get("lease_id_hash")
    owner_pid = record.get("pid")
    if (
        not isinstance(alias_hash, str)
        or not alias_hash
        or not isinstance(lease_id_hash, str)
        or not lease_id_hash
        or not isinstance(owner_pid, int)
        or owner_pid <= 0
    ):
        return {"result": "LEASE_IDENTITY_INCOMPLETE"}

    lock_path = LEASES_DIR / f"{alias_hash}.lock"
    receipt_path = LEASES_DIR / f"{alias_hash}.receipt.json"
    if not receipt_path.exists():
        return {"result": "ALREADY_ABSENT"}

    LEASES_DIR.mkdir(parents=True, exist_ok=True)
    lock_obj = lock_path.open("a+")
    try:
        try:
            fcntl.flock(lock_obj.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (BlockingIOError, OSError):
            return {"result": "LEASE_BUSY_PRESERVED"}

        try:
            receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return {"result": "LEASE_RECEIPT_UNREADABLE_PRESERVED"}

        expected = {
            "account_alias_hash": alias_hash,
            "lease_id_hash": lease_id_hash,
            "pid": owner_pid,
        }
        observed = {
            "account_alias_hash": receipt.get("account_alias_hash"),
            "lease_id_hash": receipt.get("lease_id_hash"),
            "pid": receipt.get("pid"),
        }
        if observed != expected:
            return {
                "result": "LEASE_IDENTITY_MISMATCH_PRESERVED",
                "observed": observed,
            }

        try:
            receipt_path.unlink()
        except OSError as exc:
            return {
                "result": "LEASE_RECEIPT_REMOVE_FAILED",
                "error": type(exc).__name__,
            }
        return {"result": "LEASE_RECEIPT_REMOVED"}
    finally:
        try:
            fcntl.flock(lock_obj.fileno(), fcntl.LOCK_UN)
        finally:
            lock_obj.close()


def _reconcile_operation(
    journal: AgyOperationJournal,
    operation_id: str,
) -> dict[str, Any]:
    record = journal.reconcile(operation_id)
    lease_cleanup = _cleanup_reconciled_lease(record)
    reconciliation = dict(record.get("reconciliation") or {})
    reconciliation["lease_cleanup"] = lease_cleanup
    if _completed_provider_exit_proven(record):
        reconciliation.update({
            "provider_alive_before": False,
            "provider_alive_after": False,
            "retry_permitted": False,
        })
    if lease_cleanup.get("result") == "COLLAB_PROVIDER_IDENTITY_UNPROVEN_PRESERVED":
        reconciliation.update({
            "result": "HCOM_COLLAB_PROVIDER_IDENTITY_UNPROVEN",
            "provider_alive_after": None,
            "retry_permitted": False,
        })
        return journal.update(
            operation_id,
            phase="RECONCILE_REQUIRED",
            reconciliation=reconciliation,
        )
    return journal.update(operation_id, reconciliation=reconciliation)


_SAFE_NO_EFFECT_LEASE_RESULTS = frozenset({
    "ALREADY_ABSENT",
    "LEASE_RECEIPT_REMOVED",
})


def _finalize_no_effect_operation(
    journal: AgyOperationJournal,
    operation_id: str,
) -> dict[str, Any]:
    existing = journal.read(operation_id)
    existing_reconciliation = existing.get("reconciliation")
    if (
        existing.get("status") == "FAILED"
        and isinstance(existing_reconciliation, dict)
        and existing_reconciliation.get("result") == "SOURCE_NO_DURABLE_EFFECT_PROVEN"
        and existing_reconciliation.get("reconciliation_scope") == "SOURCE_ONLY"
        and existing_reconciliation.get("retry_permitted") is True
    ):
        return existing

    record = _reconcile_operation(journal, operation_id)
    if record.get("status") != "OUTCOME_UNKNOWN":
        raise AgyOperationJournalError("NO_EFFECT_FINALIZATION_REQUIRES_OUTCOME_UNKNOWN")

    reconciliation = dict(record.get("reconciliation") or {})
    if reconciliation.get("pid_alive") is not False:
        raise AgyOperationJournalError("NO_EFFECT_PROCESS_TRUTH_UNBOUNDED")
    if reconciliation.get("provider_alive_after") is not False:
        raise AgyOperationJournalError("NO_EFFECT_PROVIDER_TRUTH_UNBOUNDED")

    lease_cleanup = reconciliation.get("lease_cleanup")
    lease_result = lease_cleanup.get("result") if isinstance(lease_cleanup, dict) else None
    if lease_result not in _SAFE_NO_EFFECT_LEASE_RESULTS:
        raise AgyOperationJournalError(f"NO_EFFECT_LEASE_NOT_SAFE:{lease_result or 'UNKNOWN'}")

    source_proof = journal.prove_source_state_unchanged(operation_id)
    reconciliation.update({
        "at": _agy_operation_journal.utc_now(),
        "result": "SOURCE_NO_DURABLE_EFFECT_PROVEN",
        "reconciliation_scope": "SOURCE_ONLY",
        "retry_permitted": True,
        "source_proof": source_proof,
        "lease_cleanup": lease_cleanup,
    })
    return journal.mark_terminal(
        operation_id,
        status="FAILED",
        exit_code=record.get("exit_code"),
        failure_kind=record.get("failure_kind"),
        cwd=record.get("cwd"),
        reconciliation=reconciliation,
    )


def _print_operation(record: dict[str, Any]) -> None:
    print(json.dumps(public_operation_view(record), indent=2, sort_keys=True))


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        description="Quota-aware direct Agy dispatcher using the existing Nexus account pool."
    )
    ap.add_argument("prompt", nargs="?")
    ap.add_argument("--prompt", dest="prompt_flag", help="Prompt text")
    ap.add_argument("--prompt-file")
    ap.add_argument("--cwd", default=os.getcwd())
    ap.add_argument(
        "--fallback-clone",
        help=(
            "Explicit standalone clone target for linked-worktree Agy compatibility; "
            "the clone becomes the actual operation cwd/repo_root"
        ),
    )
    ap.add_argument("--mode", choices=("plan", "accept-edits"), default="accept-edits")
    ap.add_argument("--model")
    ap.add_argument("--effort", choices=("low", "medium", "high"))
    ap.add_argument("--temp-command-permissions", action="store_true")
    ap.add_argument(
        "--allow",
        action="append",
        default=[],
        help="Temporary exact Agy permission rule; repeatable",
    )
    ap.add_argument(
        "--deny", action="append", default=[], help="Temporary exact Agy deny rule; repeatable"
    )
    ap.add_argument(
        "--write-path",
        action="append",
        default=[],
        help="Bounded writable path inside --cwd for accept-edits; repeatable",
    )
    ap.add_argument("--timeout", type=int, default=900)
    ap.add_argument("--max-calls", type=int, default=3)
    ap.add_argument(
        "--pool-wait-timeout",
        type=float,
        default=float(os.getenv("NEXUS_AGY_POOL_WAIT_TIMEOUT", "15.0")),
        help="Timeout in seconds to wait for an available account slot when the pool is busy",
    )
    ap.add_argument(
        "--provider-stall-seconds",
        type=float,
        default=_provider_stall_seconds(),
        help="Coding-task provider-start deadline before classifying no provider progress",
    )
    ap.add_argument(
        "--stream-no-progress-seconds",
        type=float,
        default=_stream_no_progress_seconds(),
        help="Coding-task deadline since last tool/source progress after provider stream begins",
    )
    ap.add_argument(
        "--pre-effect-max-seconds",
        type=float,
        default=_pre_effect_max_seconds(),
        help="Mutation-capable task deadline from first tool activity to first source effect",
    )
    ap.add_argument(
        "--pre-effect-max-tool-events",
        type=int,
        default=_pre_effect_max_tool_events(),
        help="Mutation-capable task tool-event budget before first source effect",
    )
    ap.add_argument(
        "--background",
        action="store_true",
        help="Start a durable background operation and return its operation_id immediately",
    )
    ap.add_argument("--status", metavar="OPERATION_ID")
    ap.add_argument("--reconcile", metavar="OPERATION_ID")
    ap.add_argument("--hcom-collab", action="store_true")
    ap.add_argument(
        "--exclude-account",
        action="append",
        default=[],
        help="Account alias or 12-hex alias hash to ephemerally exclude; repeatable",
    )
    ap.add_argument(
        "--evidence-ref",
        action="append",
        default=[],
        help="Bounded non-secret operation evidence reference; repeatable",
    )
    ap.add_argument("--hcom-args-json", default="[]", help=argparse.SUPPRESS)
    ap.add_argument(
        "--finalize-no-effect",
        metavar="OPERATION_ID",
        help=(
            "Fail closed unless one OUTCOME_UNKNOWN operation proves source-state "
            "equivalence, terminal process truth, and safe lease cleanup; on success "
            "record a source-scoped retry-safe FAILED reconciliation receipt"
        ),
    )
    ap.add_argument("--operation-root", default=str(OPERATION_ROOT), help=argparse.SUPPRESS)
    ap.add_argument("--operation-run", metavar="OPERATION_ID", help=argparse.SUPPRESS)
    args = ap.parse_args(argv)

    operation_root = Path(args.operation_root).expanduser()
    journal = AgyOperationJournal(operation_root)

    if args.status:
        _print_operation(journal.read(args.status))
        return 0

    if args.reconcile:
        _print_operation(_reconcile_operation(journal, args.reconcile))
        return 0

    if args.finalize_no_effect:
        _print_operation(_finalize_no_effect_operation(journal, args.finalize_no_effect))
        return 0

    cwd = str(Path(args.cwd).expanduser().resolve())
    if not Path(cwd).is_dir():
        raise SystemExit("INVALID_CWD")

    if args.hcom_collab:
        if args.background or args.operation_run:
            raise SystemExit("HCOM_COLLAB_FOREGROUND_ONLY")
        try:
            hcom_args = _parse_hcom_args(args.hcom_args_json)
        except ValueError as exc:
            raise SystemExit(str(exc)) from exc
        return _run_foreground_hcom_operation(
            cwd=cwd,
            hcom_args=hcom_args,
            model=args.model,
            pool_wait_timeout=args.pool_wait_timeout,
            operation_root=operation_root,
            exclude_accounts=args.exclude_account,
        )

    # The internal --operation-run already receives the effective execution root
    # persisted by the parent launcher.  Only a new external dispatch may resolve
    # an explicit linked-worktree -> standalone-clone fallback.
    if not args.operation_run:
        try:
            cwd = _resolve_cwd_for_dispatch(
                requested_cwd=cwd,
                fallback_clone_path=args.fallback_clone,
            )
        except WorktreeFallbackError as exc:
            raise SystemExit(str(exc)) from exc
    elif args.fallback_clone:
        raise SystemExit("FALLBACK_CLONE_NOT_ALLOWED_FOR_OPERATION_RUN")

    prompt_text = args.prompt_flag if args.prompt_flag is not None else args.prompt
    if args.prompt_file:
        prompt = Path(args.prompt_file).read_text(encoding="utf-8")
    elif prompt_text is not None:
        prompt = prompt_text
    else:
        prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("EMPTY_PROMPT")

    if args.evidence_ref and not args.background and not args.operation_run:
        raise SystemExit("EVIDENCE_REF_REQUIRES_BACKGROUND")

    if args.operation_run:
        return _run_background_operation(
            operation_id=args.operation_run,
            prompt_file=args.prompt_file,
            cwd=cwd,
            mode=args.mode,
            model=args.model,
            effort=args.effort,
            timeout=args.timeout,
            max_calls=args.max_calls,
            pool_wait_timeout=args.pool_wait_timeout,
            allow=args.allow,
            deny=args.deny,
            write_paths=args.write_path,
            temp_command_permissions=args.temp_command_permissions,
            operation_root=operation_root,
            provider_stall_seconds=args.provider_stall_seconds,
            stream_no_progress_seconds=args.stream_no_progress_seconds,
            pre_effect_max_seconds=args.pre_effect_max_seconds,
            pre_effect_max_tool_events=args.pre_effect_max_tool_events,
            exclude_accounts=args.exclude_account,
        )

    if args.background:
        record = _spawn_background_operation(
            prompt=prompt,
            cwd=cwd,
            mode=args.mode,
            model=args.model,
            effort=args.effort,
            timeout=args.timeout,
            max_calls=args.max_calls,
            pool_wait_timeout=args.pool_wait_timeout,
            allow=args.allow,
            deny=args.deny,
            write_paths=args.write_path,
            temp_command_permissions=args.temp_command_permissions,
            operation_root=operation_root,
            provider_stall_seconds=args.provider_stall_seconds,
            stream_no_progress_seconds=args.stream_no_progress_seconds,
            pre_effect_max_seconds=args.pre_effect_max_seconds,
            pre_effect_max_tool_events=args.pre_effect_max_tool_events,
            exclude_accounts=args.exclude_account,
            evidence_refs=args.evidence_ref,
        )
        _print_operation(record)
        return 0

    return dispatch_run(
        prompt=prompt,
        cwd=cwd,
        mode=args.mode,
        model=args.model,
        effort=args.effort,
        timeout=args.timeout,
        max_calls=args.max_calls,
        pool_wait_timeout=args.pool_wait_timeout,
        allow=args.allow,
        deny=args.deny,
        write_paths=args.write_path,
        temp_command_permissions=args.temp_command_permissions,
        provider_stall_seconds=args.provider_stall_seconds,
        stream_no_progress_seconds=args.stream_no_progress_seconds,
        pre_effect_max_seconds=args.pre_effect_max_seconds,
        pre_effect_max_tool_events=args.pre_effect_max_tool_events,
        exclude_accounts=args.exclude_account,
    )


if __name__ == "__main__":
    raise SystemExit(main())
