def _bounded_positive_seconds(env_name: str, default: float) -> float:
    raw = os.getenv(env_name)
    if raw is None:
        return default
    try:
        value = float(raw)
    except ValueError:
        return default
    return max(0.1, value)


def _provider_stall_seconds() -> float:
    return _bounded_positive_seconds(
        "NEXUS_AGY_PROVIDER_STALL_SECONDS",
        DEFAULT_PROVIDER_STALL_SECONDS,
    )


def _provider_stall_env_set() -> bool:
    """True when NEXUS_AGY_PROVIDER_STALL_SECONDS holds a usable number (it then sets the cut-off)."""
    raw = os.getenv("NEXUS_AGY_PROVIDER_STALL_SECONDS")
    if raw is None:
        return False
    try:
        float(raw)
    except ValueError:
        return False
    return True


_READ_ONLY_PROFILE_KINDS = frozenset({"READ_ONLY_RESEARCH", "NO_TOOL_PACKET"})
# A read-only answer counts as empty when its stripped stdout is shorter than this.
# 1 = only a blank answer; the R6 autopsy's "under 100 bytes" cohort included legitimate
# short replies (canaries, yes/no probes), so a larger cut-off is opt-in per call.
DEFAULT_EMPTY_OUTPUT_MIN_BYTES = 1


def _empty_output_min_bytes() -> int:
    return _bounded_positive_int("NEXUS_AGY_EMPTY_OUTPUT_MIN_BYTES", DEFAULT_EMPTY_OUTPUT_MIN_BYTES)

_DEFAULT_TIMEOUT_SECONDS = {
    "NO_TOOL_PACKET": 300,
    "READ_ONLY_RESEARCH": 600,
