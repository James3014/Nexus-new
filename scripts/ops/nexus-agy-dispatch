def _refuse_prompt_conflicts(args: argparse.Namespace) -> None:
    """Fail closed on prompt-argument conflicts instead of silently picking one.

    2026-10-29: a caller built " --exclude-account primary ..." in a shell
    variable and expanded it unquoted under zsh (no word splitting), so the
    whole option string arrived as the positional prompt, --prompt-file won,
    and every exclusion vanished without a trace (the run landed on primary).
    Runs before anything else in main(), so a refused call has no side effect.
    """
    if args.prompt_file is not None and (args.prompt_flag or args.prompt):
        raise SystemExit("PROMPT_CONFLICT:positional/--prompt text given together with --prompt-file")
    if args.prompt_flag is not None and args.prompt:
        raise SystemExit("PROMPT_CONFLICT:positional prompt given together with --prompt")
    # Only the positional slot can catch an unsplit option string. "--name" or
    # "-x" at its start reads as options ("- fix the list", "---" and "-1" do
    # not); prose that really starts that way can be passed with --prompt.
    if args.prompt is not None and _OPTION_LIKE_PROMPT.match(args.prompt):
        raise SystemExit(
            "PROMPT_LOOKS_LIKE_OPTIONS:positional prompt starts with an option "
            "(unsplit shell variable?); pass such text with --prompt"
        )


POOL_STOPPED_OVERRIDE_ENV = "NEXUS_AGY_POOL_STOPPED_OVERRIDE"
POOL_STOPPED_EXIT_CODE = 3
POOL_STOPPED_MESSAGE = (
    "nexus-agy-dispatch: Agy 帳號池已停用（James 10/30：Agy 只走原生 Cord 管道 agy-lane），"
    "拒絕新派工。改用 Claude 子代理、Codex，或寄協調者走 agy-lane。"
)


def _pool_stopped_refusal(args: argparse.Namespace) -> Optional[int]:
    """Refuse every new dispatch by default: the Agy account pool is stopped.

    James 2026-10-30: Agy runs only through the native agy-lane; pool rotation
    is stopped, not paused.  A host wrapper enforced this on the Mac mini, but
    host-sync swaps that wrapper back to a symlink on the next release, so the
    refusal lives here and ships with the release.  Only
    NEXUS_AGY_POOL_STOPPED_OVERRIDE=1 (exactly "1") runs the original logic.

    Journal maintenance on operations that already exist (--status,
    --reconcile, --finalize-no-effect, --ack-unclean-sweep) still runs: it
    starts no provider and is how a stopped pool's leftovers get cleaned up.
    Everything else, including --hcom-collab and the internal --operation-run
    child, is refused before any journal, lease or provider side effect.  A
    background child inherits its parent's environment, so an overridden
    parent's child still runs.
    """
    if os.environ.get(POOL_STOPPED_OVERRIDE_ENV) == "1":
        return None
    if args.status or args.reconcile or args.finalize_no_effect or args.ack_unclean_sweep:
        return None
    print(POOL_STOPPED_MESSAGE, file=sys.stderr)
    return POOL_STOPPED_EXIT_CODE


def main(argv: list[str] | None = None) -> int:
    args = _build_parser().parse_args(argv)
    refused = _pool_stopped_refusal(args)
    if refused is not None:
        return refused
    _refuse_prompt_conflicts(args)

    operation_root = Path(args.operation_root).expanduser()
    journal = AgyOperationJournal(operation_root)

    if args.status:
        _print_operation(journal.read(args.status))
        return 0

    if args.reconcile:
        _print_operation(_reconcile_operation(journal, args.reconcile))
        return 0

    if args.finalize_no_effect:
        _print_operation(_finalize_no_effect_operation(journal, args.finalize_no_effect))
        return 0

    if args.ack_unclean_sweep:
        _print_operation(_ack_unclean_sweep_operation(journal, args.ack_unclean_sweep))
        return 0

    cwd = str(Path(args.cwd).expanduser().resolve())
    if not Path(cwd).is_dir():
        raise SystemExit("INVALID_CWD")

    if args.hcom_collab:
        if args.run_as_user:
            raise SystemExit("RUN_AS_USER_NOT_SUPPORTED_FOR_HCOM_COLLAB")
        if args.background or args.operation_run:
            raise SystemExit("HCOM_COLLAB_FOREGROUND_ONLY")
        try:
            hcom_args = _parse_hcom_args(args.hcom_args_json)
        except ValueError as exc:
            raise SystemExit(str(exc)) from exc
        return _run_foreground_hcom_operation(
            cwd=cwd,
            hcom_args=hcom_args,
            model=args.model,
            pool_wait_timeout=(
                args.pool_wait_timeout if args.pool_wait_timeout is not None else 15.0
            ),
            operation_root=operation_root,
            exclude_accounts=args.exclude_account,
        )

    # The internal --operation-run already receives the effective execution root
    # persisted by the parent launcher.  Only a new external dispatch may resolve
    # an explicit linked-worktree -> standalone-clone fallback.
    if not args.operation_run:
        try:
            cwd = _resolve_cwd_for_dispatch(
                requested_cwd=cwd,
                fallback_clone_path=args.fallback_clone,
            )
        except WorktreeFallbackError as exc:
            raise SystemExit(str(exc)) from exc
    elif args.fallback_clone:
        raise SystemExit("FALLBACK_CLONE_NOT_ALLOWED_FOR_OPERATION_RUN")

    prompt_text = args.prompt_flag if args.prompt_flag is not None else args.prompt
    if args.prompt_file:
        prompt = Path(args.prompt_file).read_text(encoding="utf-8")
    elif prompt_text is not None:
        prompt = prompt_text
    else:
        prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("EMPTY_PROMPT")

    if args.evidence_ref and not args.background and not args.operation_run:
        raise SystemExit("EVIDENCE_REF_REQUIRES_BACKGROUND")

    if args.operation_run:
        return _run_background_operation(
            operation_id=args.operation_run,
            prompt_file=args.prompt_file,
            cwd=cwd,
            mode=args.mode,
            model=args.model,
            effort=args.effort,
            timeout=args.timeout,
            empty_output_min_bytes=args.empty_output_min_bytes,
            max_calls=args.max_calls,
            pool_wait_timeout=args.pool_wait_timeout,
            allow=args.allow,
            deny=args.deny,
            write_paths=args.write_path,
            temp_command_permissions=args.temp_command_permissions,
            operation_root=operation_root,
            provider_stall_seconds=args.provider_stall_seconds,
            stream_no_progress_seconds=args.stream_no_progress_seconds,
            pre_effect_max_seconds=args.pre_effect_max_seconds,
            pre_effect_max_tool_events=args.pre_effect_max_tool_events,
            exclude_accounts=args.exclude_account,
            **({"run_as_user": args.run_as_user} if args.run_as_user else {}),
        )

    if args.background:
        record = _spawn_background_operation(
            prompt=prompt,
            cwd=cwd,
            mode=args.mode,
            model=args.model,
            effort=args.effort,
            timeout=args.timeout,
            empty_output_min_bytes=args.empty_output_min_bytes,
            max_calls=args.max_calls,
            pool_wait_timeout=args.pool_wait_timeout,
            allow=args.allow,
            deny=args.deny,
            write_paths=args.write_path,
            temp_command_permissions=args.temp_command_permissions,
            operation_root=operation_root,
            provider_stall_seconds=args.provider_stall_seconds,
            stream_no_progress_seconds=args.stream_no_progress_seconds,
            pre_effect_max_seconds=args.pre_effect_max_seconds,
            pre_effect_max_tool_events=args.pre_effect_max_tool_events,
            exclude_accounts=args.exclude_account,
            **({"run_as_user": args.run_as_user} if args.run_as_user else {}),
            evidence_refs=args.evidence_ref,
        )
        _print_operation(record)
        return 0

    return _run_foreground_with_signal_cleanup(
        dispatch_run,
        prompt=prompt,
        cwd=cwd,
        mode=args.mode,
        model=args.model,
        effort=args.effort,
        timeout=args.timeout,
        empty_output_min_bytes=args.empty_output_min_bytes,
        max_calls=args.max_calls,
        pool_wait_timeout=args.pool_wait_timeout,
        allow=args.allow,
        deny=args.deny,
        write_paths=args.write_path,
        temp_command_permissions=args.temp_command_permissions,
        provider_stall_seconds=args.provider_stall_seconds,
        stream_no_progress_seconds=args.stream_no_progress_seconds,
        pre_effect_max_seconds=args.pre_effect_max_seconds,
        pre_effect_max_tool_events=args.pre_effect_max_tool_events,
        exclude_accounts=args.exclude_account,
        **({"run_as_user": args.run_as_user} if args.run_as_user else {}),
    )


if __name__ == "__main__":
    raise SystemExit(main())
