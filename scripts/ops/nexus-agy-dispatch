def _read_new_tool_activity(
    transcript_path: Path | None,
    *,
    offset: int,
) -> tuple[int, int]:
    if transcript_path is None:
        return offset, 0
    count = 0
    try:
        if transcript_path.stat().st_size < offset:
            offset = 0
        with transcript_path.open("r", encoding="utf-8", errors="replace") as stream:
            stream.seek(offset)
            while True:
                line_start = stream.tell()
                line = stream.readline()
                if not line:
                    break
                if not line.endswith("\n"):
                    stream.seek(line_start)
                    break
                try:
                    payload = json.loads(line)
                except json.JSONDecodeError:
                    continue
                tool_calls = payload.get("tool_calls")
                if isinstance(tool_calls, list):
                    count += sum(1 for item in tool_calls if isinstance(item, dict))
            new_offset = stream.tell()
    except OSError:
        return offset, 0
    return new_offset, count


def canonicalize_agy_model(model: str | None) -> str | None:
    if not model:
        return model
    stripped = model.strip()
    if stripped in ("claude-opus-4-6", "claude-3-opus", "claude-opus"):
        return "claude-opus-4-6-thinking"
    return stripped


AGY_MODEL_CATALOG_TIMEOUT_DEFAULT_SEC = 30.0
AGY_MODEL_CATALOG_TTL_DEFAULT_SEC = 900.0
_AGY_MODEL_ID_RE = re.compile(r"[A-Za-z0-9_.:-]+")


def _env_positive_float(name: str, default: float) -> float:
    try:
        value = float(os.getenv(name, ""))
    except ValueError:
        return default
    return value if value > 0 else default


def _parse_agy_models_output(text: str) -> list[str]:
    """Parse ``agy models`` output: ``<id>\\t<label>`` lines; header/blank ignored."""
    ids: list[str] = []
    for line in (text or "").splitlines():
        if "\t" not in line:
            continue
        candidate = line.split("\t", 1)[0].strip()
        if candidate and _AGY_MODEL_ID_RE.fullmatch(candidate) and candidate not in ids:
            ids.append(candidate)
    return ids


def _agy_model_catalog_sha256(ids: list[str]) -> str:
    return hashlib.sha256("\n".join(sorted(ids)).encode("utf-8")).hexdigest()


def _agy_model_catalog_env_binding(env: dict[str, str]) -> str:
    """Hash of the leased HOME and resolved agy executable the catalog is fetched with."""
    material = f"{env.get('HOME', '')}\0{shutil.which('agy') or ''}"
    return hashlib.sha256(material.encode("utf-8")).hexdigest()


def _agy_model_catalog_cache_path(account_alias_hash: str, env_binding: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_-]", "_", str(account_alias_hash))[:128] or "unknown"
    return OPERATION_ROOT / "model-catalog" / f"{safe}-{env_binding[:16]}.json"


def _agy_model_catalog_read_cache(
    path: Path, *, now: float, ttl: float, env_binding: str
) -> dict[str, Any] | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if data.get("env_binding") != env_binding:
            return None
        ids = data["ids"]
        epoch = float(data["checked_at_epoch"])
        if not (isinstance(ids, list) and ids and all(isinstance(i, str) for i in ids)):
            return None
        if data.get("catalog_sha256") != _agy_model_catalog_sha256(ids):
            return None
    except (OSError, ValueError, KeyError, TypeError):
        return None
    if not (0 <= now - epoch < ttl):
        return None
    return {
        "catalog_status": "OK",
        "checked_at": data.get("checked_at"),
        "checked_at_epoch": epoch,
        "catalog_sha256": data["catalog_sha256"],
        "ids": list(ids),
        "source": "CACHED",
        "reason": None,
    }


def _agy_model_catalog_write_cache(
    path: Path, snapshot: dict[str, Any], env_binding: str
) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        tmp = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
        payload = {
            "checked_at": snapshot["checked_at"],
            "checked_at_epoch": snapshot["checked_at_epoch"],
            "catalog_sha256": snapshot["catalog_sha256"],
            "ids": snapshot["ids"],
            "env_binding": env_binding,
        }
        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write(json.dumps(payload, sort_keys=True))
            os.replace(tmp, path)
        finally:
            if tmp.exists():
                tmp.unlink()
    except OSError:
        pass  # cache is an optimisation; never fail dispatch on it


def _agy_model_catalog_fetch(env: dict[str, str], timeout: float) -> tuple[int | None, str, str]:
    """Run ``agy models`` with the leased account env; returns (code, out, reason)."""
    agy = shutil.which("agy")
    if not agy:
        return None, "", "AGY_BINARY_NOT_FOUND"
    try:
        proc = subprocess.Popen(
            [agy, "models"],
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            start_new_session=True,
        )
    except OSError as exc:
        return None, "", f"CATALOG_START_FAILED:{type(exc).__name__}"
    try:
        out, _ = proc.communicate(timeout=timeout)
    except BaseException as exc:
        # Unconditional cleanup (timeout, KeyboardInterrupt, signal-raised
        # exceptions): kill the group by its own PID and reap, then propagate.
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        try:
            proc.kill()
        except OSError:
            pass
        try:
            proc.wait(timeout=5)
        except BaseException:
            pass
        # #2388: close our end of the pipe explicitly.
        try:
            if proc.stdout is not None:
                proc.stdout.close()
        except OSError:
            pass
        if isinstance(exc, subprocess.TimeoutExpired):
            return None, "", "CATALOG_TIMEOUT"
        raise
    return proc.returncode, out or "", ""


def _agy_model_catalog_snapshot(
    *,
    env: dict[str, str],
    account_alias_hash: str,
    now: float | None = None,
    max_fetch_seconds: float | None = None,
) -> dict[str, Any]:
    """Account-scoped catalog snapshot (#1357); DEGRADED never blocks and is not cached."""
    now = time.time() if now is None else now
    ttl = _env_positive_float("NEXUS_AGY_MODEL_CATALOG_TTL_SEC", AGY_MODEL_CATALOG_TTL_DEFAULT_SEC)
    timeout = _env_positive_float(
        "NEXUS_AGY_MODEL_CATALOG_TIMEOUT_SEC", AGY_MODEL_CATALOG_TIMEOUT_DEFAULT_SEC
    )
    if max_fetch_seconds is not None:
        # #2388: the fetch is spent from the operation's total deadline.
        timeout = max(1.0, min(timeout, float(max_fetch_seconds)))
    env_binding = _agy_model_catalog_env_binding(env)
    path = _agy_model_catalog_cache_path(account_alias_hash, env_binding)
    cached = _agy_model_catalog_read_cache(path, now=now, ttl=ttl, env_binding=env_binding)
    if cached is not None:
        return cached
    code, out, reason = _agy_model_catalog_fetch(env, timeout)
    if not reason and code != 0:
        reason = f"CATALOG_EXIT_{code}"
    ids = [] if reason else _parse_agy_models_output(out)
    if not reason and not ids:
        reason = "CATALOG_EMPTY"
    checked_at = datetime.fromtimestamp(now, timezone.utc).isoformat()
    if reason:
        return {
            "catalog_status": "DEGRADED",
            "checked_at": checked_at,
            "checked_at_epoch": now,
            "catalog_sha256": None,
            "ids": [],
            "source": "FRESH",
            "reason": reason,
        }
    snapshot = {
        "catalog_status": "OK",
        "checked_at": checked_at,
        "checked_at_epoch": now,
        "catalog_sha256": _agy_model_catalog_sha256(ids),
        "ids": ids,
        "source": "FRESH",
        "reason": None,
    }
    _agy_model_catalog_write_cache(path, snapshot, env_binding)
    return snapshot


def _agy_model_catalog_admission(
    *,
    model: str | None,
    effort: str | None,
    env: dict[str, str],
    account_alias_hash: str,
    max_fetch_seconds: float | None = None,
) -> dict[str, Any]:
    """Decide fixed-model admission; returns the durable ``model_catalog`` projection."""
    resolved = canonicalize_agy_model(model) if model else None
    base: dict[str, Any] = {
        "requested_model": model,
        "resolved_model": resolved,
        "model_catalog": {
            "status": "NOT_REQUIRED",
            "checked_at": None,
            "catalog_sha256": None,
            "source": None,
            "mismatch_reason": None,
        },
        "admitted": True,
    }
    catalog = base["model_catalog"]
    if not resolved:
        return base
    if os.getenv("NEXUS_AGY_MODEL_CATALOG_CHECK", "1").strip() == "0":
        catalog["status"] = "DISABLED"
        return base
    snap = _agy_model_catalog_snapshot(
        env=env, account_alias_hash=account_alias_hash, max_fetch_seconds=max_fetch_seconds
    )
    catalog.update({
        "checked_at": snap["checked_at"],
        "catalog_sha256": snap["catalog_sha256"],
        "source": snap["source"],
    })
    if snap["catalog_status"] != "OK":
        catalog["status"] = "DEGRADED"
        catalog["mismatch_reason"] = snap["reason"]
        return base
    ids = set(snap["ids"])
    tiers = ("low", "medium", "high")
    # Agy receives --model <resolved> --effort <effort>; accept catalogs that
    # encode the effort in the id (e.g. claude-sonnet-5-5-medium) as well.
    # #2388: with an explicit effort, a bare id is admitted only when the
    # catalog encodes no effort tiers for it; otherwise <resolved>-<effort>
    # itself must be served.
    if effort:
        tiered = any(f"{resolved}-{tier}" in ids for tier in tiers)
        if f"{resolved}-{effort}" in ids or (resolved in ids and not tiered):
            catalog["status"] = "OK"
            return base
    elif resolved in ids:
        catalog["status"] = "OK"
        return base
    # Without an explicit effort Agy resolves a bare alias (e.g.
    # gemini-3.8-flash) to one of its served effort tiers; admit it only when
    # the account's catalog actually serves such a tier.
    if not effort and any(f"{resolved}-{tier}" in ids for tier in ("low", "medium", "high")):
        catalog["status"] = "OK"
        return base
    catalog["status"] = "MODEL_CAPABILITY_UNAVAILABLE"
    catalog["mismatch_reason"] = "MODEL_NOT_IN_ACCOUNT_CATALOG"
    base["admitted"] = False
    return base


def _model_effort_suffix(model: str | None) -> str | None:
    """The effort tier an id encodes (``gemini-3.8-flash-medium`` -> ``medium``)."""
    for tier in ("low", "medium", "high"):
        if (model or "").strip().lower().endswith(f"-{tier}"):
            return tier
    return None


def _model_family(model: str | None) -> str:
    value = (model or "").strip().lower()
    if value.startswith("gemini-"):
        return "gemini"
    if value.startswith("claude-") or value.startswith("gpt-"):
        return "claude_gpt"
    return "unknown"


def _parse_reset_at(value: object) -> float | None:
    if not isinstance(value, str) or not value.strip():
        return None
    from datetime import datetime

    try:
        dt = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    return dt.timestamp()


def _quota_max_age_seconds() -> float:
    raw = os.getenv("NEXUS_AGY_QUOTA_MAX_AGE_SECONDS")
    if raw is None:
        return DEFAULT_QUOTA_MAX_AGE_SECONDS
    try:
        value = float(raw)
    except ValueError:
        return DEFAULT_QUOTA_MAX_AGE_SECONDS
    return max(0.0, value)


def _timestamp_is_fresh(
    checked_at: object,
    *,
    now_ts: float,
    max_age_seconds: float,
) -> bool:
    checked_ts = _parse_reset_at(checked_at)
    if checked_ts is None:
        return False
    age = float(now_ts) - checked_ts
    return -60.0 <= age <= max(0.0, float(max_age_seconds))


def _snapshot_is_fresh(
    snapshot: dict,
    *,
    now_ts: float | None = None,
    max_age_seconds: float | None = None,
) -> bool:
    checked_at = snapshot.get("checked_at") if isinstance(snapshot, dict) else None
    current = time.time() if now_ts is None else float(now_ts)
    max_age = _quota_max_age_seconds() if max_age_seconds is None else max_age_seconds
    return _timestamp_is_fresh(
        checked_at,
        now_ts=current,
        max_age_seconds=max_age,
    )


def _row_is_fresh(
    row: dict,
    snapshot: dict,
    *,
    now_ts: float,
    max_age_seconds: float,
) -> bool:
    checked_at = row.get("checked_at")
    if checked_at is None:
        checked_at = snapshot.get("checked_at")
    return _timestamp_is_fresh(
        checked_at,
        now_ts=now_ts,
        max_age_seconds=max_age_seconds,
    )


def _quota_window_state(
    window: object,
    *,
    now_ts: float,
) -> tuple[str, float | None]:
    if not isinstance(window, dict):
        return "unknown", None
    status = window.get("status")
    reset_ts = _parse_reset_at(window.get("reset_at"))
    if status == "disabled":
        return "blocked", reset_ts
    if status != "known":
        return "unknown", reset_ts
    remaining = window.get("remaining_pct")
    if isinstance(remaining, (int, float)) and float(remaining) > 0.0:
        return "available", reset_ts
    if reset_ts is not None and reset_ts <= now_ts:
        return "available", reset_ts
    if isinstance(remaining, (int, float)) and float(remaining) <= 0.0:
        return "blocked", reset_ts
    return "unknown", reset_ts


def _quota_window_drain_pressure(
    window: object,
    *,
    now_ts: float,
    remaining_cap: float | None = None,
) -> float | None:
    """Return expiring quota pressure as remaining_pct per hour until reset.

    ``remaining_cap`` bounds the usable remainder by a longer window (#2410: a
    full 5h window on an account whose weekly quota is nearly gone cannot be
    spent, so it must not outrank an account with real remaining quota).
    """
    if not isinstance(window, dict) or window.get("status") != "known":
        return None
    remaining = window.get("remaining_pct")
    reset_ts = _parse_reset_at(window.get("reset_at"))
    if (
        not isinstance(remaining, (int, float))
        or float(remaining) <= 0.0
        or reset_ts is None
        or reset_ts <= now_ts
    ):
        return None
    usable = float(remaining)
    if remaining_cap is not None:
        usable = min(usable, max(0.0, float(remaining_cap)))
        if usable <= 0.0:
            return None
    hours_to_reset = max(
        (reset_ts - now_ts) / 3600.0,
        MIN_DRAIN_HORIZON_SECONDS / 3600.0,
    )
    return usable / hours_to_reset


def _known_remaining_pct(window: object, *, now_ts: float) -> float | None:
    """Known remaining percentage of one quota window, or None when unknown/reset."""
    if not isinstance(window, dict) or window.get("status") != "known":
        return None
    remaining = window.get("remaining_pct")
    if not isinstance(remaining, (int, float)):
        return None
    reset_ts = _parse_reset_at(window.get("reset_at"))
    if reset_ts is not None and reset_ts <= now_ts:
        return None
    return float(remaining)


def _family_remaining_pct(
    groups: dict,
    group_name: str,
    *,
    now_ts: float,
) -> float | None:
    """Usable remaining quota of one model group: the tightest known window."""
    group = groups.get(group_name) if isinstance(groups, dict) else None
    if not isinstance(group, dict):
        return None
    known = [
        value
        for value in (
            _known_remaining_pct(group.get("5h"), now_ts=now_ts),
            _known_remaining_pct(group.get("weekly"), now_ts=now_ts),
        )
        if value is not None
    ]
    return min(known) if known else None


def _family_drain_pressure(
    groups: dict,
    group_name: str,
    family_state: str,
    *,
    now_ts: float,
) -> float | None:
    group = groups.get(group_name) if isinstance(groups, dict) else None
    if not isinstance(group, dict):
        return None
    if family_state == "five_hour":
        return _quota_window_drain_pressure(
            group.get("5h"),
            now_ts=now_ts,
            remaining_cap=_known_remaining_pct(group.get("weekly"), now_ts=now_ts),
        )
    if family_state == "weekly":
        return _quota_window_drain_pressure(group.get("weekly"), now_ts=now_ts)
    return None


def _order_accounts_by_drain_pressure(
    entries: list[tuple[str, float | None]] | list[tuple[str, float | None, float | None]],
) -> list[str]:
    """Prioritize known high burn pressure, then most remaining quota, then identity.

    Entries are ``(name, pressure)`` or ``(name, pressure, remaining_pct)``.
    """
    deduped: dict[str, float | None] = {}
    remaining_by_name: dict[str, float] = {}
    for entry in entries:
        name, pressure = entry[0], entry[1]
        remaining = entry[2] if len(entry) > 2 else None
        if remaining is not None:
            remaining_by_name[name] = max(remaining_by_name.get(name, 0.0), float(remaining))
        if name not in deduped:
            deduped[name] = pressure
            continue
        current = deduped[name]
        if pressure is not None and (current is None or pressure > current):
            deduped[name] = pressure

    def sort_key(item: tuple[str, float | None]) -> tuple[object, ...]:
        name, pressure = item
        remaining = -remaining_by_name.get(name, 0.0)
        if pressure is None:
            return (1, 0.0, remaining, name)
        return (0, -pressure, remaining, name)

    return [name for name, _pressure in sorted(deduped.items(), key=sort_key)]


def _family_quota_state(
    groups: dict,
    group_name: str,
    *,
    now_ts: float | None = None,
) -> tuple[str, float | None]:
    current = time.time() if now_ts is None else float(now_ts)
    group = groups.get(group_name) if isinstance(groups, dict) else None
    if not isinstance(group, dict):
        return "unknown", None

    if "5h" in group:
        state, reset_ts = _quota_window_state(group.get("5h"), now_ts=current)
        if state == "available":
            return "five_hour", reset_ts
        if state == "blocked":
            return "blocked", reset_ts
        return "unknown", reset_ts

    state, reset_ts = _quota_window_state(group.get("weekly"), now_ts=current)
    if state == "available":
        return "weekly", reset_ts
    if state == "blocked":
        return "blocked", reset_ts
    return "unknown", reset_ts


def _usable_quota_window(
    groups: dict,
    group_name: str,
    now_ts: float | None = None,
) -> tuple[bool, str]:
    state, _reset_ts = _family_quota_state(
        groups,
        group_name,
        now_ts=now_ts,
    )
    if state == "five_hour":
        return True, "5h"
    if state == "weekly":
        return True, "weekly"
    if isinstance(groups, dict):
        group = groups.get(group_name)
        if isinstance(group, dict) and "5h" in group:
            return False, "5h"
    return False, "weekly" if state == "blocked" else "missing"


def _load_quota_snapshot(path: Path = QUOTA_SNAPSHOT_PATH) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def _max_account_failovers() -> int:
    raw = os.getenv("NEXUS_AGY_MAX_ACCOUNT_FAILOVERS")
    if raw is None:
        return DEFAULT_MAX_ACCOUNT_FAILOVERS
    try:
        value = int(raw)
    except ValueError:
        return DEFAULT_MAX_ACCOUNT_FAILOVERS
    return max(1, value)


def _quota_refresh_binary() -> str | None:
    explicit = os.getenv("NEXUS_AGY_QUOTA_COMMAND", "").strip()
    if explicit:
        return explicit
    found = shutil.which("nexus-agy-quota")
    if found:
        return found
    sibling = Path(__file__).resolve().with_name("nexus-agy-quota")
    return str(sibling) if sibling.is_file() else None


def _quota_error_kind(value: object) -> str | None:
    if not isinstance(value, str):
        return None
    if value == "timeout":
        return "TIMEOUT"
    if value == "deadline_exceeded":
        return "DEADLINE_EXCEEDED"
    if value == "unknown_account":
        return "UNKNOWN_ACCOUNT"
    if value == "usage_unparseable":
        return "USAGE_UNPARSEABLE"
    if value.startswith("accounts_dir_missing:"):
        return "ACCOUNTS_DIR_MISSING"
    if value.startswith("AGY_ACCOUNT_POOL_ACCOUNTS_MISSING:"):
        return "ACCOUNTS_DIR_MISSING"
    if re.fullmatch(r"exit_[0-9]{1,3}", value):
        return "COMMAND_FAILED"
    return "OTHER"


def _quota_progress_projection(
    event: object,
    *,
    account_name: str,
    account_alias_hash: str | None,
) -> dict[str, Any] | None:
    """Project one quota CLI event into a small, identity-safe journal value."""
    if not isinstance(event, dict):
        return None
    phase = event.get("phase")
    if not isinstance(phase, str) or phase not in _QUOTA_PROGRESS_PHASES:
        return None

    projected: dict[str, Any] = {"phase": phase}
    timestamp = event.get("timestamp")
    if isinstance(timestamp, str) and len(timestamp) <= 64:
        try:
            parsed_timestamp = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
        except ValueError:
            parsed_timestamp = None
        if parsed_timestamp is not None and parsed_timestamp.tzinfo is not None:
            projected["timestamp"] = parsed_timestamp.astimezone(timezone.utc).isoformat()

    if isinstance(account_alias_hash, str) and re.fullmatch(r"[0-9a-f]{12}", account_alias_hash):
        projected["account_alias_hash"] = account_alias_hash

    if phase in _QUOTA_ACCOUNT_PHASES:
        observed_account = event.get("account")
        if observed_account is not None and observed_account != account_name:
            return None

    for source_key, target_key in (
        ("timeout", "timeout_seconds"),
        ("total_timeout", "total_timeout_seconds"),
    ):
        value = event.get(source_key)
        if (
            isinstance(value, (int, float))
            and not isinstance(value, bool)
            and 0 < float(value) <= 3600
        ):
            projected[target_key] = float(value)

    for source_key, target_key in (("total", "account_count"), ("ok", "ok_count")):
        value = event.get(source_key)
        if isinstance(value, int) and not isinstance(value, bool) and 0 <= value <= 10000:
            projected[target_key] = value
    if "ok_count" in projected:
        projected["ok_count_semantics"] = "successful_quota_queries"

    if isinstance(event.get("ok"), bool):
        projected["ok"] = event["ok"]
    error_kind = _quota_error_kind(event.get("error"))
    if error_kind is not None:
        projected["error_kind"] = error_kind
    for str_key in ("admission_state", "probe_state", "quota_state"):
        str_val = event.get(str_key)
        if isinstance(str_val, str) and 0 < len(str_val) <= 64:
            projected[str_key] = str_val
    return projected


def _notify_quota_progress(
    on_phase_hook: Any,
    progress: dict[str, Any],
    *,
    account_alias_hash: str | None = None,
) -> None:
    if not callable(on_phase_hook):
        return
    if isinstance(account_alias_hash, str) and re.fullmatch(r"[0-9a-f]{12}", account_alias_hash):
        progress = {**progress, "account_alias_hash": account_alias_hash}
    try:
        on_phase_hook(quota_preflight_progress=progress)
    except Exception:
        # Quota progress is diagnostic and must not change dispatch behavior.
        pass


def _read_quota_progress(
    stream: Any,
    *,
    account_name: str,
    account_alias_hash: str | None,
    on_phase_hook: Any,
) -> None:
    while True:
        try:
            line = stream.readline(_QUOTA_PROGRESS_MAX_LINE + 1)
        except (OSError, ValueError):
            return
        if not line:
            return
        if len(line) > _QUOTA_PROGRESS_MAX_LINE:
            while line and not line.endswith("\n"):
                line = stream.readline(_QUOTA_PROGRESS_MAX_LINE + 1)
            continue
        if not line.endswith("\n"):
            continue
        line = line.rstrip("\r\n")
        if not line.startswith(_QUOTA_PROGRESS_PREFIX):
            continue
        try:
            raw_event = json.loads(line[len(_QUOTA_PROGRESS_PREFIX) :])
        except (json.JSONDecodeError, TypeError):
            continue
        progress = _quota_progress_projection(
            raw_event,
            account_name=account_name,
            account_alias_hash=account_alias_hash,
        )
        if progress is None:
            continue
        _notify_quota_progress(on_phase_hook, progress)


def _refresh_quota_snapshot_for_account(
    account_name: str,
    *,
    timeout: int = DEFAULT_QUOTA_PREFLIGHT_TIMEOUT_SECONDS,
    on_phase_hook: Any = None,
    account_alias_hash: str | None = None,
) -> dict:
    command = _quota_refresh_binary()
    if not command:
        return _load_quota_snapshot()
    timeout_seconds = max(1, int(timeout))
    deadline = time.monotonic() + timeout_seconds
    finalize_headroom = min(1.0, max(0.5, timeout_seconds * 0.25))
    child_total_timeout = max(0.001, timeout_seconds - finalize_headroom)
    configured_total_timeout = os.getenv("NEXUS_AGY_QUOTA_TOTAL_TIMEOUT")
    if configured_total_timeout:
        try:
            child_total_timeout = min(child_total_timeout, float(configured_total_timeout))
        except ValueError:
            pass
    child_env = os.environ.copy()
    child_env["NEXUS_AGY_QUOTA_TOTAL_TIMEOUT"] = format(child_total_timeout, ".6g")
    try:
        proc = subprocess.Popen(
            [command, account_name, "--timeout", str(timeout_seconds)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            env=child_env,
        )
    except OSError:
        _notify_quota_progress(
            on_phase_hook,
            {"phase": "START_FAILED", "error_kind": "COMMAND_START_FAILED"},
            account_alias_hash=account_alias_hash,
        )
        return _load_quota_snapshot()

    assert proc.stderr is not None
    reader = threading.Thread(
        target=_read_quota_progress,
        kwargs={
            "stream": proc.stderr,
            "account_name": account_name,
            "account_alias_hash": account_alias_hash,
            "on_phase_hook": on_phase_hook,
        },
        name="agy-quota-progress",
        daemon=True,
    )
    reader.start()
    try:
        proc.wait(timeout=max(0.0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        _notify_quota_progress(
            on_phase_hook,
            {"phase": "TIMED_OUT", "error_kind": "TIMEOUT"},
            account_alias_hash=account_alias_hash,
        )
    finally:
        reader.join(timeout=max(0.0, deadline - time.monotonic()))
        if proc.stderr and not proc.stderr.closed:
            proc.stderr.close()
    return _load_quota_snapshot()


def _account_family_quota_state(
    snapshot: dict,
    *,
    account_name: str,
    model_family: str,
    now_ts: float | None = None,
) -> tuple[str, float | None, bool]:
    if model_family not in {"gemini", "claude_gpt"}:
        return "unknown", None, False
    current = time.time() if now_ts is None else float(now_ts)
    max_age = _quota_max_age_seconds()
    if not _snapshot_is_fresh(snapshot, now_ts=current, max_age_seconds=max_age):
        return "stale", None, False
    rows = snapshot.get("accounts") if isinstance(snapshot, dict) else None
    if not isinstance(rows, list):
        return "unknown", None, False
    group_name = "Gemini Models" if model_family == "gemini" else "Claude and GPT models"
    for row in rows:
        if not isinstance(row, dict) or row.get("account") != account_name:
            continue
        if not _row_is_fresh(
            row,
            snapshot,
            now_ts=current,
            max_age_seconds=max_age,
        ):
            return "stale", None, False
        if row.get("ok") is not True:
            return "unknown", None, True
        groups = row.get("groups")
        if not isinstance(groups, dict):
            return "unknown", None, True
        state, reset_ts = _family_quota_state(groups, group_name, now_ts=current)
        return state, reset_ts, True
    return "unknown", None, False


def _quota_preflight_decision(
    *,
    account_alias_hash: str | None,
    model_family: str,
    quota_state: str,
    evidence_fresh: bool,
    probe_state: str,
    dispatch_decision: str,
) -> dict[str, str | None]:
    """Separate quota-query health from the policy decision.

    ``account_alias_hash`` is None only for a family-level decision made before any claim.
    """
    evidence_state = (
        "KNOWN_BLOCKED"
        if evidence_fresh and quota_state == "blocked"
        else "KNOWN_ELIGIBLE"
        if evidence_fresh and quota_state in {"five_hour", "weekly"}
        else "UNKNOWN"
    )
    return {
        "account_alias_hash": account_alias_hash,
        "model_family": model_family,
        "evidence_state": evidence_state,
        "quota_window_state": quota_state,
        "probe_state": probe_state,
        "dispatch_decision": dispatch_decision,
    }


def _selected_snapshot_probe_state(snapshot: dict, account_name: str) -> str:
    rows = snapshot.get("accounts") if isinstance(snapshot, dict) else None
    if not isinstance(rows, list):
        return "NOT_RUN"
    for row in rows:
        if isinstance(row, dict) and row.get("account") == account_name:
            if row.get("ok") is True:
                return "CACHED_SUCCEEDED"
            if row.get("ok") is False:
                return "CACHED_FAILED"
            return "CACHED_UNKNOWN"
    return "NOT_RUN"


def _dynamic_availability_state(
    model: str | None,
    snapshot: dict,
    *,
    now_ts: float | None = None,
    max_age_seconds: float | None = None,
) -> dict[str, object]:
    family = _model_family(model)
    result: dict[str, object] = {
        "family": family,
        "snapshot_fresh": False,
        "preferred": [],
        "reserve": [],
        "fallback": [],
        "blocked": [],
        "unknown": [],
    }
    if family not in {"gemini", "claude_gpt"}:
        return result
    current = time.time() if now_ts is None else float(now_ts)
    max_age = _quota_max_age_seconds() if max_age_seconds is None else max_age_seconds
    if not _snapshot_is_fresh(
        snapshot,
        now_ts=current,
        max_age_seconds=max_age,
    ):
        return result

    rows = snapshot.get("accounts") if isinstance(snapshot, dict) else None
    if not isinstance(rows, list):
        return result

    result["snapshot_fresh"] = True
    preferred: list[tuple[str, float | None, float | None]] = []
    reserve: list[tuple[str, float | None, float | None]] = []
    fallback: list[tuple[str, float | None, float | None]] = []
    blocked: list[str] = []
    unknown: list[str] = []
    target_group = "Gemini Models" if family == "gemini" else "Claude and GPT models"
    other_group = "Claude and GPT models" if family == "gemini" else "Gemini Models"

    for row in rows:
        if not isinstance(row, dict):
            continue
        name = row.get("account")
        if not isinstance(name, str):
            continue
        if not _row_is_fresh(
            row,
            snapshot,
            now_ts=current,
            max_age_seconds=max_age,
        ):
            unknown.append(name)
            continue
        if row.get("ok") is not True:
            unknown.append(name)
            continue
        groups = row.get("groups")
        if not isinstance(groups, dict):
            unknown.append(name)
            continue

        target_state, _target_reset = _family_quota_state(
            groups,
            target_group,
            now_ts=current,
        )
        other_state, _other_reset = _family_quota_state(
            groups,
            other_group,
            now_ts=current,
        )
        drain_pressure = _family_drain_pressure(
            groups,
            target_group,
            target_state,
            now_ts=current,
        )
        remaining_pct = _family_remaining_pct(groups, target_group, now_ts=current)
        if target_state == "five_hour":
            if other_state == "five_hour":
                reserve.append((name, drain_pressure, remaining_pct))
            else:
                preferred.append((name, drain_pressure, remaining_pct))
        elif target_state == "weekly":
            fallback.append((name, drain_pressure, remaining_pct))
        elif target_state == "blocked":
            blocked.append(name)
        else:
            unknown.append(name)

    ordered_preferred = _order_accounts_by_drain_pressure(preferred)
    ordered_reserve = _order_accounts_by_drain_pressure(reserve)
    ordered_fallback = _order_accounts_by_drain_pressure(fallback)
    preferred_names = set(ordered_preferred)
    reserve_names = set(ordered_reserve) - preferred_names

    result.update({
        "preferred": ordered_preferred,
        "reserve": [name for name in ordered_reserve if name in reserve_names],
        "fallback": [
            name
            for name in ordered_fallback
            if name not in preferred_names and name not in reserve_names
        ],
        "blocked": sorted(set(blocked)),
        "unknown": sorted(set(unknown)),
    })
    return result


def _dynamic_preference_tiers(model: str | None, snapshot: dict) -> tuple[list[str], list[str]]:
    state = _dynamic_availability_state(model, snapshot)
    return list(state["preferred"]), list(state["reserve"])


def _publish_dynamic_availability(state: dict[str, object]) -> None:
    os.environ["NEXUS_AGY_PREFERRED_ACCOUNTS"] = ",".join(state["preferred"])
    os.environ["NEXUS_AGY_RESERVE_ACCOUNTS"] = ",".join(state["reserve"])
    os.environ["NEXUS_AGY_FALLBACK_ACCOUNTS"] = ",".join(state["fallback"])
    os.environ["NEXUS_AGY_BLOCKED_ACCOUNTS"] = ",".join(state["blocked"])


def _apply_dynamic_availability(model: str | None) -> tuple[dict, dict[str, object]]:
    if AGY_ACCOUNT_PREFERENCE_TIERS_VERSION != 3:
        raise RuntimeError("AGY_ACCOUNT_PREFERENCE_TIERS_VERSION_MISMATCH")
    snapshot = _load_quota_snapshot()
    state = _dynamic_availability_state(model, snapshot)
    _publish_dynamic_availability(state)
    return snapshot, state


def _apply_dynamic_preference(model: str | None) -> tuple[list[str], list[str]]:
    _snapshot, state = _apply_dynamic_availability(model)
    return list(state["preferred"]), list(state["reserve"])


def _family_failure_unavailable_until(
    *,
    snapshot: dict,
    account_name: str,
    model_family: str,
    failure_kind: AccountFailureKind,
    now_ts: float | None = None,
) -> float:
    current = time.time() if now_ts is None else float(now_ts)
    if not _snapshot_is_fresh(snapshot, now_ts=current):
        return current + DEFAULT_QUOTA_FAMILY_BLOCK_SECONDS

    target_group = "Gemini Models" if model_family == "gemini" else "Claude and GPT models"
    rows = snapshot.get("accounts") if isinstance(snapshot, dict) else None
    if isinstance(rows, list):
        for row in rows:
            if not isinstance(row, dict) or row.get("account") != account_name:
                continue
            if not _row_is_fresh(
                row,
                snapshot,
                now_ts=current,
                max_age_seconds=_quota_max_age_seconds(),
            ):
                break
            groups = row.get("groups")
            group = groups.get(target_group) if isinstance(groups, dict) else None
            if not isinstance(group, dict):
                break
            for window_name in ("5h", "weekly"):
                window = group.get(window_name)
                if not isinstance(window, dict):
                    continue
                reset_ts = _parse_reset_at(window.get("reset_at"))
                if reset_ts is not None and reset_ts > current:
                    return reset_ts
            break
    return current + DEFAULT_QUOTA_FAMILY_BLOCK_SECONDS


_QUOTA_FAILURE_MARKERS = (
    "resource_exhausted",
    "exceeded your current quota",
    "insufficient_quota",
    "quota exhausted",
    "quota_exhausted",
    "quota exceeded",
    "quota limit reached",
    "quota limit exceeded",
)


def _has_quota_failure_signal(text: str) -> bool:
    lowered = text.lower()
    return any(marker in lowered for marker in _QUOTA_FAILURE_MARKERS)


_PERMISSION_FAILURE_MARKERS = (
    "permission denied",
    "operation not permitted",
    "tool execution permission block",
    "tool permission denied",
    "blocked by active deny rules",
    "blocked by the active security/deny rules",
    "soft-denying tool confirmation",
    "headless mode cannot prompt for",
    "auto-denied",
    "denied by permission rules",
    "now let me restore my changes",
    "scope violation",
    "unauthorized write path",
)


def _has_permission_failure_signal(text: str) -> bool:
    lowered = text.lower()
    return any(marker in lowered for marker in _PERMISSION_FAILURE_MARKERS)


def _permission_scan_text(text: str, run_homes: list[Path]) -> str:
    """#2202: drop Seatbelt's expected EPERM lines for agy's own run-HOME writes.

    ``run_homes`` are the disposable HOMEs of this dispatch's attempts (the
    provider log spans attempts).  A line is dropped only when the boundary
    attributes it to one of them and it carries no permission marker besides
    the EPERM text, so a real tool-permission denial (anywhere) still counts.
    """
    if not text or not run_homes:
        return text
    boundary = _agy_dispatch_boundary()
    kept = []
    for line in text.splitlines(keepends=True):
        if any(boundary.is_expected_run_home_denial(line, home) for home in run_homes):
            residue = line.lower().replace("operation not permitted", "")
            if not _has_permission_failure_signal(residue):
                continue
        kept.append(line)
    return "".join(kept)


def classify_failure(
    returncode: int | None, stdout: str, stderr: str, timed_out: bool
) -> AccountFailureKind:
    """Failure kind of one agy attempt.

    #2415: account-level kinds (quota, rate limit, auth, unavailable,
    disabled), which retire or cool down the account, come only from agy's
    own error channel: its ``AGY_ERROR`` JSON line, else its stderr text.
    stdout is the model's reply in ``--output-format text`` and is never read
    for them.
    """
    if timed_out:
        return AccountFailureKind.TIMEOUT
    text = (stdout + "\n" + stderr).lower()
    # A genuine permission signal is never masked by a quota failure; callers
    # strip the boundary's expected run-HOME noise first (#2202).
    if _has_permission_failure_signal(text):
        return AccountFailureKind.PERMISSION_OR_SCOPE_ERROR
    structured, structured_kind = agy_structured_failure(
        "", stderr, stdout_is_envelope=False
    )
    if structured_kind is not None:
        return structured_kind
    # #2433: without a parsed AGY_ERROR line only the quota markers remain
    # (agy_structured_failure already reads every AGY_ERROR payload).
    if not structured and _has_quota_failure_signal(stderr):
        return AccountFailureKind.QUOTA_EXHAUSTED
    if (
        "invalid model selection" in text
        or "not supported for model" in text
        or "unknown model" in text
        or "unrecognized model" in text
        or "model not found" in text
        or "--effort is not supported" in text
    ):
        return AccountFailureKind.MODEL_OR_TASK_ERROR
    if not structured:
        stderr_kind = agy_stderr_account_failure(stderr)
        if stderr_kind is not None:
            return stderr_kind
    if "nexus_agy_non_progress:pre_effect_tool_thrash" in text:
        return AccountFailureKind.PRE_EFFECT_TOOL_THRASH
    if "nexus_agy_non_progress:provider_stream_no_progress" in text:
        return AccountFailureKind.PROVIDER_STREAM_NO_PROGRESS
    if "nexus_agy_non_progress:provider_stalled" in text:
        return AccountFailureKind.PROVIDER_STALLED
    if returncode == 2:
        return AccountFailureKind.SYNTAX_OR_IMPLEMENTATION_ERROR
    return AccountFailureKind.UNKNOWN


# Only an error/fatal-severity errorreport line for the agent executor itself is
# terminal; warnings, retries, and unrelated diagnostics (title generation) are not.
_AGY_TERMINAL_EXECUTOR_ERROR_RE = re.compile(
    r"(?m)^[EF]\d{4}\s+\S+\s+\d+\s+errorreport\.go:\d+\]\s+"
    r"agent executor error:(?P<detail>[^\n]*)$"
)


def _has_terminal_quota_log_signal(text: str) -> bool:
    return any(
        _has_quota_failure_signal(match.group("detail"))
        for match in _AGY_TERMINAL_EXECUTOR_ERROR_RE.finditer(text)
    )


_AGY_ALIAS_RESOLUTION_RE = re.compile(
    r'model alias "(?P<alias>[^"\n]+)" resolved to "(?P<resolved>[^"\n]+)"'
)
_AGY_RESOLVING_MODEL_RE = re.compile(r"Resolving model (?P<resolved>[^\s]+)")
_AGY_CONVERSATION_RE = re.compile(r"Created conversation (?P<conversation>[0-9a-fA-F-]{36})")
_AGY_INSTRUCTION_TRUNCATION_RE = re.compile(
    r"(?m)^\S+\s+\S+\s+\d+\s+rules\.go:\d+\]\s+"
    r"Rule file (?P<path>.+?) truncated by (?P<truncated>\d{1,12}) bytes "
    r"\(original (?P<original>\d{1,12}) bytes, limit (?P<limit>\d{1,12}) bytes\)",
    re.IGNORECASE,
)


def _parse_input_delivery(text: str) -> dict[str, Any]:
    """Return only positive provider-log evidence of truncated input files."""
    truncations: list[dict[str, Any]] = []
    seen: set[tuple[str, int, int, int]] = set()
    for match in _AGY_INSTRUCTION_TRUNCATION_RE.finditer(text):
        file_name = Path(match.group("path").strip()).name
        observation = (
            file_name,
            int(match.group("original")),
            int(match.group("limit")),
            int(match.group("truncated")),
        )
        if observation in seen:
            continue
        seen.add(observation)
        truncations.append({
            "file_name": file_name,
            "original_bytes": observation[1],
            "limit_bytes": observation[2],
            "truncated_bytes": observation[3],
        })
    if not truncations:
        return {}
    return {
        "input_delivery_state": "TRUNCATED",
        "input_delivery_source": "AGY_LOG",
        "input_delivery_truncations": truncations,
    }


AGY_ATTESTATION_TAMPER_SUSPECT = "AGY_ATTESTATION_TAMPER_SUSPECT"
AGY_LOG_RELAY_INCOMPLETE_MARKER = "NEXUS_AGY_LOG_RELAY_INCOMPLETE"
AGY_LOG_RELAY_ATTEMPT_MARKER = "NEXUS_AGY_LOG_RELAY_ATTEMPT"
AGY_LOG_RELAY_JOIN_SECONDS = 10.0
AGY_LOG_RELAY_MAX_PENDING_BYTES = 1 << 20


def _attempt_attestation_disagrees(text: str, *, requested_model: str | None) -> bool:
    """True when one agy run's relayed log names two models or two conversations."""
    canonical_requested = canonicalize_agy_model(requested_model)
    resolved = {
        match.group("resolved")
        for match in _AGY_ALIAS_RESOLUTION_RE.finditer(text)
        if requested_model is None
        or match.group("alias") in (requested_model, canonical_requested)
    }
    conversations = {match.group("conversation") for match in _AGY_CONVERSATION_RE.finditer(text)}
    return len(resolved) > 1 or len(conversations) > 1


class AgyAttestationLogUnwritable(RuntimeError):
    """The dispatcher cannot write the attestation log; agy must not start."""


_AGY_LOG_RELAY_MARKER_PREFIX = b"NEXUS_AGY_LOG_RELAY"
_AGY_LOG_RELAY_INCOMPLETE_RE = re.compile(rf"(?m)^{AGY_LOG_RELAY_INCOMPLETE_MARKER}:")
_AGY_LOG_RELAY_ATTEMPT_RE = re.compile(
    rf"(?m)^{AGY_LOG_RELAY_ATTEMPT_MARKER} [0-9a-f]{{32}}$"
)


class _AgyLogRelay:
    """Own agy's ``--log-file`` channel so the confined run cannot write it (#2314).

    agy gets the path of a private FIFO instead of the attestation log.  agy
    1.4.0 opens its log once, in-process, at startup (its descriptor is
    close-on-exec, so tool children never inherit it).  As soon as that open
    lands, the relay unlinks the FIFO and its directories, so no later process
    (a tool spawned inside the Seatbelt) can open the channel by path.  The
    relay alone appends what agy writes to ``sink``, the dispatcher-owned
    attestation log, which therefore needs no Seatbelt write grant.

    The FIFO path ends in ``<operation_id>/agy.log`` like the old log path, so
    the journal's provider identity check (``_pid_has_operation_marker``)
    still recognizes agy's command line.  Relayed lines that start with the
    dispatcher's marker prefix are escaped, so only the dispatcher can write
    attempt boundaries.
    """

    def __init__(self, sink: Path, *, fifo_parent: Path | None = None) -> None:
        import tempfile

        self.sink = sink
        self.sink_error: str | None = None
        self.root = Path(
            tempfile.mkdtemp(
                prefix="nexus-agy-log-", dir=str(fifo_parent) if fifo_parent else None
            )
        )
        self.dir = self.root / (sink.parent.name or "operation")
        self.fifo = self.dir / (sink.name or "agy.log")
        self._opened = threading.Event()
        self._finished = False
        try:
            self.dir.mkdir(mode=0o700)
            os.mkfifo(self.fifo, 0o600)
            # Dispatcher-written attempt boundary: corroboration is per agy run.
            # It always starts a line, even after an attempt killed mid-line.
            lead = "\n" if self._sink_needs_newline() else ""
            self._append_sink(
                f"{lead}{AGY_LOG_RELAY_ATTEMPT_MARKER} {uuid.uuid4().hex}\n".encode()
            )
        except OSError as exc:
            self.sink_error = self.sink_error or type(exc).__name__
        if self.sink_error is not None:
            self._remove_endpoint()
            raise AgyAttestationLogUnwritable(
                f"AGY_ATTESTATION_LOG_UNWRITABLE:{self.sink_error}"
            )
        self._thread = threading.Thread(target=self._run, name="agy-log-relay", daemon=True)
        self._thread.start()

    def _open_sink(self) -> int:
        """Open the attestation log: a regular file, never a symlink or FIFO."""
        import stat as _stat

        fd = os.open(
            self.sink,
            os.O_WRONLY
            | os.O_APPEND
            | os.O_CREAT
            | os.O_NONBLOCK
            | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        if not _stat.S_ISREG(os.fstat(fd).st_mode):
            os.close(fd)
            raise OSError(21, "attestation log is not a regular file")
        return fd

    def _sink_needs_newline(self) -> bool:
        """True when a regular, non-empty sink does not end in a newline."""
        import stat as _stat

        try:
            fd = os.open(
                self.sink, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0)
            )
        except OSError:
            return False
        try:
            info = os.fstat(fd)
            if not _stat.S_ISREG(info.st_mode) or info.st_size == 0:
                return False
            return os.pread(fd, 1, info.st_size - 1) != b"\n"
        except OSError:
            return False
        finally:
            os.close(fd)

    def _append_sink(self, data: bytes) -> None:
        try:
            fd = self._open_sink()
        except OSError as exc:
            self.sink_error = type(exc).__name__
            return
        try:
            self._write_all(fd, data)
        except OSError as exc:
            self.sink_error = type(exc).__name__
        finally:
            os.close(fd)

    @staticmethod
    def _write_all(fd: int, data: bytes) -> None:
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view) :]

    def _remove_endpoint(self) -> None:
        for remove, path in (
            (os.unlink, self.fifo),
            (os.rmdir, self.dir),
            (os.rmdir, self.root),
        ):
            try:
                remove(path)
            except OSError:
                pass

    def _relay_write(self, sink_fd: int, data: bytes) -> int | None:
        """Write to the sink; on failure keep draining agy (never block it)."""
        try:
            self._write_all(sink_fd, data)
            return sink_fd
        except OSError as exc:
            self.sink_error = self.sink_error or type(exc).__name__
            os.close(sink_fd)
            return None

    @staticmethod
    def _escape(line: bytes) -> bytes:
        if line.startswith(_AGY_LOG_RELAY_MARKER_PREFIX):
            return b"[agy] " + line
        return line

    def _run(self) -> None:
        try:
            source = os.open(self.fifo, os.O_RDONLY)
        except OSError as exc:
            self.sink_error = f"RELAY_OPEN_FAILED:{type(exc).__name__}"
            self._remove_endpoint()
            return
        self._opened.set()
        self._remove_endpoint()
        sink_fd: int | None = None
        try:
            sink_fd = self._open_sink()
        except OSError as exc:
            self.sink_error = type(exc).__name__
        pending = b""
        try:
            while True:
                chunk = os.read(source, 65536)
                if not chunk:
                    break
                pending += chunk
                *lines, pending = pending.split(b"\n")
                if len(pending) > AGY_LOG_RELAY_MAX_PENDING_BYTES:
                    lines.append(pending)  # an unbounded line is flushed as-is
                    pending = b""
                if lines and sink_fd is not None:
                    sink_fd = self._relay_write(
                        sink_fd, b"".join(self._escape(line) + b"\n" for line in lines)
                    )
            if pending and sink_fd is not None:
                sink_fd = self._relay_write(sink_fd, self._escape(pending) + b"\n")
        except OSError as exc:
            self.sink_error = self.sink_error or type(exc).__name__
        finally:
            os.close(source)
            if sink_fd is not None:
                os.close(sink_fd)

    def finish(self, *, timeout: float = AGY_LOG_RELAY_JOIN_SECONDS) -> bool:
        """Wait for agy's end of the channel to close; True only when fully relayed."""
        if not self._finished:
            self._finished = True
            deadline = time.monotonic() + max(0.0, timeout)
            # agy may never have opened its log: release the reader blocked in
            # open().  ENXIO means the reader is not in open() yet, so retry.
            while (
                not self._opened.is_set()
                and self._thread.is_alive()
                and time.monotonic() < deadline
            ):
                try:
                    os.close(os.open(self.fifo, os.O_WRONLY | os.O_NONBLOCK))
                    break
                except OSError:
                    time.sleep(0.01)
            self._thread.join(max(0.0, deadline - time.monotonic()))
            self._remove_endpoint()
            if self._thread.is_alive():
                # Something besides agy still holds the write end: the log can
                # no longer be attested.
                self._append_sink(
                    f"\n{AGY_LOG_RELAY_INCOMPLETE_MARKER}:WRITER_OUTLIVED_AGY\n".encode()
                )
        return not self._thread.is_alive() and self.sink_error is None


def _parse_agy_attestation(
    log_path: Path,
    *,
    requested_model: str | None,
) -> dict[str, str | None]:
    """Parse Agy-owned execution witnesses without trusting configured identity."""
    try:
        text = log_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {
            "observed_provider": None,
            "observed_model": None,
            "provider_session_id": None,
            **_parse_input_delivery(""),
        }

    input_delivery = _parse_input_delivery(text)
    # #2314: in a relayed log the witnesses come from the last agy run only;
    # a log without relay markers (pre-#2314) keeps last-match-wins.
    segments = _AGY_LOG_RELAY_ATTEMPT_RE.split(text)[1:]
    scope = segments[-1] if segments else text

    canonical_requested = canonicalize_agy_model(requested_model)
    resolved_models: list[str] = []
    for match in _AGY_ALIAS_RESOLUTION_RE.finditer(scope):
        alias = match.group("alias")
        if (
            requested_model is None
            or alias == requested_model
            or (canonical_requested and alias == canonical_requested)
        ):
            resolved_models.append(match.group("resolved"))
    if not resolved_models and requested_model:
        for match in _AGY_RESOLVING_MODEL_RE.finditer(scope):
            resolved = match.group("resolved")
            if resolved == requested_model or (
                canonical_requested and resolved == canonical_requested
            ):
                resolved_models.append(resolved)

    conversations = [
        match.group("conversation") for match in _AGY_CONVERSATION_RE.finditer(scope)
    ]
    # #2314: the log is relayed by the dispatcher, so the confined run cannot
    # append to it.  Corroborate anyway and fail closed, with a distinct marker,
    # when one relayed attempt resolved the requested alias to more than one
    # model or created more than one conversation (zero cases in 1846 real
    # operation logs), or the relay saw a writer outlive agy.
    if _AGY_LOG_RELAY_INCOMPLETE_RE.search(text) or any(
        _attempt_attestation_disagrees(segment, requested_model=requested_model)
        for segment in segments
    ):
        return {
            "observed_provider": None,
            "observed_model": None,
            "provider_session_id": None,
            "attestation_failure": AGY_ATTESTATION_TAMPER_SUSPECT,
            **input_delivery,
        }
    if not resolved_models or not conversations:
        return {
            "observed_provider": None,
            "observed_model": None,
            "provider_session_id": None,
            **input_delivery,
        }
    return {
        "observed_provider": "agy",
        "observed_model": resolved_models[-1],
        "provider_session_id": conversations[-1],
        **input_delivery,
    }


def run_agy(
    *,
    env: dict[str, str],
    prompt: str,
    cwd: str,
    mode: str,
    model: str | None,
    effort: str | None,
    timeout: int,
    operation_hook: Any = None,
    expect_coding_progress: bool = False,
    provider_stall_seconds: float | None = None,
    stream_no_progress_seconds: float | None = None,
    pre_effect_max_seconds: float | None = None,
    pre_effect_max_tool_events: int | None = None,
    write_boundary: Any = None,
    lease_fd: int | None = None,
):
    expect_coding_progress = bool(expect_coding_progress and mode == "accept-edits")
    if mode == "accept-edits":
        # #2202: never launch an editing Agy run without the Seatbelt write
        # boundary, disposable HOME, exact env and descendant sweep.
        if write_boundary is None:
            raise RuntimeError("AGY_WRITE_BOUNDARY_REQUIRED")
        env = write_boundary.env
    agy = shutil.which("agy")
    if not agy:
        raise RuntimeError("AGY_BINARY_NOT_FOUND")
    argv = [
        agy,
        "--new-project",
        "--add-dir",
        cwd,
        "--mode",
        mode,
        "--output-format",
        "text",
        "--print-timeout",
        f"{timeout}s",
    ]
    attestation_log = os.getenv("NEXUS_AGY_ATTESTATION_LOG")
    log_relay: _AgyLogRelay | None = None
    if attestation_log:
        Path(attestation_log).expanduser().parent.mkdir(parents=True, exist_ok=True)
    canonical_model = canonicalize_agy_model(model)
    if canonical_model:
        argv += ["--model", canonical_model]
    if effort:
        argv += ["--effort", effort]
    argv += ["--print", prompt]

    baseline_worktree_state = None
    try:
        baseline_worktree_state = direct_operation_journal.capture_source_baseline(cwd)
        if baseline_worktree_state is None:
            raise RuntimeError("SOURCE_BASELINE_UNAVAILABLE")
    except Exception as exc:
        if operation_hook:
            _operation_hook(
                operation_hook,
                effect_observation_error=f"BASELINE_CAPTURE_FAILED:{type(exc).__name__}",
            )

    provider_log_path = Path(attestation_log).expanduser() if attestation_log else None
    if provider_log_path is not None:
        try:
            provider_log_offset = provider_log_path.stat().st_size
        except OSError:
            provider_log_offset = 0
    else:
        provider_log_offset = 0

    started = time.monotonic()
    if provider_log_path is not None:
        # #2314: agy writes a relay FIFO, never the attestation log itself.
        log_relay = _AgyLogRelay(
            provider_log_path,
            fifo_parent=getattr(write_boundary, "run_root", None),
        )
        argv[-2:-2] = ["--log-file", str(log_relay.fifo)]
    try:
        launch_argv = argv
        if write_boundary is not None:
            launch_argv = write_boundary.wrap_argv(argv)
            write_boundary.before_launch()
        provider_env = _popen_env(write_boundary, env)
        try:
            process = subprocess.Popen(
                launch_argv,
                cwd=cwd,
                # #2884: the worker-account boundary launches sudo with a fixed
                # minimal environment; the wrapper builds agy's own.
                env=provider_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
                start_new_session=True,
                # #2717: the provider inherits the per-account lease lock, so the
                # account stays locked while any provider outlives this dispatcher.
                pass_fds=(lease_fd,) if isinstance(lease_fd, int) and lease_fd > 2 else (),
            )
        except OSError as exc:
            # Only an error the child reported (exec or chdir, which carries a
            # filename) proves no child is left: CPython reaps that child before
            # raising.  An OSError in the parent after fork may leave sudo
            # running, so the launch still counts as possibly started.
            launch_failed = getattr(write_boundary, "launch_failed_before_spawn", None)
            if launch_failed is not None and exc.filename is not None:
                launch_failed()
            raise
    except BaseException:
        if log_relay is not None:
            log_relay.finish(timeout=2.0)
        raise
    provider_pid = getattr(process, "pid", None)
    if write_boundary is not None and isinstance(provider_pid, int):
        try:
            write_boundary.after_launch(provider_pid)
        except BaseException:
            # The boundary's cleanup sweep stops agy; the relay is then
            # unattestable, which finish() records (fail closed).
            if log_relay is not None:
                log_relay.finish(timeout=2.0)
            raise
    provider_pgid: int | None = (
        provider_pid if isinstance(provider_pid, int) and provider_pid > 0 else None
    )
    if provider_pgid is not None:
        try:
            provider_pgid = os.getpgid(provider_pid)
        except OSError:
            # start_new_session=True establishes a fresh session/process group
            # whose PGID is the child PID. Preserve that deterministic identity
            # even if a very short-lived child exits before getpgid() readback.
            provider_pgid = provider_pid
    if operation_hook:
        try:
            _operation_hook(
                operation_hook,
                phase="PROVIDER_RUNNING",
                provider_pid=provider_pid,
                provider_pgid=provider_pgid,
                provider_process_state="RUNNING",
                provider_started_at=_agy_operation_journal.utc_now(),
            )
        except Exception as hook_exc:
            # A provider whose durable physical identity cannot be persisted
            # must not continue. This frame still owns the live Popen/session,
            # so bounded cleanup is authorized without trusting a later PID.
            if provider_pgid is not None:
                try:
                    _agy_operation_journal._stop_process_group(
                        provider_pgid,
                        grace_seconds=2.0,
                    )
                except Exception:
                    pass
            if process.poll() is None and isinstance(provider_pid, int):
                try:
                    _agy_operation_journal._stop_process(
                        provider_pid,
                        grace_seconds=2.0,
                    )
                except Exception:
                    pass
            provider_alive = isinstance(
                provider_pid, int
            ) and _agy_operation_journal._process_alive(provider_pid)
            group_alive = provider_pgid is not None and _agy_operation_journal._process_group_alive(
                provider_pgid
            )
            if log_relay is not None:
                log_relay.finish()
            if provider_alive or group_alive:
                raise RuntimeError(
                    "PROVIDER_IDENTITY_PERSIST_FAILED_CLEANUP_UNVERIFIED"
                ) from hook_exc
            raise

    stdout_lines: list[str] = []
    stderr_lines: list[str] = []
    quota_failure = threading.Event()
    first_stream_seen = threading.Event()
    first_effect_seen = threading.Event()
    first_stream_monotonic: float | None = None
    non_progress_failure: str | None = None
    resolved_provider_stall_seconds = (
        _provider_stall_seconds()
        if provider_stall_seconds is None
        else max(0.1, float(provider_stall_seconds))
    )
    resolved_stream_no_progress_seconds = (
        _stream_no_progress_seconds()
        if stream_no_progress_seconds is None
        else max(0.1, float(stream_no_progress_seconds))
    )
    resolved_pre_effect_max_seconds = (
        _pre_effect_max_seconds()
        if pre_effect_max_seconds is None
        else max(0.1, float(pre_effect_max_seconds))
    )
    resolved_pre_effect_max_tool_events = (
        _pre_effect_max_tool_events()
        if pre_effect_max_tool_events is None
        else max(1, int(pre_effect_max_tool_events))
    )
    provider_session_id: str | None = None
    transcript_path: Path | None = None
    transcript_offset = 0
    tool_event_count = 0
    first_tool_activity_at: str | None = None
    first_tool_monotonic: float | None = None
    last_coding_progress_monotonic: float | None = None

    def _record_tool_events(count: int, *, observed_at: float) -> None:
        nonlocal tool_event_count, first_tool_activity_at, first_tool_monotonic
        nonlocal last_coding_progress_monotonic
        if count <= 0:
            return
        tool_event_count += count
        last_coding_progress_monotonic = observed_at
        now_iso = _agy_operation_journal.utc_now()
        payload: dict[str, Any] = {
            "tool_event_count": tool_event_count,
            "last_progress_activity_at": now_iso,
        }
        if first_tool_activity_at is None:
            first_tool_activity_at = now_iso
            first_tool_monotonic = observed_at
            payload["first_tool_activity_at"] = first_tool_activity_at
        if operation_hook:
            _operation_hook(operation_hook, **payload)

    def _advance_provider_sessions(
        sessions: list[str],
        *,
        observed_at: float,
    ) -> None:
        nonlocal provider_session_id, transcript_path, transcript_offset
        for session_id in sessions:
            if session_id == provider_session_id:
                continue
            if transcript_path is not None:
                transcript_offset, prior_tool_events = _read_new_tool_activity(
                    transcript_path,
                    offset=transcript_offset,
                )
                _record_tool_events(prior_tool_events, observed_at=observed_at)
            provider_session_id = session_id
            transcript_path = _agy_transcript_path(env, provider_session_id)
            transcript_offset = 0
            if operation_hook:
                _operation_hook(
                    operation_hook,
                    provider_session_id=provider_session_id,
                )

    def _refresh_progress_telemetry(*, observed_at: float) -> None:
        nonlocal provider_log_offset, transcript_offset, first_stream_monotonic
        if provider_log_path is not None:
            (
                provider_log_offset,
                stream_events,
                new_sessions,
            ) = _read_new_provider_log_activity(
                provider_log_path,
                offset=provider_log_offset,
            )
            if new_sessions:
                _advance_provider_sessions(new_sessions, observed_at=observed_at)
            if stream_events:
                now_iso = _agy_operation_journal.utc_now()
                if first_stream_monotonic is None:
                    first_stream_monotonic = observed_at
                if not first_stream_seen.is_set():
                    first_stream_seen.set()
                    if operation_hook:
                        _operation_hook(
                            operation_hook,
                            first_stream_activity_at=now_iso,
                            provider_stream_last_activity_at=now_iso,
                        )
                elif operation_hook:
                    _operation_hook(
                        operation_hook,
                        provider_stream_last_activity_at=now_iso,
                    )

        if transcript_path is not None:
            transcript_offset, new_tool_events = _read_new_tool_activity(
                transcript_path,
                offset=transcript_offset,
            )
            _record_tool_events(new_tool_events, observed_at=observed_at)

    def _classify_non_progress(*, observed_at: float) -> str | None:
        if (
            not first_stream_seen.is_set()
            and tool_event_count == 0
            and observed_at - started >= resolved_provider_stall_seconds
        ):
            return "PROVIDER_STALLED"
        if not expect_coding_progress:
            return None
        if first_tool_monotonic is not None and (
            observed_at - first_tool_monotonic >= resolved_pre_effect_max_seconds
            or tool_event_count >= resolved_pre_effect_max_tool_events
        ):
            return "PRE_EFFECT_TOOL_THRASH"
        if first_stream_monotonic is not None:
            progress_anchor = max(
                first_stream_monotonic,
                (
                    last_coding_progress_monotonic
                    if last_coding_progress_monotonic is not None
                    else first_stream_monotonic
                ),
            )
            if observed_at - progress_anchor >= resolved_stream_no_progress_seconds:
                return "PROVIDER_STREAM_NO_PROGRESS"
        return None

    def _drain_stdout(stream, sink: list[str]) -> None:
        nonlocal first_stream_monotonic
        if stream is None:
            return
        for line in iter(stream.readline, ""):
            sink.append(line)
            if not line.strip():
                continue
            now_iso = _agy_operation_journal.utc_now()
            if not first_stream_seen.is_set():
                first_stream_monotonic = time.monotonic()
                first_stream_seen.set()
                if operation_hook:
                    _operation_hook(
                        operation_hook,
                        first_stream_activity_at=now_iso,
                        provider_stream_last_activity_at=now_iso,
                    )
            elif operation_hook:
                _operation_hook(
                    operation_hook,
                    provider_stream_last_activity_at=now_iso,
                )
        stream.close()

    def _drain_stderr(stream, sink: list[str], *, detect_quota: bool = False) -> None:
        if stream is None:
            return
        for line in iter(stream.readline, ""):
            sink.append(line)
            if detect_quota and _has_quota_failure_signal(line):
                quota_failure.set()
        stream.close()

    stdout_thread = threading.Thread(
        target=_drain_stdout,
        args=(process.stdout, stdout_lines),
        daemon=True,
    )
    stderr_thread = threading.Thread(
        target=_drain_stderr,
        args=(process.stderr, stderr_lines),
        kwargs={"detect_quota": True},
        daemon=True,
    )
    stdout_thread.start()
    stderr_thread.start()

    timed_out = False
    quota_terminated = False
    deadline = started + max(1, timeout) + 10
    next_effect_observation_at = started
    try:
        while process.poll() is None:
            now = time.monotonic()

            _refresh_progress_telemetry(observed_at=now)

            # A plan run is judged stalled only when a provider stream signal exists
            # (attestation log, background operations). A foreground plan run has none:
            # its stdout stays empty while the model thinks, so the cut-off measured time
            # to the first answer byte and killed live answers. The timeout still bounds it.
            if (
                expect_coding_progress
                or (
                    mode == "plan"
                    and provider_stall_seconds is not None
                    and provider_log_path is not None
                )
            ) and not first_effect_seen.is_set():
                non_progress_failure = _classify_non_progress(observed_at=now)
                if non_progress_failure is not None:
                    # Telemetry can become durable after the regular poll but before
                    # termination. Refresh it at the watchdog boundary, then classify
                    # again so a stale observation cannot kill or misclassify progress.
                    boundary_now = time.monotonic()
                    _refresh_progress_telemetry(observed_at=boundary_now)
                    non_progress_failure = _classify_non_progress(
                        observed_at=boundary_now
                    )

                if non_progress_failure is not None:
                    # Source mutation is the strongest positive progress witness.
                    # Recheck immediately at the watchdog boundary so an effect
                    # that lands between regular scans is not misclassified.
                    if baseline_worktree_state is not None:
                        try:
                            changed = direct_operation_journal.observed_changed_paths_since(
                                cwd, baseline_worktree_state
                            )
                        except Exception as exc:
                            changed = None
                            baseline_worktree_state = None
                            if operation_hook:
                                _operation_hook(
                                    operation_hook,
                                    effect_observation_error=(
                                        f"WATCHDOG_EFFECT_OBSERVATION_FAILED:{type(exc).__name__}"
                                    ),
                                )
                        if changed:
                            first_effect_seen.set()
                            non_progress_failure = None
                            now_effect_iso = _agy_operation_journal.utc_now()
                            effect_wall_ms = int((time.monotonic() - started) * 1000)
                            last_coding_progress_monotonic = boundary_now
                            if operation_hook:
                                _operation_hook(
                                    operation_hook,
                                    first_effect_at=now_effect_iso,
                                    time_to_first_effect_ms=effect_wall_ms,
                                    last_progress_activity_at=now_effect_iso,
                                )
                    if non_progress_failure is not None:
                        if provider_pgid is not None:
                            _agy_operation_journal._stop_process_group(
                                provider_pgid,
                                grace_seconds=2.0,
                            )
                        else:
                            process.terminate()
                        break

            if (
                baseline_worktree_state is not None
                and not first_effect_seen.is_set()
                and now >= next_effect_observation_at
            ):
                next_effect_observation_at = now + _EFFECT_OBSERVATION_INTERVAL_SECONDS
                try:
                    changed = direct_operation_journal.observed_changed_paths_since(
                        cwd, baseline_worktree_state
                    )
                    if changed is None:
                        baseline_worktree_state = None
                        if operation_hook:
                            _operation_hook(
                                operation_hook,
                                effect_observation_error="EFFECT_OBSERVATION_UNAVAILABLE",
                            )
                    elif changed:
                        first_effect_seen.set()
                        now_effect_iso = _agy_operation_journal.utc_now()
                        effect_wall_ms = int((time.monotonic() - started) * 1000)
                        if operation_hook:
                            _operation_hook(
                                operation_hook,
                                first_effect_at=now_effect_iso,
                                time_to_first_effect_ms=effect_wall_ms,
                                last_progress_activity_at=now_effect_iso,
                            )
                except Exception as exc:
                    baseline_worktree_state = None
                    if operation_hook:
                        _operation_hook(
                            operation_hook,
                            effect_observation_error=f"EFFECT_OBSERVATION_FAILED:{type(exc).__name__}",
                        )
            if quota_failure.wait(0.05):
                quota_terminated = True
                if provider_pgid is not None:
                    _agy_operation_journal._stop_process_group(
                        provider_pgid,
                        grace_seconds=2.0,
                    )
                else:
                    process.terminate()
                break
            if time.monotonic() >= deadline:
                timed_out = True
                if provider_pgid is not None:
                    _agy_operation_journal._stop_process_group(
                        provider_pgid,
                        grace_seconds=2.0,
                    )
                else:
                    process.terminate()
                break
            time.sleep(0.05)

        if process.poll() is None:
            # #2884: a worker-account agy runs under another uid that the
            # process-group stop above cannot signal; stop it as the worker.
            terminate_worker = getattr(write_boundary, "terminate_worker", None)
            if terminate_worker is not None:
                terminate_worker()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                if provider_pgid is not None:
                    _agy_operation_journal._stop_process_group(
                        provider_pgid,
                        grace_seconds=2.0,
                    )
                else:
                    process.kill()
                process.wait(timeout=2)
    finally:
        if provider_pgid is not None and _agy_operation_journal._process_group_alive(provider_pgid):
            try:
                _agy_operation_journal._stop_process_group(
                    provider_pgid,
                    grace_seconds=2.0,
                )
            except Exception:
                pass
        if process.poll() is None and isinstance(provider_pid, int):
            try:
                _agy_operation_journal._stop_process(
                    provider_pid,
                    grace_seconds=2.0,
                )
            except Exception:
                pass
        if log_relay is not None and not log_relay.finish():
            # #2314: a partial or unwritable relay cannot attest this run.
            if operation_hook:
                try:
                    _operation_hook(
                        operation_hook,
                        attestation_failure=AGY_ATTESTATION_TAMPER_SUSPECT,
                        attestation_failure_reason=(
                            "LOG_RELAY_INCOMPLETE:"
                            f"{log_relay.sink_error or 'WRITER_OUTLIVED_AGY'}"
                        ),
                    )
                except Exception:
                    pass

    # #2202: a descendant that survives the provider (setsid, cleared env,
    # cwd inside the target or run root) is killed; an unproven sweep fails
    # the attempt.
    descendants_swept = write_boundary.sweep() if write_boundary is not None else True

    stdout_thread.join(timeout=2)
    stderr_thread.join(timeout=2)
    out = "".join(stdout_lines)
    err = "".join(stderr_lines)
    stderr_lower = err.lower()
    agy_print_timed_out = (
        "[agy] print timeout after" in stderr_lower and "turn in progress" in stderr_lower
    )

    # Final provider-metadata readback closes the same short-lived race as the
    # final source-delta readback below. A provider may write its stream/session
    # or transcript after the last loop poll and exit immediately afterward.
    (
        provider_log_offset,
        final_stream_events,
        final_sessions,
    ) = _read_new_provider_log_activity(
        provider_log_path,
        offset=provider_log_offset,
    )
    if final_sessions:
        _advance_provider_sessions(
            final_sessions,
            observed_at=time.monotonic(),
        )
    if final_stream_events:
        now_iso = _agy_operation_journal.utc_now()
        if first_stream_monotonic is None:
            first_stream_monotonic = time.monotonic()
        if not first_stream_seen.is_set():
            first_stream_seen.set()
            if operation_hook:
                _operation_hook(
                    operation_hook,
                    first_stream_activity_at=now_iso,
                    provider_stream_last_activity_at=now_iso,
                )
        elif operation_hook:
            _operation_hook(
                operation_hook,
                provider_stream_last_activity_at=now_iso,
            )
    if transcript_path is not None:
        transcript_offset, final_tool_events = _read_new_tool_activity(
            transcript_path,
            offset=transcript_offset,
        )
        _record_tool_events(final_tool_events, observed_at=time.monotonic())

    # A short-lived provider can mutate the worktree and exit between polling
    # intervals. Perform one final source-delta readback before projecting EXITED
    # so time-to-first-effect does not silently miss that physical change.
    if baseline_worktree_state is not None and not first_effect_seen.is_set():
        try:
            changed = direct_operation_journal.observed_changed_paths_since(
                cwd, baseline_worktree_state
            )
            if changed is None:
                baseline_worktree_state = None
                if operation_hook:
                    _operation_hook(
                        operation_hook,
                        effect_observation_error="EFFECT_OBSERVATION_UNAVAILABLE",
                    )
            elif changed:
                first_effect_seen.set()
                now_effect_iso = _agy_operation_journal.utc_now()
                effect_wall_ms = int((time.monotonic() - started) * 1000)
                if operation_hook:
                    _operation_hook(
                        operation_hook,
                        first_effect_at=now_effect_iso,
                        time_to_first_effect_ms=effect_wall_ms,
                        last_progress_activity_at=now_effect_iso,
                    )
        except Exception as exc:
            baseline_worktree_state = None
            if operation_hook:
                _operation_hook(
                    operation_hook,
                    effect_observation_error=f"EFFECT_OBSERVATION_FAILED:{type(exc).__name__}",
                )

    wall_ms = int((time.monotonic() - started) * 1000)

    if operation_hook:
        _operation_hook(
            operation_hook,
            provider_process_state="EXITED",
        )

    if not descendants_swept:
        err += f"\n{DESCENDANT_SWEEP_FAILED_MARKER}\n"
        return (
            process.returncode if process.returncode not in (None, 0) else 1,
            out,
            err,
            False,
            wall_ms,
        )
    if non_progress_failure is not None:
        err += f"\nNEXUS_AGY_NON_PROGRESS:{non_progress_failure}\n"
        return (
            process.returncode if process.returncode not in (None, 0) else 1,
            out,
            err,
            False,
            wall_ms,
        )
    if timed_out:
        return None, out, err, True, wall_ms
    if quota_terminated:
        return (
            process.returncode if process.returncode not in (None, 0) else 1,
            out,
            err,
            False,
            wall_ms,
        )
    return process.returncode, out, err, agy_print_timed_out, wall_ms


AGY_WRITE_BOUNDARY_UNAVAILABLE = "AGY_WRITE_BOUNDARY_UNAVAILABLE"
AGY_WRITE_BOUNDARY_RUNNER_UNSUPPORTED = "AGY_WRITE_BOUNDARY_RUNNER_UNSUPPORTED"
AGY_WRITE_BOUNDARY_PREPARE_FAILED = "AGY_WRITE_BOUNDARY_PREPARE_FAILED"
AGY_DESCENDANT_SWEEP_FAILED = "AGY_DESCENDANT_SWEEP_FAILED"
# #2888: the lease receipt could not record the worker run before launch.
AGY_WORKER_LEASE_MARK_FAILED = "AGY_WORKER_LEASE_MARK_FAILED"
DESCENDANT_SWEEP_FAILED_MARKER = "NEXUS_AGY_DESCENDANT_SWEEP_FAILED"


def _neutralize_relayed_stderr(err: str) -> str:
    """The provider's stderr as relayed on ours: no part of it may pass for our lines.

    The provider (with --run-as-user, a process of the worker account) can print
    anything, including lines shaped like the status line or the WORKER_*
    receipts. Every piece that would start a line for any reader (split on any
    line boundary ``str.splitlines`` knows, leading blanks ignored) and begins
    like a dispatcher line gets a prefix. Classification still reads the raw text.

    A reader that cuts an over-long line at a fixed buffer size can start a line
    anywhere inside it, so the token is also broken wherever it appears
    (``NEXUS_AGY_DISPATCH`` -> ``NEXUS-AGY-DISPATCH``, #2888): no cut of the
    relayed text can begin like a dispatcher line.  One pass is complete: the
    token has no self-overlap and the replacement cannot complete it.
    """
    if "NEXUS_AGY_DISPATCH" not in err:
        return err
    prefixed = "".join(
        "[provider] " + piece if piece.lstrip().startswith("NEXUS_AGY_DISPATCH") else piece
        for piece in err.splitlines(keepends=True)
    )
    return prefixed.replace("NEXUS_AGY_DISPATCH", "NEXUS-AGY-DISPATCH")


def _agy_dispatch_boundary() -> Any:
    """The #2202 boundary module, loaded from the snapshot on first use."""
    return import_module("nexus.executors.agy_dispatch_boundary")


def _agy_worker_account() -> Any:
    """The #2884 worker-account boundary module, loaded from the snapshot on first use."""
    return import_module("nexus.executors.agy_worker_account")


RUN_AS_USER_REQUIRES_ACCEPT_EDITS = "RUN_AS_USER_REQUIRES_ACCEPT_EDITS"


def _remap_rules_to_workdir(rules: list[str], cwd: str, workdir: str) -> list[str]:
    """Rewrite path rules naming ``cwd`` (or a path inside it) to the worker copy (#2884)."""
    root = str(Path(cwd).expanduser().resolve())
    remapped: list[str] = []
    for rule in rules:
        match = re.fullmatch(r"(?P<kind>[a-z_]+)\((?P<path>.*)\)", rule)
        if match is not None:
            path = match.group("path")
            if path == root or path.startswith(root + "/"):
                rule = f"{match.group('kind')}({workdir}{path[len(root):]})"
        if rule not in remapped:
            remapped.append(rule)
    return remapped


def _popen_env(write_boundary: Any, env: dict[str, str]) -> dict[str, str]:
    launch_env = getattr(write_boundary, "launch_env", None)
    return dict(launch_env) if launch_env else env


def _write_boundary_available() -> bool:
    try:
        return bool(_agy_dispatch_boundary().boundary_available())
    except Exception:
        # A snapshot without the boundary module cannot confine the run.
        return False


def _runner_accepts(runner: Any, name: str) -> bool:
    """True when ``runner`` takes a parameter ``name`` (#2314: not just a local)."""
    if runner is run_agy:
        return True
    code = getattr(runner, "__code__", None)
    if code is None:
        return False
    params = code.co_varnames[: code.co_argcount + code.co_kwonlyargcount]
    return name in params


def emit_meta(data: dict) -> None:
    sys.stderr.write("NEXUS_AGY_DISPATCH " + json.dumps(data, sort_keys=True) + "\n")


def _runtime_revision() -> str | None:
    receipt = Path.home() / ".local/share/nexus-host-runtime/current/host-generation.json"
    try:
        data = json.loads(receipt.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    value = data.get("source_revision")
    return value if isinstance(value, str) and value else None


# One wall-clock budget (--timeout) covers every attempt and account rotation
# of a single dispatch. No further attempt starts below this floor (#1216 V12).
TOTAL_DEADLINE_MIN_ATTEMPT_SECONDS = 5.0
# #2905: the orphan run-root GC removes at most WORKER_GC_MAX_ROOTS roots per
# pass (up to three ps probes and two wrapper sweeps, at most 90 s of
# subprocess timeouts) and runs only when more than this much of the dispatch
# budget remains.
WORKER_GC_MAX_ROOTS = 2
WORKER_GC_MIN_REMAINING_SECONDS = 120.0
_monotonic = time.monotonic

MAX_FAILURE_HISTORY_ENTRIES = 16


def _pool_busy_failure_fields(exc: Any) -> dict[str, Any]:
    """#1681: a busy-pool exit must persist its failure_kind, not a stale earlier one."""
    return {"failure_kind": "AGY_ACCOUNT_POOL_BUSY"} if exc.busy else {}


def _operation_hook(callback: Any, **payload: Any) -> None:
    if callback is not None:
        callback(payload)


_DESCENDANT_SWEEP_KEYS = _agy_operation_journal.DESCENDANT_SWEEP_KEYS
_WORKER_SWEEP_KEYS = ("worker_run_as_user", "worker_run_root", "worker_run_root_id")
_descendant_sweep_unproven = _agy_operation_journal.descendant_sweep_unproven


def _record_descendant_sweep(callback: Any, write_boundary: Any, attempt: int) -> None:
    """Record the attempt's sweep verdict while an exception propagates (#2470).

    The sweep runs once; a recorded result is reused. A sweep that cannot
    finish (it raised, or a second signal interrupted it) counts as unclean.
    Recording never replaces the propagating exception. When the write itself
    fails, the durable pending marker (``descendant_sweep_clean=None``) written
    before launch stays, and readers treat it as unclean.
    """
    try:
        clean = bool(write_boundary.sweep())
    except BaseException:
        clean = False
    try:
        _operation_hook(callback, descendant_sweep_clean=clean, descendant_sweep_attempt=attempt)
    except BaseException as exc:
        sys.stderr.write(
            f"nexus-agy-dispatch: could not record descendant_sweep_clean={clean}: "
            f"{type(exc).__name__}\n"
        )


TEMP_COMMAND_DENY = [
    "command(git push)",
    "command(git reset --hard)",
    "command(git reset)",
    "command(git checkout)",
    "command(git restore)",
    "command(git stash)",
    "command(git commit)",
    "command(git branch)",
    "command(git merge)",
    "command(git rebase)",
    "command(git cherry-pick)",
    "command(git revert)",
    "command(git clean)",
    "command(gh)",
    "command(curl)",
    "command(wget)",
    "command(ssh)",
    "command(scp)",
    "command(rsync)",
]

# NO_TOOL_PACKET runs replace (never inherit) the lease account's persisted
# allow/deny lists: a stale persisted ``command(*)`` would otherwise stay active.
NO_TOOL_DENY = [
    "command(*)",
    "read_file(*)",
    "write_file(*)",
]
NO_TOOL_PROFILE_VIOLATION = "NO_TOOL_PROFILE_VIOLATION"

# #2411: agy's plan mode prefixes the prompt with ``/plan`` and the model then
# probes tools (``echo``, ``view_file``, ``ls``) although the packet says it has
# none.  NO_TOOL_DENY makes agy refuse every such call before it runs.  In 48 h
# all 39 NO_TOOL_PROFILE_VIOLATION runs had only refused calls and a complete
# answer, which was discarded.  The answer is returned only when the transcript
# proves that every tool call was refused and no other step ran.
# agy's two refusal shapes, matched in full because parts of them carry
# model-supplied arguments.  Each refused result is paired, in order, with the
# tool call it answers, and the refusal must name that call's tool, so a failed
# tool whose error echoes a crafted argument cannot pass as a refusal.
# The cortex shape fails while converting the call for the permission check;
# the tool does not run, but agy may stat the path, so the model can learn
# whether a path exists.
_NO_TOOL_DENY_RULE_RE = re.compile(
    r'permission check failed for (unsandboxed|read_file|write_file) "(?:[^"\\]|\\.)*": '
    r"permission denied for \1\(.*\)\. matches user-configured deny rule\.",
    re.DOTALL,
)
_NO_TOOL_DECLARATION_RE = re.compile(
    r"declaring permissions: cortex tool ([a-z_]+): convert tool call for permissions: "
    r"model output error: invalid tool call error \(invalid_args\) .*",
    re.DOTALL,
)
_NO_TOOL_DENY_RULE_TOOLS = {
    "unsandboxed": frozenset({"run_command"}),
    "read_file": frozenset({"view_file", "view_file_outline", "list_dir", "grep_search"}),
    "write_file": frozenset({
        "write_to_file",
        "replace_file_content",
        "multi_replace_file_content",
    }),
}
# Only file tools fail in permission declaration; a run_command error that
# starts with a crafted cwd must not pass as one.
_NO_TOOL_DECLARATION_TOOLS = (
    _NO_TOOL_DENY_RULE_TOOLS["read_file"] | _NO_TOOL_DENY_RULE_TOOLS["write_file"]
)
_NO_TOOL_PASSIVE_STEP_TYPES = frozenset({"USER_INPUT", "PLANNER_RESPONSE"})


def _no_tool_refused_tool_call_count(transcript_path: Path | None) -> int | None:
    """Return the tool-call count when every call was refused before running.

    Reads agy's ``transcript_full.jsonl``.  Returns ``None`` (fail closed) when
    the transcript is missing or malformed, has no tool calls, has a step other
    than user input, model responses, system error messages and refused tool
    results, or a result that is not agy's refusal of the call it answers.
    """
    if transcript_path is None:
        return None
    try:
        text = transcript_path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    pending: list[str] = []
    calls = 0
    refused = 0
    for line in text.splitlines():
        if not line.strip():
            continue
        try:
            step = json.loads(line)
        except json.JSONDecodeError:
            return None
        if not isinstance(step, dict):
            return None
        step_type = step.get("type")
        tool_calls = step.get("tool_calls")
        if tool_calls is not None:
            if step_type != "PLANNER_RESPONSE" or not isinstance(tool_calls, list):
                return None
            for call in tool_calls:
                if not isinstance(call, dict) or not isinstance(call.get("name"), str):
                    return None
                pending.append(call["name"])
            calls += len(tool_calls)
        if step_type in _NO_TOOL_PASSIVE_STEP_TYPES:
            continue
        if step_type == "ERROR_MESSAGE" and step.get("source") == "SYSTEM":
            continue
        if step.get("status") != "ERROR" or not pending:
            return None
        tool = pending.pop(0)
        error = str(step.get("error") or "").strip().lower()
        deny = _NO_TOOL_DENY_RULE_RE.fullmatch(error)
        declaration = _NO_TOOL_DECLARATION_RE.fullmatch(error)
        if deny is not None:
            if tool not in _NO_TOOL_DENY_RULE_TOOLS[deny.group(1)]:
                return None
        elif (
            declaration is None
            or declaration.group(1) != tool
            or tool not in _NO_TOOL_DECLARATION_TOOLS
        ):
            return None
        refused += 1
    if calls == 0 or refused != calls or pending:
        return None
    return calls


_UNSAFE_PERMISSION_RULES = {
    "command(*)",
    "read_file(*)",
    "write_file(*)",
    "read_file(/)",
    "write_file(/)",
}


COMMAND_GRANT_REFUSED = "COMMAND_GRANT_REFUSED"


def _is_command_rule(rule: str) -> bool:
    return rule.strip().lower().startswith("command")


def install_temp_permissions(
    env: dict[str, str],
    *,
    allow_rules: list[str],
    deny_rules: list[str] | None = None,
    allow_unsafe_legacy: bool = False,
    replace_allow_deny: bool = False,
    mode: str = "plan",
    expected_profile_sha256: str | None = None,
):
    home = str(env.get("HOME") or "").strip()
    if not home:
        raise RuntimeError("LEASE_HOME_MISSING")
    settings = Path(home) / ".gemini" / "antigravity-cli" / "settings.json"
    original = settings.read_bytes() if settings.exists() else None
    try:
        data = json.loads(original.decode("utf-8")) if original else {}
    except Exception as exc:
        raise RuntimeError(f"LEASE_SETTINGS_INVALID:{exc}") from exc
    existing_perms = data.get("permissions")
    if existing_perms is None:
        existing_perms = {}
    if not isinstance(existing_perms, dict):
        raise RuntimeError("LEASE_SETTINGS_INVALID:permissions must be an object")
    perms = dict(existing_perms)
    if replace_allow_deny:
        allow: list[str] = []
        deny: list[str] = []
    else:
        allow = list(perms.get("allow") or [])
        deny = list(perms.get("deny") or [])
    for rule in allow_rules:
        if not allow_unsafe_legacy and rule in _UNSAFE_PERMISSION_RULES:
            raise RuntimeError(f"UNSAFE_PERMISSION_RULE:{rule}")
        if rule not in allow:
            allow.append(rule)
    for rule in deny_rules or []:
        if rule not in deny:
            deny.append(rule)
    perms["allow"] = allow
    perms["deny"] = deny
    data["permissions"] = perms
    settings.parent.mkdir(parents=True, exist_ok=True)
    settings.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")

    # Deterministic permission preflight and readback
    try:
        read_text = settings.read_text(encoding="utf-8")
        read_data = json.loads(read_text)
    except Exception as exc:
        raise RuntimeError(f"PERMISSION_PREFLIGHT_READBACK_FAILED:{exc}") from exc

    read_perms = read_data.get("permissions")
    if not isinstance(read_perms, dict):
        raise RuntimeError("PERMISSION_PREFLIGHT_READBACK_FAILED:permissions must be an object")
    read_allow = read_perms.get("allow")
    read_deny = read_perms.get("deny")
    if not isinstance(read_allow, list) or not isinstance(read_deny, list):
        raise RuntimeError("PERMISSION_PREFLIGHT_READBACK_FAILED:allow and deny must be lists")

    missing_allow = [r for r in allow if r not in read_allow]
    if missing_allow:
        raise RuntimeError(
            f"PERMISSION_PREFLIGHT_VERIFICATION_FAILED:missing allow rules:{missing_allow}"
        )
    missing_deny = [r for r in deny if r not in read_deny]
    if missing_deny:
        raise RuntimeError(
            f"PERMISSION_PREFLIGHT_VERIFICATION_FAILED:missing deny rules:{missing_deny}"
        )

    if mode == "accept-edits":
        if "write_file(*)" in read_deny or "write_file(/)" in read_deny:
            raise RuntimeError(
                "PERMISSION_PREFLIGHT_CONTRADICTION:blanket write_file deny in accept-edits"
            )
        if "read_file(*)" in read_deny or "read_file(/)" in read_deny:
            raise RuntimeError(
                "PERMISSION_PREFLIGHT_CONTRADICTION:blanket read_file deny in accept-edits"
            )
        if any(r.startswith("command") for r in read_allow) and "command(*)" in read_deny:
            raise RuntimeError(
                "PERMISSION_PREFLIGHT_CONTRADICTION:blanket command deny while command permitted"
            )

    canonical_perms = {
        "allow": sorted(list(dict.fromkeys(read_allow))),
        "deny": sorted(list(dict.fromkeys(read_deny))),
    }
    computed_sha256 = permission_profile_digest(canonical_perms)
    if expected_profile_sha256 and computed_sha256 != expected_profile_sha256:
        raise RuntimeError(
            f"PERMISSION_PREFLIGHT_SHA256_MISMATCH:computed={computed_sha256}, expected={expected_profile_sha256}"
        )

    return settings, original, computed_sha256, canonical_perms


def restore_temp_permissions(token) -> None:
    if token is None:
        return
    settings, original = token[:2]
    if original is None:
        try:
            settings.unlink()
        except FileNotFoundError:
            pass
    else:
        settings.write_bytes(original)


_WRITE_FILE_RULE_RE = re.compile(r"^write_file\((?P<path>.+)\)$")


def _canonical_write_path(raw: str, *, cwd: str) -> str:
    cwd_path = Path(cwd).expanduser().resolve()
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute():
        candidate = cwd_path / candidate
    resolved = candidate.resolve()
    try:
        resolved.relative_to(cwd_path)
    except ValueError as exc:
        raise ValueError(f"AGY_WRITE_PATH_OUTSIDE_CWD:{resolved}") from exc
    return str(resolved)


def _project_write_permissions(
    *,
    cwd: str,
    mode: str,
    write_paths: list[str] | None,
    allow_rules: list[str],
) -> list[str]:
    for rule in allow_rules:
        if rule in _UNSAFE_PERMISSION_RULES:
            raise ValueError(f"UNSAFE_PERMISSION_RULE:{rule}")

    if mode != "accept-edits":
        return []

    projected: list[str] = []
    for raw in write_paths or []:
        canonical = _canonical_write_path(raw, cwd=cwd)
        rule = f"write_file({canonical})"
        if rule not in projected:
            projected.append(rule)

    for rule in allow_rules:
        match = _WRITE_FILE_RULE_RE.fullmatch(rule)
        if match is None:
            continue
        canonical = _canonical_write_path(match.group("path"), cwd=cwd)
        normalized = f"write_file({canonical})"
        if normalized != rule:
            raise ValueError(f"AGY_WRITE_RULE_NOT_CANONICAL:{rule}")
        if normalized not in projected:
            projected.append(normalized)

    if not projected:
        raise ValueError("AGY_WRITE_SCOPE_REQUIRED")
    return projected


def permission_profile_digest(effective_permissions: dict[str, list[str]]) -> str:
    canonical = {
        "allow": sorted(list(dict.fromkeys(effective_permissions.get("allow") or []))),
        "deny": sorted(list(dict.fromkeys(effective_permissions.get("deny") or []))),
    }
    raw = json.dumps(canonical, separators=(",", ":"), sort_keys=True).encode("utf-8")
    return hashlib.sha256(raw).hexdigest()


def build_effective_permission_profile(
    *,
    cwd: str,
    mode: str,
    write_paths: list[str] | None = None,
    allow_rules: list[str] | None = None,
    deny_rules: list[str] | None = None,
    temp_command_permissions: bool = False,
) -> tuple[dict[str, list[str]], str, str]:
    user_allow = list(allow_rules or [])
    user_deny = list(deny_rules or [])

    for rule in user_allow:
        if rule in _UNSAFE_PERMISSION_RULES:
            raise ValueError(f"UNSAFE_PERMISSION_RULE:{rule}")
    # #2202 / Owner decision on #1912: no auto-approved commands.  No caller
    # needs a narrow command grant, so every command allow is refused.
    if temp_command_permissions:
        raise ValueError(f"{COMMAND_GRANT_REFUSED}:--temp-command-permissions")
    for rule in user_allow:
        if _is_command_rule(rule):
            raise ValueError(f"{COMMAND_GRANT_REFUSED}:{rule}")

    effective_allow: list[str] = list(user_allow)
    effective_deny: list[str] = list(user_deny)

    if mode == "accept-edits":
        projected_write_rules = _project_write_permissions(
            cwd=cwd,
            mode=mode,
            write_paths=write_paths,
            allow_rules=user_allow,
        )
        for rule in projected_write_rules:
            if rule not in effective_allow:
                effective_allow.append(rule)

        resolved_cwd = str(Path(cwd).expanduser().resolve())
        bounded_read_rule = f"read_file({resolved_cwd}/**)"
        if bounded_read_rule not in effective_allow:
            effective_allow.append(bounded_read_rule)

        if temp_command_permissions:
            if "command(*)" not in effective_allow:
                effective_allow.append("command(*)")
            for r in TEMP_COMMAND_DENY:
                if r not in effective_deny:
                    effective_deny.append(r)

        kind = "CODING_BOUNDED"
    else:
        if temp_command_permissions:
            if "command(*)" not in effective_allow:
                effective_allow.append("command(*)")
            for r in TEMP_COMMAND_DENY:
                if r not in effective_deny:
                    effective_deny.append(r)

        if any(r.startswith("read_file") or r.startswith("command") for r in effective_allow):
            kind = "READ_ONLY_RESEARCH"
        elif not effective_allow:
            kind = "NO_TOOL_PACKET"
            for r in NO_TOOL_DENY:
                if r not in effective_deny:
                    effective_deny.append(r)
        else:
            kind = "CUSTOM"

    # Every profile explicitly denies commands, like the worker adapter's
    # per-run settings (``agy_run_settings``).
    if "command(*)" not in effective_deny:
        effective_deny.append("command(*)")

    # Anti-blanket-override / contradiction prevention
    has_command_allow = any(r.startswith("command") for r in effective_allow)
    if has_command_allow and "command(*)" in effective_deny:
        raise ValueError(
            "CONTRADICTORY_PERMISSION_PROFILE:command(*) in deny rules neutralizes command capability"
        )

    has_read_allow = any(r.startswith("read_file") for r in effective_allow)
    if has_read_allow and ("read_file(*)" in effective_deny or "read_file(/)" in effective_deny):
        raise ValueError(
            "CONTRADICTORY_PERMISSION_PROFILE:read_file(*) in deny rules neutralizes read capability"
        )

    has_write_allow = any(r.startswith("write_file") for r in effective_allow)
    if has_write_allow and ("write_file(*)" in effective_deny or "write_file(/)" in effective_deny):
        raise ValueError(
            "CONTRADICTORY_PERMISSION_PROFILE:write_file(*) in deny rules neutralizes write capability"
        )

    common_rules = set(effective_allow).intersection(effective_deny)
    if common_rules:
        colliding = sorted(common_rules)[0]
        raise ValueError(
            f"CONTRADICTORY_PERMISSION_PROFILE:rule present in both allow and deny:{colliding}"
        )

    canonical_perms = {
        "allow": sorted(list(dict.fromkeys(effective_allow))),
        "deny": sorted(list(dict.fromkeys(effective_deny))),
    }
    sha256 = permission_profile_digest(canonical_perms)
    return canonical_perms, kind, sha256


_WORKTREE_GITFILE_RE = re.compile(r"^gitdir:\s*(.+)$", re.MULTILINE)

# ---------------------------------------------------------------------------
# Linked-worktree detection and standalone-clone fallback
# ---------------------------------------------------------------------------


def _run_git(*args: str, cwd: str) -> tuple[int, str]:
    """Run a git command, return (returncode, stdout). Never raises."""
    try:
        result = subprocess.run(
            ["git"] + list(args),
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
            check=False,
        )
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def _is_linked_worktree(cwd: str) -> bool:
    """Return True when *cwd* is a linked Git worktree (not a standalone clone).

    Detection uses deterministic Git metadata only — no Agy logs:

    1. The .git entry is a plain file (gitfile) rather than a directory, which
       is the canonical marker for a linked worktree checkout.
    2. The common config referenced via that gitfile contains
       extensions.worktreeConfig, which is the specific setting that triggers
       the Agy 1.2.16 watcher rejection.

    A standalone clone always has a real .git *directory*.  When either
    condition cannot be read (missing git, non-git directory) this function
    returns False so normal flow is unaffected.
    """
    try:
        git_path = Path(cwd) / ".git"
        if not git_path.exists():
            # May still be a git repo via parent discovery, but check via git
            rc, toplevel = _run_git("rev-parse", "--show-toplevel", cwd=cwd)
            if rc != 0:
                return False
            git_path = Path(toplevel) / ".git"
            if not git_path.exists():
                return False

        # A regular file at .git is the gitfile pointer used by linked worktrees.
        if not git_path.is_file():
            return False  # real .git directory — standalone clone

        # Read the gitfile to find the per-worktree git dir.
        try:
            gitfile_content = git_path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return False
        match = _WORKTREE_GITFILE_RE.search(gitfile_content)
        if not match:
            return False
        worktree_git_dir = Path(match.group(1).strip()).expanduser()
        if not worktree_git_dir.is_absolute():
            worktree_git_dir = (Path(cwd) / worktree_git_dir).resolve()

        # The common config lives at <worktrees_dir>/../../config which is the
        # main repository's config.  Walk up from the per-worktree git dir.
        # Layout: <main-git-dir>/worktrees/<name>/  -> gitdir points here
        # Common config: <main-git-dir>/config
        common_config_path = worktree_git_dir.parent.parent / "config"
        if not common_config_path.is_file():
            # Non-standard layout: still a gitfile → still a linked worktree.
            return True

        try:
            config_text = common_config_path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return True  # gitfile confirmed linked worktree even without config read

        # Presence of extensions.worktreeConfig in any case is the trigger.
        if re.search(r"worktreeConfig\s*=\s*true", config_text, re.IGNORECASE):
            return True
        # Even without worktreeConfig, a gitfile-linked worktree is still
        # incompatible with the Agy watcher: return True for any gitfile.
        return True

    except Exception:
        return False


def _git_remote_url(cwd: str) -> str | None:
    """Return the 'origin' remote URL for the repo at *cwd*, or None."""
    rc, url = _run_git("remote", "get-url", "origin", cwd=cwd)
    if rc == 0 and url:
        return url
    return None


def _git_head_sha(cwd: str) -> str | None:
    """Return the full HEAD commit SHA for the repo at *cwd*, or None."""
    rc, sha = _run_git("rev-parse", "HEAD", cwd=cwd)
    if rc == 0 and sha and len(sha) >= 40:
        return sha
    return None


def _git_is_dirty(cwd: str) -> bool:
    """Return True when the working tree or index has uncommitted changes."""
    rc, output = _run_git("status", "--porcelain", cwd=cwd)
    if rc != 0:
        return True  # fail closed
    return bool(output.strip())


def _git_real_dot_git(cwd: str) -> bool:
    """Return True when .git is a real directory (not a gitfile)."""
    git_path = Path(cwd) / ".git"
    if git_path.is_dir():
        return True
    # Also accept repos that were initialized without a top-level .git (rare)
    if git_path.is_file():
        return False
    return False


class WorktreeFallbackError(ValueError):
    """Raised when a standalone-clone fallback cannot be established safely."""


def _validate_standalone_clone(
    *,
    clone_path: str,
    expected_remote: str,
    expected_sha: str,
) -> None:
    """Validate that an *existing* directory is a safe, exact standalone clone.

    Raises WorktreeFallbackError with a deterministic tag on any mismatch.
    """
    clone_dir = Path(clone_path)
    if not clone_dir.is_dir():
        raise WorktreeFallbackError(f"FALLBACK_CLONE_NOT_A_DIR:{clone_path}")

    # Must have a real .git directory (not a gitfile-linked worktree).
    if not _git_real_dot_git(clone_path):
        raise WorktreeFallbackError(f"FALLBACK_CLONE_IS_LINKED_WORKTREE:{clone_path}")

    # Remote must match exactly.
    actual_remote = _git_remote_url(clone_path)
    if actual_remote != expected_remote:
        raise WorktreeFallbackError(
            f"FALLBACK_CLONE_REMOTE_MISMATCH:expected={expected_remote!r} actual={actual_remote!r}"
        )

    # HEAD SHA must match exactly.
    actual_sha = _git_head_sha(clone_path)
    if actual_sha != expected_sha:
        raise WorktreeFallbackError(
            f"FALLBACK_CLONE_BASE_MISMATCH:expected={expected_sha!r} actual={actual_sha!r}"
        )

    # Clone must be clean (no uncommitted changes).
    if _git_is_dirty(clone_path):
        raise WorktreeFallbackError(f"FALLBACK_CLONE_DIRTY:{clone_path}")


def _prepare_standalone_clone_fallback(
    *,
    source_cwd: str,
    fallback_path: str,
) -> str:
    """Create or validate a standalone clone and return the clone path as cwd.

    Behaviour:
    - If *fallback_path* does not exist: create a fresh ``git clone`` from the
      source origin at the source HEAD revision with no shared object store and
      no worktree metadata.
    - If *fallback_path* exists and is already an exact, clean standalone clone
      of the same origin/HEAD: reuse it without modification.
    - Any other state (non-empty non-repo dir, wrong remote, wrong base, dirty,
      linked worktree) raises WorktreeFallbackError — fail closed.

    Raises WorktreeFallbackError on any unresolvable condition.
    Returns the resolved absolute path string of the standalone clone.
    """
    source_remote = _git_remote_url(source_cwd)
    if not source_remote:
        raise WorktreeFallbackError(
            f"FALLBACK_SOURCE_NO_REMOTE:cannot read origin from {source_cwd!r}"
        )

    source_sha = _git_head_sha(source_cwd)
    if not source_sha:
        raise WorktreeFallbackError(f"FALLBACK_SOURCE_NO_HEAD:cannot read HEAD from {source_cwd!r}")
    if _git_is_dirty(source_cwd):
        raise WorktreeFallbackError(
            "FALLBACK_SOURCE_DIRTY:explicit fallback cannot discard uncommitted source state"
        )

    source_dir = Path(source_cwd).expanduser().resolve()
    clone_dir = Path(fallback_path).expanduser().resolve()
    try:
        clone_dir.relative_to(source_dir)
    except ValueError:
        pass
    else:
        raise WorktreeFallbackError(
            "FALLBACK_CLONE_INSIDE_SOURCE:standalone target must be outside source worktree"
        )
    clone_path = str(clone_dir)

    if clone_dir.exists():
        # Must be a directory; non-directory is an ambiguous collision.
        if not clone_dir.is_dir():
            raise WorktreeFallbackError(f"FALLBACK_CLONE_PATH_COLLISION_NOT_DIR:{clone_path}")

        contents = list(clone_dir.iterdir())
        if not contents:
            # Empty directory: treat as new destination (will be populated below).
            clone_dir.rmdir()  # remove so git clone can create it
        else:
            # Non-empty: validate as existing clone.
            _validate_standalone_clone(
                clone_path=clone_path,
                expected_remote=source_remote,
                expected_sha=source_sha,
            )
            return clone_path

    # Create a fresh standalone clone from the local source checkout.  --no-local
    # forces independent object storage instead of hardlinks/shared worktree metadata.
    # The externally visible origin is restored to the source repository remote after
    # cloning, and checkout is pinned to the exact source SHA.
    clone_dir.parent.mkdir(parents=True, exist_ok=True)
    rc, _out = _run_git(
        "clone",
        "--no-local",
        source_cwd,
        clone_path,
        cwd=str(clone_dir.parent),
    )
    if rc != 0:
        raise WorktreeFallbackError(
            f"FALLBACK_CLONE_FAILED:git clone exited {rc} for {source_cwd!r}"
        )

    rc, _out = _run_git("remote", "set-url", "origin", source_remote, cwd=clone_path)
    if rc != 0:
        raise WorktreeFallbackError("FALLBACK_CLONE_REMOTE_SET_FAILED")

    # Checkout the exact base SHA (detached HEAD for isolation).
    rc, _out = _run_git("checkout", "--detach", source_sha, cwd=clone_path)
    if rc != 0:
        # Try without --detach (older git fallback).
        rc2, _out2 = _run_git("checkout", source_sha, cwd=clone_path)
        if rc2 != 0:
            raise WorktreeFallbackError(
                f"FALLBACK_CLONE_CHECKOUT_FAILED:cannot checkout {source_sha!r}"
            )

    # Final validation: confirm identity and cleanliness.
    _validate_standalone_clone(
        clone_path=clone_path,
        expected_remote=source_remote,
        expected_sha=source_sha,
    )
    return clone_path


def _resolve_cwd_for_dispatch(
    *,
    requested_cwd: str,
    fallback_clone_path: str | None,
) -> str:
    """Return the effective cwd for dispatch, applying fallback logic.

    - If *fallback_clone_path* is None and the requested cwd is a linked
      worktree, raise WorktreeFallbackError with WORKTREE_NO_FALLBACK_REQUESTED
      so the caller can surface a clear diagnostic.
    - If *fallback_clone_path* is provided, prepare/validate the standalone
      clone and return its path regardless of whether the source is a linked
      worktree (explicit opt-in).
    - If *fallback_clone_path* is None and the requested cwd is a normal
      standalone repo (or non-git directory), return *requested_cwd* unchanged.
    """
    if fallback_clone_path is not None:
        return _prepare_standalone_clone_fallback(
            source_cwd=requested_cwd,
            fallback_path=fallback_clone_path,
        )

    if _is_linked_worktree(requested_cwd):
        raise WorktreeFallbackError(
            "WORKTREE_NO_FALLBACK_REQUESTED:"
            "The requested --cwd is a linked Git worktree which is incompatible "
            "with the Agy watcher. Re-run with --fallback-clone <path> to provide "
            "an explicit standalone clone target."
        )

    return requested_cwd


def _resolve_hcom_agy_safe() -> Path:
    override = os.environ.get("NEXUS_HCOM_AGY_SAFE_BIN")
    if override:
        path = Path(override).expanduser().resolve()
        if path.is_file() and os.access(path, os.X_OK):
            return path
        raise RuntimeError("NEXUS_HCOM_AGY_SAFE_BIN_INVALID")
    bundled = Path(__file__).with_name("nexus-hcom-agy-safe")
    if bundled.is_file() and os.access(bundled, os.X_OK):
        return bundled
    resolved = shutil.which("hcom-agy-safe")
    if resolved:
        return Path(resolved).resolve()
    raise RuntimeError("HCOM_AGY_SAFE_NOT_FOUND")


FORBIDDEN_HCOM_COLLAB_FLAGS = {
    "--detach",
    "--daemon",
    "-d",
    "--background",
    "--headless",
    "--no-terminal",
}


def _parse_hcom_args(raw: str | None) -> list[str]:
    if raw is None or not raw.strip():
        return []
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ValueError("HCOM_ARGS_JSON_INVALID") from exc
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        raise ValueError("HCOM_ARGS_JSON_INVALID")
    for item in value:
        lowered = item.strip().lower()
        if lowered in FORBIDDEN_HCOM_COLLAB_FLAGS or lowered.startswith((
            "--detach=",
            "--daemon=",
            "--background=",
        )):
            raise ValueError(f"HCOM_COLLAB_FORBIDDEN_FLAG:{item}")
    return list(value)


def _decode_hcom_collab_status(
    line: str,
    *,
    account_alias_hash: str,
    lease_id_hash: str,
) -> dict[str, Any] | None:
    try:
        payload = json.loads(line)
    except (json.JSONDecodeError, TypeError):
        return None
    if not isinstance(payload, dict) or payload.get("schema") != "nexus.hcom_collab_status.v1":
        return None
    if (
        payload.get("account_alias_hash") != account_alias_hash
        or payload.get("lease_id_hash") != lease_id_hash
    ):
        return None
    event = payload.get("event")
    if event == "pre_provider_failed":
        return payload
    pid = payload.get("pid")
    if (
        event not in {"provider_started", "provider_terminal"}
        or not isinstance(pid, int)
        or pid <= 0
    ):
        return None
    if event == "provider_terminal" and not isinstance(payload.get("exit_code"), int):
        return None
    return payload


def dispatch_hcom_collab(
    *,
    cwd: str,
    hcom_args: list[str],
    model: str | None,
    pool_wait_timeout: float = 15.0,
    exclude_accounts: list[str] | None = None,
    coordinator: CrossProcessLeaseCoordinator | None = None,
    popen_factory: Any = subprocess.Popen,
    launcher_path: Path | None = None,
    operation_hook: Any = None,
) -> int:
    """Run one foreground hcom/Agy session under the canonical pool claim.

    Account selection and admission stay in nexus-agy-dispatch.  The launcher
    receives only the exact admitted account snapshot and an inherited
    per-account flock descriptor; it never chooses or rotates accounts itself.
    """
    for item in hcom_args:
        lowered = item.strip().lower()
        if lowered in FORBIDDEN_HCOM_COLLAB_FLAGS or lowered.startswith((
            "--detach=",
            "--daemon=",
            "--background=",
        )):
            raise ValueError(f"HCOM_COLLAB_FORBIDDEN_FLAG:{item}")

    if coordinator is None:
        if not MANAGER.is_file() or not MANAGER_ROOT.is_dir():
            raise RuntimeError("AGY_ACCOUNT_POOL_RUNTIME_MISSING")
        pool = AgyAccountPoolManager(
            manager_path=str(MANAGER),
            manager_root=str(MANAGER_ROOT),
            use_real_manager=True,
        )
        coordinator = CrossProcessLeaseCoordinator(
            manager=pool,
            allocator_lock_path=ALLOCATOR_LOCK_PATH,
            leases_dir=LEASES_DIR,
        )

    quota_snapshot, availability_state = _apply_dynamic_availability(model)
    model_family = str(availability_state["family"])
    scoped_model_family = model_family if model_family in {"gemini", "claude_gpt"} else None
    consumer_id = "hcom-" + uuid.uuid4().hex
    exclude_hashes = _resolve_excluded_account_hashes(
        exclude_accounts,
        manager=getattr(coordinator, "manager", None),
    )
    claim: AccountLeaseClaim | None = None
    child: Any = None
    status_read_fd: int | None = None
    status_write_fd: int | None = None
    status_stream: Any = None

    try:
        while True:
            try:
                claim = coordinator.acquire_claim(
                    consumer_id=consumer_id,
                    exclude_hashes=exclude_hashes,
                    wait_timeout=pool_wait_timeout,
                    model_family=scoped_model_family,
                )
            except AgyAccountPoolBusyError:
                emit_meta({
                    "status": "pool_busy",
                    "attempts": 0,
                    "rotations": len(exclude_hashes),
                    "failure_kind": "AGY_ACCOUNT_POOL_BUSY",
                    "wall_ms": 0,
                })
                return 75
            except AgyAccountPoolExhaustedError:
                emit_meta({
                    "status": "pool_exhausted",
                    "attempts": 0,
                    "rotations": len(exclude_hashes),
                    "failure_kind": "ACCOUNT_UNAVAILABLE",
                    "wall_ms": 0,
                })
                return 75
            if scoped_model_family is None:
                break
            quota_state, reset_ts, evidence_fresh = _account_family_quota_state(
                quota_snapshot,
                account_name=claim.internal_id,
                model_family=scoped_model_family,
            )
            if not evidence_fresh:
                quota_snapshot = _refresh_quota_snapshot_for_account(claim.internal_id)
                quota_state, reset_ts, evidence_fresh = _account_family_quota_state(
                    quota_snapshot,
                    account_name=claim.internal_id,
                    model_family=scoped_model_family,
                )
            if not (evidence_fresh and quota_state == "blocked"):
                break
            unavailable_until = (
                reset_ts
                if reset_ts is not None and reset_ts > time.time()
                else time.time() + DEFAULT_QUOTA_FAMILY_BLOCK_SECONDS
            )
            failed_hash = claim.account_alias_hash
            coordinator.retire_failed_claim(
                claim,
                AccountFailureKind.QUOTA_EXHAUSTED,
                model_family=scoped_model_family,
                unavailable_until=unavailable_until,
            )
            claim = None
            exclude_hashes.add(failed_hash)

        assert claim is not None
        _operation_hook(
            operation_hook,
            phase="ACCOUNT_LEASED",
            attempts=1,
            rotations=len(exclude_hashes),
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
        )
        profile_home = str(claim.lease.execution_env.get("HOME") or "").strip()
        if not profile_home:
            raise RuntimeError("LEASE_HOME_MISSING")
        profile = Path(profile_home).expanduser().resolve()
        accounts_root = (MANAGER_ROOT / "accounts").resolve()
        if profile != (accounts_root / claim.internal_id).resolve():
            raise RuntimeError("LEASE_PROFILE_IDENTITY_MISMATCH")

        lock_obj = claim.lock_file_obj
        if lock_obj is None:
            raise RuntimeError("LEASE_LOCK_MISSING")
        lease_fd = int(lock_obj.fileno())
        os.set_inheritable(lease_fd, True)

        launcher = (
            launcher_path.resolve() if launcher_path is not None else _resolve_hcom_agy_safe()
        )
        env = dict(os.environ)
        sensitive_keys = getattr(_agy_account_pool, "SENSITIVE_API_KEYS", None)
        if sensitive_keys is None:
            raise RuntimeError("SENSITIVE_API_KEYS_CONFIG_MISSING")
        for key in sensitive_keys:
            env.pop(key, None)
        status_read_fd, status_write_fd = os.pipe()
        os.set_inheritable(status_write_fd, True)
        env.update({
            "NEXUS_HCOM_AGY_LEASE_ACCOUNT": claim.internal_id,
            "NEXUS_HCOM_AGY_PROFILE_HOME": str(profile),
            "NEXUS_HCOM_AGY_LEASE_FD": str(lease_fd),
            "NEXUS_HCOM_AGY_LEASE_ID_HASH": claim.lease_id_hash,
            "NEXUS_HCOM_AGY_ACCOUNT_ALIAS_HASH": claim.account_alias_hash,
            "NEXUS_HCOM_AGY_STATUS_FD": str(status_write_fd),
        })
        child = popen_factory(
            [str(launcher), *hcom_args],
            cwd=cwd,
            env=env,
            pass_fds=(lease_fd, status_write_fd),
        )
        _operation_hook(
            operation_hook,
            phase="LAUNCHING",
            attempts=1,
            rotations=len(exclude_hashes),
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
        )
        os.close(status_write_fd)
        status_write_fd = None
        status_stream = os.fdopen(status_read_fd, "r", encoding="utf-8", errors="replace")
        status_read_fd = None

        first = _decode_hcom_collab_status(
            status_stream.readline(),
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
        )
        provider_started = first is not None and first.get("event") == "provider_started"
        pre_provider_failed = first is not None and first.get("event") == "pre_provider_failed"
        if provider_started:
            _operation_hook(
                operation_hook,
                phase="EXECUTING",
                attempts=1,
                rotations=len(exclude_hashes),
                account_alias_hash=claim.account_alias_hash,
                lease_id_hash=claim.lease_id_hash,
                provider_pid=int(first["pid"]),
            )

        code = int(child.wait())
        terminal = (
            _decode_hcom_collab_status(
                status_stream.readline(),
                account_alias_hash=claim.account_alias_hash,
                lease_id_hash=claim.lease_id_hash,
            )
            if provider_started
            else None
        )
        clean_terminal = (
            provider_started
            and terminal is not None
            and terminal.get("event") == "provider_terminal"
            and terminal.get("pid") == first.get("pid")
            and terminal.get("exit_code") == code
        )
        if clean_terminal or pre_provider_failed:
            claim.release()
            claim = None
            return code

        _operation_hook(
            operation_hook,
            phase="EXECUTING" if provider_started else "LAUNCHING",
            attempts=1,
            rotations=len(exclude_hashes),
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
            provider_pid=int(first["pid"]) if provider_started else None,
            failure_kind="HCOM_COLLAB_TERMINALITY_UNPROVEN",
        )
        claim.abandon_parent_reference()
        claim = None
        raise RuntimeError("HCOM_COLLAB_TERMINALITY_UNPROVEN")
    except BaseException:
        if claim is not None:
            if child is not None:
                claim.abandon_parent_reference()
            else:
                claim.release()
            claim = None
        raise
    finally:
        if status_stream is not None:
            status_stream.close()
        if status_read_fd is not None:
            try:
                os.close(status_read_fd)
            except OSError:
                pass
        if status_write_fd is not None:
            try:
                os.close(status_write_fd)
            except OSError:
                pass
        if claim is not None:
            claim.release()


def _run_foreground_hcom_operation(
    *,
    cwd: str,
    hcom_args: list[str],
    model: str | None,
    pool_wait_timeout: float,
    operation_root: Path,
    exclude_accounts: list[str] | None = None,
) -> int:
    resolved_exclude_hashes = sorted(_resolve_excluded_account_hashes(exclude_accounts))
    journal = AgyOperationJournal(operation_root)
    operation_id = new_operation_id()
    attempt_id = new_attempt_id()
    args_sha256 = hashlib.sha256(
        json.dumps(hcom_args, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    journal.create(
        operation_id=operation_id,
        attempt_id=attempt_id,
        cwd=cwd,
        provider="agy",
        model=model,
        effort=None,
        prompt_sha256=args_sha256,
        runtime_revision=_runtime_revision(),
        initial_fields={
            "mode": "hcom_collab",
            "hcom_args_sha256": args_sha256,
            "excluded_account_hashes": resolved_exclude_hashes,
        },
    )
    journal.mark_started(operation_id, pid=os.getpid())
    journal.update(operation_id, phase="STARTING")
    emit_meta({
        "status": "hcom_collab_started",
        "operation_id": operation_id,
        "attempt_id": attempt_id,
    })

    def on_event(event: dict[str, Any]) -> None:
        journal.heartbeat(
            operation_id,
            phase=str(event.get("phase") or "RUNNING"),
            attempts=int(event.get("attempts") or 0),
            rotations=int(event.get("rotations") or 0),
            account_alias_hash=event.get("account_alias_hash"),
            lease_id_hash=event.get("lease_id_hash"),
            failure_kind=event.get("failure_kind"),
        )
        if event.get("provider_pid"):
            journal.update(operation_id, provider_pid=int(event["provider_pid"]))

    try:
        code = dispatch_hcom_collab(
            cwd=cwd,
            hcom_args=hcom_args,
            model=model,
            pool_wait_timeout=pool_wait_timeout,
            exclude_accounts=resolved_exclude_hashes,
            operation_hook=on_event,
        )
    except BaseException as exc:
        record = journal.read(operation_id)
        if record.get("phase") != "TERMINAL":
            provider_effect_possible = str(record.get("phase") or "") in {
                "LAUNCHING",
                "EXECUTING",
            }
            journal.mark_terminal(
                operation_id,
                status="OUTCOME_UNKNOWN" if provider_effect_possible else "FAILED",
                exit_code=None,
                failure_kind=f"HCOM_COLLAB_PARENT_ABORT:{type(exc).__name__}",
                cwd=cwd,
                reconciliation={
                    "at": _agy_operation_journal.utc_now(),
                    "result": (
                        "HCOM_COLLAB_TERMINALITY_UNPROVEN"
                        if provider_effect_possible
                        else "HCOM_COLLAB_ABORT_BEFORE_PROVIDER"
                    ),
                    "retry_permitted": False,
                },
            )
        raise

    terminal_status = "COMPLETED" if code == 0 else "FAILED"
    journal.mark_terminal(
        operation_id,
        status=terminal_status,
        exit_code=code,
        failure_kind=None if code == 0 else "HCOM_COLLAB_EXIT_NONZERO",
        cwd=cwd,
        reconciliation=None,
    )
    return code


# #2410: a busy or briefly-cooling pool queues against the dispatch's own total
# deadline instead of failing after a fixed 15 s; ``pool_exhausted`` is only
# returned when no eligible account recovers before that deadline, and then it
# carries the earliest recovery time.
DEFAULT_POOL_QUEUE_POLL_SECONDS = 2.0
POOL_QUEUE_MAX_SLEEP_SECONDS = 30.0
POOL_QUEUE_MAX_POLL_SECONDS = 10.0
POOL_QUEUE_REFRESH_SECONDS = 30.0
_sleep = time.sleep
_queue_monotonic = time.monotonic


def _pool_queue_poll_seconds() -> float:
    # Capped well below POOL_QUEUE_TICKET_STALE_SECONDS so a sleeping waiter
    # always touches its ticket before others may prune it.
    return min(
        _bounded_positive_seconds(
            "NEXUS_AGY_POOL_QUEUE_POLL_SECONDS",
            DEFAULT_POOL_QUEUE_POLL_SECONDS,
        ),
        POOL_QUEUE_MAX_POLL_SECONDS,
    )


def _env_pool_wait_timeout() -> float | None:
    """An explicit NEXUS_AGY_POOL_WAIT_TIMEOUT caps the queue; unset derives it."""
    raw = os.getenv("NEXUS_AGY_POOL_WAIT_TIMEOUT")
    if raw is None or not raw.strip():
        return None
    try:
        return max(0.0, float(raw))
    except ValueError:
        return None


def _pool_wait_budget(*, total_deadline: float, explicit: float | None) -> float:
    """Seconds a claim may queue: until the attempt floor before the total deadline.

    An explicit ``--pool-wait-timeout`` only shortens the queue; it never lets a
    dispatch wait past its own total deadline.
    """
    remaining = max(0.0, total_deadline - _monotonic() - TOTAL_DEADLINE_MIN_ATTEMPT_SECONDS)
    if explicit is None:
        return remaining
    return max(0.0, min(float(explicit), remaining))


def _iso_utc(ts: float | None) -> str | None:
    if ts is None:
        return None
    return datetime.fromtimestamp(float(ts), tz=timezone.utc).isoformat()


def _pool_recovery_estimate(
    coordinator: Any,
    *,
    model_family: str | None,
    exclude_hashes: set[str],
    quota_snapshot: dict,
    now_ts: float | None = None,
) -> dict[str, Any]:
    """Earliest time an enabled, non-excluded account becomes claimable again.

    Reads only availability metadata (manager cooldowns, family quota markers,
    quarantine markers and the quota snapshot's reset times); account names are
    reduced to their 12-hex alias hash and never returned.  An account blocked
    by anything without a known end (quarantine, disabled) never recovers here.
    Every lookup is best effort: a coordinator without that metadata yields an
    unknown recovery time, which callers treat as "not before the deadline".
    """
    current = time.time() if now_ts is None else float(now_ts)
    result: dict[str, Any] = {
        "earliest_reset_ts": None,
        "earliest_reset_at": None,
        "accounts_considered": 0,
        "accounts_cooling": 0,
        "accounts_quota_blocked": 0,
        "accounts_without_known_recovery": 0,
    }
    manager = getattr(coordinator, "manager", None)
    call_cli = getattr(manager, "_call_manager_cli", None)
    # An in-memory (alias-env) pool has no manager state to read; the real
    # manager's accounts would not be this coordinator's accounts.
    if not callable(call_cli) or getattr(manager, "_use_real_manager", True) is False:
        return result
    try:
        status = call_cli(["status", "--json"])
    except Exception:
        return result
    accounts = status.get("accounts") if isinstance(status, dict) else None
    if isinstance(accounts, dict):
        entries = list(accounts.items())
    elif isinstance(accounts, list):
        entries = [
            (str(info.get("name")), info)
            for info in accounts
            if isinstance(info, dict) and info.get("name")
        ]
    else:
        return result

    family_until: dict[str, float] = {}
    leases_dir = getattr(coordinator, "leases_dir", None)
    if model_family in {"gemini", "claude_gpt"} and isinstance(leases_dir, Path):
        suffix = f".family-unavailable.{model_family}.json"
        try:
            marker_paths = list(leases_dir.glob(f"*{suffix}"))
        except OSError:
            marker_paths = []
        for path in marker_paths:
            alias_hash = path.name[: -len(suffix)]
            try:
                payload = json.loads(path.read_text(encoding="utf-8"))
                until = float(payload.get("unavailable_until"))
            except (OSError, ValueError, TypeError, json.JSONDecodeError):
                until = float("inf")
            if until > current:
                family_until[alias_hash] = max(family_until.get(alias_hash, 0.0), until)
    quarantined: set[str] = set()
    get_quarantined = getattr(coordinator, "get_quarantined_hashes", None)
    if callable(get_quarantined):
        try:
            quarantined = set(get_quarantined())
        except Exception:
            quarantined = set()
    blocked_names = {
        name.strip()
        for name in os.getenv("NEXUS_AGY_BLOCKED_ACCOUNTS", "").split(",")
        if name.strip()
    }

    earliest: float | None = None
    for name, info in entries:
        if not isinstance(info, dict) or info.get("enabled") is not True:
            continue
        alias_hash = hashlib.sha256(str(name).encode("utf-8")).hexdigest()[:12]
        if alias_hash in exclude_hashes:
            continue
        result["accounts_considered"] += 1
        if alias_hash in quarantined:
            result["accounts_without_known_recovery"] += 1
            continue
        recover_at = current
        blocker_found = False
        cooldown_ts = _parse_reset_at(info.get("cooldown_until"))
        if info.get("cooldown_until") and cooldown_ts is None:
            result["accounts_without_known_recovery"] += 1
            continue
        if cooldown_ts is not None and cooldown_ts > current:
            blocker_found = True
            result["accounts_cooling"] += 1
            recover_at = max(recover_at, cooldown_ts)
        quota_blocked = False
        if alias_hash in family_until:
            quota_blocked = True
            recover_at = max(recover_at, family_until[alias_hash])
        if str(name) in blocked_names and model_family in {"gemini", "claude_gpt"}:
            quota_blocked = True
            _state, reset_ts, _fresh = _account_family_quota_state(
                quota_snapshot,
                account_name=str(name),
                model_family=model_family,
                now_ts=current,
            )
            recover_at = max(
                recover_at,
                reset_ts if reset_ts is not None and reset_ts > current else float("inf"),
            )
        if quota_blocked:
            blocker_found = True
            result["accounts_quota_blocked"] += 1
        if not blocker_found or recover_at == float("inf"):
            # Unavailable for a reason without a known end (missing identity,
            # missing snapshot, unbounded block): never a reason to queue.
            result["accounts_without_known_recovery"] += 1
            continue
        if earliest is None or recover_at < earliest:
            earliest = recover_at
    if earliest is not None:
        result["earliest_reset_ts"] = earliest
        result["earliest_reset_at"] = _iso_utc(earliest)
    return result


class _PoolClaimFailure(Exception):
    """The queue ended without a lease: still busy, or no recovery before the deadline."""

    def __init__(self, *, busy: bool, waited_seconds: float, recovery: dict[str, Any] | None):
        super().__init__("AGY_ACCOUNT_POOL_BUSY" if busy else "AGY_ACCOUNT_POOL_EXHAUSTED")
        self.busy = busy
        self.waited_seconds = waited_seconds
        self.recovery = dict(recovery or {})


POOL_QUEUE_TICKET_STALE_SECONDS = 90.0


class _PoolQueueTicket:
    """One FIFO waiter in ``<leases_dir>/queue`` for one model family.

    Without an order, a waiter polling a full pool loses each freed lease to
    whichever process takes the allocator lock first, so newcomers can starve
    it until its deadline (seven 900 s waits ended busy on 2026-10-15 while
    later dispatches leased).  Every new dispatch takes a ticket before its
    first allocator pass; it may pass only while no older live unrestricted
    ticket (one without ``--exclude-account``) of the same family exists.
    Restricted tickets never block anyone: they may have excluded the very
    account that is free (head-of-line blocking).  A ticket is live while its
    process exists and keeps touching the file; anything else is pruned.
    """

    def __init__(
        self,
        queue_dir: Path,
        *,
        model_family: str | None,
        restricted: bool,
        exclude_hashes: set[str] | frozenset[str] = frozenset(),
    ):
        self.family = model_family or "any"
        self.queue_dir = queue_dir
        queue_dir.mkdir(parents=True, exist_ok=True)
        if restricted:
            signature = hashlib.sha256(
                ",".join(sorted(exclude_hashes)).encode("utf-8")
            ).hexdigest()[:12]
            self.kind = f"r-{signature}"
        else:
            self.kind = "u"
        self.path = queue_dir / (
            f"{time.time_ns():020d}-{os.getpid()}-{uuid.uuid4().hex[:8]}"
            f".{self.family}.{self.kind}.ticket"
        )
        self.path.write_text(f"{os.getpid()}\n", encoding="utf-8")

    @staticmethod
    def _live(path: Path, *, now: float) -> bool:
        try:
            pid = int(path.name.split("-", 2)[1])
            mtime = path.stat().st_mtime
        except (IndexError, ValueError, OSError):
            return False
        if now - mtime > POOL_QUEUE_TICKET_STALE_SECONDS:
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        return True

    @classmethod
    def live_tickets(cls, queue_dir: Path, family: str) -> list[Path]:
        now = time.time()
        live: list[Path] = []
        try:
            paths = sorted([
                *queue_dir.glob(f"*.{family}.u.ticket"),
                *queue_dir.glob(f"*.{family}.r-*.ticket"),
            ])
        except OSError:
            return live
        for path in paths:
            if cls._live(path, now=now):
                live.append(path)
            else:
                try:
                    path.unlink()
                except OSError:
                    pass
        return live

    def is_head(self) -> bool:
        """True when no older live ticket that may take this waiter's accounts waits.

        Unrestricted waiters are ordered among themselves; a restricted waiter
        also waits behind older restricted waiters with the same exclusions.
        """
        blocking = {".u.ticket", f".{self.kind}.ticket"}
        for path in self.live_tickets(self.queue_dir, self.family):
            if path == self.path:
                return True
            if any(path.name.endswith(suffix) for suffix in blocking):
                return False
        return True

    def touch(self) -> None:
        try:
            os.utime(self.path)
        except OSError:
            pass

    def close(self) -> None:
        try:
            self.path.unlink()
        except OSError:
            pass


def _pool_queue_dir(coordinator: Any) -> Path | None:
    leases_dir = getattr(coordinator, "leases_dir", None)
    return leases_dir / "queue" if isinstance(leases_dir, Path) else None


def _acquire_claim_queued(
    coordinator: Any,
    *,
    consumer_id: str,
    exclude_hashes: set[str],
    wait_budget: float,
    model_family: str | None,
    quota_snapshot: dict,
    first_pass: Any = None,
    on_queue: Any = None,
    refresh_availability: Any = None,
    restricted: bool | None = None,
) -> tuple[Any, float]:
    """Claim one account, queueing while the pool is busy or recovers in time.

    Each pass is a single non-blocking allocator pass (``wait_timeout=0``); the
    queue sleeps between passes so many waiters do not spin on the allocator
    lock, and no pass starts after the wait deadline.  ``first_pass`` lets a
    rotation retire its failed claim exactly once; a rotation is a running
    task and never waits behind new dispatches.  A new dispatch takes a FIFO
    ticket first.  After waiting for a predicted recovery,
    ``refresh_availability`` re-reads quota availability (and returns the new
    snapshot) so an account whose quota reset is claimable again.
    """
    started = _queue_monotonic()
    deadline = started + max(0.0, float(wait_budget))
    poll = _pool_queue_poll_seconds()
    queue_dir = _pool_queue_dir(coordinator)
    ticket: _PoolQueueTicket | None = None
    if first_pass is None and queue_dir is not None:
        try:
            # Ordering is best effort: a queue directory failure must not turn
            # a fairness aid into an outage, so the dispatch proceeds unordered.
            ticket = _PoolQueueTicket(
                queue_dir,
                model_family=model_family,
                restricted=bool(exclude_hashes) if restricted is None else restricted,
                exclude_hashes=exclude_hashes,
            )
        except OSError:
            ticket = None

    def default_pass() -> Any:
        return coordinator.acquire_claim(
            consumer_id=consumer_id,
            exclude_hashes=exclude_hashes,
            wait_timeout=0.0,
            model_family=model_family,
        )

    attempt = first_pass or default_pass
    passes = 0
    state = "POOL_BUSY"
    recovery: dict[str, Any] | None = None
    refresh_before_pass = False
    last_refresh = started

    def give_up() -> _PoolClaimFailure:
        return _PoolClaimFailure(
            busy=state != "POOL_RECOVERING",
            waited_seconds=_queue_monotonic() - started,
            recovery=recovery if state == "POOL_RECOVERING" else None,
        )

    try:
        while True:
            if passes > 0 and _queue_monotonic() >= deadline:
                raise give_up()
            if ticket is not None and not ticket.is_head():
                ticket.touch()
                remaining = deadline - _queue_monotonic()
                if remaining <= 0:
                    raise give_up()
                if on_queue is not None:
                    on_queue(
                        state="QUEUED_BEHIND_OLDER_WAITER",
                        passes=passes,
                        waited_seconds=_queue_monotonic() - started,
                        earliest_reset_at=None,
                    )
                _sleep(max(0.01, min(poll, remaining)))
                continue
            if refresh_availability is not None and (
                refresh_before_pass
                or _queue_monotonic() - last_refresh >= POOL_QUEUE_REFRESH_SECONDS
            ):
                # Quota-blocked accounts are hidden through the published
                # availability; re-read it so one that reset is claimable,
                # also while other accounts keep the pool busy.
                refreshed = refresh_availability()
                last_refresh = _queue_monotonic()
                if isinstance(refreshed, dict):
                    quota_snapshot = refreshed
            refresh_before_pass = False
            passes += 1
            try:
                claim = attempt()
                return claim, _queue_monotonic() - started
            except AgyAccountPoolBusyError:
                busy = True
                recovery = None
            except AgyAccountPoolExhaustedError:
                busy = False
                recovery = _pool_recovery_estimate(
                    coordinator,
                    model_family=model_family,
                    exclude_hashes=exclude_hashes,
                    quota_snapshot=quota_snapshot,
                )
            attempt = default_pass
            state = "POOL_BUSY" if busy else "POOL_RECOVERING"
            remaining = deadline - _queue_monotonic()
            if busy:
                if remaining <= 0:
                    raise give_up()
                delay = min(poll, remaining)
            else:
                assert recovery is not None
                earliest = recovery.get("earliest_reset_ts")
                until_reset = None if earliest is None else float(earliest) - time.time()
                if until_reset is None or until_reset > remaining:
                    raise give_up()
                delay = min(max(until_reset, 0.0) + 0.5, POOL_QUEUE_MAX_SLEEP_SECONDS, remaining)
                refresh_before_pass = True
            if ticket is not None:
                ticket.touch()
            if on_queue is not None:
                reset_at = None if recovery is None else recovery.get("earliest_reset_at")
                on_queue(
                    state=state,
                    passes=passes,
                    waited_seconds=_queue_monotonic() - started,
                    earliest_reset_at=reset_at,
                )
            _sleep(max(0.01, delay))
    finally:
        if ticket is not None:
            ticket.close()


# #2432: profiles under which agy has no write tool and no command tool (every
# profile denies commands; ``plan`` mode never edits), so a run cannot have
# changed the repository even when the change observation is unavailable.
NO_WRITE_PERMISSION_PROFILE_KINDS = frozenset({"READ_ONLY_RESEARCH", "NO_TOOL_PACKET"})


def _quota_failure_effect(
    attempt_changed_paths: list[str] | None,
    *,
    mode: str,
    permission_profile_kind: str | None,
    allow_rules: list[str] | None = None,
) -> tuple[str, bool | None, bool]:
    """``(failure_kind, provider_effect, reconciliation_required)`` of a quota failure.

    An observed change keeps reconciliation.  Without an observation
    (``None``: cwd outside git, or the readback failed) a write-capable run is
    UNKNOWN_EFFECT, but a run that could not write is no-effect (#2432) and
    rotates like a pre-effect quota failure.
    """
    if attempt_changed_paths:
        return "PROVIDER_QUOTA_EXHAUSTED_AFTER_EFFECT", True, True
    if attempt_changed_paths == []:
        return "PROVIDER_QUOTA_EXHAUSTED_PRE_EFFECT", False, False
    # A READ_ONLY_RESEARCH packet keeps caller allow rules, so it is no-write
    # only when no write or command tool is granted (Codex r1 on #2435).
    grants_effect_tool = any(
        str(rule).startswith(("write_file", "command")) for rule in (allow_rules or [])
    )
    if (
        mode != "accept-edits"
        and permission_profile_kind in NO_WRITE_PERMISSION_PROFILE_KINDS
        and not grants_effect_tool
    ):
        return "PROVIDER_QUOTA_EXHAUSTED_NO_WRITE_PROFILE", False, False
    return "PROVIDER_QUOTA_EXHAUSTED_UNKNOWN_EFFECT", None, True


def _rotation_cap(coordinator: Any) -> int:
    """Rotations allowed: the configured cap, never more than the other pool accounts."""
    cap = _max_account_failovers()
    manager = getattr(coordinator, "manager", None)
    ensure_pool = getattr(manager, "_ensure_pool", None)
    if callable(ensure_pool):
        try:
            pool_size = len(ensure_pool()._accounts)
        except Exception:
            pool_size = 0
        if pool_size > 1:
            cap = min(cap, pool_size - 1)
    return cap


def dispatch_run(
    *,
    prompt: str,
    cwd: str,
    mode: str = "plan",
    model: str | None = None,
    effort: str | None = None,
    timeout: int | None = None,
    max_calls: int = 3,
    pool_wait_timeout: float | None = None,
    allow: list[str] | None = None,
    deny: list[str] | None = None,
    write_paths: list[str] | None = None,
    temp_command_permissions: bool = False,
    coordinator: CrossProcessLeaseCoordinator | None = None,
    run_agy_fn: Any = None,
    operation_hook: Any = None,
    admission: dict[str, Any] | None = None,
    provider_stall_seconds: float | None = None,
    stream_no_progress_seconds: float | None = None,
    pre_effect_max_seconds: float | None = None,
    pre_effect_max_tool_events: int | None = None,
    exclude_accounts: list[str] | None = None,
    run_as_user: str | None = None,
    empty_output_min_bytes: int | None = None,
    operation_id: str | None = None,
) -> int:
    started_at = _monotonic()
    limits: dict[str, Any] = {}
    empty_output_failovers = 0

    def emit_run_meta(data: dict[str, Any]) -> None:
        emit_meta({**limits, "empty_output_failovers": empty_output_failovers, **data})

    user_allow = list(allow or [])
    try:
        effective_permissions, permission_profile_kind, permission_profile_sha256 = (
            build_effective_permission_profile(
                cwd=cwd,
                mode=mode,
                write_paths=write_paths,
                allow_rules=user_allow,
                deny_rules=deny,
                temp_command_permissions=temp_command_permissions,
            )
        )
    except ValueError as exc:
        failure_kind = str(exc)
        contract_failure = f"DISPATCH_CONTRACT_REJECTED:{failure_kind}"
        limits = _unresolved_dispatch_limits(
            timeout, provider_stall_seconds, empty_output_min_bytes
        )
        _operation_hook(
            operation_hook,
            phase="CONTRACT_REJECTED",
            attempts=0,
            rotations=0,
            failure_kind=contract_failure,
            provider_effect=False,
            permission_profile_kind="INVALID",
            permission_profile_sha256=None,
            effective_permissions=None,
        )
        emit_run_meta({
            "status": "invalid_contract",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": contract_failure,
            "provider_effect": False,
            "wall_ms": 0,
            "permission_profile_sha256": None,
            "permission_profile_kind": "INVALID",
        })
        return 64

    limits = _resolve_dispatch_limits(
        permission_profile_kind, timeout, provider_stall_seconds, empty_output_min_bytes
    )
    total_budget_seconds = max(1, int(limits["timeout_seconds"]))
    total_deadline = started_at + total_budget_seconds
    provider_stall_seconds = limits["provider_stall_seconds"]
    _operation_hook(
        operation_hook,
        **limits,
        empty_output_failovers=empty_output_failovers,
        permission_profile_sha256=permission_profile_sha256,
        permission_profile_kind=permission_profile_kind,
        effective_permissions=effective_permissions,
    )

    if effort is not None and effort not in ("low", "medium", "high"):
        effort_failure = f"DISPATCH_CONTRACT_REJECTED:INVALID_EFFORT:{effort}"
        _operation_hook(
            operation_hook,
            phase="CONTRACT_REJECTED",
            attempts=0,
            rotations=0,
            failure_kind=effort_failure,
            provider_effect=False,
        )
        emit_run_meta({
            "status": "invalid_contract",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": effort_failure,
            "provider_effect": False,
            "wall_ms": 0,
        })
        return 64

    if model is not None:
        stripped_model = model.strip()
        if not stripped_model:
            model_failure = "DISPATCH_MODEL_REJECTED:EMPTY_MODEL"
        elif not re.fullmatch(r"[a-zA-Z0-9_.:-]+", stripped_model):
            model_failure = f"DISPATCH_MODEL_REJECTED:INVALID_MODEL_SYNTAX:{model}"
        elif _model_family(stripped_model) == "unknown":
            model_failure = f"DISPATCH_MODEL_REJECTED:UNSUPPORTED_MODEL_FAMILY:{model}"
        elif (
            stripped_model in ("claude-opus-4-6", "claude-3-opus", "claude-opus")
            and effort is not None
        ) or (
            # #2388: an effort-suffixed id names its own effort.
            effort is not None
            and _model_effort_suffix(stripped_model) not in (None, effort)
        ):
            model_failure = (
                f"DISPATCH_MODEL_CONTRACT_REJECTED:UNSUPPORTED_EFFORT_FOR_MODEL:{model}:{effort}"
            )
        else:
            model_failure = None
        if model_failure:
            _operation_hook(
                operation_hook,
                phase="MODEL_REJECTED",
                attempts=0,
                rotations=0,
                failure_kind=model_failure,
                provider_effect=False,
            )
            emit_run_meta({
                "status": "invalid_model",
                "attempts": 0,
                "rotations": 0,
                "failure_kind": model_failure,
                "provider_effect": False,
                "wall_ms": 0,
            })
            return 64

    if admission is not None:
        decision = admission.get("overall_decision") or admission.get("decision")
        if decision != "ALLOW":
            reason = str(admission.get("reason") or decision or "DISPATCH_ADMISSION_REJECTED")
            admission_failure = f"DISPATCH_ADMISSION_REJECTED:{reason}"
            _operation_hook(
                operation_hook,
                phase="ADMISSION_REJECTED",
                attempts=0,
                rotations=0,
                failure_kind=admission_failure,
                provider_effect=False,
            )
            emit_run_meta({
                "status": "admission_rejected",
                "attempts": 0,
                "rotations": 0,
                "failure_kind": admission_failure,
                "provider_effect": False,
                "wall_ms": 0,
            })
            return 64

    runner = run_agy_fn if run_agy_fn is not None else run_agy
    # #2202: an accept-edits Agy run only ever starts inside the #1912 Seatbelt
    # write boundary.  Refuse before any account is leased when it is missing.
    # A runner that cannot take the boundary would run unconfined, so it is
    # refused here too rather than after a lease.
    needs_write_boundary = mode == "accept-edits"
    boundary_refusal = None
    if run_as_user is not None and not needs_write_boundary:
        # #2884: the worker account only ever runs inside the accept-edits boundary.
        boundary_refusal = RUN_AS_USER_REQUIRES_ACCEPT_EDITS
    elif needs_write_boundary and not _runner_accepts(runner, "write_boundary"):
        boundary_refusal = AGY_WRITE_BOUNDARY_RUNNER_UNSUPPORTED
    elif needs_write_boundary and not _write_boundary_available():
        boundary_refusal = AGY_WRITE_BOUNDARY_UNAVAILABLE
    if boundary_refusal is not None:
        boundary_failure = f"DISPATCH_CONTRACT_REJECTED:{boundary_refusal}"
        _operation_hook(
            operation_hook,
            phase="CONTRACT_REJECTED",
            attempts=0,
            rotations=0,
            failure_kind=boundary_failure,
            provider_effect=False,
        )
        emit_run_meta({
            "status": "invalid_contract",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": boundary_failure,
            "provider_effect": False,
            "wall_ms": 0,
        })
        return 64

    if coordinator is None:
        if not MANAGER.is_file() or not MANAGER_ROOT.is_dir():
            raise SystemExit("AGY_ACCOUNT_POOL_RUNTIME_MISSING")

        pool = AgyAccountPoolManager(
            manager_path=str(MANAGER),
            manager_root=str(MANAGER_ROOT),
            use_real_manager=True,
        )
        coordinator = CrossProcessLeaseCoordinator(
            manager=pool,
            allocator_lock_path=ALLOCATOR_LOCK_PATH,
            leases_dir=LEASES_DIR,
        )

    quota_snapshot, availability_state = _apply_dynamic_availability(model)
    model_family = str(availability_state["family"])
    scoped_model_family = model_family if model_family in {"gemini", "claude_gpt"} else None

    usable_candidates = (
        list(availability_state.get("preferred", []))
        + list(availability_state.get("reserve", []))
        + list(availability_state.get("fallback", []))
    )
    blocked_candidates = list(availability_state.get("blocked", []))
    raw_unknown = availability_state.get("unknown")
    unknown_candidates = list(raw_unknown) if isinstance(raw_unknown, list) else []
    # Only a family whose every account is KNOWN blocked is exhausted. UNKNOWN
    # (stale/failed evidence) accounts proceed to claim and bounded per-account refresh.
    if (
        availability_state.get("snapshot_fresh")
        and len(usable_candidates) == 0
        and len(blocked_candidates) > 0
        and len(unknown_candidates) == 0
        and scoped_model_family is not None
    ):
        _operation_hook(
            operation_hook,
            phase="QUOTA_PREFLIGHT_EXHAUSTED",
            attempts=0,
            rotations=0,
            failure_kind="PROVIDER_QUOTA_EXHAUSTED_PRE_EFFECT",
            provider_effect=False,
            quota_preflight_progress={
                "phase": "PREFLIGHT_BLOCKED",
                "admission_state": "KNOWN_BLOCKED",
                "probe_state": "PROBE_OK",
                "quota_state": "blocked",
                "usable_count": 0,
                "blocked_count": len(blocked_candidates),
                "unknown_count": 0,
            },
            quota_preflight_decision=_quota_preflight_decision(
                account_alias_hash=None,
                model_family=scoped_model_family,
                quota_state="blocked",
                evidence_fresh=True,
                probe_state="CACHED_SUCCEEDED",
                dispatch_decision="BLOCK_KNOWN_QUOTA",
            ),
        )
        emit_run_meta({
            "status": "failed",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": "PROVIDER_QUOTA_EXHAUSTED_PRE_EFFECT",
            "provider_effect": False,
            "wall_ms": 0,
        })
        return 75

    consumer_id = "desktop-" + uuid.uuid4().hex
    try:
        exclude_hashes = _resolve_excluded_account_hashes(
            exclude_accounts,
            manager=getattr(coordinator, "manager", None),
        )
    except ValueError as exc:
        contract_failure = f"DISPATCH_CONTRACT_REJECTED:{exc}"
        _operation_hook(
            operation_hook,
            phase="CONTRACT_REJECTED",
            attempts=0,
            rotations=0,
            failure_kind=contract_failure,
            provider_effect=False,
        )
        emit_run_meta({
            "status": "invalid_contract",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": contract_failure,
            "provider_effect": False,
            "wall_ms": 0,
        })
        return 64

    claim: Optional[AccountLeaseClaim] = None
    user_exclude_hashes = frozenset(exclude_hashes)
    pool_queue: dict[str, Any] = {
        "wait_ms": 0,
        "waits": 0,
        "state": None,
        "earliest_reset_at": None,
    }

    def _on_pool_queue(**event: Any) -> None:
        pool_queue["state"] = event.get("state")
        if event.get("earliest_reset_at"):
            pool_queue["earliest_reset_at"] = event.get("earliest_reset_at")
        _operation_hook(
            operation_hook,
            pool_queue=dict(
                pool_queue,
                current_wait_ms=int(float(event.get("waited_seconds") or 0.0) * 1000),
            ),
        )

    def _record_pool_wait(waited_seconds: float) -> None:
        waited_ms = int(max(0.0, waited_seconds) * 1000)
        pool_queue["wait_ms"] += waited_ms
        if waited_ms > 0:
            pool_queue["waits"] += 1

    def _pool_claim_meta(exc: _PoolClaimFailure) -> dict[str, Any]:
        recovery = exc.recovery
        meta: dict[str, Any] = {
            "pool_queue_wait_ms": pool_queue["wait_ms"],
            "pool_wait_budget_seconds": round(last_wait_budget[0], 3),
        }
        if not exc.busy:
            meta["earliest_reset_at"] = recovery.get("earliest_reset_at")
            meta["pool_recovery"] = {
                key: recovery.get(key)
                for key in (
                    "accounts_considered",
                    "accounts_cooling",
                    "accounts_quota_blocked",
                    "accounts_without_known_recovery",
                )
            }
        return meta

    last_wait_budget = [0.0]

    def _refresh_availability() -> dict:
        # After waiting for a predicted quota reset, republish availability so
        # NEXUS_AGY_BLOCKED_ACCOUNTS no longer hides an account that reset.
        nonlocal quota_snapshot, availability_state
        quota_snapshot, availability_state = _apply_dynamic_availability(model)
        return quota_snapshot

    def _queued_claim(first_pass: Any = None) -> Any:
        last_wait_budget[0] = _pool_wait_budget(
            total_deadline=total_deadline,
            explicit=pool_wait_timeout,
        )
        try:
            new_claim, waited = _acquire_claim_queued(
                coordinator,
                consumer_id=consumer_id,
                exclude_hashes=exclude_hashes,
                wait_budget=last_wait_budget[0],
                model_family=scoped_model_family,
                quota_snapshot=quota_snapshot,
                first_pass=first_pass,
                on_queue=_on_pool_queue,
                refresh_availability=_refresh_availability,
                restricted=bool(user_exclude_hashes),
            )
        except _PoolClaimFailure as exc:
            _record_pool_wait(exc.waited_seconds)
            pool_queue["state"] = "POOL_BUSY" if exc.busy else "POOL_EXHAUSTED"
            if not exc.busy:
                pool_queue["earliest_reset_at"] = exc.recovery.get("earliest_reset_at")
            raise
        _record_pool_wait(waited)
        pool_queue["state"] = "LEASED"
        return new_claim

    try:
        claim = _queued_claim()
    except _PoolClaimFailure as claim_exc:
        busy = claim_exc.busy
        claim_failure = "AGY_ACCOUNT_POOL_BUSY" if busy else "ACCOUNT_UNAVAILABLE"
        claim_meta = _pool_claim_meta(claim_exc)
        claim_event: dict[str, Any] = {
            "phase": "ACCOUNT_CLAIM_FAILED",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": claim_failure,
            "provider_effect": False,
            "pool_queue": dict(pool_queue),
            "failure_history_entry": {
                "attempts": 0,
                "rotations": 0,
                "failure_kind": claim_failure,
                "account_alias_hash": None,
                "lease_id_hash": None,
                "pool_queue_wait_ms": pool_queue["wait_ms"],
                "earliest_reset_at": claim_meta.get("earliest_reset_at"),
            },
        }
        if scoped_model_family is not None:
            claim_event["quota_preflight_progress"] = {
                "phase": "PREFLIGHT_BLOCKED",
                "admission_state": (
                    "UNKNOWN_NOT_CLAIMABLE" if unknown_candidates else "NOT_CLAIMABLE"
                ),
                "usable_count": len(usable_candidates),
                "blocked_count": len(blocked_candidates),
                "unknown_count": len(unknown_candidates),
            }
        _operation_hook(operation_hook, **claim_event)
        emit_run_meta({
            "status": "pool_busy" if busy else "pool_exhausted",
            "attempts": 0,
            "rotations": 0,
            "failure_kind": claim_failure,
            "provider_effect": False,
            "wall_ms": 0,
            **claim_meta,
        })
        return 75

    attempts = 0
    work_failures = 0
    work_budget = max(1, max_calls)
    rotations = 0
    max_failovers = _rotation_cap(coordinator)
    # #2415: account-wide retirements (auth, unavailable, rate limit; not a
    # model-family quota cooldown) this run may make before it stops.
    account_retirements = 0
    retirement_cap = max_account_retirements()
    # #2432: accounts released because their catalog lacks the fixed model.
    capability_skipped: set[str] = set()
    # Accounts this run already ran agy on; a capability rotation never
    # returns to one of them.
    attempted_accounts: set[str] = set()
    # #2905: the orphan run-root GC runs at most once per dispatch, not per attempt.
    worker_gc_attempted = False
    last_kind = None
    total_wall_ms = 0
    active_provider_pid: int | None = None
    active_provider_pgid: int | None = None
    # #2888: set when a ``--run-as-user`` attempt ends without a proven clean
    # worker sweep.  The agy ran under another uid through sudo (the inherited
    # lease fd is closed), so the claim must not be released: the receipt stays
    # and the next claimer's reaper decides whether the worker run is gone.
    worker_lease_unproven = False

    attempt_tool_event_count = 0
    attempt_provider_session_id: str | None = None
    # #2202: disposable run HOMEs of this dispatch's boundary-wrapped attempts.
    boundary_run_homes: list[Path] = []

    def _inner_operation_hook(event: dict[str, Any] | None = None, **kwargs: Any) -> None:
        nonlocal active_provider_pid, active_provider_pgid, attempt_tool_event_count
        nonlocal attempt_provider_session_id
        merged = dict(event or {})
        merged.update(kwargs)
        if isinstance(merged.get("tool_event_count"), int):
            attempt_tool_event_count = max(attempt_tool_event_count, merged["tool_event_count"])
        if isinstance(merged.get("provider_session_id"), str):
            attempt_provider_session_id = merged["provider_session_id"]
        if isinstance(merged.get("provider_pid"), int):
            active_provider_pid = merged["provider_pid"]
        if isinstance(merged.get("provider_pgid"), int):
            active_provider_pgid = merged["provider_pgid"]
        _operation_hook(operation_hook, **merged)

    _operation_hook(
        operation_hook,
        phase="ACCOUNT_LEASED",
        account_alias_hash=claim.account_alias_hash,
        lease_id_hash=claim.lease_id_hash,
        attempts=attempts,
        rotations=rotations,
        pool_queue=dict(pool_queue),
    )

    def _budget_exhausted() -> bool:
        """True when a further attempt/rotation would start below the budget floor."""
        return attempts > 0 and (
            total_deadline - _monotonic() < TOTAL_DEADLINE_MIN_ATTEMPT_SECONDS
        )

    def _emit_total_deadline_exhausted() -> int:
        _operation_hook(
            operation_hook,
            phase="CLASSIFYING_FAILURE",
            attempts=attempts,
            rotations=rotations,
            failure_kind="TIMEOUT",
            timed_out=True,
            account_alias_hash=claim.account_alias_hash,
            lease_id_hash=claim.lease_id_hash,
            provider_effect=None,
            reconciliation_required=False,
        )
        emit_run_meta({
            "status": "failed",
            "attempts": attempts,
            "rotations": rotations,
            "failure_kind": "TIMEOUT",
            "total_deadline_exhausted": True,
            "total_timeout_seconds": total_budget_seconds,
            "account_alias_hash": claim.account_alias_hash,
            "lease_id_hash": claim.lease_id_hash,
            "parallel_slot": True,
            "wall_ms": total_wall_ms,
        })
        return 124

    try:
        while True:
            if _budget_exhausted():
                return _emit_total_deadline_exhausted()
            quota_probe = {
                "state": _selected_snapshot_probe_state(quota_snapshot, claim.internal_id)
            }
            if scoped_model_family is not None:
                quota_state, reset_ts, evidence_fresh = _account_family_quota_state(
                    quota_snapshot,
                    account_name=claim.internal_id,
                    model_family=scoped_model_family,
                )
                if not evidence_fresh:
                    quota_probe["state"] = "UNKNOWN"

                    def on_quota_progress(**event: Any) -> None:
                        progress = event.get("quota_preflight_progress")
                        if isinstance(progress, dict):
                            if progress.get("phase") == "ACCOUNT_RESULT":
                                quota_probe["state"] = (
                                    "SUCCEEDED" if progress.get("ok") is True else "FAILED"
                                )
                            elif progress.get("phase") == "TIMED_OUT":
                                quota_probe["state"] = "TIMED_OUT"
                            elif progress.get("phase") == "START_FAILED":
                                quota_probe["state"] = "START_FAILED"
                        _operation_hook(operation_hook, **event)

                    quota_snapshot = _refresh_quota_snapshot_for_account(
                        claim.internal_id,
                        on_phase_hook=on_quota_progress,
                        account_alias_hash=claim.account_alias_hash,
                    )
                    availability_state = _dynamic_availability_state(model, quota_snapshot)
                    _publish_dynamic_availability(availability_state)
                    quota_state, reset_ts, evidence_fresh = _account_family_quota_state(
                        quota_snapshot,
                        account_name=claim.internal_id,
                        model_family=scoped_model_family,
                    )
                if evidence_fresh and quota_state == "blocked":
                    _operation_hook(
                        operation_hook,
                        quota_preflight_decision=_quota_preflight_decision(
                            account_alias_hash=claim.account_alias_hash,
                            model_family=scoped_model_family,
                            quota_state=quota_state,
                            evidence_fresh=evidence_fresh,
                            probe_state=quota_probe["state"],
                            dispatch_decision=(
                                "BLOCK_KNOWN_QUOTA"
                                if rotations >= max_failovers
                                else "ROTATE_KNOWN_QUOTA"
                            ),
                        ),
                    )
                    unavailable_until = (
                        reset_ts
                        if reset_ts is not None and reset_ts > time.time()
                        else time.time() + DEFAULT_QUOTA_FAMILY_BLOCK_SECONDS
                    )
                    _operation_hook(
                        operation_hook,
                        failure_history_entry={
                            "attempts": attempts,
                            "rotations": rotations,
                            "failure_kind": "QUOTA_EXHAUSTED_KNOWN_PRE_ATTEMPT",
                            "account_alias_hash": claim.account_alias_hash,
                            "lease_id_hash": claim.lease_id_hash,
                        },
                    )
                    if rotations >= max_failovers:
                        coordinator.retire_failed_claim(
                            claim,
                            AccountFailureKind.QUOTA_EXHAUSTED,
                            model_family=scoped_model_family,
                            unavailable_until=unavailable_until,
                        )
                        emit_run_meta({
                            "status": "failed",
                            "attempts": attempts,
                            "rotations": rotations,
                            "failure_kind": "ACCOUNT_FAILOVER_LIMIT",
                            "account_alias_hash": claim.account_alias_hash,
                            "lease_id_hash": claim.lease_id_hash,
                            "parallel_slot": True,
                            "wall_ms": total_wall_ms,
                        })
                        return 75
                    blocked_claim = claim
                    try:
                        claim = _queued_claim(
                            first_pass=lambda: coordinator.rotate_claim(
                                current_claim=blocked_claim,
                                failure_kind=AccountFailureKind.QUOTA_EXHAUSTED,
                                exclude_hashes=exclude_hashes,
                                wait_timeout=0.0,
                                model_family=scoped_model_family,
                                unavailable_until=unavailable_until,
                            )
                        )
                        rotations += 1
                        _operation_hook(
                            operation_hook,
                            phase="ACCOUNT_ROTATED",
                            attempts=attempts,
                            rotations=rotations,
                            failure_kind=AccountFailureKind.QUOTA_EXHAUSTED.value,
                            account_alias_hash=claim.account_alias_hash,
                            lease_id_hash=claim.lease_id_hash,
                            quota_preflight_progress={
                                "phase": "PREFLIGHT_BLOCKED",
                                "admission_state": "KNOWN_BLOCKED",
                                "probe_state": "PROBE_OK",
                                "quota_state": "blocked",
                                "account_alias_hash": claim.account_alias_hash,
                            },
                        )
                        continue
                    except _PoolClaimFailure as rotate_exc:
                        _operation_hook(
                            operation_hook,
                            pool_queue=dict(pool_queue),
                            **_pool_busy_failure_fields(rotate_exc),
                        )
                        emit_run_meta({
                            "status": "pool_busy" if rotate_exc.busy else "pool_exhausted",
                            "attempts": attempts,
                            "rotations": rotations,
                            "failure_kind": (
                                "AGY_ACCOUNT_POOL_BUSY" if rotate_exc.busy else "QUOTA_EXHAUSTED"
                            ),
                            "wall_ms": total_wall_ms,
                            "permission_profile_sha256": permission_profile_sha256,
                            "permission_profile_kind": permission_profile_kind,
                            **_pool_claim_meta(rotate_exc),
                        })
                        return 75

            if scoped_model_family is not None:
                admission_state = (
                    "KNOWN_ELIGIBLE"
                    if evidence_fresh and quota_state in ("five_hour", "weekly")
                    else "UNVERIFIED_POLICY_ALLOWED"
                )
                probe_state = (
                    "PROBE_OK"
                    if evidence_fresh
                    else ("PROBE_STALE" if quota_state == "stale" else "PROBE_UNKNOWN_OR_FAILED")
                )
                _operation_hook(
                    operation_hook,
                    quota_preflight_progress={
                        "phase": "PREFLIGHT_ADMITTED",
                        "admission_state": admission_state,
                        "probe_state": probe_state,
                        "quota_state": quota_state,
                        "account_alias_hash": claim.account_alias_hash,
                    },
                )
                _operation_hook(
                    operation_hook,
                    quota_preflight_decision=_quota_preflight_decision(
                        account_alias_hash=claim.account_alias_hash,
                        model_family=scoped_model_family,
                        quota_state=quota_state,
                        evidence_fresh=evidence_fresh,
                        probe_state=quota_probe["state"],
                        dispatch_decision=(
                            "ALLOW_KNOWN_ELIGIBLE"
                            if evidence_fresh and quota_state in {"five_hour", "weekly"}
                            else "ALLOW_UNKNOWN_QUOTA"
                        ),
                    ),
                )
            else:
                _operation_hook(
                    operation_hook,
                    quota_preflight_decision=_quota_preflight_decision(
                        account_alias_hash=claim.account_alias_hash,
                        model_family=model_family,
                        quota_state="not_applicable",
                        evidence_fresh=False,
                        probe_state="NOT_RUN",
                        dispatch_decision="ALLOW_NO_QUOTA_FAMILY",
                    ),
                )

            catalog_decision = _agy_model_catalog_admission(
                model=model,
                effort=effort,
                env=dict(claim.lease.execution_env),
                account_alias_hash=claim.account_alias_hash,
                # #2388: a fresh `agy models` fetch (up to 30 s) is charged to
                # the total deadline and leaves room for one attempt.
                max_fetch_seconds=(
                    total_deadline - _monotonic() - TOTAL_DEADLINE_MIN_ATTEMPT_SECONDS
                ),
            )
            _operation_hook(
                operation_hook,
                requested_model=catalog_decision["requested_model"],
                resolved_model=catalog_decision["resolved_model"],
                model_catalog=catalog_decision["model_catalog"],
            )
            if not catalog_decision["admitted"]:
                # #1357: the leased account's live catalog lacks the fixed model.
                # No substitution.  #2432: accounts expose different model
                # lists, so release this one (it is healthy: not retired) and
                # claim another account not yet tried; fail only when no
                # remaining account can be claimed.
                capability_skipped.add(claim.account_alias_hash)
                exclude_hashes.add(claim.account_alias_hash)
                skipped_claim = claim
                skipped_claim.release()
                if total_deadline - _monotonic() < TOTAL_DEADLINE_MIN_ATTEMPT_SECONDS:
                    # No budget left to check another account (Codex r1 #2435).
                    return _emit_total_deadline_exhausted()
                next_claim = None
                exhausted_meta: dict[str, Any] = {}
                try:
                    next_claim = _queued_claim(
                        first_pass=lambda: coordinator.acquire_claim(
                            consumer_id=consumer_id,
                            exclude_hashes=exclude_hashes,
                            wait_timeout=0.0,
                            model_family=scoped_model_family,
                        )
                    )
                except _PoolClaimFailure as capability_exc:
                    if capability_exc.busy:
                        # Unchecked accounts are leased elsewhere: the model may
                        # be available there, so this is a busy pool, not an
                        # invalid model.
                        _operation_hook(
                            operation_hook,
                            pool_queue=dict(pool_queue),
                            failure_kind="AGY_ACCOUNT_POOL_BUSY",
                        )
                        emit_run_meta({
                            "status": "pool_busy",
                            "attempts": attempts,
                            "rotations": rotations,
                            "failure_kind": "AGY_ACCOUNT_POOL_BUSY",
                            "capability_checked_accounts": len(capability_skipped),
                            "wall_ms": total_wall_ms,
                            "permission_profile_sha256": permission_profile_sha256,
                            "permission_profile_kind": permission_profile_kind,
                            **_pool_claim_meta(capability_exc),
                        })
                        return 75
                    exhausted_meta = _pool_claim_meta(capability_exc)
                    next_claim = None
                if (
                    next_claim is not None
                    and next_claim.account_alias_hash not in capability_skipped
                    and next_claim.account_alias_hash not in attempted_accounts
                ):
                    claim = next_claim
                    _operation_hook(
                        operation_hook,
                        phase="ACCOUNT_ROTATED",
                        attempts=attempts,
                        rotations=rotations,
                        failure_kind="MODEL_CAPABILITY_UNAVAILABLE",
                        capability_skipped_accounts=len(capability_skipped),
                        account_alias_hash=claim.account_alias_hash,
                        lease_id_hash=claim.lease_id_hash,
                        pool_queue=dict(pool_queue),
                    )
                    continue
                if next_claim is not None and next_claim is not skipped_claim:
                    next_claim.release()
                capability_detail = (
                    "DISPATCH_MODEL_CONTRACT_REJECTED:MODEL_CAPABILITY_UNAVAILABLE:"
                    f"{catalog_decision['resolved_model']}"
                )
                last_kind = "MODEL_CAPABILITY_UNAVAILABLE"
                _operation_hook(
                    operation_hook,
                    phase="MODEL_REJECTED",
                    attempts=attempts,
                    rotations=rotations,
                    failure_kind="MODEL_CAPABILITY_UNAVAILABLE",
                    failure_detail=capability_detail,
                    provider_effect=False,
                    retry_permitted=True,
                    account_alias_hash=claim.account_alias_hash,
                    lease_id_hash=claim.lease_id_hash,
                )
                emit_run_meta({
                    "status": "invalid_model",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": "MODEL_CAPABILITY_UNAVAILABLE",
                    "failure_detail": capability_detail,
                    # #2432: every claimable account was checked; none offers it.
                    "capability_checked_accounts": len(capability_skipped),
                    **exhausted_meta,
                    "provider_effect": False,
                    "retry_permitted": True,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "requested_model": catalog_decision["requested_model"],
                    "resolved_model": catalog_decision["resolved_model"],
                    "model_catalog": catalog_decision["model_catalog"],
                    "wall_ms": total_wall_ms,
                })
                return 64

            if _budget_exhausted() or (
                # #2432: capability checks ran before the first attempt; do not
                # start the provider past the deadline (Codex r2 on #2435).
                # #2388: the same holds after a fresh catalog fetch.
                (
                    capability_skipped
                    or catalog_decision["model_catalog"].get("source") == "FRESH"
                )
                and total_deadline - _monotonic() < TOTAL_DEADLINE_MIN_ATTEMPT_SECONDS
            ):
                return _emit_total_deadline_exhausted()
            attempts += 1
            attempted_accounts.add(claim.account_alias_hash)
            _operation_hook(
                operation_hook,
                phase="EXECUTING",
                attempts=attempts,
                rotations=rotations,
                failure_kind=None,
                account_alias_hash=claim.account_alias_hash,
                lease_id_hash=claim.lease_id_hash,
            )
            env = dict(claim.lease.execution_env)
            attempt_baseline = None
            try:
                attempt_baseline = direct_operation_journal.capture_source_baseline(cwd)
                if attempt_baseline is None:
                    raise RuntimeError("SOURCE_BASELINE_UNAVAILABLE")
            except Exception as exc:
                _operation_hook(
                    operation_hook,
                    effect_observation_error=f"ATTEMPT_BASELINE_CAPTURE_FAILED:{type(exc).__name__}",
                )
            provider_log_path = env.get("NEXUS_AGY_ATTESTATION_LOG") or os.getenv(
                "NEXUS_AGY_ATTESTATION_LOG"
            )
            # None means this attempt's log span is unknown; never scan stale bytes.
            provider_log_attempt_offset: int | None = 0
            if provider_log_path:
                try:
                    provider_log_attempt_offset = (
                        Path(provider_log_path).expanduser().stat().st_size
                    )
                except FileNotFoundError:
                    provider_log_attempt_offset = 0
                except OSError:
                    provider_log_attempt_offset = None
            permission_token = None
            write_boundary = None
            attempt_tool_event_count = 0
            attempt_provider_session_id = None
            attempt_last_tool_target = (None, None)
            try:
                if needs_write_boundary:
                    # Disposable HOME + exact env + Seatbelt profile; the permission
                    # profile below is installed into the disposable HOME, never
                    # into the leased account HOME.
                    # #2314: no write grant for the attestation log; run_agy
                    # relays agy's --log-file through a FIFO in the run root.
                    boundary_module = _agy_dispatch_boundary()
                    try:
                        if run_as_user is not None:
                            # #2884: agy runs as the worker account in a per-run
                            # copy of the target under worker-runs.
                            if (
                                not worker_gc_attempted
                                and total_deadline - _monotonic() > WORKER_GC_MIN_REMAINING_SECONDS
                            ):
                                worker_gc_attempted = True
                                try:
                                    _agy_worker_account().gc_unreferenced_worker_run_roots(
                                        _agy_account_pool.referenced_worker_run_roots(
                                            claim.receipt_path.parent
                                        ),
                                        limit=WORKER_GC_MAX_ROOTS,
                                    )
                                except Exception:
                                    pass  # #2905: best-effort hygiene; never fails a dispatch
                            write_boundary = _agy_worker_account().prepare_worker_account_boundary(
                                source_env=env,
                                target=cwd,
                                worker_user=run_as_user,
                                source_agy=shutil.which("agy"),
                            )
                            # Worker receipts on stderr (one WORKER_LAUNCH, WORKER_SWEEP
                            # and WORKER_CLEANUP line per attempt); the foreground has
                            # no operation id.
                            write_boundary.receipt_context = {
                                "operation_id": operation_id,
                                "attempt": attempts,
                            }
                        else:
                            write_boundary = boundary_module.prepare_accept_edits_boundary(
                                source_env=env,
                                target=cwd,
                            )
                    except boundary_module.AgyWriteBoundaryError as exc:
                        # Typed, non-rotating contract rejection; the boundary
                        # already removed its run root and the outer finally
                        # releases the lease.
                        prepare_failure = (
                            f"DISPATCH_CONTRACT_REJECTED:{AGY_WRITE_BOUNDARY_PREPARE_FAILED}:{exc}"
                        )
                        last_kind = prepare_failure
                        _operation_hook(
                            operation_hook,
                            phase="CONTRACT_REJECTED",
                            attempts=attempts,
                            rotations=rotations,
                            failure_kind=prepare_failure,
                            provider_effect=False,
                        )
                        emit_run_meta({
                            "status": "invalid_contract",
                            "attempts": attempts,
                            "rotations": rotations,
                            "failure_kind": prepare_failure,
                            "provider_effect": False,
                            "account_alias_hash": claim.account_alias_hash,
                            "lease_id_hash": claim.lease_id_hash,
                            "wall_ms": total_wall_ms,
                        })
                        return 64
                    env = write_boundary.env
                    if run_as_user is not None:
                        # #2888: sudo closes the inherited lease fd, so only this
                        # process holds the account flock.  Record the worker run
                        # in the durable receipt before anything launches; a
                        # failure here means nothing started, so end without
                        # rotation or retry (the attempt's finally removes the
                        # boundary, the function's finally releases the lease).
                        try:
                            claim.mark_worker_run(
                                run_root=str(write_boundary.run_root),
                                run_root_id=_path_identity(write_boundary.run_root),
                                run_as_user=run_as_user,
                            )
                        except Exception as mark_exc:
                            mark_failure = (
                                f"{AGY_WORKER_LEASE_MARK_FAILED}:{type(mark_exc).__name__}"
                            )
                            last_kind = mark_failure
                            _operation_hook(
                                operation_hook,
                                phase="CLASSIFYING_FAILURE",
                                attempts=attempts,
                                rotations=rotations,
                                failure_kind=mark_failure,
                                provider_effect=False,
                                reconciliation_required=False,
                                account_alias_hash=claim.account_alias_hash,
                                lease_id_hash=claim.lease_id_hash,
                            )
                            emit_run_meta({
                                "status": "failed",
                                "attempts": attempts,
                                "rotations": rotations,
                                "failure_kind": mark_failure,
                                "provider_effect": False,
                                "reconciliation_required": False,
                                "account_alias_hash": claim.account_alias_hash,
                                "lease_id_hash": claim.lease_id_hash,
                                "wall_ms": total_wall_ms,
                            })
                            return 1
                allow_rules = list(effective_permissions.get("allow") or [])
                deny_rules = list(effective_permissions.get("deny") or [])
                replace_allow_deny = bool(
                    mode == "accept-edits"
                    or allow_rules
                    or deny_rules
                    or temp_command_permissions
                    or permission_profile_kind == "NO_TOOL_PACKET"
                )
                allow_unsafe_legacy = bool(temp_command_permissions or "command(*)" in allow_rules)
                installed_profile_sha256 = permission_profile_sha256
                agent_cwd = cwd
                if run_as_user is not None and write_boundary is not None:
                    # #2884: agy sees the per-run copy, so its path rules name it.
                    agent_cwd = str(write_boundary.target)
                    allow_rules = _remap_rules_to_workdir(allow_rules, cwd, agent_cwd)
                    deny_rules = _remap_rules_to_workdir(deny_rules, cwd, agent_cwd)
                    installed_profile_sha256 = permission_profile_digest({
                        "allow": allow_rules,
                        "deny": deny_rules,
                    })
                if allow_rules or deny_rules or replace_allow_deny:
                    permission_token = install_temp_permissions(
                        env,
                        allow_rules=allow_rules,
                        deny_rules=deny_rules,
                        allow_unsafe_legacy=allow_unsafe_legacy,
                        replace_allow_deny=replace_allow_deny,
                        mode=mode,
                        expected_profile_sha256=installed_profile_sha256,
                    )
                runner_kwargs = {
                    "env": env,
                    "prompt": prompt,
                    "cwd": agent_cwd,
                    "mode": mode,
                    "model": model,
                    "effort": effort,
                    "timeout": max(1, int(total_deadline - _monotonic())),
                }
                if _runner_accepts(runner, "operation_hook"):
                    runner_kwargs["operation_hook"] = _inner_operation_hook
                if _runner_accepts(runner, "expect_coding_progress"):
                    runner_kwargs["expect_coding_progress"] = bool(
                        mode == "accept-edits" and write_paths
                    )
                if _runner_accepts(runner, "provider_stall_seconds"):
                    runner_kwargs["provider_stall_seconds"] = provider_stall_seconds
                if _runner_accepts(runner, "stream_no_progress_seconds"):
                    runner_kwargs["stream_no_progress_seconds"] = stream_no_progress_seconds
                if _runner_accepts(runner, "pre_effect_max_seconds"):
                    runner_kwargs["pre_effect_max_seconds"] = pre_effect_max_seconds
                if _runner_accepts(runner, "pre_effect_max_tool_events"):
                    runner_kwargs["pre_effect_max_tool_events"] = pre_effect_max_tool_events
                if write_boundary is not None:
                    runner_kwargs["write_boundary"] = write_boundary
                lease_lock_obj = getattr(claim, "lock_file_obj", None)
                if lease_lock_obj is not None and _runner_accepts(runner, "lease_fd"):
                    try:
                        runner_kwargs["lease_fd"] = int(lease_lock_obj.fileno())
                    except (OSError, ValueError, TypeError):
                        pass
                if write_boundary is not None:
                    # #2470: durable "sweep pending" marker before launch. Until
                    # a verdict replaces it, the supervisor guard and the
                    # completion path treat the attempt's sweep as unclean, so
                    # a verdict write that fails (or a second signal during
                    # it) never reads as clean.
                    worker_sweep_fields = (
                        {
                            "worker_run_as_user": run_as_user,
                            "worker_run_root": str(write_boundary.run_root),
                            # (st_dev, st_ino) of the run root: the journal is
                            # owner-only, so the worker cannot rewrite it.
                            "worker_run_root_id": _path_identity(write_boundary.run_root),
                        }
                        if run_as_user is not None else {}
                    )
                    _operation_hook(
                        operation_hook,
                        descendant_sweep_clean=None,
                        descendant_sweep_attempt=attempts,
                        # roots the operator ack re-checks (the run root is
                        # removed at cleanup unless kept for diagnostics)
                        descendant_sweep_roots=list(getattr(write_boundary, "sweep_roots", ())),
                        **worker_sweep_fields,
                    )
                try:
                    code, out, err, timed_out, wall_ms = runner(**runner_kwargs)
                except Exception as runner_exc:
                    # #2202: a launch frame that raised after launch skipped its
                    # own sweep; sweep now (once) and, when descendants may
                    # survive, end the operation as a sweep failure.
                    if write_boundary is None or write_boundary.sweep():
                        raise
                    code, out, timed_out, wall_ms = 1, "", False, 0
                    err = (
                        f"{type(runner_exc).__name__}: {runner_exc}\n"
                        f"{DESCENDANT_SWEEP_FAILED_MARKER}\n"
                    )
            except BaseException:
                # #2470: a signal (_SupervisorSignalError, KeyboardInterrupt) or
                # any other exception leaving the attempt skips the result check
                # above; cleanup() would sweep and drop the verdict. Record it
                # first so the supervisor guard terminalizes an unclean sweep
                # as RECONCILE_REQUIRED.
                if write_boundary is not None:
                    _record_descendant_sweep(operation_hook, write_boundary, attempts)
                raise
            finally:
                try:
                    restore_temp_permissions(permission_token)
                finally:
                    # #2783: cleanup deletes the transcript with the run HOME.
                    # Keep only the last tool name/path, never copied credentials.
                    transcript = _agy_transcript_path(env, attempt_provider_session_id)
                    if transcript is not None:
                        try:
                            attempt_last_tool_target = last_tool_call_target(
                                transcript.read_text(encoding="utf-8", errors="replace")
                            )
                        except Exception:
                            # Best effort only: the run HOME cleanup below must run.
                            pass
                    if write_boundary is not None:
                        try:
                            write_boundary.cleanup()
                        finally:
                            if run_as_user is not None:
                                # #2888: cleanup ran the (run-once) sweep.  Anything
                                # but a proven clean verdict, including a sweep that
                                # raised, keeps this lease claim unreleased.
                                # The recorded verdict only: calling sweep() here
                                # would re-run a sweep that raised in cleanup().
                                if getattr(write_boundary, "sweep_verdict_clean", None) is not True:
                                    worker_lease_unproven = True
                                    try:
                                        # Always marked, even with no survivor
                                        # identity: the marker alone makes the
                                        # reaper wait for an idle worker account.
                                        claim.mark_worker_unclean(
                                            getattr(write_boundary, "unclean_tokens", ())
                                        )
                                    except Exception as exc:
                                        sys.stderr.write(
                                            "nexus-agy-dispatch: worker unclean lease mark failed: "
                                            f"{type(exc).__name__}\n"
                                        )
            if write_boundary is not None:
                # #2470: the attempt ended normally; replace the pending marker
                # with the (already recorded, run-once) sweep verdict.
                _operation_hook(
                    operation_hook,
                    descendant_sweep_clean=bool(write_boundary.sweep()),
                    descendant_sweep_attempt=attempts,
                )
            total_wall_ms += wall_ms

            worker_failure = getattr(write_boundary, "worker_failure", None)
            if (
                worker_failure
                and DESCENDANT_SWEEP_FAILED_MARKER not in (err or "")
                and not worker_lease_unproven
            ):
                # #2884: the worker never started (sudo or wrapper refused), or
                # its edits could not be copied back.  Not an account fault:
                # never rotate or retry.  A failed copy-back may have left the
                # target partly written, so it needs reconciliation.
                # Only a partly applied copy-back (AGY_WORKER_COPY_BACK_FAILED)
                # touched the target; a refusal (..._REFUSED) applied nothing.
                copy_back_failed = worker_failure.startswith("AGY_WORKER_COPY_BACK_FAILED")
                last_kind = worker_failure
                _operation_hook(
                    operation_hook,
                    phase="CLASSIFYING_FAILURE",
                    attempts=attempts,
                    rotations=rotations,
                    failure_kind=last_kind,
                    timed_out=bool(timed_out),
                    account_alias_hash=claim.account_alias_hash,
                    lease_id_hash=claim.lease_id_hash,
                    provider_effect=None if copy_back_failed else False,
                    reconciliation_required=copy_back_failed,
                )
                if out:
                    sys.stdout.write(out)
                if err:
                    sys.stderr.write(_neutralize_relayed_stderr(err))
                emit_run_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    "provider_effect": None if copy_back_failed else False,
                    "reconciliation_required": copy_back_failed,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return code if isinstance(code, int) and code != 0 else 1

            if write_boundary is not None and (
                DESCENDANT_SWEEP_FAILED_MARKER in (err or "") or worker_lease_unproven
            ):
                # Descendants of this attempt may still be running: never
                # classify, rotate or retry; end the operation for reconciliation.
                last_kind = AGY_DESCENDANT_SWEEP_FAILED
                _operation_hook(
                    operation_hook,
                    phase="CLASSIFYING_FAILURE",
                    attempts=attempts,
                    rotations=rotations,
                    failure_kind=last_kind,
                    timed_out=bool(timed_out),
                    account_alias_hash=claim.account_alias_hash,
                    lease_id_hash=claim.lease_id_hash,
                    provider_effect=None,
                    reconciliation_required=True,
                )
                if out:
                    sys.stdout.write(out)
                if err:
                    sys.stderr.write(_neutralize_relayed_stderr(err))
                emit_run_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    "provider_effect": None,
                    "reconciliation_required": True,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return code if isinstance(code, int) and code != 0 else 1

            provider_log_text = ""
            attempt_log_text = ""
            if provider_log_path:
                try:
                    provider_log_bytes = Path(provider_log_path).expanduser().read_bytes()
                except OSError:
                    provider_log_bytes = b""
                provider_log_text = provider_log_bytes.decode("utf-8", errors="replace")
                if provider_log_attempt_offset is not None:
                    # A log shorter than the pre-attempt offset was truncated or
                    # replaced during this attempt, so all of it is current.
                    if len(provider_log_bytes) >= provider_log_attempt_offset:
                        provider_log_bytes = provider_log_bytes[provider_log_attempt_offset:]
                    attempt_log_text = provider_log_bytes.decode("utf-8", errors="replace")
            # Issue #1362: agy may exit 0 after a terminal executor quota failure.
            provider_terminal_quota = (
                code == 0 and not timed_out and _has_terminal_quota_log_signal(attempt_log_text)
            )
            provider_log_lower = provider_log_text.lower()
            provider_headless_denial = (
                "print mode: soft-denying tool confirmation" in provider_log_lower
                or "soft-denying tool confirmation" in provider_log_lower
                or "headless mode cannot prompt for" in provider_log_lower
                or "auto-denied" in provider_log_lower
            )
            # #2202: Seatbelt's expected run-HOME denials are not permission
            # evidence; any other permission signal still wins over quota.
            # A boundary without a run HOME filters nothing (fail-closed).
            run_home = getattr(write_boundary, "run_home", None)
            if run_home is not None:
                boundary_run_homes.append(run_home)
            provider_permission_denial = mode == "accept-edits" and _has_permission_failure_signal(
                _permission_scan_text(provider_log_text, boundary_run_homes)
            )
            scanned_out = _permission_scan_text(out, boundary_run_homes)
            scanned_err = _permission_scan_text(err, boundary_run_homes)
            semantic_output = out + "\n" + err
            semantic_output_lower = semantic_output.lower()
            semantic_permission_refusal = mode == "accept-edits" and _has_permission_failure_signal(
                scanned_out + "\n" + scanned_err
            )
            semantic_headless_denial = mode == "accept-edits" and (
                "headless mode cannot prompt for" in semantic_output_lower
                or "soft-denying tool confirmation" in semantic_output_lower
                or "auto-denied" in semantic_output_lower
            )
            permission_blocked = (
                provider_headless_denial
                or provider_permission_denial
                or semantic_headless_denial
                or semantic_permission_refusal
            )
            attempt_changed_paths = None
            if attempt_baseline is not None:
                try:
                    attempt_changed_paths = direct_operation_journal.observed_changed_paths_since(
                        cwd, attempt_baseline
                    )
                except Exception as exc:
                    _operation_hook(
                        operation_hook,
                        effect_observation_error=(
                            f"ATTEMPT_EFFECT_OBSERVATION_FAILED:{type(exc).__name__}"
                        ),
                    )

            scope_state, scope_violations = direct_operation_journal.validate_write_scope(
                repo_root=cwd,
                write_paths=write_paths,
                observed_changed_paths=attempt_changed_paths,
            )
            scope_blocked = bool(write_paths and scope_state == "VIOLATION_OUT_OF_SCOPE")
            no_tool_violation = bool(
                permission_profile_kind == "NO_TOOL_PACKET" and attempt_tool_event_count > 0
            )
            no_tool_refused_calls = 0
            # Without a source observation (``None``: cwd outside git, or the
            # baseline/readback failed) the transcript is the proof, since agy
            # writes only through tool calls.  Any observed change keeps the
            # quarantine.
            if (
                no_tool_violation
                and code == 0
                and not timed_out
                and not attempt_changed_paths
                and out.strip()
            ):
                refused_calls = _no_tool_refused_tool_call_count(
                    _agy_transcript_path(env, attempt_provider_session_id)
                )
                if refused_calls is not None and refused_calls == attempt_tool_event_count:
                    no_tool_violation = False
                    no_tool_refused_calls = refused_calls

            empty_output = (
                permission_profile_kind in _READ_ONLY_PROFILE_KINDS
                and code == 0
                and not timed_out
                and len(out.strip().encode("utf-8")) < int(limits["empty_output_min_bytes"])
            )
            if (
                code == 0
                and not timed_out
                and not empty_output
                and not permission_blocked
                and not scope_blocked
                and not no_tool_violation
                and not provider_terminal_quota
            ):
                sys.stdout.write(out)
                if err:
                    sys.stderr.write(_neutralize_relayed_stderr(err))
                completed_meta: dict[str, Any] = {
                    "status": "completed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "pool_queue_wait_ms": pool_queue["wait_ms"],
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                }
                if no_tool_refused_calls:
                    completed_meta["no_tool_refused_tool_calls"] = no_tool_refused_calls
                emit_run_meta(completed_meta)
                return 0

            kind = (
                AccountFailureKind.PERMISSION_OR_SCOPE_ERROR
                if (permission_blocked or scope_blocked or no_tool_violation)
                else AccountFailureKind.QUOTA_EXHAUSTED
                if provider_terminal_quota
                else classify_failure(code, scanned_out, scanned_err, timed_out)
            )
            last_kind = kind.value
            provider_effect_observed: bool | None = False
            reconciliation_required = False

            denial_fields: dict[str, Any] = {}
            if no_tool_violation:
                # Quarantine: a no-tool packet must not report success after tool use.
                last_kind = NO_TOOL_PROFILE_VIOLATION
                provider_effect_observed = True if attempt_changed_paths else None
                reconciliation_required = True
            elif permission_blocked and (provider_headless_denial or semantic_headless_denial):
                last_kind = HEADLESS_TOOL_PERMISSION_DENIED
                denial = agy_headless_denial(out, err, stdout_is_envelope=False)
                if denial is None:
                    denial = agy_headless_denial("", provider_log_text, stdout_is_envelope=False)
                transcript_tool, transcript_path = attempt_last_tool_target
                denied_tool = denial.tool if denial is not None else "unknown"
                if denied_tool == "unknown" and transcript_tool:
                    denied_tool = transcript_tool
                denial_fields = {
                    "denied_tool": denied_tool,
                    "denied_path": (denial.path if denial is not None else None) or transcript_path,
                }
                if attempt_changed_paths:
                    provider_effect_observed = True
                    reconciliation_required = True
                elif attempt_changed_paths == []:
                    provider_effect_observed = False
                else:
                    provider_effect_observed = None
                    reconciliation_required = True
            elif scope_blocked:
                last_kind = "SCOPE_VIOLATION_UNAUTHORIZED_MUTATION"
                provider_effect_observed = True
                reconciliation_required = True
            elif permission_blocked:
                if attempt_changed_paths:
                    provider_effect_observed = True
                    reconciliation_required = True
                elif attempt_changed_paths == []:
                    provider_effect_observed = False
                else:
                    provider_effect_observed = None
                    reconciliation_required = True
            elif empty_output and not provider_terminal_quota:
                last_kind = AGY_EMPTY_OUTPUT
                if attempt_changed_paths:
                    provider_effect_observed = True
                    reconciliation_required = True
            elif kind == AccountFailureKind.MODEL_OR_TASK_ERROR:
                last_kind = "DISPATCH_MODEL_CONTRACT_REJECTED"
                if attempt_changed_paths:
                    provider_effect_observed = True
                    reconciliation_required = True
            elif kind == AccountFailureKind.QUOTA_EXHAUSTED:
                last_kind, provider_effect_observed, reconciliation_required = (
                    _quota_failure_effect(
                        attempt_changed_paths,
                        mode=mode,
                        permission_profile_kind=permission_profile_kind,
                        allow_rules=list(effective_permissions.get("allow") or []),
                    )
                )
            elif attempt_changed_paths:
                provider_effect_observed = True
                reconciliation_required = True
            _operation_hook(
                operation_hook,
                phase="CLASSIFYING_FAILURE",
                attempts=attempts,
                rotations=rotations,
                failure_kind=last_kind,
                timed_out=bool(timed_out),
                account_alias_hash=claim.account_alias_hash,
                lease_id_hash=claim.lease_id_hash,
                provider_effect=provider_effect_observed,
                reconciliation_required=reconciliation_required,
                **denial_fields,
            )

            if reconciliation_required:
                if out:
                    sys.stdout.write(out)
                if err:
                    sys.stderr.write(_neutralize_relayed_stderr(err))
                emit_run_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    **denial_fields,
                    "provider_effect": provider_effect_observed,
                    "reconciliation_required": True,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return code if isinstance(code, int) and code != 0 else 1

            if last_kind == AGY_EMPTY_OUTPUT:
                # Dispatch-local: the account is healthy, so it is only excluded
                # for this dispatch. It is released and another account is leased
                # with acquire_claim; rotate_claim / retire_failed_claim are never
                # called, so no cooldown or family retirement is persisted.
                exclude_hashes.add(claim.account_alias_hash)
                claim.release()
                if empty_output_failovers >= 1 or rotations >= max_failovers:
                    if out:
                        sys.stdout.write(out)
                    if err:
                        sys.stderr.write(_neutralize_relayed_stderr(err))
                    emit_run_meta({
                        "status": "failed",
                        "attempts": attempts,
                        "rotations": rotations,
                        "failure_kind": AGY_EMPTY_OUTPUT,
                        "provider_effect": False,
                        "wall_ms": total_wall_ms,
                        "permission_profile_kind": permission_profile_kind,
                        "permission_profile_sha256": permission_profile_sha256,
                    })
                    return 1
                if _budget_exhausted():
                    return _emit_total_deadline_exhausted()
                try:
                    claim = _queued_claim(first_pass=lambda: coordinator.acquire_claim(
                        consumer_id=consumer_id,
                        exclude_hashes=exclude_hashes,
                        wait_timeout=0.0,
                        model_family=scoped_model_family,
                    ))
                except _PoolClaimFailure as exc:
                    _operation_hook(
                        operation_hook,
                        pool_queue=dict(pool_queue),
                        **_pool_busy_failure_fields(exc),
                    )
                    emit_run_meta({
                        "status": "pool_busy" if exc.busy else "pool_exhausted",
                        "attempts": attempts,
                        "rotations": rotations,
                        "failure_kind": (
                            "AGY_ACCOUNT_POOL_BUSY" if exc.busy else AGY_EMPTY_OUTPUT
                        ),
                        "wall_ms": total_wall_ms,
                        **_pool_claim_meta(exc),
                    })
                    return 75
                except Exception:
                    emit_run_meta({
                        "status": "failed",
                        "attempts": attempts,
                        "rotations": rotations,
                        "failure_kind": AGY_EMPTY_OUTPUT,
                        "wall_ms": total_wall_ms,
                    })
                    return 75
                empty_output_failovers += 1
                # One account switch: it counts toward the failover cap (bounded by
                # the pool size) but not toward --max-calls (work_failures).
                rotations += 1
                _operation_hook(
                    operation_hook,
                    phase="ACCOUNT_ROTATED",
                    attempts=attempts,
                    rotations=rotations,
                    empty_output_failovers=empty_output_failovers,
                    failure_kind=last_kind,
                    account_alias_hash=claim.account_alias_hash,
                    lease_id_hash=claim.lease_id_hash,
                    pool_queue=dict(pool_queue),
                )
                continue

            if not is_agy_rotation_eligible(kind):
                if out:
                    sys.stdout.write(out)
                if err:
                    sys.stderr.write(_neutralize_relayed_stderr(err))
                emit_run_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    **denial_fields,
                    "provider_effect": False,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return code if isinstance(code, int) and code != 0 else 1

            family_unavailable_until = None
            if kind == AccountFailureKind.QUOTA_EXHAUSTED and scoped_model_family is not None:
                family_unavailable_until = _family_failure_unavailable_until(
                    snapshot=quota_snapshot,
                    account_name=claim.internal_id,
                    model_family=scoped_model_family,
                    failure_kind=kind,
                )

            if not is_account_failover_failure(kind):
                work_failures += 1

            def _retire_current() -> None:
                coordinator.retire_failed_claim(
                    claim,
                    kind,
                    model_family=scoped_model_family,
                    unavailable_until=family_unavailable_until,
                )

            if not is_account_failover_failure(kind) and work_failures >= work_budget:
                # Real work failure budget is independent from account-selection
                # failover. Retire the current failed scope without acquiring
                # another account when the model-work budget is exhausted.
                try:
                    _retire_current()
                except Exception:
                    pass
                if out:
                    sys.stdout.write(out)
                if err:
                    sys.stderr.write(_neutralize_relayed_stderr(err))
                emit_run_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "work_failures": work_failures,
                    "work_budget": work_budget,
                    "failure_kind": last_kind,
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return code if isinstance(code, int) and code != 0 else 1

            # #2433 (N2, documented difference): this route retires RATE_LIMITED
            # through the pool (account-global cooldown, the pool's contract in
            # retire_failed_claim) and counts it toward the outage cap, so
            # concurrent dispatches avoid the account.  The Gateway worker route
            # (worker_registry._invoke_with_claims) only skips a rate-limited
            # account for its own run and never retires or counts it.
            if is_account_global_retirement(kind, scoped_model_family):
                account_retirements += 1
                if account_retirements >= retirement_cap:
                    # #2415: this many accounts failing account-wide in one run
                    # is a host-wide cause (outage, upstream 503), not bad
                    # accounts.  Retire this one (still within the cap) and stop
                    # instead of marking the rest of the pool bad.
                    try:
                        _retire_current()
                    except Exception:
                        pass
                    if err:
                        sys.stderr.write(_neutralize_relayed_stderr(err))
                    emit_run_meta({
                        "status": "failed",
                        "attempts": attempts,
                        "rotations": rotations,
                        "work_failures": work_failures,
                        "work_budget": work_budget,
                        "failure_kind": AGY_UPSTREAM_UNAVAILABLE,
                        "last_account_failure_kind": last_kind,
                        "account_retirements": account_retirements,
                        "account_retirement_cap": retirement_cap,
                        "account_alias_hash": claim.account_alias_hash,
                        "lease_id_hash": claim.lease_id_hash,
                        "parallel_slot": True,
                        "wall_ms": total_wall_ms,
                        "permission_profile_sha256": permission_profile_sha256,
                        "permission_profile_kind": permission_profile_kind,
                    })
                    return 75

            if rotations >= max_failovers:
                try:
                    _retire_current()
                except Exception:
                    pass
                emit_run_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "work_failures": work_failures,
                    "work_budget": work_budget,
                    "failure_kind": "ACCOUNT_FAILOVER_LIMIT",
                    "account_alias_hash": claim.account_alias_hash,
                    "lease_id_hash": claim.lease_id_hash,
                    "parallel_slot": True,
                    "wall_ms": total_wall_ms,
                    "permission_profile_sha256": permission_profile_sha256,
                    "permission_profile_kind": permission_profile_kind,
                })
                return 75

            if total_deadline - _monotonic() < TOTAL_DEADLINE_MIN_ATTEMPT_SECONDS:
                # No budget is left for another attempt: retire the failed scope
                # (quota/auth still mark the account) but lease nothing new.
                try:
                    _retire_current()
                except Exception:
                    pass
                return _emit_total_deadline_exhausted()

            # Rotation eligible: rotate claim, queueing for the next account.
            failed_claim = claim

            def _rotation_pass() -> Any:
                return coordinator.rotate_claim(
                    current_claim=failed_claim,
                    failure_kind=kind,
                    exclude_hashes=exclude_hashes,
                    wait_timeout=0.0,
                    model_family=scoped_model_family,
                    unavailable_until=family_unavailable_until,
                )

            try:
                claim = _queued_claim(first_pass=_rotation_pass)
                rotations += 1
                _operation_hook(
                    operation_hook,
                    phase="ACCOUNT_ROTATED",
                    attempts=attempts,
                    rotations=rotations,
                    failure_kind=last_kind,
                    account_alias_hash=claim.account_alias_hash,
                    lease_id_hash=claim.lease_id_hash,
                    pool_queue=dict(pool_queue),
                )
            except _PoolClaimFailure as rotate_exc:
                _operation_hook(
                    operation_hook,
                    pool_queue=dict(pool_queue),
                    **_pool_busy_failure_fields(rotate_exc),
                )
                emit_run_meta({
                    "status": "pool_busy" if rotate_exc.busy else "pool_exhausted",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": "AGY_ACCOUNT_POOL_BUSY" if rotate_exc.busy else last_kind,
                    "wall_ms": total_wall_ms,
                    **_pool_claim_meta(rotate_exc),
                })
                return 75
            except Exception:
                emit_run_meta({
                    "status": "failed",
                    "attempts": attempts,
                    "rotations": rotations,
                    "failure_kind": last_kind,
                    "wall_ms": total_wall_ms,
                })
                return 75
    finally:
        # Numeric PID/PGID observations can retain the lease, but they do not
        # authorize signalling after the owning Popen frame has returned.
        provider_still_running = (
            active_provider_pid is not None
            and _agy_operation_journal._process_alive(active_provider_pid)
        ) or (
            active_provider_pgid is not None
            and _agy_operation_journal._process_group_alive(active_provider_pgid)
        )
        if claim is not None and not provider_still_running and not worker_lease_unproven:
            try:
                claim.release()
            except Exception:
                pass

    emit_run_meta({"status": "failed", "failure_kind": last_kind or "UNKNOWN"})
    return 1


def _write_private_prompt(path: Path, prompt: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(prompt)
        fh.flush()
        os.fsync(fh.fileno())


def _normalize_evidence_refs(values: list[str] | None) -> list[str]:
    refs = [str(value).strip() for value in (values or [])]
    if len(refs) > 16:
        raise ValueError("EVIDENCE_REF_LIMIT_EXCEEDED")
    for ref in refs:
        if not ref or len(ref) > 512 or any(ord(char) < 0x20 for char in ref):
            raise ValueError("EVIDENCE_REF_INVALID")
    return refs


def _spawn_background_operation(
    *,
    prompt: str,
    cwd: str,
    mode: str,
    model: str | None,
    effort: str | None,
    timeout: int | None,
    max_calls: int,
    pool_wait_timeout: float | None,
    allow: list[str],
    deny: list[str],
    temp_command_permissions: bool,
    operation_root: Path,
    write_paths: list[str] | None = None,
    provider_stall_seconds: float | None = None,
    stream_no_progress_seconds: float | None = None,
    pre_effect_max_seconds: float | None = None,
    pre_effect_max_tool_events: int | None = None,
    exclude_accounts: list[str] | None = None,
    evidence_refs: list[str] | None = None,
    run_as_user: str | None = None,
    empty_output_min_bytes: int | None = None,
) -> dict[str, Any]:
    resolved_exclude_hashes = sorted(_resolve_excluded_account_hashes(exclude_accounts))
    resolved_evidence_refs = _normalize_evidence_refs(evidence_refs)
    journal = AgyOperationJournal(operation_root)
    operation_id = new_operation_id()
    attempt_id = new_attempt_id()
    coding_progress_required = bool(mode == "accept-edits" and write_paths)
    try:
        _, profile_kind, _ = build_effective_permission_profile(
            cwd=cwd,
            mode=mode,
            write_paths=write_paths,
            allow_rules=allow,
            deny_rules=deny,
            temp_command_permissions=temp_command_permissions,
        )
    except ValueError:
        # Preserve background launch semantics: the child owns contract rejection.
        profile_kind = None
    if profile_kind is None:
        limits = _unresolved_dispatch_limits(
            timeout, provider_stall_seconds, empty_output_min_bytes
        )
    else:
        limits = _resolve_dispatch_limits(
            profile_kind, timeout, provider_stall_seconds, empty_output_min_bytes
        )
    resolved_provider_stall_seconds = _resolve_dispatch_limits(
        profile_kind or "INVALID", timeout, provider_stall_seconds
    )["provider_stall_seconds"]
    resolved_stream_no_progress_seconds = (
        _stream_no_progress_seconds()
        if stream_no_progress_seconds is None
        else max(0.1, float(stream_no_progress_seconds))
    )
    resolved_pre_effect_max_seconds = (
        _pre_effect_max_seconds()
        if pre_effect_max_seconds is None
        else max(0.1, float(pre_effect_max_seconds))
    )
    resolved_pre_effect_max_tool_events = (
        _pre_effect_max_tool_events()
        if pre_effect_max_tool_events is None
        else max(1, int(pre_effect_max_tool_events))
    )
    journal.create(
        operation_id=operation_id,
        attempt_id=attempt_id,
        cwd=cwd,
        provider="agy",
        model=model,
        effort=effort,
        prompt_sha256=hashlib.sha256(prompt.encode("utf-8")).hexdigest(),
        runtime_revision=_runtime_revision(),
        initial_fields={
            **limits,
            "empty_output_failovers": 0,
            "excluded_account_hashes": resolved_exclude_hashes,
            "evidence_refs": resolved_evidence_refs,
            "liveness_policy": {
                "coding_progress_required": coding_progress_required,
                "provider_stall_seconds": resolved_provider_stall_seconds,
                "stream_no_progress_seconds": resolved_stream_no_progress_seconds,
                "pre_effect_max_seconds": resolved_pre_effect_max_seconds,
                "pre_effect_max_tool_events": resolved_pre_effect_max_tool_events,
            }
        },
    )
    prompt_path = journal.prompt_path(operation_id)
    _write_private_prompt(prompt_path, prompt)
    if write_paths:
        journal.update(operation_id, write_paths=list(write_paths))

    argv = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--operation-run",
        operation_id,
        "--operation-root",
        str(operation_root),
        "--prompt-file",
        str(prompt_path),
        "--cwd",
        cwd,
        "--mode",
        mode,
        *(["--timeout", str(timeout)] if timeout is not None else []),
        *(
            ["--empty-output-min-bytes", str(empty_output_min_bytes)]
            if empty_output_min_bytes is not None
            else []
        ),
        "--max-calls",
        str(max_calls),
        *(["--pool-wait-timeout", str(pool_wait_timeout)] if pool_wait_timeout is not None else []),
        *(
            ["--provider-stall-seconds", str(provider_stall_seconds)]
            if provider_stall_seconds is not None
            else []
        ),
        "--stream-no-progress-seconds",
        str(resolved_stream_no_progress_seconds),
        "--pre-effect-max-seconds",
        str(resolved_pre_effect_max_seconds),
        "--pre-effect-max-tool-events",
        str(resolved_pre_effect_max_tool_events),
    ]
    if model:
        argv += ["--model", model]
    if effort:
        argv += ["--effort", effort]
    if temp_command_permissions:
        argv.append("--temp-command-permissions")
    for rule in allow:
        argv += ["--allow", rule]
    for rule in deny:
        argv += ["--deny", rule]
    for write_path in write_paths or []:
        argv += ["--write-path", write_path]
    for account_hash in resolved_exclude_hashes:
        argv += ["--exclude-account", account_hash]
    if run_as_user is not None:
        argv += ["--run-as-user", run_as_user]

    stdout_path = journal.stdout_path(operation_id)
    stderr_path = journal.stderr_path(operation_id)
    stdout_path.parent.mkdir(parents=True, exist_ok=True)
    with (
        stdout_path.open("ab", buffering=0) as out_fh,
        stderr_path.open("ab", buffering=0) as err_fh,
    ):
        proc = subprocess.Popen(
            argv,
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=out_fh,
            stderr=err_fh,
            start_new_session=True,
            close_fds=True,
        )
    return journal.bind_pid(operation_id, proc.pid)


def _supervisor_terminal_guard(func):
    """Cover background-supervisor startup and provider execution with durable terminalization."""

    @functools.wraps(func)
    def guarded(*args, **kwargs):
        operation_id = str(kwargs["operation_id"])
        operation_root = Path(kwargs["operation_root"])
        cwd = str(kwargs["cwd"])
        model = kwargs.get("model")
        journal = AgyOperationJournal(operation_root)
        attestation_log_path = journal.operation_dir(operation_id) / "agy.log"
        prior_sigterm = signal.getsignal(signal.SIGTERM)
        prior_sigint = signal.getsignal(signal.SIGINT)

        def _signal_handler(signum: int, _frame: Any) -> None:
            raise _SupervisorSignalError(signum)

        def _terminalize_if_needed(
            *,
            unknown_failure_kind: str,
            known_failure_kind: str,
            unknown_result: str,
            known_result: str,
            unresolved_running_result: str,
            unresolved_unverified_result: str,
            unresolved_sweep_unclean_result: str,
        ) -> None:
            record = journal.read(operation_id)
            phase = str(record.get("phase") or "QUEUED")
            if phase == "TERMINAL":
                return
            provider_effect_possible = phase not in {
                "QUEUED",
                "STARTING",
                "ACCOUNT_LEASED",
            }
            if phase == "MODEL_REJECTED":
                # Pre-provider only when no provider attempt ever ran: after an
                # account rotation an earlier attempt may have had an effect.
                provider_effect_possible = bool(
                    int(record.get("attempts") or 0) > 0
                    or record.get("provider_pid")
                    or record.get("provider_started_at")
                    or record.get("first_effect_at")
                    or int(record.get("tool_event_count") or 0) > 0
                )
            attestation = _parse_agy_attestation(
                attestation_log_path,
                requested_model=model,
            )
            had_before, alive_after, unverified = _agy_operation_journal._stop_operation_processes(
                operation_id,
                journal.operation_dir(operation_id),
                pid=record.get("pid"),
                provider_pid=record.get("provider_pid"),
                provider_pgid=record.get("provider_pgid"),
                supervisor_pid=os.getpid(),
                grace_seconds=2.0,
            )
            had_before = had_before or bool(record.get("provider_pid")) or provider_effect_possible
            # #2470: an attempt whose descendant sweep is unclean, unfinished
            # or still pending (None: its verdict was never durably written)
            # may have left workers running.
            sweep_unclean = _descendant_sweep_unproven(record)
            provider_state = (
                "RUNNING"
                if alive_after
                else (
                    "EXITED"
                    if record.get("provider_pid")
                    else record.get("provider_process_state", "IDLE")
                )
            )
            telemetry = {
                "provider_pid": record.get("provider_pid"),
                "provider_pgid": record.get("provider_pgid"),
                "provider_process_state": provider_state,
                "provider_started_at": record.get("provider_started_at"),
                "provider_stream_last_activity_at": record.get("provider_stream_last_activity_at"),
                "first_stream_activity_at": record.get("first_stream_activity_at"),
                "first_tool_activity_at": record.get("first_tool_activity_at"),
                "last_progress_activity_at": record.get("last_progress_activity_at"),
                "first_effect_at": record.get("first_effect_at"),
                "time_to_first_effect_ms": record.get("time_to_first_effect_ms"),
                "tool_event_count": int(record.get("tool_event_count") or 0),
            }

            if alive_after:
                journal.update(
                    operation_id,
                    status="RUNNING",
                    phase="RECONCILE_REQUIRED",
                    failure_kind=unknown_failure_kind,
                    reconciliation={
                        "at": _agy_operation_journal.utc_now(),
                        "result": (
                            unresolved_unverified_result
                            if unverified
                            else unresolved_running_result
                        ),
                        "provider_alive_before": had_before,
                        "provider_alive_after": True,
                        "retry_permitted": False,
                        **({"descendant_sweep_clean": False} if sweep_unclean else {}),
                    },
                    **telemetry,
                    **attestation,
                )
            elif sweep_unclean:
                # The provider is gone but its descendants are not proven
                # gone: never terminal, never a lease cleanup.
                journal.update(
                    operation_id,
                    status="RUNNING",
                    phase="RECONCILE_REQUIRED",
                    failure_kind=unknown_failure_kind,
                    reconciliation={
                        "at": _agy_operation_journal.utc_now(),
                        "result": unresolved_sweep_unclean_result,
                        "provider_alive_before": had_before,
                        "provider_alive_after": None,
                        "descendant_sweep_clean": False,
                        "retry_permitted": False,
                    },
                    **telemetry,
                    **attestation,
                )
            else:
                journal.mark_terminal(
                    operation_id,
                    status="OUTCOME_UNKNOWN" if provider_effect_possible else "FAILED",
                    exit_code=record.get("exit_code"),
                    failure_kind=(
                        unknown_failure_kind if provider_effect_possible else known_failure_kind
                    ),
                    cwd=cwd,
                    reconciliation={
                        "at": _agy_operation_journal.utc_now(),
                        "result": unknown_result if provider_effect_possible else known_result,
                        "provider_alive_before": had_before,
                        "provider_alive_after": False,
                        "retry_permitted": False,
                    },
                    **telemetry,
                    **attestation,
                )

        try:
            signal.signal(signal.SIGTERM, _signal_handler)
            signal.signal(signal.SIGINT, _signal_handler)
            return func(*args, **kwargs)
        except _SupervisorSignalError as sig_exc:
            sig_name = signal.Signals(sig_exc.signum).name
            _terminalize_if_needed(
                unknown_failure_kind=f"SUPERVISOR_SIGNAL:{sig_name}",
                known_failure_kind=f"SUPERVISOR_SIGNAL_PRE_PROVIDER:{sig_name}",
                unknown_result="SUPERVISOR_SIGNAL_WITH_UNKNOWN_PROVIDER_EFFECT",
                known_result="SUPERVISOR_SIGNAL_BEFORE_PROVIDER",
                unresolved_running_result="SUPERVISOR_SIGNAL_ORPHAN_PROVIDER_STILL_RUNNING",
                unresolved_unverified_result="SUPERVISOR_SIGNAL_ORPHAN_PROVIDER_UNVERIFIED",
                unresolved_sweep_unclean_result="SUPERVISOR_SIGNAL_DESCENDANT_SWEEP_UNCLEAN",
            )
            raise
        except BaseException as exc:
            _terminalize_if_needed(
                unknown_failure_kind=f"WRAPPER_EXCEPTION:{type(exc).__name__}",
                known_failure_kind=f"WRAPPER_EXCEPTION_PRE_PROVIDER:{type(exc).__name__}",
                unknown_result="WRAPPER_EXCEPTION_WITH_UNKNOWN_PROVIDER_EFFECT",
                known_result="WRAPPER_EXCEPTION_BEFORE_PROVIDER",
                unresolved_running_result="WRAPPER_EXCEPTION_ORPHAN_PROVIDER_STILL_RUNNING",
                unresolved_unverified_result="WRAPPER_EXCEPTION_ORPHAN_PROVIDER_UNVERIFIED",
                unresolved_sweep_unclean_result="WRAPPER_EXCEPTION_DESCENDANT_SWEEP_UNCLEAN",
            )
            raise
        finally:
            signal.signal(signal.SIGTERM, prior_sigterm)
            signal.signal(signal.SIGINT, prior_sigint)

    return guarded


@_supervisor_terminal_guard
def _run_background_operation(
    *,
    operation_id: str,
    prompt_file: str,
    cwd: str,
    mode: str,
    model: str | None,
    effort: str | None,
    timeout: int | None,
    max_calls: int,
    pool_wait_timeout: float | None,
    allow: list[str],
    deny: list[str],
    temp_command_permissions: bool,
    operation_root: Path,
    write_paths: list[str] | None = None,
    heartbeat_interval: float = 15.0,
    provider_stall_seconds: float | None = None,
    stream_no_progress_seconds: float | None = None,
    pre_effect_max_seconds: float | None = None,
    pre_effect_max_tool_events: int | None = None,
    exclude_accounts: list[str] | None = None,
    run_as_user: str | None = None,
    empty_output_min_bytes: int | None = None,
) -> int:
    journal = AgyOperationJournal(operation_root)
    prompt_path = Path(prompt_file)
    try:
        prompt = prompt_path.read_text(encoding="utf-8")
    finally:
        try:
            prompt_path.unlink()
        except FileNotFoundError:
            pass

    current_runtime_revision = _runtime_revision()
    journal.update(operation_id, runtime_revision=current_runtime_revision)
    journal.mark_started(operation_id, pid=os.getpid())
    stop = threading.Event()
    state: dict[str, Any] = {
        "phase": "STARTING",
        "attempts": 0,
        "rotations": 0,
        "account_alias_hash": None,
        "lease_id_hash": None,
        "failure_kind": None,
        "failure_history": [],
        "timed_out": False,
        "provider_pid": None,
        "provider_pgid": None,
        "provider_process_state": "IDLE",
        "provider_started_at": None,
        "provider_stream_last_activity_at": None,
        "first_stream_activity_at": None,
        "first_tool_activity_at": None,
        "last_progress_activity_at": None,
        "first_effect_at": None,
        "time_to_first_effect_ms": None,
        "tool_event_count": 0,
        "provider_session_id": None,
        "quota_preflight_progress": None,
        "quota_preflight_decision": None,
        "permission_profile_sha256": None,
        "permission_profile_kind": None,
        "effective_permissions": None,
    }
    # #2887: resolve the limits here too, so a heartbeat written before dispatch_run's
    # first event carries the same values the parent recorded instead of nulls.
    try:
        _, _seed_profile_kind, _ = build_effective_permission_profile(
            cwd=cwd,
            mode=mode,
            write_paths=write_paths,
            allow_rules=allow,
            deny_rules=deny,
            temp_command_permissions=temp_command_permissions,
        )
    except ValueError:
        state.update(
            _unresolved_dispatch_limits(timeout, provider_stall_seconds, empty_output_min_bytes)
        )
    else:
        state.update(
            _resolve_dispatch_limits(
                _seed_profile_kind, timeout, provider_stall_seconds, empty_output_min_bytes
            )
        )
    state["empty_output_failovers"] = 0
    state_lock = threading.Lock()
    sweep_write_lock = threading.Lock()

    def _heartbeat_snapshot(snapshot: dict[str, Any]) -> None:
        journal.heartbeat(
            operation_id,
            phase=str(snapshot.get("phase") or "RUNNING"),
            attempts=int(snapshot.get("attempts") or 0),
            rotations=int(snapshot.get("rotations") or 0),
            empty_output_failovers=int(snapshot.get("empty_output_failovers") or 0),
            timeout_seconds=snapshot.get("timeout_seconds"),
            timeout_source=snapshot.get("timeout_source"),
            provider_stall_seconds=snapshot.get("provider_stall_seconds"),
            provider_stall_source=snapshot.get("provider_stall_source"),
            account_alias_hash=snapshot.get("account_alias_hash"),
            lease_id_hash=snapshot.get("lease_id_hash"),
            failure_kind=snapshot.get("failure_kind"),
            failure_history=list(snapshot.get("failure_history") or []),
            provider_pid=snapshot.get("provider_pid"),
            provider_pgid=snapshot.get("provider_pgid"),
            provider_process_state=snapshot.get("provider_process_state") or "IDLE",
            provider_started_at=snapshot.get("provider_started_at"),
            provider_stream_last_activity_at=snapshot.get("provider_stream_last_activity_at"),
            first_stream_activity_at=snapshot.get("first_stream_activity_at"),
            first_tool_activity_at=snapshot.get("first_tool_activity_at"),
            last_progress_activity_at=snapshot.get("last_progress_activity_at"),
            first_effect_at=snapshot.get("first_effect_at"),
            time_to_first_effect_ms=snapshot.get("time_to_first_effect_ms"),
            tool_event_count=int(snapshot.get("tool_event_count") or 0),
            provider_session_id=snapshot.get("provider_session_id"),
            quota_preflight_progress=snapshot.get("quota_preflight_progress"),
            quota_preflight_decision=snapshot.get("quota_preflight_decision"),
            permission_profile_sha256=snapshot.get("permission_profile_sha256"),
            permission_profile_kind=snapshot.get("permission_profile_kind"),
            effective_permissions=snapshot.get("effective_permissions"),
            requested_model=snapshot.get("requested_model"),
            resolved_model=snapshot.get("resolved_model"),
            model_catalog=snapshot.get("model_catalog"),
            pool_queue=snapshot.get("pool_queue"),
            # #2470: never the descendant-sweep keys. A periodic snapshot can be
            # older than the latest pending marker; only on_event writes them.
        )

    def on_event(event: dict[str, Any]) -> None:
        with state_lock:
            event = dict(event)
            history_entry = event.pop("failure_history_entry", None)
            state.update(event)
            failure_kind = event.get("failure_kind")
            if isinstance(history_entry, dict):
                # #2410: pool claim failures and known-quota rotations never
                # reach CLASSIFYING_FAILURE; record them so failure_history
                # shows every account the dispatch gave up on.
                history = list(state.get("failure_history") or [])
                history.append({"at": _agy_operation_journal.utc_now(), **history_entry})
                state["failure_history"] = history[-MAX_FAILURE_HISTORY_ENTRIES:]
            if (
                event.get("phase") == "CLASSIFYING_FAILURE"
                and isinstance(failure_kind, str)
                and failure_kind
            ):
                history = list(state.get("failure_history") or [])
                history.append({
                    "at": _agy_operation_journal.utc_now(),
                    "attempts": int(state.get("attempts") or 0),
                    "rotations": int(state.get("rotations") or 0),
                    "failure_kind": failure_kind,
                    **(
                        {
                            "denied_tool": event.get("denied_tool"),
                            "denied_path": event.get("denied_path"),
                        }
                        if failure_kind == HEADLESS_TOOL_PERMISSION_DENIED
                        else {}
                    ),
                    "account_alias_hash": state.get("account_alias_hash"),
                    "lease_id_hash": state.get("lease_id_hash"),
                })
                state["failure_history"] = history[-MAX_FAILURE_HISTORY_ENTRIES:]
            snapshot = dict(state)
            sweep_changes = {
                key: event[key]
                for key in (*_DESCENDANT_SWEEP_KEYS, *_WORKER_SWEEP_KEYS)
                if key in event
            }
        if sweep_changes:
            # #2470: the sweep marker/verdict is written on its own, in the
            # order the attempt emits it, before the general heartbeat; no
            # snapshot write carries these keys, so none can overwrite a newer
            # marker with an older verdict.
            with sweep_write_lock:
                if "worker_run_root" in sweep_changes:
                    # Bind the run root to this operation before the record
                    # names it; a failure here stops the launch (fail closed).
                    _agy_worker_account().write_operation_marker(
                        Path(sweep_changes["worker_run_root"]), operation_id
                    )
                journal.heartbeat(operation_id, **sweep_changes)
        _heartbeat_snapshot(snapshot)

    def heartbeat_loop() -> None:
        while not stop.wait(max(1.0, heartbeat_interval)):
            with state_lock:
                snapshot = dict(state)
            try:
                _heartbeat_snapshot(snapshot)
            except Exception:
                pass

    heartbeat_thread = threading.Thread(
        target=heartbeat_loop,
        name=f"agy-heartbeat-{operation_id}",
        daemon=True,
    )
    heartbeat_thread.start()

    exit_code: int | None = None
    attestation_log_path = journal.operation_dir(operation_id) / "agy.log"
    prior_attestation_log = os.environ.get("NEXUS_AGY_ATTESTATION_LOG")
    os.environ["NEXUS_AGY_ATTESTATION_LOG"] = str(attestation_log_path)
    try:
        exit_code = dispatch_run(
            prompt=prompt,
            cwd=cwd,
            mode=mode,
            model=model,
            effort=effort,
            timeout=timeout,
            empty_output_min_bytes=empty_output_min_bytes,
            max_calls=max_calls,
            pool_wait_timeout=pool_wait_timeout,
            allow=allow,
            deny=deny,
            write_paths=write_paths,
            temp_command_permissions=temp_command_permissions,
            operation_hook=on_event,
            provider_stall_seconds=provider_stall_seconds,
            stream_no_progress_seconds=stream_no_progress_seconds,
            pre_effect_max_seconds=pre_effect_max_seconds,
            pre_effect_max_tool_events=pre_effect_max_tool_events,
            exclude_accounts=exclude_accounts,
            **(
                {"run_as_user": run_as_user, "operation_id": operation_id}
                if run_as_user is not None
                else {}
            ),
        )
        with state_lock:
            snapshot = dict(state)
        failure_kind = snapshot.get("failure_kind")
        provider_pid = snapshot.get("provider_pid")
        provider_pgid = snapshot.get("provider_pgid")
        provider_alive = _agy_operation_journal._process_alive(provider_pid)
        provider_group_alive = _agy_operation_journal._process_group_alive(provider_pgid)

        if provider_alive or provider_group_alive:
            attestation = _parse_agy_attestation(
                attestation_log_path,
                requested_model=model,
            )
            unresolved_failure = failure_kind or "PROVIDER_PROCESS_STILL_RUNNING_AFTER_DISPATCH"
            journal.update(
                operation_id,
                status="RUNNING",
                phase="RECONCILE_REQUIRED",
                failure_kind=unresolved_failure,
                attempts=int(snapshot.get("attempts") or 0),
                rotations=int(snapshot.get("rotations") or 0),
                empty_output_failovers=int(snapshot.get("empty_output_failovers") or 0),
                timeout_seconds=snapshot.get("timeout_seconds"),
                timeout_source=snapshot.get("timeout_source"),
                provider_stall_seconds=snapshot.get("provider_stall_seconds"),
                provider_stall_source=snapshot.get("provider_stall_source"),
                account_alias_hash=snapshot.get("account_alias_hash"),
                lease_id_hash=snapshot.get("lease_id_hash"),
                provider_pid=provider_pid,
                provider_pgid=provider_pgid,
                provider_process_state="RUNNING",
                provider_started_at=snapshot.get("provider_started_at"),
                provider_stream_last_activity_at=snapshot.get("provider_stream_last_activity_at"),
                first_stream_activity_at=snapshot.get("first_stream_activity_at"),
                first_tool_activity_at=snapshot.get("first_tool_activity_at"),
                last_progress_activity_at=snapshot.get("last_progress_activity_at"),
                first_effect_at=snapshot.get("first_effect_at"),
                time_to_first_effect_ms=snapshot.get("time_to_first_effect_ms"),
                permission_profile_sha256=snapshot.get("permission_profile_sha256"),
                permission_profile_kind=snapshot.get("permission_profile_kind"),
                effective_permissions=snapshot.get("effective_permissions"),
                tool_event_count=int(snapshot.get("tool_event_count") or 0),
                reconciliation={
                    "at": _agy_operation_journal.utc_now(),
                    "result": "PROVIDER_PROCESS_STILL_RUNNING_AFTER_DISPATCH",
                    "provider_alive_before": True,
                    "provider_alive_after": True,
                    "retry_permitted": False,
                },
                **attestation,
            )
            return int(exit_code if exit_code not in (None, 0) else 1)

        if _descendant_sweep_unproven(snapshot, bind_attempt=False):
            # #2470: dispatch returned, but a writer of this run may survive
            # (e.g. an env-cleared double fork the sweep could only report).
            # Never terminal and never "provider gone", so no lease cleanup.
            attestation = _parse_agy_attestation(
                attestation_log_path,
                requested_model=model,
            )
            journal.update(
                operation_id,
                status="RUNNING",
                phase="RECONCILE_REQUIRED",
                failure_kind=failure_kind or AGY_DESCENDANT_SWEEP_FAILED,
                attempts=int(snapshot.get("attempts") or 0),
                rotations=int(snapshot.get("rotations") or 0),
                empty_output_failovers=int(snapshot.get("empty_output_failovers") or 0),
                timeout_seconds=snapshot.get("timeout_seconds"),
                timeout_source=snapshot.get("timeout_source"),
                provider_stall_seconds=snapshot.get("provider_stall_seconds"),
                provider_stall_source=snapshot.get("provider_stall_source"),
                account_alias_hash=snapshot.get("account_alias_hash"),
                lease_id_hash=snapshot.get("lease_id_hash"),
                provider_pid=provider_pid,
                provider_pgid=provider_pgid,
                provider_started_at=snapshot.get("provider_started_at"),
                first_effect_at=snapshot.get("first_effect_at"),
                tool_event_count=int(snapshot.get("tool_event_count") or 0),
                descendant_sweep_clean=snapshot.get("descendant_sweep_clean"),
                descendant_sweep_attempt=snapshot.get("descendant_sweep_attempt"),
                reconciliation={
                    "at": _agy_operation_journal.utc_now(),
                    "result": "DESCENDANT_SWEEP_UNCLEAN_AFTER_DISPATCH",
                    "provider_alive_before": bool(provider_pid or provider_pgid),
                    "provider_alive_after": None,
                    "descendant_sweep_clean": False,
                    "retry_permitted": False,
                },
                **attestation,
            )
            return int(exit_code if exit_code not in (None, 0) else 1)

        timed_out = bool(snapshot.get("timed_out")) or failure_kind == "TIMEOUT"
        effect_observed = snapshot.get("first_effect_at") is not None
        if timed_out:
            terminal_status = "OUTCOME_UNKNOWN"
            reconciliation = {
                "at": _agy_operation_journal.utc_now(),
                "result": "PROVIDER_TURN_MAY_STILL_BE_RUNNING",
                "retry_permitted": False,
            }
        elif exit_code == 0:
            terminal_status = "COMPLETED"
            reconciliation = None
        elif effect_observed:
            terminal_status = "OUTCOME_UNKNOWN"
            failure_kind = failure_kind or "PROVIDER_EXIT_AFTER_EFFECT"
            reconciliation = {
                "at": _agy_operation_journal.utc_now(),
                "result": "PROVIDER_EXIT_AFTER_OBSERVED_EFFECT",
                "provider_alive_before": bool(provider_pid or provider_pgid),
                "provider_alive_after": False,
                "retry_permitted": False,
            }
        else:
            terminal_status = "FAILED"
            reconciliation = None

        attestation = _parse_agy_attestation(
            attestation_log_path,
            requested_model=model,
        )
        # #2314: an attestation that may be forged or incomplete never ends
        # COMPLETED; with an observed effect the outcome is unknown.
        if snapshot.get("attestation_failure") and not attestation.get("attestation_failure"):
            attestation = {
                **attestation,
                "observed_provider": None,
                "observed_model": None,
                "provider_session_id": None,
                "attestation_failure": snapshot.get("attestation_failure"),
            }
        if attestation.get("attestation_failure") and terminal_status == "COMPLETED":
            failure_kind = str(attestation["attestation_failure"])
            if effect_observed:
                terminal_status = "OUTCOME_UNKNOWN"
                reconciliation = {
                    "at": _agy_operation_journal.utc_now(),
                    "result": "PROVIDER_ATTESTATION_UNTRUSTED_AFTER_EFFECT",
                    "retry_permitted": False,
                }
            else:
                terminal_status = "FAILED"
            exit_code = 1
        terminal_record = journal.mark_terminal(
            operation_id,
            status=terminal_status,
            exit_code=exit_code,
            failure_kind=failure_kind,
            cwd=cwd,
            write_paths=write_paths,
            attempts=int(snapshot.get("attempts") or 0),
            rotations=int(snapshot.get("rotations") or 0),
            empty_output_failovers=int(snapshot.get("empty_output_failovers") or 0),
            timeout_seconds=snapshot.get("timeout_seconds"),
            timeout_source=snapshot.get("timeout_source"),
            provider_stall_seconds=snapshot.get("provider_stall_seconds"),
            provider_stall_source=snapshot.get("provider_stall_source"),
            account_alias_hash=snapshot.get("account_alias_hash"),
            lease_id_hash=snapshot.get("lease_id_hash"),
            reconciliation=reconciliation,
            provider_pid=snapshot.get("provider_pid"),
            provider_pgid=snapshot.get("provider_pgid"),
            provider_process_state=(
                (
                    "RUNNING"
                    if direct_operation_journal._process_alive(snapshot.get("provider_pid"))
                    else "EXITED"
                )
                if isinstance(snapshot.get("provider_pid"), int)
                and snapshot.get("provider_pid") > 0
                else (snapshot.get("provider_process_state") or "IDLE")
            ),
            provider_started_at=snapshot.get("provider_started_at"),
            provider_stream_last_activity_at=snapshot.get("provider_stream_last_activity_at"),
            first_stream_activity_at=snapshot.get("first_stream_activity_at"),
            first_tool_activity_at=snapshot.get("first_tool_activity_at"),
            last_progress_activity_at=snapshot.get("last_progress_activity_at"),
            first_effect_at=snapshot.get("first_effect_at"),
            time_to_first_effect_ms=snapshot.get("time_to_first_effect_ms"),
            quota_preflight_progress=snapshot.get("quota_preflight_progress"),
            permission_profile_sha256=snapshot.get("permission_profile_sha256"),
            permission_profile_kind=snapshot.get("permission_profile_kind"),
            effective_permissions=snapshot.get("effective_permissions"),
            tool_event_count=int(snapshot.get("tool_event_count") or 0),
            has_unresolved_external_effect=bool(
                terminal_status == "OUTCOME_UNKNOWN" and effect_observed
            ),
            **attestation,
        )
        if (
            terminal_record.get("status") == "FAILED"
            and terminal_record.get("failure_kind") == "SCOPE_VIOLATION_UNAUTHORIZED_MUTATION"
        ):
            return 1
        return int(exit_code or 0)
    except _SupervisorSignalError:
        raise
    except BaseException:
        # The outer supervisor guard owns cleanup + terminalization. Writing a
        # terminal record here would make the guard skip child reconciliation.
        raise
    finally:
        if prior_attestation_log is None:
            os.environ.pop("NEXUS_AGY_ATTESTATION_LOG", None)
        else:
            os.environ["NEXUS_AGY_ATTESTATION_LOG"] = prior_attestation_log
        stop.set()
        heartbeat_thread.join(timeout=2.0)


def _completed_provider_exit_proven(record: dict[str, Any]) -> bool:
    """Return whether durable terminal evidence proves this completed provider exited."""
    return bool(
        record.get("status") == "COMPLETED"
        and record.get("phase") == "TERMINAL"
        and record.get("provider_process_state") == "EXITED"
        and record.get("has_unresolved_external_effect") is False
        and record.get("exit_code") == 0
    )


def _cleanup_reconciled_lease(record: dict[str, Any]) -> dict[str, Any]:
    reconciliation = record.get("reconciliation")
    reconciled_provider_absent = bool(
        isinstance(reconciliation, dict)
        and reconciliation.get("provider_alive_after") is False
    )
    if not reconciled_provider_absent and not _completed_provider_exit_proven(record):
        return {"result": "NOT_SAFE_TO_CLEAN"}

    provider_pid = record.get("provider_pid")
    if (
        record.get("mode") == "hcom_collab"
        and record.get("status") == "OUTCOME_UNKNOWN"
        and (not isinstance(provider_pid, int) or provider_pid <= 0)
    ):
        return {"result": "COLLAB_PROVIDER_IDENTITY_UNPROVEN_PRESERVED"}

    alias_hash = record.get("account_alias_hash")
    lease_id_hash = record.get("lease_id_hash")
    owner_pid = record.get("pid")
    if (
        not isinstance(alias_hash, str)
        or not alias_hash
        or not isinstance(lease_id_hash, str)
        or not lease_id_hash
        or not isinstance(owner_pid, int)
        or owner_pid <= 0
    ):
        return {"result": "LEASE_IDENTITY_INCOMPLETE"}

    lock_path = LEASES_DIR / f"{alias_hash}.lock"
    receipt_path = LEASES_DIR / f"{alias_hash}.receipt.json"
    if not receipt_path.exists():
        return {"result": "ALREADY_ABSENT"}

    LEASES_DIR.mkdir(parents=True, exist_ok=True)
    lock_obj = lock_path.open("a+")
    try:
        try:
            fcntl.flock(lock_obj.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (BlockingIOError, OSError):
            return {"result": "LEASE_BUSY_PRESERVED"}

        try:
            receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return {"result": "LEASE_RECEIPT_UNREADABLE_PRESERVED"}

        expected = {
            "account_alias_hash": alias_hash,
            "lease_id_hash": lease_id_hash,
            "pid": owner_pid,
        }
        observed = {
            "account_alias_hash": receipt.get("account_alias_hash"),
            "lease_id_hash": receipt.get("lease_id_hash"),
            "pid": receipt.get("pid"),
        }
        if observed != expected:
            return {
                "result": "LEASE_IDENTITY_MISMATCH_PRESERVED",
                "observed": observed,
            }

        # #2888: a worker-account agy runs through sudo without the inherited
        # lock, so matching alias, lease and pid is not enough (same rule as the
        # pool's reconcile_claim_receipt).
        if _agy_account_pool.receipt_has_worker_fields(
            receipt
        ) and not _agy_account_pool.worker_receipt_run_gone(receipt):
            return {"result": "LEASE_WORKER_UNPROVEN_PRESERVED"}

        try:
            receipt_path.unlink()
        except OSError as exc:
            return {
                "result": "LEASE_RECEIPT_REMOVE_FAILED",
                "error": type(exc).__name__,
            }
        return {"result": "LEASE_RECEIPT_REMOVED"}
    finally:
        try:
            fcntl.flock(lock_obj.fileno(), fcntl.LOCK_UN)
        finally:
            lock_obj.close()


def _path_identity(path: Path) -> list[int]:
    info = os.lstat(path)
    return [info.st_dev, info.st_ino]


def _run_worker_sweep(record: dict[str, Any], operation_id: str) -> dict[str, Any]:
    """Validate journal data before invoking the whitelisted worker sweep."""
    worker = _agy_worker_account()
    raw_root = record.get("worker_run_root")
    outcome = {"result": "RECORD_INVALID", "run_root": raw_root}
    if record.get("worker_run_as_user") != worker.WORKER_USER:
        return outcome
    if not isinstance(raw_root, str) or not raw_root or "\x00" in raw_root:
        return outcome
    try:
        run_root = Path(raw_root)
        if (
            ".." in run_root.parts
            or str(run_root.resolve()) != raw_root
            or run_root.parent != worker.WORKER_RUNS.resolve()
        ):
            return outcome
    except (OSError, ValueError, RuntimeError):
        return outcome
    if not os.path.lexists(run_root):
        # A vanished run root proves nothing: a surviving worker can keep an
        # unlinked cwd and the wrapper refuses a missing root. Only the
        # wrapper's own recorded clean sweep verdict for the latest attempt
        # counts as evidence that no worker process is alive.
        outcome["result"] = (
            "RUN_ROOT_GONE_UNPROVEN" if _descendant_sweep_unproven(record) else "RUN_ROOT_GONE"
        )
        return outcome
    # Identity check: no symlink, a directory we own, the very inode recorded at
    # creation (a same-named replacement or a renamed-in directory differs).
    # What remains between this check and sudo is closed by the wrapper's own
    # validation: a 32-hex direct child of worker-runs, canonical, no symlink.
    try:
        info = os.lstat(run_root)
    except OSError:
        return outcome
    if (
        not stat.S_ISDIR(info.st_mode)
        or info.st_uid != os.getuid()
        or record.get("worker_run_root_id") != [info.st_dev, info.st_ino]
    ):
        return outcome
    # Second factor: the Owner-written marker names this operation.
    if not worker.operation_marker_matches(run_root, operation_id):
        return outcome  # not this operation's run root
    outcome["result"] = worker.sweep_run_root(run_root)
    return outcome


def _reconcile_operation(
    journal: AgyOperationJournal,
    operation_id: str,
) -> dict[str, Any]:
    existing = journal.read(operation_id)
    worker_sweep = (
        _run_worker_sweep(existing, operation_id)
        if any(key in existing for key in _WORKER_SWEEP_KEYS) else None
    )
    record = journal.reconcile(operation_id)
    worker_sweep_failed = worker_sweep is not None and worker_sweep["result"] not in (
        "CLEAN", "RUN_ROOT_GONE",
    )
    if worker_sweep_failed:
        # A worker agy may still hold this account's token: never free the lease.
        lease_cleanup = {"result": "WORKER_SWEEP_UNPROVEN_PRESERVED"}
    else:
        lease_cleanup = _cleanup_reconciled_lease(record)
    reconciliation = dict(record.get("reconciliation") or {})
    reconciliation["lease_cleanup"] = lease_cleanup
    if worker_sweep is not None:
        reconciliation["worker_sweep"] = worker_sweep
        if worker_sweep_failed:
            # No positive evidence that no worker-uid process of this run is
            # alive: hold, and never let provider_alive_after read False.
            reconciliation.update({
                "result": "WORKER_SWEEP_UNPROVEN_HELD",
                "provider_alive_after": None,
                "retry_permitted": False,
            })
            return journal.update(
                operation_id,
                phase="RECONCILE_REQUIRED",
                reconciliation=reconciliation,
            )
    if _completed_provider_exit_proven(record) and not worker_sweep_failed:
        reconciliation.update({
            "provider_alive_before": False,
            "provider_alive_after": False,
            "retry_permitted": False,
        })
    if lease_cleanup.get("result") == "COLLAB_PROVIDER_IDENTITY_UNPROVEN_PRESERVED":
        reconciliation.update({
            "result": "HCOM_COLLAB_PROVIDER_IDENTITY_UNPROVEN",
            "provider_alive_after": None,
            "retry_permitted": False,
        })
        return journal.update(
            operation_id,
            phase="RECONCILE_REQUIRED",
            reconciliation=reconciliation,
        )
    return journal.update(operation_id, reconciliation=reconciliation)


_SAFE_NO_EFFECT_LEASE_RESULTS = frozenset({
    "ALREADY_ABSENT",
    "LEASE_RECEIPT_REMOVED",
})


def _finalize_no_effect_operation(
    journal: AgyOperationJournal,
    operation_id: str,
) -> dict[str, Any]:
    existing = journal.read(operation_id)
    existing_reconciliation = existing.get("reconciliation")
    if (
        existing.get("status") == "FAILED"
        and isinstance(existing_reconciliation, dict)
        and existing_reconciliation.get("result") == "SOURCE_NO_DURABLE_EFFECT_PROVEN"
        and existing_reconciliation.get("reconciliation_scope") == "SOURCE_ONLY"
        and existing_reconciliation.get("retry_permitted") is True
    ):
        return existing

    if _descendant_sweep_unproven(existing):
        # #2470: a writer of this run may survive; no source proof can bind it.
        raise AgyOperationJournalError("NO_EFFECT_DESCENDANT_SWEEP_UNPROVEN")
    record = _reconcile_operation(journal, operation_id)
    if _descendant_sweep_unproven(record):
        raise AgyOperationJournalError("NO_EFFECT_DESCENDANT_SWEEP_UNPROVEN")
    if record.get("status") != "OUTCOME_UNKNOWN":
        raise AgyOperationJournalError("NO_EFFECT_FINALIZATION_REQUIRES_OUTCOME_UNKNOWN")

    reconciliation = dict(record.get("reconciliation") or {})
    if reconciliation.get("pid_alive") is not False:
        raise AgyOperationJournalError("NO_EFFECT_PROCESS_TRUTH_UNBOUNDED")
    if reconciliation.get("provider_alive_after") is not False:
        raise AgyOperationJournalError("NO_EFFECT_PROVIDER_TRUTH_UNBOUNDED")

    lease_cleanup = reconciliation.get("lease_cleanup")
    lease_result = lease_cleanup.get("result") if isinstance(lease_cleanup, dict) else None
    if lease_result not in _SAFE_NO_EFFECT_LEASE_RESULTS:
        raise AgyOperationJournalError(f"NO_EFFECT_LEASE_NOT_SAFE:{lease_result or 'UNKNOWN'}")

    source_proof = journal.prove_source_state_unchanged(operation_id)
    reconciliation.update({
        "at": _agy_operation_journal.utc_now(),
        "result": "SOURCE_NO_DURABLE_EFFECT_PROVEN",
        "reconciliation_scope": "SOURCE_ONLY",
        "retry_permitted": True,
        "source_proof": source_proof,
        "lease_cleanup": lease_cleanup,
    })
    return journal.mark_terminal(
        operation_id,
        status="FAILED",
        exit_code=record.get("exit_code"),
        failure_kind=record.get("failure_kind"),
        cwd=record.get("cwd"),
        reconciliation=reconciliation,
    )


_ACK_OPEN_FILE_SCAN_TIMEOUT_SECONDS = 120


def _open_file_holders(roots: list[str], exclude: set[int]) -> set[int] | None:
    """Same-uid pids holding any open file (cwd included) under ``roots``.

    ``lsof +D`` per root, bounded by a timeout; None when a scan cannot run,
    prints diagnostics or returns a record it cannot parse.
    """
    found: set[int] = set()
    for root in roots:
        try:
            completed = subprocess.run(
                ["lsof", "-nP", "-a", "-u", str(os.getuid()), "-F", "p", "+D", root],
                env={"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL": "C", "LANG": "C"},
                capture_output=True,
                text=True,
                timeout=_ACK_OPEN_FILE_SCAN_TIMEOUT_SECONDS,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            return None
        # lsof exits 1 both for "nothing found" and (with -a on macOS) for a
        # partial match, so the exit code alone proves nothing: any diagnostic
        # or a malformed record makes the scan unknown.
        if completed.returncode not in (0, 1) or completed.stderr.strip():
            return None
        for line in completed.stdout.splitlines():
            if not line:
                continue
            if line[:1] == "p" and line[1:].isdigit():
                found.add(int(line[1:]))
            elif line[:1] != "f":
                return None
    return found - exclude


def _ack_unclean_sweep_operation(
    journal: AgyOperationJournal,
    operation_id: str,
) -> dict[str, Any]:
    """Operator attestation for an operation held by an unproven sweep (#2470).

    This is not proof that the run's writers are gone: an escaped process
    could still come back. It refuses while the wrapper or provider lives,
    while any process of this uid (other than this one and its ancestors) has
    its cwd or any open file under the target or the run's sweep roots, and
    when a scan cannot run. On success it records
    ``descendant_sweep_operator_ack`` for the latest attempt (the sweep
    verdict itself is left as it was, never set True) and reconciles.
    """
    record = journal.read(operation_id)
    if not _descendant_sweep_unproven(record):
        raise AgyOperationJournalError("ACK_UNCLEAN_SWEEP_NOT_REQUIRED")
    if _agy_operation_journal._process_alive(record.get("pid")) or (
        _agy_operation_journal._process_alive(record.get("provider_pid"))
    ):
        raise AgyOperationJournalError("ACK_UNCLEAN_SWEEP_PROCESS_ALIVE")
    target = record.get("cwd")
    if not isinstance(target, str) or not target:
        raise AgyOperationJournalError("ACK_UNCLEAN_SWEEP_TARGET_UNKNOWN")
    roots = [target]
    for root in record.get("descendant_sweep_roots") or []:
        if isinstance(root, str) and root not in roots and os.path.isdir(root):
            roots.append(root)
    cli_worker = import_module("nexus.executors.cli_worker")
    baseline = cli_worker.sweep_baseline()
    if baseline is None:
        raise AgyOperationJournalError("ACK_UNCLEAN_SWEEP_SCAN_UNAVAILABLE")
    # Every process of this uid counts, however old: the escaped writer may
    # predate this command.
    everything = dataclasses.replace(baseline, started_at=0.0, preexisting=frozenset())
    residents = cli_worker._pids_with_cwd_under(tuple(roots), everything)
    if residents is None:
        raise AgyOperationJournalError("ACK_UNCLEAN_SWEEP_SCAN_UNAVAILABLE")
    if residents:
        raise AgyOperationJournalError(
            "ACK_UNCLEAN_SWEEP_RESIDENTS:" + ",".join(str(pid) for pid in sorted(residents))
        )
    holders = _open_file_holders(roots, set(baseline.protected) | {os.getpid()})
    if holders is None:
        raise AgyOperationJournalError("ACK_UNCLEAN_SWEEP_SCAN_UNAVAILABLE")
    if holders:
        raise AgyOperationJournalError(
            "ACK_UNCLEAN_SWEEP_OPEN_FILES:" + ",".join(str(pid) for pid in sorted(holders))
        )
    journal.update(
        operation_id,
        descendant_sweep_operator_ack={
            "attempt": int(record.get("attempts") or 0),
            "at": _agy_operation_journal.utc_now(),
            "kind": "OPERATOR_ATTESTATION_NOT_PROOF",
            "operator_check": {
                "roots": roots,
                "cwd_residents": [],
                "open_file_holders": [],
                "sweep_clean_at_ack": record.get("descendant_sweep_clean"),
                "sweep_attempt_at_ack": record.get("descendant_sweep_attempt"),
            },
        },
    )
    return _reconcile_operation(journal, operation_id)


def _print_operation(record: dict[str, Any]) -> None:
    summary = public_operation_view(record)
    for key in (
        "timeout_seconds",
        "timeout_source",
        "provider_stall_seconds",
        "provider_stall_source",
        "empty_output_failovers",
    ):
        if key in record:
            summary[key] = record[key]
    print(json.dumps(summary, indent=2, sort_keys=True))


class _ForegroundSignalExit(BaseException):
    """Raised by the foreground signal handler so ``finally`` cleanup runs (#2717)."""

    def __init__(self, signum: int) -> None:
        self.signum = signum
        super().__init__(signum)


_FOREGROUND_CLEANUP_SIGNALS = tuple(
    sig for sig in (getattr(signal, "SIGTERM", None), getattr(signal, "SIGHUP", None)) if sig
)


def _run_foreground_with_signal_cleanup(func: Any, **kwargs: Any) -> int:
    """Run a foreground dispatch so SIGTERM/SIGHUP unwind through cleanup.

    Python's default SIGTERM/SIGHUP action kills the interpreter without running
    ``finally`` blocks, which orphaned the provider (own session) and left the
    lease receipt behind (#2717).  Converting the signal into an exception lets
    ``run_agy`` stop the provider group and ``dispatch_run`` release the claim.
    Only installed on the main thread; prior handlers are restored afterwards.
    """
    if threading.current_thread() is not threading.main_thread():
        return func(**kwargs)

    def _handler(signum: int, _frame: Any) -> None:
        # One-shot: a repeated signal must not interrupt the cleanup itself.
        for sig in _FOREGROUND_CLEANUP_SIGNALS:
            try:
                signal.signal(sig, signal.SIG_IGN)
            except (OSError, ValueError):
                pass
        raise _ForegroundSignalExit(signum)

    prior: dict[int, Any] = {}
    try:
        for sig in _FOREGROUND_CLEANUP_SIGNALS:
            prior[sig] = signal.getsignal(sig)
            signal.signal(sig, _handler)
        return func(**kwargs)
    except _ForegroundSignalExit as exc:
        try:
            emit_meta({
                "status": "failed",
                "failure_kind": f"FOREGROUND_SIGNAL:{signal.Signals(exc.signum).name}",
            })
        except Exception:
            pass
        return 128 + int(exc.signum)
    finally:
        for sig, handler in prior.items():
            try:
                signal.signal(sig, handler)
            except (OSError, ValueError, TypeError):
                pass


