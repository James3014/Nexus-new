{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus Public Benchmark Manifest",
  "type": "object",
  "required": ["version", "frozen", "benchmark_id", "description", "tasks"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "frozen": {"type": "boolean"},
    "benchmark_id": {"type": "string"},
    "description": {"type": "string"},
    "commercial_lane_source": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "difficulty",
          "repo_kind",
          "repo",
          "repo_ref",
          "task_desc",
          "success_criteria",
          "mutation_required",
          "allowed_files",
          "forbidden_files",
          "setup_command",
          "verification_command"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "category": {
            "enum": ["bugfix", "test_repair", "refactor", "feature", "docs_code_sync", "ops_research"]
          },
          "difficulty": {"enum": ["easy", "medium", "hard"]},
          "repo_kind": {"enum": ["nexus_internal", "neutral_fixture", "external"]},
          "repo": {"type": "string"},
          "repo_ref": {"type": "string"},
          "task_desc": {"type": "string"},
          "stratum_type": {
            "enum": ["pure_docs", "docs_code_sync", "evidence_required_docs"]
          },
          "target_file": {"type": "string"},
          "test_file": {"type": "string"},
          "fixture_kind": {"type": "string"},
          "commercial_lane": {
            "enum": ["capability_lift", "governed_delivery", "cost_efficiency"]
          },
          "source_manifest": {"type": "string"},
          "expected_capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "codeintel",
                "research",
                "hyper",
                "nightshift",
                "swarm",
                "drone",
                "ultra_review",
                "autoreason",
                "ddtree",
                "memory",
                "lancedb",
                "semantic_searcher",
                "belief",
                "swarm_quiet_moment",
                "mempalace_gate",
                "artifact_gate",
                "claim_gate",
                "delivery_gate"
              ]
            }
          },
          "capability_activation_contract": {
            "enum": ["required", "allowed", "forbidden", "cost_capped"]
          },
          "hidden_oracle_kind": {
            "enum": ["pytest_hidden", "report_claims", "semantic_fixture", "trace_receipt", "cost_guard"]
          },
          "eligibility_class": {
            "enum": ["deterministic_contract", "model_required", "bare_model_only"]
          },
          "cost_budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_wall_sec": {"type": "number"},
              "max_model_calls": {"type": "integer"},
              "max_tokens": {"type": "integer"},
              "max_capability_stack_size": {"type": "integer"}
            }
          },
          "token_budget": {"type": "integer"},
          "wall_time_budget_sec": {"type": "number"},
          "public_claim_allowed_metrics": {
            "type": "array",
            "items": {"type": "string"}
          },
          "rlm_challenge": {
            "enum": [
              "multi_file",
              "long_context",
              "misleading_tests",
              "second_round_diagnosis",
              "hidden_governance",
              "hidden_evidence",
              "hidden_second_round",
              "hidden_belief_budget",
              "hidden_memory_contract"
            ]
          },
          "success_criteria": {"enum": ["all_target_tests_pass", "patch_and_tests_pass", "report_contract_verified"]},
          "mutation_required": {"type": "boolean"},
          "allowed_files": {"type": "array", "items": {"type": "string"}},
          "forbidden_files": {"type": "array", "items": {"type": "string"}},
          "setup_command": {"type": "string"},
          "verification_command": {"type": "string"}
        }
      }
    }
  }
}
