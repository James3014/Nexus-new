        if transform.op == '&' and sepleft.shape[0] > 1 and sepright.shape[0] > 1:
            # For AND operations with multiple outputs on each side, create block diagonal
            n_left = sepleft.shape[0]
            n_right = sepright.shape[0]
            result = np.zeros((n_left + n_right, n_left + n_right), dtype=np.bool_)
            result[:n_left, :n_left] = sepleft
            result[n_left:, n_left:] = sepright
            return result
