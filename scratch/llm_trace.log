def _separable(transform):
    """
    Compute the separability matrix for a given transform.

    Parameters
    ----------
    transform : `~astropy.modeling.core.Model`
        A (compound) model.

    Returns
    -------
    separable_matrix : ndarray
        A boolean correlation matrix of shape (n_outputs, n_inputs).
        Indicates the dependence of outputs on inputs. For completely
        independent outputs, the diagonal elements are True and
        off-diagonal elements are False.
    """
    if isinstance(transform, CompoundModel):
        left = _separable(transform.left)
        right = _separable(transform.right)
        separable_matrix = np.zeros((transform.n_outputs, transform.n_inputs), dtype=bool)
        separable_matrix[:left.shape[0], :left.shape[1]] = left
        separable_matrix[left.shape[0]:, left.shape[1]:] = right
        return separable_matrix
    else:
        if transform.separable:
            separable_matrix = np.eye(transform.n_outputs, dtype=bool)
        else:
            separable_matrix = np.ones((transform.n_outputs, transform.n_inputs), dtype=bool)
        return separable_matrix
```

