{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "decision_id": {"type": "string"},
    "url": {"type": "string"},
    "resolver": {"type": "string", "enum": ["firecrawl", "yt-dlp", "scrapegraph", "crawlee"]},
    "tier": {"type": "integer", "minimum": 1, "maximum": 4},
    "content_type": {"type": "string", "enum": ["markdown", "structured", "transcript", "screenshot"]},
    "markdown": {"type": "string"},
    "structured_data": {"type": ["object", "null"]},
    "transcript": {"type": ["array", "string", "null"]},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "elapsed_ms": {"type": "integer"},
    "trace": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["decision_id", "url", "resolver", "tier", "content_type", "markdown", "elapsed_ms"]
}
