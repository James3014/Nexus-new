      "test": {"cwd": "TARGET_ROOT", "argv": ["python3", "-m", "pytest", "-q", "tests/ops/test_nexus_benchmark_preflight.py"]},
      "fixture_policy": {"kind": "clean_cache", "network": false, "secrets": false},
