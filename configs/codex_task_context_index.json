      "test": {"cwd": "TARGET_ROOT", "argv": ["git", "diff", "--check"]},
      "fixture_policy": {"kind": "no_mutation", "network": false, "secrets": false},
      "forbidden_scope": [".env", ".git", ".nexus"]
    },
    {
      "id": "dx-verification-v1",
      "task_class": "verification",
